include "../compiler/runtime/elisacore_std/elisacore_runtime.elisa"

# FIXED. stage1 now returns 4, matching stage0. `decode_string_escapes`
# (src/backend/codegen_env.elisa) grew `\xHH` and `\uXXXX` handling plus two
# helpers, hex_digit_value and push_utf8; a malformed escape keeps its source text
# and clears all_known rather than guessing a value.
#
# Verified across every escape form, dumped as raw bytes and diffed against
# stage0 -- \x lower/upper hex, \u producing 1/2/3 UTF-8 bytes, the classic
# escapes (unchanged), and a non-escape `%`: all IDENTICAL.
#
# It was the ONLY mismatch in the 145-program differential corpus, and the corpus
# was the thing that surfaced it -- this file had documented the bug since
# 2026-08-25 but nothing was failing on it.
#
# ORIGINAL REPORT (stage1 only): the `\xHH` and `\uXXXX` escapes in a string literal are
# not decoded by stage1's lexer. Both literals below are 2 bytes under stage0;
# the program returns the total length it observes, so the exit code IS the
# answer.
#
#   stage0: exit 4   (correct: "\x41\x42" is "AB" and "é" is the 2 UTF-8
#                     bytes of e-acute)
#   stage1: exit 14  (both escapes survived as their literal source text)
#
# Found while generating the elisacore_json cross-check corpus (2026-08-25).
# This one is nastier than a decline: it does not fail to compile, it silently
# feeds the two compilers DIFFERENT input, so a test fixture that spells a byte
# with `\xHH` or a codepoint with `\uXXXX` disagrees across stages for reasons
# that have nothing to do with the code under test.
#
# `\n`, `\r`, `\t`, `\"`, `\\` and raw UTF-8 bytes are decoded identically by
# both lexers; the json fixture and its generator use only those, and build any
# other control byte at run time by pushing it into a darray.

def main() -> i64:
    hex_form: sview = sview("\x41\x42", 0, -1)
    unicode_form: sview = sview("\u00e9", 0, -1)
    return hex_form.len + unicode_form.len
