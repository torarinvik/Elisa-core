# stage0 wasm32: a fresh `darray` is not fresh on the SECOND call
#
# ---------------------------------------------------------------------------
# RESOLVED (2026-08-25, nw-port stage0 ff42deed) -- and the original diagnosis
# in this file was WRONG about the cause.
# ---------------------------------------------------------------------------
#
# What this file measured: nw_literal_direct() returned 914 every call while
# nw_literal_checksum() returned 914 once and then 935 forever. That framing --
# "stale on the second call" -- described the symptom, not the defect, and the
# suspects it listed (a static holding initial capacity, thread-local storage,
# data-segment init) were all wrong.
#
# THE ACTUAL CAUSE was pointer width. The backend seeded `wordBits` from
# unsafe.Sizeof(uintptr(0)), the COMPILER's pointer size, so a wasm32 build had
# 4-byte pointers alongside an 8-byte `usize`. The darray header
# {items, count, capacity} therefore measured 24 bytes where the emitted code
# indexed it as 12, and reads through the two paths landed at different offsets.
# The "second call" pattern was just which stale bytes happened to be lying
# around. Fixed by deriving the width from LLVM's data layout for the resolved
# triple; both exports now return 914 on every call.
#
# The same root cause produced the unsatisfiable import ABI recorded in
# nw_wasm32_usize_width.md, which is fixed by the same change.
#
# STILL BROKEN, separately: two darrays growing INTERLEAVED lose elements past
# the first relocation, because only one array can be the arena's tail
# allocation. See repro/nw_wasm32_interleaved_darray_growth.elisa. That is what
# still garbles pooled strings in a display-list frame; a single growing array
# is now correct.
#
# Kept as a regression guard: both exports must return 914 on every call.

def literal_checksum() -> i64:
    can Memory.Allocate, Abort.Panic:
        text: sview = "Dual N-Back"
        bytes: mutable darray[u8] = []
        total: mutable i64 = 0
        index: mutable i64 = 0
        length: i64 = sview_len(text).i64()
        while index < length |index, bytes, text|:
            bytes.push(sview_at(text, index.usize()))
            index <- index + 1
        scan: mutable i64 = 0
        while scan < bytes.count.i64() |scan, total, bytes|:
            total <- total + (get bytes[scan.usize()] else 0.u8()).i64()
            scan <- scan + 1
        return total

# The same, but reading the literal directly with no darray in between.
def literal_direct() -> i64:
    can Abort.Panic:
        text: sview = "Dual N-Back"
        total: mutable i64 = 0
        index: mutable i64 = 0
        length: i64 = sview_len(text).i64()
        while index < length |index, total, text|:
            total <- total + sview_at(text, index.usize()).i64()
            index <- index + 1
        return total

export fn nw_literal_checksum() -> i64 = literal_checksum
export fn nw_literal_direct() -> i64 = literal_direct
