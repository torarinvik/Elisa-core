include "../compiler/runtime/elisacore_std/elisacore_runtime.elisa"

# Repro (stage1 only): an `sview` (builtin StringView) used as an ENUM VARIANT
# PAYLOAD makes the stage1 backend decline every function that matches on the
# enum, which drops the whole unit. Binding the payload is enough -- the arm
# below never reads `t`. Found while building elisacore_json (2026-08-25).
#
#   stage0: compiles + runs, exit 0
#   stage1: error: backend emitted no functions for this unit; declined 4:
#             tag_of, join, tag_of, main
#           note: every function in the unit is dropped when the backend
#                 declines one; the object was not written
#
# ---------------------------------------------------------------------------
# NARROWED
# ---------------------------------------------------------------------------
# * A USER struct payload of the same shape ({i64, i64}) is fine on BOTH stages
#   -- so it is not "struct payloads" in general, it is `sview` specifically.
# * Scalar payloads (bool / f64 / i64 / uintptr) are fine on both stages.
# * An `sview` LOCAL, and calls to `sview(...)`, are fine on stage1; only the
#   enum-variant-payload position declines.
# * `join` in the decline list is the std's Fs::join and is declined harmlessly
#   in every build; `tag_of` is the function that actually matters. Run with
#   ELISA_DBG_DECLINE=1 and grep for `DROPPED` on a name from your own file.
#
# WORKAROUND used by elisacore_json.elisa: carry strings as
# `(data_bits: uintptr, len: i64)` in the variant and rebuild the `sview` in an
# accessor under `trusted Unsafe.PointerCast`.

enum Holder:
    Empty
    Text(text: sview)

def tag_of(v: Holder) -> i64:
    match v:
        Holder.Empty:
            return 0
        Holder.Text(t):
            return 1

def main() -> i64:
    1 return if tag_of(Holder.Empty) != 0
    2 return if tag_of(Holder.Text(text: sview("hi", 0, -1))) != 1
    return 0
