# FIXED. An UNQUALIFIED call to a sibling inside a module bound to a STDLIB
# GENERIC of the same name instead of the sibling. stage0 refused this:
#
#   argument 1 to "add" expects mutable Flags[T]&, got mutable Box.Sack&
#
# while stage1 compiled and ran it correctly -- the two compilers disagreeing
# about a module member calling its own sibling by its own name.
#
# Cause: identifier resolution reaches the global scope through the ordinary
# scope chain, so the stdlib's `add` was found there and returned before the
# enclosing module was ever consulted. The namespace-aware lookup existed
# (visibleNameCandidates puts `Box.add` first) but nothing on this path used it.
#
# Fixed by rewriteEnclosingNamespaceCallee, which RENAMES a bare callee to the
# enclosing module's member. Renaming, not merely resolving the type: the first
# attempt preferred the member in ident analysis alone, so the call type-checked
# against Box's signature while codegen still emitted the stdlib symbol -- this
# file compiled clean and returned 0. A wrong answer is worse than the error it
# replaced, and only running it showed that. Guarded at runtime by
# compiler/src/module_sibling_runtime_test.go for exactly that reason.
#
# Locals and parameters still shadow.
#
# Kept as a runnable check: it must exit 7.

include "../compiler/runtime/elisacore_std/elisacore_runtime.elisa"

module Box:
    struct Sack:
        items: mutable darray[i64]

    def add(s: mutable Sack&, v: i64):
        can Memory.Allocate, Abort.Panic:
            s.items.push(v)

    def fill(s: mutable Sack&):
        can Memory.Allocate, Abort.Panic:
            add(s, 7)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region w(64 * 1024)
        out: mutable i64 = 0
        in w:
            s: mutable Box::Sack = Box::Sack{items: []}
            Box::fill(&s)
            out <- get s.items[0] else 0
        destroy w
        return out
