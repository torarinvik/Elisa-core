# Repro: `try <void error union> else <fallback>` traps at runtime even on the
# ok path. The equivalent `catch` handling works. Found while porting the
# fileio std module (2026-08-25). Expected exit 0; actual: SIGTRAP (exit 133).

error VoidErr:
    Bad

def ok_void() -> void error[VoidErr]:
    return

def main() -> i64:
    try ok_void() else return 1
    return 0
