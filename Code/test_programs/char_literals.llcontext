include "../llcontext_std/test.llcontext"

const CHAR_A: char = 'A'
const CHAR_NL: char = '\n'
const CHAR_B: char = '\x42'
const CHAR_C: char = '\u0043'

def char_code() -> i64:
    return CHAR_A.i64()

def escaped_char_code() -> i64:
    return CHAR_NL.i64()

def char_compare() -> bool:
    return 'A' == CHAR_A and CHAR_B == 'B' and CHAR_C == 'C'

def char_array_checksum() -> i64:
    values: char[4] = ['A', '\n', '\x42', '\u0043']
    return values[0].i64() + values[1].i64() + values[2].i64() + values[3].i64()

def char_literals_main_impl() -> int:
    can Abort.Panic:
        assert_eq(char_code(), 65)
        assert_eq(escaped_char_code(), 10)
        assert_eq(char_compare(), true)
        assert_eq(char_array_checksum(), 208)
        return 0

export func main() -> int = char_literals_main_impl