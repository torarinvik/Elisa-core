struct FactBuilderTag:
    value: int

static interface FactBuilder:
    type State
    def state() -> State

impl FactBuilder for FactBuilderTag:
    type State = int

    def state() -> int:
        return 7

def fact_interface_rules[B: FactBuilder]() -> B.State can[Console.Write]:
    can Console.Write:
        signal Console.Write
    return B.state()

def fact_interface_concrete() -> int can[Console.Write]:
    can Console.Write:
        return fact_interface_rules[FactBuilderTag]()
