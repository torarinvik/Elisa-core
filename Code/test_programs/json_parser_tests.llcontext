# include "json_parser.llcontext"


@test
def checksum_suite_matches_expected_values() -> void:
    assert(json_expect_checksum("{}", 47))
    assert(json_expect_checksum("[]", 43))
    assert(json_expect_checksum("{\"a\":1}", 89))
    assert(json_expect_checksum("[true,false,null]", 152))


@test
def ast_checksum_matches_expected_values() -> void:
    assert(json_expect_ast_checksum("{}", 47))
    assert(json_expect_ast_checksum("[]", 43))
    assert(json_expect_ast_checksum("{\"a\":1}", 89))
    assert(json_expect_ast_checksum("[true,false,null]", 152))


@test
def ast_and_checksum_paths_agree_on_nested_inputs() -> void:
    assert(json_parser_ast_checksum_impl("{\"items\":[1,2,3],\"ok\":true}".cast[any u8&]()) == json_parser_checksum_impl("{\"items\":[1,2,3],\"ok\":true}".cast[any u8&]()))
    assert(json_parser_ast_checksum_impl("[-12,3.5,null]".cast[any u8&]()) == json_parser_checksum_impl("[-12,3.5,null]".cast[any u8&]()))


@test
def invalid_inputs_are_rejected() -> void:
    assert(json_expect_invalid("{\"a\":[1,2}"))
    assert(json_expect_invalid_ast("{\"a\":[1,2}"))
    assert(json_expect_invalid("[1,,2]"))
    assert(json_expect_invalid_ast("[1,,2]"))
    assert(json_expect_invalid("\"\\q\""))
    assert(json_expect_invalid_ast("\"\\q\""))
    assert(json_expect_invalid("\"\\uD83D\""))
    assert(json_expect_invalid_ast("\"\\uD83D\""))
    assert(json_expect_invalid("\"\\uDE00\""))
    assert(json_expect_invalid_ast("\"\\uDE00\""))
    assert(json_expect_invalid("\"\\uD83D\\u0041\""))
    assert(json_expect_invalid_ast("\"\\uD83D\\u0041\""))


@test
def ast_raw_dom_helpers_expose_source_spans_and_structure() -> void:
    source: static u8& = "{\"name\":\"Ada\",\"nums\":[1,-2,3.5],\"ok\":true,\"none\":null}"
    source_any: any u8& = source.cast[any u8&]()
    source_len: usize = runtime_strlen(source_any)

    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, store)

    assert(result.checksum > 0)
    assert(json_ast_kind(result.node, store) == JsonNodeKind.OBJECT)
    assert(json_ast_object_len(result.node, store) == 4)

    name_node: JsonNode = json_ast_object_get(result.node, source_any, "name".cast[any u8&](), store)
    assert(not json_node_is_invalid(name_node, store))
    assert(json_ast_kind(name_node, store) == JsonNodeKind.STRING)
    assert(string_view_eq(json_ast_source_view(source_any, name_node, store), "\"Ada\"".cast[any u8&]()) != 0)
    assert(string_view_eq(json_ast_string_view(source_any, name_node, store), "Ada".cast[any u8&]()) != 0)

    nums_node: JsonNode = json_ast_object_get(result.node, source_any, "nums".cast[any u8&](), store)
    assert(not json_node_is_invalid(nums_node, store))
    assert(json_ast_kind(nums_node, store) == JsonNodeKind.ARRAY)
    assert(json_ast_array_len(nums_node, store) == 3)

    first_num: JsonNode = json_ast_array_nth(nums_node, 0u, store)
    second_num: JsonNode = json_ast_array_nth(nums_node, 1u, store)
    third_num: JsonNode = json_ast_array_nth(nums_node, 2u, store)
    missing_num: JsonNode = json_ast_array_nth(nums_node, 3u, store)
    assert(string_view_eq(json_ast_number_view(source_any, first_num, store), "1".cast[any u8&]()) != 0)
    assert(string_view_eq(json_ast_number_view(source_any, second_num, store), "-2".cast[any u8&]()) != 0)
    assert(string_view_eq(json_ast_number_view(source_any, third_num, store), "3.5".cast[any u8&]()) != 0)
    assert(json_node_is_invalid(missing_num, store))

    ok_node: JsonNode = json_ast_object_get(result.node, source_any, "ok".cast[any u8&](), store)
    none_node: JsonNode = json_ast_object_get(result.node, source_any, "none".cast[any u8&](), store)
    missing_field: JsonNode = json_ast_object_get(result.node, source_any, "missing".cast[any u8&](), store)
    assert(json_ast_bool_value(ok_node, store) == 1)
    assert(json_ast_is_null(none_node, store))
    assert(json_node_is_invalid(missing_field, store))

    destroy scratch


@test
def ast_string_helpers_decode_escapes_and_match_unescaped_keys() -> void:
    source: static u8& = "{\"na\\u006de\":\"line\\nbreak\",\"quote\":\"\\\"\",\"slash\":\"\\/\",\"smile\":\"\\u263A\",\"grin\":\"\\uD83D\\uDE00\"}"
    source_any: any u8& = source.cast[any u8&]()
    source_len: usize = runtime_strlen(source_any)

    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, store)

    assert(result.checksum > 0)

    name_node: JsonNode = json_ast_object_get(result.node, source_any, "name".cast[any u8&](), store)
    quote_node: JsonNode = json_ast_object_get(result.node, source_any, "quote".cast[any u8&](), store)
    slash_node: JsonNode = json_ast_object_get(result.node, source_any, "slash".cast[any u8&](), store)
    smile_node: JsonNode = json_ast_object_get(result.node, source_any, "smile".cast[any u8&](), store)
    grin_node: JsonNode = json_ast_object_get(result.node, source_any, "grin".cast[any u8&](), store)

    assert(not json_node_is_invalid(name_node, store))
    assert(not json_node_is_invalid(quote_node, store))
    assert(not json_node_is_invalid(slash_node, store))
    assert(not json_node_is_invalid(smile_node, store))
    assert(not json_node_is_invalid(grin_node, store))

    assert(json_ast_string_eq_literal(source_any, name_node, "line\nbreak".cast[any u8&](), store))
    assert(json_ast_string_eq_literal(source_any, quote_node, "\"".cast[any u8&](), store))
    assert(json_ast_string_eq_literal(source_any, slash_node, "/".cast[any u8&](), store))
    assert(json_ast_string_eq_literal(source_any, smile_node, "\u263A".cast[any u8&](), store))
    assert(json_ast_string_eq_literal(source_any, grin_node, "\uD83D\uDE00".cast[any u8&](), store))

    destroy scratch


@test
def ast_number_helpers_materialize_integral_values_and_classify_edges() -> void:
    source: static u8& = "{\"small\":123,\"big\":18446744073709551615,\"neg\":-9223372036854775808,\"frac\":1.5,\"exp\":1e3,\"huge\":18446744073709551616,\"tiny\":-9223372036854775809}"
    source_any: any u8& = source.cast[any u8&]()
    source_len: usize = runtime_strlen(source_any)

    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, store)

    assert(result.checksum > 0)

    small_node: JsonNode = json_ast_object_get(result.node, source_any, "small".cast[any u8&](), store)
    big_node: JsonNode = json_ast_object_get(result.node, source_any, "big".cast[any u8&](), store)
    neg_node: JsonNode = json_ast_object_get(result.node, source_any, "neg".cast[any u8&](), store)
    frac_node: JsonNode = json_ast_object_get(result.node, source_any, "frac".cast[any u8&](), store)
    exp_node: JsonNode = json_ast_object_get(result.node, source_any, "exp".cast[any u8&](), store)
    huge_node: JsonNode = json_ast_object_get(result.node, source_any, "huge".cast[any u8&](), store)
    tiny_node: JsonNode = json_ast_object_get(result.node, source_any, "tiny".cast[any u8&](), store)

    assert(not json_node_is_invalid(small_node, store))
    assert(not json_node_is_invalid(big_node, store))
    assert(not json_node_is_invalid(neg_node, store))
    assert(not json_node_is_invalid(frac_node, store))
    assert(not json_node_is_invalid(exp_node, store))
    assert(not json_node_is_invalid(huge_node, store))
    assert(not json_node_is_invalid(tiny_node, store))

    small_u64: JsonUnsignedResult = json_ast_number_u64_value(source_any, small_node, store)
    small_i64: JsonSignedResult = json_ast_number_i64_value(source_any, small_node, store)
    big_u64: JsonUnsignedResult = json_ast_number_u64_value(source_any, big_node, store)
    big_i64: JsonSignedResult = json_ast_number_i64_value(source_any, big_node, store)
    neg_u64: JsonUnsignedResult = json_ast_number_u64_value(source_any, neg_node, store)
    neg_i64: JsonSignedResult = json_ast_number_i64_value(source_any, neg_node, store)
    frac_value: JsonNumberValue = json_ast_number_value(source_any, frac_node, store)
    exp_value: JsonNumberValue = json_ast_number_value(source_any, exp_node, store)
    huge_value: JsonNumberValue = json_ast_number_value(source_any, huge_node, store)
    tiny_value: JsonNumberValue = json_ast_number_value(source_any, tiny_node, store)

    assert(json_ast_number_kind(source_any, small_node, store) == JsonNumberKind.UNSIGNED)
    assert(small_u64.ok)
    assert(small_u64.value == 123u64)
    assert(small_i64.ok)
    assert(small_i64.value == 123)
    assert(json_ast_number_is_integral(source_any, small_node, store))

    assert(json_ast_number_kind(source_any, big_node, store) == JsonNumberKind.UNSIGNED)
    assert(big_u64.ok)
    assert(big_u64.value == 18446744073709551615u64)
    assert(not big_i64.ok)
    assert(json_ast_number_is_integral(source_any, big_node, store))

    assert(json_ast_number_kind(source_any, neg_node, store) == JsonNumberKind.SIGNED)
    assert(not neg_u64.ok)
    assert(neg_i64.ok)
    min_i64: i64 = -9223372036854775807 - 1
    assert(neg_i64.value == min_i64)
    assert(json_ast_number_is_integral(source_any, neg_node, store))

    assert(frac_value.kind == JsonNumberKind.NON_INTEGRAL)
    assert(exp_value.kind == JsonNumberKind.NON_INTEGRAL)
    assert(huge_value.kind == JsonNumberKind.OUT_OF_RANGE)
    assert(tiny_value.kind == JsonNumberKind.OUT_OF_RANGE)
    assert(not json_ast_number_is_integral(source_any, frac_node, store))
    assert(not json_ast_number_is_integral(source_any, exp_node, store))
    assert(not json_ast_number_is_integral(source_any, huge_node, store))
    assert(not json_ast_number_is_integral(source_any, tiny_node, store))
    assert(not json_ast_number_u64_value(source_any, frac_node, store).ok)
    assert(not json_ast_number_i64_value(source_any, exp_node, store).ok)

    destroy scratch


@test
def ast_number_helpers_materialize_float_values_across_fractional_and_large_inputs() -> void:
    source: static u8& = "{\"frac\":1.5,\"exp\":1e3,\"huge\":18446744073709551616}"
    source_any: any u8& = source.cast[any u8&]()
    source_len: usize = runtime_strlen(source_any)

    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, store)

    assert(result.checksum > 0)

    frac_node: JsonNode = json_ast_object_get(result.node, source_any, "frac".cast[any u8&](), store)
    exp_node: JsonNode = json_ast_object_get(result.node, source_any, "exp".cast[any u8&](), store)
    huge_node: JsonNode = json_ast_object_get(result.node, source_any, "huge".cast[any u8&](), store)

    frac_f64: JsonFloat64Result = json_ast_number_f64_value(source_any, frac_node, store)
    frac_f32: JsonFloat32Result = json_ast_number_f32_value(source_any, frac_node, store)
    exp_f64: JsonFloat64Result = json_ast_number_f64_value(source_any, exp_node, store)
    exp_f32: JsonFloat32Result = json_ast_number_f32_value(source_any, exp_node, store)
    huge_f64: JsonFloat64Result = json_ast_number_f64_value(source_any, huge_node, store)
    huge_f32: JsonFloat32Result = json_ast_number_f32_value(source_any, huge_node, store)

    assert(frac_f64.ok)
    assert(frac_f64.value == 1.5)
    assert(frac_f32.ok)
    assert(frac_f32.value == 1.5)

    assert(exp_f64.ok)
    assert(exp_f64.value == 1000.0)
    assert(exp_f32.ok)
    assert(exp_f32.value == 1000.0)

    assert(json_ast_number_kind(source_any, huge_node, store) == JsonNumberKind.OUT_OF_RANGE)
    assert(huge_f64.ok)
    assert(huge_f64.value == 18446744073709551616.0)
    assert(huge_f32.ok)
    assert(huge_f32.value > 1.0e19)

    destroy scratch


@test
def ast_iterator_helpers_walk_object_fields_and_array_items() -> void:
    source: static u8& = "{\"first\":1,\"second\":2,\"third\":3,\"items\":[4,5,6]}"
    source_any: any u8& = source.cast[any u8&]()
    source_len: usize = runtime_strlen(source_any)

    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, store)

    assert(result.checksum > 0)

    field1: JsonNode = json_ast_object_iter_first(result.node, store)
    assert(not json_node_is_invalid(field1, store))
    assert(json_ast_string_eq_literal(source_any, json_ast_object_iter_key(field1, store), "first".cast[any u8&](), store))
    value1: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_object_iter_value(field1, store), store)
    assert(value1.ok)
    assert(value1.value == 1)

    field2: JsonNode = json_ast_object_iter_next(field1, store)
    assert(not json_node_is_invalid(field2, store))
    assert(json_ast_string_eq_literal(source_any, json_ast_object_iter_key(field2, store), "second".cast[any u8&](), store))
    value2: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_object_iter_value(field2, store), store)
    assert(value2.ok)
    assert(value2.value == 2)

    field3: JsonNode = json_ast_object_iter_next(field2, store)
    assert(not json_node_is_invalid(field3, store))
    assert(json_ast_string_eq_literal(source_any, json_ast_object_iter_key(field3, store), "third".cast[any u8&](), store))
    value3: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_object_iter_value(field3, store), store)
    assert(value3.ok)
    assert(value3.value == 3)

    field4: JsonNode = json_ast_object_iter_next(field3, store)
    assert(not json_node_is_invalid(field4, store))
    assert(json_ast_string_eq_literal(source_any, json_ast_object_iter_key(field4, store), "items".cast[any u8&](), store))
    assert(json_ast_kind(json_ast_object_iter_value(field4, store), store) == JsonNodeKind.ARRAY)
    assert(json_node_is_invalid(json_ast_object_iter_next(field4, store), store))

    items: JsonNode = json_ast_object_iter_value(field4, store)
    item1: JsonNode = json_ast_array_iter_first(items, store)
    assert(not json_node_is_invalid(item1, store))
    item_value1: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_array_iter_value(item1, store), store)
    assert(item_value1.ok)
    assert(item_value1.value == 4)

    item2: JsonNode = json_ast_array_iter_next(item1, store)
    assert(not json_node_is_invalid(item2, store))
    item_value2: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_array_iter_value(item2, store), store)
    assert(item_value2.ok)
    assert(item_value2.value == 5)

    item3: JsonNode = json_ast_array_iter_next(item2, store)
    assert(not json_node_is_invalid(item3, store))
    item_value3: JsonSignedResult = json_ast_number_i64_value(source_any, json_ast_array_iter_value(item3, store), store)
    assert(item_value3.ok)
    assert(item_value3.value == 6)
    assert(json_node_is_invalid(json_ast_array_iter_next(item3, store), store))

    destroy scratch