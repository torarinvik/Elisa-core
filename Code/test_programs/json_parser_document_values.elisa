def json_parser_document_root_value_impl(doc: JsonParserDocument&, out: mutable JsonParserValue&) -> i64:
    can Memory.Allocate, Abort.Panic:
        out[0] <- json_parser_value_null()
        if doc[0].impl_bits == 0.uintptr():
            return 0

        impl: heap JsonParserDocumentInternal& = doc[0].impl_bits.cast[heap JsonParserDocumentInternal&]
        out[0] <- json_parser_value_from_node_ref(impl, (&impl.root).cast[JsonNode&])
        return 1 if out[0].impl_bits != 0.uintptr() else 0
def json_parser_value_is_valid_impl(value: JsonParserValue&) -> i64:
    return 1 if json_parser_value_is_live(value) else 0
def json_parser_value_kind_impl(value: JsonParserValue&) -> i64:
    if not json_parser_value_is_live(value):
        return -1
    impl: heap JsonParserDocumentInternal& = json_parser_value_doc_impl(value)
    store: JsonNode.Store[Local] = json_parser_document_store(impl)
    return json_ast_kind_code(json_ast_kind(json_parser_value_node(value), store))
