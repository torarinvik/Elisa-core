def json_parser_value_i64_impl(value: JsonParserValue&, out: mutable i64&) -> i64:
    if not json_parser_value_is_live(value):
        return 0
    impl: heap JsonParserDocumentInternal& = json_parser_value_doc_impl(value)
    store: JsonNode.Store[Local] = json_parser_document_store(impl)
    number_value: JsonNumberValue = json_ast_number_value_with_len(json_parser_document_source(impl), json_parser_document_source_len(impl), json_parser_value_node(value), store)
    if not json_number_value_can_materialize_i64(number_value):
        return 0
    out[0] <- number_value.signed_value if number_value.kind == JsonNumberKind.SIGNED else number_value.unsigned_value.i64()
    return 1
