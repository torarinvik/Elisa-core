def json_parser_value_number_data_impl(value: JsonParserValue&, out: mutable JsonParserNumberData&) -> i64:
    out[0] <- JsonParserNumberData{kind: -1, unsigned_value: 0, signed_value: 0, float_value: 0.0}
    if not json_parser_value_is_live(value):
        return 0

    impl: heap JsonParserDocumentInternal& = json_parser_value_doc_impl(value)
    store: JsonNode.Store[Local] = json_parser_document_store(impl)
    node: JsonNode = json_parser_value_node(value)
    number_value: JsonNumberValue = json_ast_number_value_with_len(json_parser_document_source(impl), json_parser_document_source_len(impl), node, store)
    kind_code: i64 = json_ast_number_kind_code(number_value.kind)
    if kind_code < 0:
        return 0

    out[0].kind <- kind_code
    out[0].unsigned_value <- number_value.unsigned_value
    out[0].signed_value <- number_value.signed_value
    if number_value.kind in {JsonNumberKind.NON_INTEGRAL, JsonNumberKind.OUT_OF_RANGE}:
        out[0].float_value <- try json_ast_number_f64_value_with_len(json_parser_document_source(impl), json_parser_document_source_len(impl), node, store) else 0.0
    return 1
