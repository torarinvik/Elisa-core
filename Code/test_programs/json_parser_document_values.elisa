def json_parser_value_index_impl(value: JsonParserValue&, index: usize, out: mutable JsonParserValue&) -> i64:
    can Memory.Allocate, Abort.Panic:
        out[0] <- json_parser_value_null()
        if not json_parser_value_is_live(value):
            return 0
        impl: heap JsonParserDocumentInternal& = json_parser_value_doc_impl(value)
        store: JsonNode.Store[Local] = JsonNode.Store(impl.arena)
        child_node_ref: JsonNode&? = json_parser_value_index_node_ref(value, index, store)
        out[0] <- json_parser_value_from_node_ref(impl, child_node_ref)
        return 1 if out[0].impl_bits != 0.uintptr() else 0
def json_parser_value_index_node(value: JsonParserValue&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_parser_value_index_node_ref(value, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
