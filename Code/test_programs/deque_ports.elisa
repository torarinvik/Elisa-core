include "../../compiler/runtime/elisacore_std/test.elisa"
include "../../compiler/runtime/elisacore_std/heap.elisa"

def deque_i64_make_with_capacity(a: mutable Arena&, capacity: usize) -> Deque[i64]:
    ctor: fn(mutable Arena&, usize) -> Deque[i64] can[Memory.Allocate, Abort.Panic] = arena_deque_with_capacity[i64]
    return ctor(a, capacity) can Memory.Allocate, Abort.Panic

def deque_i64_make_buffer(buffer: i64&, capacity: usize) -> Deque[i64]:
    ctor: fn(i64&, usize) -> Deque[i64] = arena_deque_init_buffer[i64]
    return ctor(buffer, capacity)

def assert_deque_i64_value(d: Deque[i64]&, index: usize, expected: i64):
    can Abort.Panic:
        slot: i64& = arena_deque_at(d, index)
        assert_eq(slot[0], expected)

def deque_basic_smoke() -> void:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        defer block:
            arena_free(&arena)

        d: mutable Deque[i64] = deque_i64_make_with_capacity(&arena, 2)

        _ = arena_deque_push_back(&arena, &d, 1)
        _ = arena_deque_push_back(&arena, &d, 2)
        _ = arena_deque_push_front(&arena, &d, 0)

        assert_eq(arena_deque_len(&d), 3)
        assert not arena_deque_is_empty(&d)

        front_opt: i64&? = arena_deque_front(&d)
        back_opt: i64&? = arena_deque_back(&d)
        assert front_opt != null
        assert back_opt != null

        front_ref: i64& = front_opt
        back_ref: i64& = back_opt
        assert_eq(front_ref[0], 0)
        assert_eq(back_ref[0], 2)

        middle: mutable i64& = arena_deque_at(&d, 1)
        middle[0] <- 7
        assert_deque_i64_value(&d, 1, 7)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(&d, &popped)
        assert_eq(popped, 0)
        assert arena_deque_pop_back(&d, &popped)
        assert_eq(popped, 2)
        assert_eq(arena_deque_len(&d), 1)

        arena_deque_clear(&d)
        assert arena_deque_is_empty(&d)

        _ = arena_deque_push_back(&arena, &d, 9)
        assert_deque_i64_value(&d, 0, 9)

def deque_wraparound_smoke() -> void:
    can Abort.Panic:
        buffer: i64[4] = zeroed
        d: mutable Deque[i64] = deque_i64_make_buffer(&buffer[0], 4)

        assert arena_deque_push_back_bounded(&d, 1)
        assert arena_deque_push_back_bounded(&d, 2)
        assert arena_deque_push_back_bounded(&d, 3)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(&d, &popped)
        assert_eq(popped, 1)
        assert arena_deque_pop_front(&d, &popped)
        assert_eq(popped, 2)

        assert arena_deque_push_back_bounded(&d, 4)
        assert arena_deque_push_back_bounded(&d, 5)
        assert arena_deque_push_front_bounded(&d, 2)
        assert not arena_deque_push_back_bounded(&d, 6)

        assert_eq(arena_deque_len(&d), 4)
        assert_deque_i64_value(&d, 0, 2)
        assert_deque_i64_value(&d, 1, 3)
        assert_deque_i64_value(&d, 2, 4)
        assert_deque_i64_value(&d, 3, 5)

        front_opt: i64&? = arena_deque_front(&d)
        back_opt: i64&? = arena_deque_back(&d)
        assert front_opt != null
        assert back_opt != null
        assert_eq(front_opt[0], 2)
        assert_eq(back_opt[0], 5)

def deque_resize_smoke() -> void:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        defer block:
            arena_free(&arena)

        buffer: i64[4] = zeroed
        d: mutable Deque[i64] = deque_i64_make_buffer(&buffer[0], 4)

        assert arena_deque_push_back_bounded(&d, 10)
        assert arena_deque_push_back_bounded(&d, 11)
        assert arena_deque_push_back_bounded(&d, 12)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(&d, &popped)
        assert_eq(popped, 10)

        assert arena_deque_push_back_bounded(&d, 13)
        assert arena_deque_push_back_bounded(&d, 14)

        _ = arena_deque_push_back(&arena, &d, 15)

        assert_eq(arena_deque_capacity(&d), 8)
        assert_eq(d.head, 0)
        assert_eq(arena_deque_len(&d), 5)
        assert_deque_i64_value(&d, 0, 11)
        assert_deque_i64_value(&d, 1, 12)
        assert_deque_i64_value(&d, 2, 13)
        assert_deque_i64_value(&d, 3, 14)
        assert_deque_i64_value(&d, 4, 15)

def deque_ports_main_impl() -> int:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        deque_basic_smoke()
        deque_wraparound_smoke()
        deque_resize_smoke()
        return 0

export fn main() -> int = deque_ports_main_impl