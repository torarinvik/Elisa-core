include "../../compiler/runtime/elisacore_std/test.elisa"
include "../../compiler/runtime/elisacore_std/heap.elisa"

def deque_i64_make_with_capacity(a: mutable Arena&, capacity: usize) -> Deque[i64]:
    ctor: func(mutable Arena&, usize) -> Deque[i64] effects[Memory.Allocate, Abort.Panic] = arena_deque_with_capacity.specialize[i64]()
    return ctor(a, capacity) can Memory.Allocate, Abort.Panic

def deque_i64_make_buffer(buffer: i64&, capacity: usize) -> Deque[i64]:
    ctor: func(i64&, usize) -> Deque[i64] = arena_deque_init_buffer.specialize[i64]()
    return ctor(buffer, capacity)

def assert_deque_i64_value(d: Deque[i64]&, index: usize, expected: i64):
    can Abort.Panic:
        slot: i64& = arena_deque_at(d, index)
        assert_eq(slot[0], expected)

def deque_basic_smoke() -> void:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        defer block:
            arena_free(arena.ref[Arena&])

        d: mutable Deque[i64] = deque_i64_make_with_capacity(arena.ref[Arena&], 2)

        _ = arena_deque_push_back(arena.ref[Arena&], d.ref[Deque[i64]&], 1)
        _ = arena_deque_push_back(arena.ref[Arena&], d.ref[Deque[i64]&], 2)
        _ = arena_deque_push_front(arena.ref[Arena&], d.ref[Deque[i64]&], 0)

        assert_eq(arena_deque_len(d.ref[Deque[i64]&]), 3)
        assert not arena_deque_is_empty(d.ref[Deque[i64]&])

        front_opt: i64&? = arena_deque_front(d.ref[Deque[i64]&])
        back_opt: i64&? = arena_deque_back(d.ref[Deque[i64]&])
        assert front_opt != null
        assert back_opt != null

        front_ref: i64& = front_opt.cast[i64&]
        back_ref: i64& = back_opt.cast[i64&]
        assert_eq(front_ref[0], 0)
        assert_eq(back_ref[0], 2)

        middle: mutable i64& = arena_deque_at(d.ref[Deque[i64]&], 1)
        middle[0] <- 7
        assert_deque_i64_value(d.ref[Deque[i64]&], 1, 7)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(d.ref[Deque[i64]&], popped.ref[i64&])
        assert_eq(popped, 0)
        assert arena_deque_pop_back(d.ref[Deque[i64]&], popped.ref[i64&])
        assert_eq(popped, 2)
        assert_eq(arena_deque_len(d.ref[Deque[i64]&]), 1)

        arena_deque_clear(d.ref[Deque[i64]&])
        assert arena_deque_is_empty(d.ref[Deque[i64]&])

        _ = arena_deque_push_back(arena.ref[Arena&], d.ref[Deque[i64]&], 9)
        assert_deque_i64_value(d.ref[Deque[i64]&], 0, 9)

def deque_wraparound_smoke() -> void:
    can Abort.Panic:
        buffer: i64[4] = zeroed
        d: mutable Deque[i64] = deque_i64_make_buffer(buffer[0].ref[i64&], 4)

        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 1)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 2)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 3)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(d.ref[Deque[i64]&], popped.ref[i64&])
        assert_eq(popped, 1)
        assert arena_deque_pop_front(d.ref[Deque[i64]&], popped.ref[i64&])
        assert_eq(popped, 2)

        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 4)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 5)
        assert arena_deque_push_front_bounded(d.ref[Deque[i64]&], 2)
        assert not arena_deque_push_back_bounded(d.ref[Deque[i64]&], 6)

        assert_eq(arena_deque_len(d.ref[Deque[i64]&]), 4)
        assert_deque_i64_value(d.ref[Deque[i64]&], 0, 2)
        assert_deque_i64_value(d.ref[Deque[i64]&], 1, 3)
        assert_deque_i64_value(d.ref[Deque[i64]&], 2, 4)
        assert_deque_i64_value(d.ref[Deque[i64]&], 3, 5)

        front_opt: i64&? = arena_deque_front(d.ref[Deque[i64]&])
        back_opt: i64&? = arena_deque_back(d.ref[Deque[i64]&])
        assert front_opt != null
        assert back_opt != null
        assert_eq(front_opt.cast[i64&][0], 2)
        assert_eq(back_opt.cast[i64&][0], 5)

def deque_resize_smoke() -> void:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        arena: mutable Arena = zeroed
        defer block:
            arena_free(arena.ref[Arena&])

        buffer: i64[4] = zeroed
        d: mutable Deque[i64] = deque_i64_make_buffer(buffer[0].ref[i64&], 4)

        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 10)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 11)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 12)

        popped: mutable i64 = 0
        assert arena_deque_pop_front(d.ref[Deque[i64]&], popped.ref[i64&])
        assert_eq(popped, 10)

        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 13)
        assert arena_deque_push_back_bounded(d.ref[Deque[i64]&], 14)

        _ = arena_deque_push_back(arena.ref[Arena&], d.ref[Deque[i64]&], 15)

        assert_eq(arena_deque_capacity(d.ref[Deque[i64]&]), 8)
        assert_eq(d.head, 0)
        assert_eq(arena_deque_len(d.ref[Deque[i64]&]), 5)
        assert_deque_i64_value(d.ref[Deque[i64]&], 0, 11)
        assert_deque_i64_value(d.ref[Deque[i64]&], 1, 12)
        assert_deque_i64_value(d.ref[Deque[i64]&], 2, 13)
        assert_deque_i64_value(d.ref[Deque[i64]&], 3, 14)
        assert_deque_i64_value(d.ref[Deque[i64]&], 4, 15)

def deque_ports_main_impl() -> int:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        deque_basic_smoke()
        deque_wraparound_smoke()
        deque_resize_smoke()
        return 0

export func main() -> int = deque_ports_main_impl