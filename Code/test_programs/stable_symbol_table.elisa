include "../../compiler/runtime/elisacore_std/elisacore_runtime.elisa"

struct FixtureSymbol:
    value: mutable i32


def stable_symbol_table_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        map: mutable IndexMap[cstr[key_shape], FixtureSymbol] = indexmap.with_capacity(a, 4)

        alpha_id: SymbolTableId = symbol_table_id_from_index(map.set("alpha", FixtureSymbol{value: 7}))
        beta_id: SymbolTableId = symbol_table_id_from_index(map.set("beta", FixtureSymbol{value: 3}))
        _ = map.update_at(symbol_table_index(alpha_id), FixtureSymbol{value: 11})

        -1 return if alpha_id == SYMBOL_TABLE_INVALID_ID
        -2 return if beta_id == SYMBOL_TABLE_INVALID_ID
        -3 return if alpha_id == beta_id

        found_alpha_index: usize = get index_map_find_index[cstr[key_shape], FixtureSymbol](map, "alpha") else return -4
        found_alpha_id: SymbolTableId = symbol_table_id_from_index(found_alpha_index)
        -4 return if found_alpha_id != alpha_id
        -5 return if not map.has("beta")
        -6 return if map.count() != 2

        total: mutable i32 = 0
        for entry in map.entry_view():
            total <- total + entry.value.value

        alpha: FixtureSymbol = get map.get("alpha") else return -7
        beta: FixtureSymbol = map.value(symbol_table_index(beta_id))
        return alpha.value + beta.value + total


def stable_symbol_table_default_capacity(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        map: mutable IndexMap[cstr[key_shape], FixtureSymbol] = indexmap.new(a)
        symbol_id: SymbolTableId = symbol_table_id_from_index(map.set("gamma", FixtureSymbol{value: 19}))
        symbol: FixtureSymbol? = map.get("gamma")
        -1 return if symbol_id == SYMBOL_TABLE_INVALID_ID
        found: FixtureSymbol = get symbol else return -2
        return found.value


def stable_index_map_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        map: mutable IndexMap[cstr[key_shape], FixtureSymbol] = indexmap.new(a)

        alpha_index: usize = map.set("alpha", FixtureSymbol{value: 5})
        beta_index: usize = map.set("beta", FixtureSymbol{value: 8})
        alpha_index_again: usize = map.set("alpha", FixtureSymbol{value: 13})

        -1 return if alpha_index != alpha_index_again
        -2 return if alpha_index == beta_index
        -3 return if not map.has("beta")
        -4 return if map.count() != 2

        total: mutable i32 = 0
        for entry in map.entry_view():
            total <- total + entry.value.value

        alpha: FixtureSymbol = get map.get("alpha") else return -5
        beta_entry: IndexMapEntry[cstr[key_shape], FixtureSymbol] = map.entry(beta_index)
        return alpha.value + beta_entry.value.value + total
