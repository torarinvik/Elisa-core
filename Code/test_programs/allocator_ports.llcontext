# include "../llcontext_std/test.llcontext"
# include "../llcontext_std/heap.llcontext"

struct PoolPair:
    left: mutable i64
    right: mutable i64

def fixed_buffer_allocator_smoke() -> void can[Abort.Panic]:
    can Abort.Panic:
        buffer: u8[64] = zeroed
        alloc: mutable FixedBufferAllocator = fixed_buffer_allocator_init(buffer[0].ref[u8&], 64)

        first: void& = fixed_buffer_alloc_or_panic(alloc.ref[FixedBufferAllocator&], 8)
        second: void& = fixed_buffer_alloc_or_panic(alloc.ref[FixedBufferAllocator&], 8)
        fixed_buffer_release(alloc.ref[FixedBufferAllocator&], second, 8)
        third: void& = fixed_buffer_alloc_or_panic(alloc.ref[FixedBufferAllocator&], 8)
        assert_eq(third.cast[u8&].uintptr(), second.cast[u8&].uintptr())

        mark: FixedBufferMark = fixed_buffer_snapshot(alloc.ref[FixedBufferAllocator&])
        aligned_ptr: void& = fixed_buffer_alloc_align_or_panic(alloc.ref[FixedBufferAllocator&], 4, 16)
        assert_eq(aligned_ptr.cast[u8&].uintptr() % 16.uintptr(), 0.uintptr())
        fixed_buffer_rewind(alloc.ref[FixedBufferAllocator&], mark)
        rewinded: void& = fixed_buffer_alloc_align_or_panic(alloc.ref[FixedBufferAllocator&], 4, 16)
        assert_eq(rewinded.cast[u8&].uintptr(), aligned_ptr.cast[u8&].uintptr())

        assert fixed_buffer_resize(alloc.ref[FixedBufferAllocator&], rewinded, 4, 12)
        fixed_buffer_reset(alloc.ref[FixedBufferAllocator&])
        reset_ptr: void& = fixed_buffer_alloc_or_panic(alloc.ref[FixedBufferAllocator&], 8)
        assert_eq(reset_ptr.cast[u8&].uintptr(), first.cast[u8&].uintptr())

def memory_pool_smoke() -> void can[Memory.Allocate, Memory.Release, Abort.Panic]:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        pool: mutable MemoryPool[PoolPair] = zeroed
        defer block:
            memory_pool_deinit(pool.ref[MemoryPool[PoolPair]&]) can Memory.Release, Abort.Panic

        memory_pool_add_capacity(pool.ref[MemoryPool[PoolPair]&], 2)

        first: heap PoolPair& = memory_pool_create(pool.ref[MemoryPool[PoolPair]&])
        second: heap PoolPair& = memory_pool_create(pool.ref[MemoryPool[PoolPair]&])
        first.left <- 11
        first.right <- 12
        second.left <- 13
        second.right <- 14

        memory_pool_destroy(pool.ref[MemoryPool[PoolPair]&], first)
        reused: heap PoolPair& = memory_pool_create(pool.ref[MemoryPool[PoolPair]&])
        assert_eq(reused.cast[u8&].uintptr(), first.cast[u8&].uintptr())
        assert_eq(reused.left, 0)
        assert_eq(reused.right, 0)

        memory_pool_reset(pool.ref[MemoryPool[PoolPair]&])
        after_reset: heap PoolPair& = memory_pool_create(pool.ref[MemoryPool[PoolPair]&])
        assert_eq(after_reset.cast[u8&].uintptr(), second.cast[u8&].uintptr())

def allocator_ports_main_impl() -> int can[Memory.Allocate, Memory.Release, Abort.Panic]:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        fixed_buffer_allocator_smoke()
        memory_pool_smoke()
        return 0

export func main() -> int = allocator_ports_main_impl
