def json_empty_view() -> sview:
    return sview("", 0, 0)
def json_ast_is_number_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Num:
        return true
    return false
def json_ast_is_text_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Text:
        return true
    return false
def json_ast_is_array_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Array:
        return true
    return false
def json_ast_is_object_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Object:
        return true
    return false
def json_ast_kind(node: JsonNode, store: JsonNode.Store[Local]) -> JsonNodeKind:
    if json_node_is_invalid(node, store):
        return JsonNodeKind.INVALID
    if json_ast_is_null(node, store):
        return JsonNodeKind.NULL
    if json_ast_bool_value(node, store) >= 0:
        return JsonNodeKind.BOOL
    if json_ast_is_number_node(node, store):
        return JsonNodeKind.NUMBER
    if json_ast_is_text_node(node, store):
        return JsonNodeKind.STRING
    if json_ast_is_array_node(node, store):
        return JsonNodeKind.ARRAY
    if json_ast_is_object_node(node, store):
        return JsonNodeKind.OBJECT
    return JsonNodeKind.INVALID
def json_ast_kind_code(kind: JsonNodeKind) -> i64:
    if kind == JsonNodeKind.NULL:
        return 0
    if kind == JsonNodeKind.BOOL:
        return 1
    if kind == JsonNodeKind.NUMBER:
        return 2
    if kind == JsonNodeKind.STRING:
        return 3
    if kind == JsonNodeKind.ARRAY:
        return 4
    if kind == JsonNodeKind.OBJECT:
        return 5
    return -1
def json_ast_number_kind_code(kind: JsonNumberKind) -> i64:
    if kind == JsonNumberKind.UNSIGNED:
        return 0
    if kind == JsonNumberKind.SIGNED:
        return 1
    if kind == JsonNumberKind.NON_INTEGRAL:
        return 2
    if kind == JsonNumberKind.OUT_OF_RANGE:
        return 3
    return -1
def json_ast_source_view_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    text_lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if text_lexeme.checksum >= 0:
        start: i64 = text_lexeme.source_offset.i64()
        return sview(source, start, start + text_lexeme.source_len.i64())
    number_lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if number_lexeme.checksum >= 0:
        start: i64 = number_lexeme.source_offset.i64()
        return sview(source, start, start + number_lexeme.source_len.i64())
    return json_empty_view()
def json_ast_source_view(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    return json_ast_source_view_with_len(source, runtime_strlen(source), node, store)
def json_ast_number_view_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        start: i64 = lexeme.source_offset.i64()
        return sview(source, start, start + lexeme.source_len.i64())
    return json_empty_view()
def json_ast_number_view(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    return json_ast_number_view_with_len(source, runtime_strlen(source), node, store)
def json_ast_number_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberValue:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return json_parse_number_value(source, lexeme.source_offset, lexeme.source_len)
    return json_invalid_number_value()
def json_ast_number_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberValue:
    return json_ast_number_value_with_len(source, runtime_strlen(source), node, store)
def json_ast_number_kind_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberKind:
    return json_ast_number_value_with_len(source, source_len, node, store).kind
def json_ast_number_kind(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberKind:
    return json_ast_number_value(source, node, store).kind
def json_ast_number_is_integral(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    kind: JsonNumberKind = json_ast_number_kind(source, node, store)
    return kind in {JsonNumberKind.UNSIGNED, JsonNumberKind.SIGNED}
def json_ast_number_u64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> u64 error[JsonNumberAccessError]:
    value: JsonNumberValue = json_ast_number_value(source, node, store)
    if value.kind == JsonNumberKind.UNSIGNED:
        return value.unsigned_value
    raise JsonNumberAccessError.Invalid
def json_ast_number_i64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> i64 error[JsonNumberAccessError]:
    value: JsonNumberValue = json_ast_number_value(source, node, store)
    i64_max_u64: u64 = 9223372036854775807
    if value.kind == JsonNumberKind.SIGNED:
        return value.signed_value
    if value.kind == JsonNumberKind.UNSIGNED and value.unsigned_value <= i64_max_u64:
        return value.unsigned_value.i64()
    raise JsonNumberAccessError.Invalid
def json_ast_number_f64_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> f64 error[JsonNumberAccessError]:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return try json_parse_number_f64_value(source, lexeme.source_offset, lexeme.source_len)
    raise JsonNumberAccessError.Invalid
def json_ast_number_f64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> f64 error[JsonNumberAccessError]:
    return try json_ast_number_f64_value_with_len(source, runtime_strlen(source), node, store)
def json_ast_number_f32_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> f32 error[JsonNumberAccessError]:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return try json_parse_number_f32_value(source, lexeme.source_offset, lexeme.source_len)
    raise JsonNumberAccessError.Invalid
def json_ast_number_f32_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> f32 error[JsonNumberAccessError]:
    return try json_ast_number_f32_value_with_len(source, runtime_strlen(source), node, store)
def json_node_can_materialize_float(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Num:
        return true
    return false
def json_ast_bool_value(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store is JsonNode.Bool(value: value):
        return 1 if value else 0
    return -1
def json_ast_is_null(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store is JsonNode.Null:
        return true
    return false
def json_ast_array_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store is JsonNode.Array(items_ptr: _, item_count: item_count):
        return item_count.i64()
    return -1
def json_ast_object_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store is JsonNode.Object(fields_ptr: _, field_count: field_count):
        return field_count.i64()
    return -1
def json_ast_array_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    items: view[JsonNode] = json_ast_array_items_view(node, store)
    if index < items.len:
        return json_node_view_ref(items, index)
    return null
def json_ast_array_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_array_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_array_iter_first(node: JsonNode, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    items: view[JsonNode] = json_ast_array_items_view(node, store)
    if items.len > 0:
        return JsonAstArrayIterCursor{items: items, index: 0}
    return json_invalid_array_iter_cursor()
def json_ast_array_iter_value_ref(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_array_iter_is_valid(cursor):
        return null
    return json_node_view_ref(cursor.items, cursor.index)
def json_ast_array_iter_value(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_array_iter_value_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_array_iter_next(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    if json_ast_array_iter_is_valid(cursor) and cursor.index + 1 < cursor.items.len:
        return JsonAstArrayIterCursor{items: cursor.items, index: cursor.index + 1}
    return json_invalid_array_iter_cursor()
def json_ast_object_get_ref(node: JsonNode, source: u8&, key: u8&, store: JsonNode.Store[Local]) -> JsonNode&?:
    readonly_fields: view[JsonField] = json_ast_object_fields_view(node, store)
    for index in 0..<readonly_fields.len:
        field_ref: JsonField& = json_field_view_ref(readonly_fields, index)
        key_node: JsonNode = json_node_copy_ref(json_field_key_ref(field_ref))
        if json_ast_string_eq_literal(source, key_node, key, store):
            return json_field_value_ref(field_ref)
    return null
def json_ast_object_get(node: JsonNode, source: u8&, key: u8&, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_get_ref(node, source, key, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_object_iter_first(node: JsonNode, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    fields: view[JsonField] = json_ast_object_fields_view(node, store)
    if fields.len > 0:
        return JsonAstObjectIterCursor{fields: fields, index: 0}
    return json_invalid_object_iter_cursor()
def json_ast_object_iter_key_ref(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_object_iter_is_valid(cursor):
        return null
    field_ref: JsonField& = json_field_view_ref(cursor.fields, cursor.index)
    return json_field_key_ref(field_ref)
def json_ast_object_iter_key(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_iter_key_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_object_iter_value_ref(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_object_iter_is_valid(cursor):
        return null
    field_ref: JsonField& = json_field_view_ref(cursor.fields, cursor.index)
    return json_field_value_ref(field_ref)
def json_ast_object_iter_value(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_iter_value_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_object_iter_next(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    if json_ast_object_iter_is_valid(cursor) and cursor.index + 1 < cursor.fields.len:
        return JsonAstObjectIterCursor{fields: cursor.fields, index: cursor.index + 1}
    return json_invalid_object_iter_cursor()
def json_ast_array_iter_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    items: view[JsonNode] = json_ast_array_items_view(node, store)
    if index < items.len:
        return JsonAstArrayIterCursor{items: items, index: index}
    return json_invalid_array_iter_cursor()
def json_ast_object_iter_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    fields: view[JsonField] = json_ast_object_fields_view(node, store)
    if index < fields.len:
        return JsonAstObjectIterCursor{fields: fields, index: index}
    return json_invalid_object_iter_cursor()
def json_ast_object_key_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    return json_ast_object_iter_key_ref(json_ast_object_iter_nth(node, index, store), store)
def json_ast_object_key_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_key_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
def json_ast_object_value_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    return json_ast_object_iter_value_ref(json_ast_object_iter_nth(node, index, store), store)
def json_ast_object_value_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_value_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref)
    return json_node_invalid(store)
