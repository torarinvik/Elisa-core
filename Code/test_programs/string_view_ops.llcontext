def head_codepoint(text: dstr[row]) -> char:
    view: sview[1, 3] = text[1:3]
    return view[0]


def head_codepoint_i64(text: dstr[row]) -> i64:
    return head_codepoint(text).i64()


def text_len(text: dstr[row]) -> i64:
    return text.len


def same_view_text(view: sview[view_begin, view_end], text: dstr[row]) -> bool:
    return view == text


def different_views(left: sview[left_begin, left_end], right: sview[right_begin, right_end]) -> bool:
    return left != right
