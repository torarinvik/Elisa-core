struct FuzzPair:
    left: mutable int
    right: mutable int

struct HeapPairNode:
    pair: mutable FuzzPair
    next: mutable heap HeapPairNode&?

error DiskError:
    Missing

error NetError:
    Timeout

error LogicError:
    Impossible

error MemoryError:
    OutOfMemory

error FormatError:
    WriteFailed

extern alloc_heap_pair_node() -> mutable heap HeapPairNode&? can[Memory.Allocate]
extern sfree_heap_pair_node(node: heap HeapPairNode&) -> heap HeapPairNode! can[Memory.Release]
extern alloc_bytes(size: usize) -> mutable heap u8&? can[Memory.Allocate]
extern sfree_bytes(ptr: heap u8&) -> heap u8! can[Memory.Release]
extern snprintf(buffer: mutable any u8&?, buffer_size: usize, format: static u8&, ...) -> int can[Console.Format]


def require_heap_pair_node() -> mutable heap HeapPairNode& error[MemoryError] can[Memory.Allocate]:
    raw: heap HeapPairNode&? = alloc_heap_pair_node() can Memory.Allocate
    node: heap HeapPairNode& = raw else raise MemoryError.OutOfMemory
    return node


def release_heap_pair_node(node: mutable heap HeapPairNode&?) can[Memory.Release]:
    if node != null:
        can Memory.Release:
            node as ! <- sfree_heap_pair_node(node)


def checked_heap_pair(slot: heap FuzzPair&) -> int error[DiskError, NetError]:
    if slot.left == 0:
        raise DiskError.Missing
    if slot.right == 0:
        raise NetError.Timeout
    return slot.left + slot.right


def recursive_pair_node_sum(node: heap HeapPairNode&) -> int error[LogicError, DiskError, NetError]:
    value: int = try checked_heap_pair(&node.pair)
    if node.next == null:
        return value
    next: heap HeapPairNode& = node.next
    return value + (try recursive_pair_node_sum(next))


def recursive_free_pair_chain(node: mutable heap HeapPairNode&?) -> void can[Memory.Release]:
    if node == null:
        return
    live: heap HeapPairNode& = node
    next_node: mutable heap HeapPairNode&? = live.next
    can Memory.Release:
        node as ! <- sfree_heap_pair_node(node)
        recursive_free_pair_chain(next_node)


def build_pair_chain_sum() -> int error[MemoryError, LogicError, DiskError, NetError] can[Memory.Allocate, Memory.Release]:
    can Memory.Allocate:
        first: mutable heap HeapPairNode&? = null
        defer block:
            recursive_free_pair_chain(first)

        first_live: mutable heap HeapPairNode& = try require_heap_pair_node()
        first <- first_live
        second_live: mutable heap HeapPairNode& = try require_heap_pair_node()
        first_live.pair <- FuzzPair(301, 302)
        second_live.pair <- FuzzPair(303, 304)
        first_live.next <- second_live
        total: int = try recursive_pair_node_sum(first_live)
        return total


def borrow_then_release_single_pair() -> int error[MemoryError, DiskError, NetError] can[Memory.Allocate, Memory.Release]:
    can Memory.Allocate:
        handle: mutable heap HeapPairNode&? = null
        defer block:
            release_heap_pair_node(handle)

        live: mutable heap HeapPairNode& = try require_heap_pair_node()
        handle <- live
        live.pair <- FuzzPair(11, 12)
        total: int = try checked_heap_pair(&live.pair)
        return total


def checked_write_into_heap(buffer: mutable heap u8&, size: usize, format: static u8&) -> int error[FormatError] can[Console.Format]:
    written: int = snprintf(buffer.cast[any u8&?], size, format, 11) can Console.Format
    if written < 0:
        raise FormatError.WriteFailed
    return written


def checked_write_into_stack(buffer: mutable stack u8&, size: usize, format: static u8&) -> int error[FormatError] can[Console.Format]:
    written: int = snprintf(buffer.cast[any u8&?], size, format, 11) can Console.Format
    if written < 0:
        raise FormatError.WriteFailed
    return written


def alloc_and_format_heap_buffer() -> int error[MemoryError, FormatError] can[Memory.Allocate, Memory.Release, Console.Format]:
    can Memory.Allocate, Console.Format:
        buffer: mutable heap u8&? = null
        defer block:
            if buffer != null:
                can Memory.Release:
                    buffer as ! <- sfree_bytes(buffer)

        raw: heap u8&? = alloc_bytes(32)
        buffer_live: heap u8& = raw else raise MemoryError.OutOfMemory
        buffer <- buffer_live
        written: int = try checked_write_into_heap(buffer_live, 32, "num=%d")
        return written


def stack_buffer_format() -> int error[FormatError] can[Console.Format]:
    buffer: u8[32] = zeroed
    return try checked_write_into_stack(&buffer[0], 32, "stack=%d")


def recursive_format_or_fallback(depth: int) -> int can[Memory.Allocate, Memory.Release, Console.Format]:
    can Memory.Allocate, Console.Format:
        if depth <= 0:
            return try alloc_and_format_heap_buffer() else -1
        return (try alloc_and_format_heap_buffer() else -1) + recursive_format_or_fallback(depth - 1)


def allocator_ownership_combo(depth: int) -> int can[Memory.Allocate, Memory.Release, Console.Format]:
    can Memory.Allocate, Console.Format:
        total: mutable int = try build_pair_chain_sum() else -1000
        total <- total + (try borrow_then_release_single_pair() else -1001)
        total <- total + (try stack_buffer_format() else -1002)
        total <- total + recursive_format_or_fallback(depth)
        return total
