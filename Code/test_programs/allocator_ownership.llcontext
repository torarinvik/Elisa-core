repr(c) struct FuzzPair:
    left: mutable int
    right: mutable int

repr(c) struct HeapPairNode:
    pair: mutable FuzzPair
    next: mutable heap HeapPairNode&?

error DiskError:
    Missing

error NetError:
    Timeout

error LogicError:
    Impossible

error MemoryError:
    OutOfMemory

error FormatError:
    WriteFailed

extern alloc_heap_pair_node() -> heap HeapPairNode&?
extern sfree_heap_pair_node(node: heap HeapPairNode&) -> heap HeapPairNode!
extern alloc_bytes(size: usize) -> heap u8&?
extern sfree_bytes(ptr: heap u8&) -> heap u8!
extern snprintf(buffer: any u8&?, buffer_size: usize, format: static u8&, ...) -> int


def require_heap_pair_node() -> heap HeapPairNode& error[MemoryError]:
    node: heap HeapPairNode& = alloc_heap_pair_node() else raise MemoryError.OutOfMemory
    return node


def release_heap_pair_node(node: mutable heap HeapPairNode&?):
    if node != null:
        node as ! <- sfree_heap_pair_node(node)


def checked_any_pair(slot: any FuzzPair&) -> int error[DiskError, NetError]:
    if slot.left == 0:
        raise DiskError.Missing
    if slot.right == 0:
        raise NetError.Timeout
    return slot.left + slot.right


def recursive_pair_node_sum(node: heap HeapPairNode&) -> int error[LogicError, DiskError, NetError]:
    value: int = try checked_any_pair((&node.pair).cast[any FuzzPair&]())
    if node.next == null:
        return value
    next: heap HeapPairNode& = node.next
    return value + (try recursive_pair_node_sum(next))


def recursive_free_pair_chain(node: mutable heap HeapPairNode&?) -> void error[LogicError]:
    if node == null:
        return
    live: heap HeapPairNode& = node
    next_node: mutable heap HeapPairNode&? = live.next
    node as ! <- sfree_heap_pair_node(node)
    try recursive_free_pair_chain(next_node)


def build_pair_chain_sum() -> int error[MemoryError, LogicError, DiskError, NetError]:
    first_live: heap HeapPairNode& = try require_heap_pair_node()
    second_live: heap HeapPairNode& = try require_heap_pair_node()
    first_live.pair <- FuzzPair(301, 302)
    second_live.pair <- FuzzPair(303, 304)
    first_live.next <- second_live
    total: int = try recursive_pair_node_sum(first_live)
    first: mutable heap HeapPairNode&? = first_live
    try recursive_free_pair_chain(first)
    return total


def borrow_then_release_single_pair() -> int error[MemoryError, DiskError, NetError]:
    live: heap HeapPairNode& = try require_heap_pair_node()
    live.pair <- FuzzPair(11, 12)
    total: int = try checked_any_pair((&live.pair).cast[any FuzzPair&]())
    handle: mutable heap HeapPairNode&? = live
    release_heap_pair_node(handle)
    return total


def checked_write_into(buffer: any u8&, size: usize, format: static u8&) -> int error[FormatError]:
    written: int = snprintf(buffer, size, format, 11)
    if written < 0:
        raise FormatError.WriteFailed
    return written


def alloc_and_format_heap_buffer() -> int error[MemoryError, FormatError]:
    buffer: heap u8& = alloc_bytes(32u) else raise MemoryError.OutOfMemory
    written: int = try checked_write_into(buffer.cast[any u8&](), 32u, "num=%d")
    sfree_bytes(buffer)
    return written


def stack_buffer_format() -> int error[FormatError]:
    buffer: u8[32] = zeroed
    return try checked_write_into((&buffer[0u]).cast[any u8&](), 32u, "stack=%d")


def recursive_format_or_fallback(depth: int) -> int:
    if depth <= 0:
        return try alloc_and_format_heap_buffer() else -1
    return (try alloc_and_format_heap_buffer() else -1) + recursive_format_or_fallback(depth - 1)


def allocator_ownership_combo(depth: int) -> int:
    total: mutable int = try build_pair_chain_sum() else -1000
    total <- total + (try borrow_then_release_single_pair() else -1001)
    total <- total + (try stack_buffer_format() else -1002)
    total <- total + recursive_format_or_fallback(depth)
    return total
