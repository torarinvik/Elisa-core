include "../../compiler/runtime/elisacore_std/elisacore_runtime.elisa"
include "../../compiler/runtime/elisacore_std/names.elisa"


def interned_name_methods_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        names: mutable NameTable = name_table_init(a)
        hello_id: NameId = names.intern("Hello", NameCasePolicy.CaseSensitive)
        copy_id: NameId = names.intern_copy(name_cstr_view("Copied"), NameCasePolicy.CaseSensitive)
        lower_id: NameId = names.intern_ci("mixed")

        -1 return if not names.valid_id(hello_id)
        -2 return if not names.valid_id(copy_id)
        -3 return if not names.has_text_cs(hello_id, "Hello")
        -4 return if names.has_text_cs(hello_id, "hello")
        -5 return if not names.has_text_ci(lower_id, "MIXED")

        copy_name: InternedName = names.interned(copy_id)
        lower_name: InternedName = names.interned(lower_id)
        -6 return if not copy_name.valid()
        -7 return if copy_name.value() != copy_id
        -8 return if not copy_name.matches_cs("Copied")
        -9 return if not lower_name.matches_ci("MIXED")
        -10 return if copy_name.NameId() != copy_id

        text: sview = copy_name.text()
        return text.len.i32()
