struct Node:
    value: mutable int
    next: mutable heap Node&?

error MemoryError:
    OutOfMemory

extern alloc_node() -> mutable heap Node&? can[Memory.Allocate]
extern sfree_node(node: heap Node&) -> heap Node! can[Memory.Release]

def require_node() -> mutable heap Node& error[MemoryError] can[Memory.Allocate]:
    raw: heap Node&? = alloc_node() can Memory.Allocate
    node: heap Node& = raw else raise MemoryError.OutOfMemory
    return node

def make_node_value() -> int error[MemoryError] can[Memory.Allocate]:
    can Memory.Allocate:
        node: mutable heap Node& = try require_node()
        node.value <- 42
        return node.value

def make_node_value_or_zero() -> int can[Memory.Allocate]:
    can Memory.Allocate:
        value: int = try make_node_value() else 0
        return value

def release_node(node: mutable heap Node&?) can[Memory.Release]:
    if node != null:
        node as ! <- (sfree_node(node) can Memory.Release)
