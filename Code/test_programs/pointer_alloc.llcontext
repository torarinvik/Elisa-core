repr(c) struct Node:
    value: mutable int
    next: mutable Node&?

extern alloc_node() -> Node&?
extern sfree_node(node: Node&) -> Node!

def make_node_value() -> int:
    node: mutable Node&? = alloc_node()
    if node == null:
        return 0

    node.value <- 42
    return node.value

def release_node(node: mutable Node&?):
    if node != null:
        node as ! <- sfree_node(node)
