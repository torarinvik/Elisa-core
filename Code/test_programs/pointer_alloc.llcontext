repr(c) struct Node:
    value: mutable int
    next: mutable any Node&?

extern alloc_node() -> any Node&?
extern sfree_node(node: any Node&) -> any Node!

def make_node_value() -> int:
    node: mutable any Node&? = alloc_node()
    if node == null:
        return 0

    node.value <- 42
    return node.value

def release_node(node: mutable any Node&?):
    if node != null:
        node as ! <- sfree_node(node)
