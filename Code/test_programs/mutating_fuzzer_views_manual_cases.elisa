def seed_string_ops(text: cstr[row]) -> i64:
    mid: sview[1, 3] = text[1:3]
    return mid[0].i64() + text.len


def mutate_25_same_view_as_text(text: cstr[row]) -> bool:
    mid: sview[1, 3] = text[1:3]
    return mid == text


def mutate_26_different_string_views(left: cstr[row], right: cstr[col]) -> bool:
    left_mid: sview[0, 2] = left[0:2]
    right_mid: sview[0, 2] = right[0:2]
    return left_mid != right_mid


def mutate_27_ptr_bits_roundtrip(ptr: u8&) -> bool:
    bits: uintptr = ptr.uintptr()
    return bits.cast[u8&] == ptr


def mutate_28_nullable_ptr_is_null(ptr: u8&?) -> bool:
    return ptr == null


def mutate_29_advance_raw_twice(ptr: void&, offset: usize) -> void&:
    mid: u8& = ptr.cast[u8&] + offset
    return mid.cast[void&]


def seed_list_view() -> i32:
    return make_array_view()[0]


def mutate_30_list_view_pair_sum() -> i32:
    return make_array_view()[0] + make_array_view()[0]


def mutate_32_explicit_list_view_temp() -> i32:
    values: dview[i32] = make_array_view()
    return values[0]


def mutate_251_manual_pair_value() -> int error[MemoryError, DiskError, NetError]:
    live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    live.pair <- FuzzPair(251, 252)
    total: int = try mutate_203_checked_any_pair(live.pair.ref[FuzzPair&])
    handle: mutable heap HeapPairNode&? = live
    mutate_202_release_heap_pair_node(handle)
    return total


def mutate_252_manual_two_pair_chain() -> int error[MemoryError, LogicError, DiskError, NetError]:
    first_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    second_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    first_live.pair <- FuzzPair(252, 253)
    second_live.pair <- FuzzPair(254, 255)
    first_live.next <- second_live
    total: int = try mutate_204_recursive_pair_node_sum(first_live)
    first: mutable heap HeapPairNode&? = first_live
    try mutate_205_recursive_free_pair_chain(first)
    return total


def mutate_253_manual_three_pair_chain() -> int error[MemoryError, LogicError, DiskError, NetError]:
    first_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    second_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    third_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    first_live.pair <- FuzzPair(253, 254)
    second_live.pair <- FuzzPair(255, 256)
    third_live.pair <- FuzzPair(257, 258)
    first_live.next <- second_live
    second_live.next <- third_live
    total: int = try mutate_204_recursive_pair_node_sum(first_live)
    first: mutable heap HeapPairNode&? = first_live
    try mutate_205_recursive_free_pair_chain(first)
    return total


def mutate_254_manual_heap_buffer_bits() -> uintptr error[MemoryError, FormatError]:
    ptr: heap u8& = get alloc_bytes(48) else raise MemoryError.OutOfMemory
    try mutate_181_checked_write_into(ptr.cast[u8&], 48, "m254=%d")
    next: u8& = ptr.cast[u8&] + 1
    bits: uintptr = ptr.uintptr() + next.uintptr()
    sfree_bytes(ptr)
    return bits


def mutate_255_manual_stack_heap_bits() -> uintptr error[MemoryError, FormatError]:
    local: u8[16] = zeroed
    stack_bits: uintptr = local[0].ref[u8&].uintptr()
    heap_bits: uintptr = try mutate_254_manual_heap_buffer_bits()
    static_bits: uintptr = mutate_184_static_as_any_bits("m255")
    return stack_bits + heap_bits + static_bits


def mutate_256_manual_nullable_release_cycle() -> int error[MemoryError]:
    live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    handle: mutable heap HeapPairNode&? = live
    mutate_202_release_heap_pair_node(handle)
    return 256


