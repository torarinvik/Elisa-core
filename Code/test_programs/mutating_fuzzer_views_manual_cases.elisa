def mutate_279_recursive_wave(depth: int) -> int:
    if depth <= 0:
        return mutate_276_format_pair_wave(1)
    return mutate_276_format_pair_wave(depth) + mutate_279_recursive_wave(depth - 1)


def mutate_280_deep_memory_wave(depth: int, which: int) -> int:
    return mutate_250_final_memory_recursion_combo(depth, which) + mutate_279_recursive_wave(depth)

