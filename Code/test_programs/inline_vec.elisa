include "../../compiler/runtime/elisacore_std/elisacore_runtime.elisa"


def inline_vec4_inline_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        values: mutable InlineVec[i32, 4] = inlinevec.new(a)
        values.push(2)
        values.push(3)
        values.push(5)

        -1 return if values.count() != 3
        -2 return if values.spilled()
        return values.get(0) + values.get(1) + values.get(2)


def inline_vec4_spill_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        values: mutable InlineVec[i32, 4] = inlinevec.new(a)
        values.push(1)
        values.push(2)
        values.push(3)
        values.push(4)
        values.push(5)
        values.push(6)

        -1 return if values.count() != 6
        -2 return if not values.spilled()
        values.set(2, 30)
        return values.get(0) + values.get(2) + values.get(5)


def inline_vec8_view_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        values: mutable InlineVec[i32, 8] = inlinevec.new(a)
        for index in 0..<9:
            values.push(index.i32())

        -1 return if values.count() != 9
        -2 return if not values.spilled()

        view: view[i32] = values.view()
        sum: mutable i32 = 0
        for value in view:
            sum <- sum + value
        return sum


def inline_vec_clear_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        values: mutable InlineVec[i32, 4] = inlinevec.new(a)
        for index in 0..<5:
            values.push(index.i32())

        -1 return if not values.spilled()
        values.clear()
        -2 return if values.count() != 0
        -3 return if values.spilled()
        -4 return if not values.is_empty()

        values.push(42)
        return values.get(0)


def inline_vec_pop_last_smoke(a: mutable Arena&) -> i32:
    can Memory.Allocate, Abort.Panic:
        values: mutable InlineVec[i32, 4] = inlinevec.new(a)
        values.push(10)
        values.push(20)
        values.push(30)

        -1 return if values.last() != 30
        popped: i32 = values.pop()
        -2 return if values.count() != 2
        return popped + values.last()
