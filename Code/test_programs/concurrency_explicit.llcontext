# include "../contextlang_runtime.llcontext"

def atomic_roundtrip() -> i64 can[Atomics.Load, Atomics.Store, Atomics.Exchange, Atomics.CompareExchange, Atomics.Fence]:
	slot: atomic[i64] = zeroed
	slot_ref: any atomic[i64]& = (&slot).cast[any atomic[i64]&]()

	store(slot_ref, 41, MemoryOrder.Release)
	updated: bool = compare_exchange(slot_ref, 41, 42, MemoryOrder.AcqRel, MemoryOrder.Acquire)
	if updated:
		fence(MemoryOrder.SeqCst)

	previous: i64 = exchange(slot_ref, 7, MemoryOrder.SeqCst)
	current: i64 = load(slot_ref, MemoryOrder.SeqCst)
	return previous + current

def concurrency_handles(thread: Thread[i64, Joinable], task: Task[i64, Pending], pool: ThreadPool, group: TaskGroup, mu: Mutex, guard: MutexGuard[Held], cv: CondVar) -> bool:
	return (
		thread.handle == 0 and
		thread.state == null and
		task.handle == 0 and
		task.state == null and
		pool.handle == null and
		group.handle == null and
		group.cleanup == null and
		mu.handle == null and
		guard.handle == null and
		cv.handle == null
	)

def thread_worker(value: i64) -> i64:
	return value + 1

def permissioned_thread_worker(value: i64) -> i64 can[Console.Write]:
	puts("worker".cast[any u8&]()) can Console.Write
	return value + 2

def typed_thread_spawn(value: i64) -> Thread[i64, Joinable] can[Thread.Spawn, Memory.Allocate, Abort.Panic]:
	return spawn1(thread_worker, value)

def typed_thread_spawn_permissioned(value: i64) -> Thread[i64, Joinable] can[Thread.Spawn, Memory.Allocate, Abort.Panic]:
	return spawn1(permissioned_thread_worker, value)

def typed_thread_join(thread: Thread[i64, Joinable]) -> i64 can[Thread.Join, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	return join(move thread)

def typed_thread_detach_permissioned(value: i64) can[Thread.Spawn, Thread.Detach, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	thread: Thread[i64, Joinable] = spawn1(permissioned_thread_worker, value)
	detach(move thread)

def typed_pool_roundtrip(pool: any ThreadPool&, value: i64) -> i64 can[Pool.Submit, Pool.Await, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	task: Task[i64, Pending] = pool_submit1(pool, thread_worker, value)
	return await task

def typed_group_waitall(pool: any ThreadPool&, value: i64) can[Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	group: TaskGroup = task_group_new()
	task: Task[i64, Pending] = pool_submit1(pool, thread_worker, value)
	task_group_add((&group).cast[any TaskGroup&](), move task)
	task_group_wait_all((&group).cast[any TaskGroup&]())
