def mutate_201_require_heap_pair_node() -> heap HeapPairNode& error[MemoryError]:
    node: heap HeapPairNode& = get alloc_heap_pair_node() else raise MemoryError.OutOfMemory
    return node


def mutate_202_release_heap_pair_node(node: mutable heap HeapPairNode&?):
    if node != null:
        node as ! <- sfree_heap_pair_node(node)


def mutate_203_checked_any_pair(slot: FuzzPair&) -> int error[DiskError, NetError]:
    if slot.left == 0:
        raise DiskError.Missing
    if slot.right == 0:
        raise NetError.Timeout
    return slot.left + slot.right


def mutate_204_recursive_pair_node_sum(node: heap HeapPairNode&) -> int error[LogicError, DiskError, NetError]:
    value: int = try mutate_203_checked_any_pair((&node.pair).cast[FuzzPair&])
    if node.next == null:
        return value
    next: heap HeapPairNode& = node.next
    return value + (try mutate_204_recursive_pair_node_sum(next))


def mutate_205_recursive_free_pair_chain(node: mutable heap HeapPairNode&?) -> void error[LogicError]:
    if node == null:
        return
    live: heap HeapPairNode& = node
    next_node: mutable heap HeapPairNode&? = live.next
    node as ! <- sfree_heap_pair_node(node)
    try mutate_205_recursive_free_pair_chain(next_node)


def mutate_206_build_pair_chain_sum() -> int error[MemoryError, LogicError, DiskError, NetError]:
    first_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    second_live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    first_live.pair <- FuzzPair(206, 207)
    second_live.pair <- FuzzPair(208, 209)
    first_live.next <- second_live
    total: int = try mutate_204_recursive_pair_node_sum(first_live)
    first: mutable heap HeapPairNode&? = first_live
    try mutate_205_recursive_free_pair_chain(first)
    return total


def mutate_207_stack_buffer_format() -> int error[FormatError]:
    buffer: u8[32] = zeroed
    return try mutate_181_checked_write_into(&buffer[0], 32, "stack=%d")


def mutate_208_stack_buffer_format_or_minus_one() -> int:
