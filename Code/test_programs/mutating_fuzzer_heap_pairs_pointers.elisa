def mutate_214_heap_pair_any_roundtrip() -> bool error[MemoryError]:
    live: heap HeapPairNode& = try mutate_201_require_heap_pair_node()
    live.pair <- root_pair
    same: bool = (&live.pair).cast[FuzzPair&].uintptr() == (&live.pair).cast[FuzzPair&].uintptr()
    handle: mutable heap HeapPairNode&? = live
    mutate_202_release_heap_pair_node(handle)
