def mutate_221_alloc_zero_offset_compare() -> bool error[MemoryError]:
    ptr: heap u8& = get alloc_bytes(12) else raise MemoryError.OutOfMemory
    same: bool = (ptr + 0).uintptr() == ptr.uintptr()
