def mutate_215_alloc_and_compare_two_buffers() -> bool error[MemoryError]:
    left: heap u8& = get alloc_bytes(8) else raise MemoryError.OutOfMemory
    right: heap u8& = get alloc_bytes(8) else raise MemoryError.OutOfMemory
    different: bool = left.uintptr() != right.uintptr()
    sfree_bytes(left)
    sfree_bytes(right)
    return different


def mutate_216_recursive_static_format_bits(depth: int) -> uintptr:
    bits: uintptr = mutate_184_static_as_any_bits("fmt")
    if depth <= 0:
        return bits
    return bits + mutate_216_recursive_static_format_bits(depth - 1)


