def mutate_222_heap_bytes_to_any_void_roundtrip() -> bool error[MemoryError]:
    ptr: heap u8& = get alloc_bytes(12) else raise MemoryError.OutOfMemory
    same: bool = ptr.cast[void&].cast[u8&].uintptr() == ptr.uintptr()
