def region_checkpoint_demo(seed: i32) -> i32:
    region scratch(1024)
    mark scratch as cp
    temp: i32& @scratch = new[scratch] seed + 1
    restore scratch from cp
    reused: i32& @scratch = new[scratch] seed + 2
    carried: i32 = reused[0]
    reset scratch
    final: i32& @scratch = new[scratch] seed + 3
    out: i32 = carried + final[0]
    destroy scratch
    return out


def region_checkpoint_nested_demo(seed: i32) -> i32:
    region scratch(1024)
    base: i32& @scratch = new[scratch] seed
    baseline: i32 = base[0]
    mark scratch as outer
    stable: i32& @scratch = new[scratch] seed + 1
    mark scratch as inner
    temp: i32& @scratch = new[scratch] seed + 2
    restore scratch from inner
    kept: i32 = stable[0]
    restore scratch from outer
    reset scratch
    final: i32& @scratch = new[scratch] seed + 3
    out: i32 = baseline + kept + final[0]
    destroy scratch
    return out
