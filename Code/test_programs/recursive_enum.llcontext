enum Expr:
	Int(value: int)
	Add(left: any Expr&, right: any Expr&)

def eval(node: any Expr&) -> int:
	return match node[0u]:
		Expr.Int(value: value):
			value
		Expr.Add(left: left, right: right):
			eval(left) + eval(right)

def make_sum() -> int:
	region scratch(1024u)
	one: any Expr& = new[scratch] Expr.Int(1)
	two: any Expr& = new[scratch] Expr.Int(2)
	tree: any Expr& = new[scratch] Expr.Add(one, two)
	return eval(tree)
