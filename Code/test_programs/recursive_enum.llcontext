enum Expr:
	Int(value: int)
	Add(left: any Expr&, right: any Expr&)

def eval(node: any Expr&) -> int:
	return match node[0u]:
		Expr.Int(value):
			value
		Expr.Add(left, right):
			eval(left) + eval(right)

def fold_small(node: any Expr&) -> int:
	return match node[0u]:
		Expr.Add(Expr.Int(left), Expr.Int(right)):
			left + right
		_:
			eval(node)

def make_sum() -> int:
	region scratch(1024u)
	one: scratch Expr& = new[scratch] Expr.Int(1)
	two: scratch Expr& = new[scratch] Expr.Int(2)
	tree: scratch Expr& = new[scratch] Expr.Add(one.cast[any Expr&], two.cast[any Expr&])
	return fold_small(tree.cast[any Expr&])
