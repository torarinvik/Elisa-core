def json_parser_document_field_i64_impl(doc: JsonParserDocument&, key: u8&, out: mutable i64&) -> i64:
    if doc[0].impl_bits == 0.uintptr():
        return 0
    impl: heap JsonParserDocumentInternal& = doc[0].impl_bits.cast[heap JsonParserDocumentInternal&]
    store: JsonNode.Store[Local] = JsonNode.Store(impl.arena)
    field_node: JsonNode = json_parser_document_field_node(impl, key, store)
    if json_node_is_invalid(field_node, store):
        return 0
    number_value: JsonNumberValue = json_ast_number_value(json_parser_document_source(impl), field_node, store)
    if not json_number_value_can_materialize_i64(number_value):
        return 0
    out[0] <- number_value.signed_value if number_value.kind == JsonNumberKind.SIGNED else number_value.unsigned_value.i64()
    return 1
