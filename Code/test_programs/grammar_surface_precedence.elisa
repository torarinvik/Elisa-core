enum TokenKind:
    EOF
    INT
    PLUS
    MINUS
    CARET
    EQ
    LT
    GT


struct Token:
    kind: TokenKind


struct ParserState:
    cursor: mutable usize


def current_token(self: ParserState&) -> Token:
    return Token{kind: TokenKind.EOF}


def advance_token(self: mutable ParserState&) -> void:
    self.cursor <- self.cursor + 1


def token_kind_for_text(text: cstr) -> TokenKind:
    match text:
        "+":
            return TokenKind.PLUS
        "-":
            return TokenKind.MINUS
        "^":
            return TokenKind.CARET
        "=":
            return TokenKind.EQ
        "<":
            return TokenKind.LT
        ">":
            return TokenKind.GT
        _:
            return TokenKind.EOF


def expect(self: mutable ParserState&, text: cstr) -> Token:
    return Token{kind: token_kind_for_text(text)}


def expect_kind(self: mutable ParserState&, kind: TokenKind) -> Token:
    return Token{kind: kind}


def record_parse_error(self: mutable ParserState&, message: cstr) -> void:
    pass


grammar Arithmetic over Token using ParserState:
    cursor self
    token_kind TokenKind
    eof TokenKind.EOF
    token_field kind
    current current_token
    advance advance_token
    expect expect
    expect_kind expect_kind
    record_error record_parse_error
    token:
        INT
        PLUS "+"
        MINUS "-"
        CARET "^"
        EQ "="
        LT "<"
        GT ">"
    infix table Expr(compare):
        atom = token(TokenKind.INT)
        right power(left = atom()):
            .CARET -> right
        left additive(left = power()):
            op = .PLUS | .MINUS -> right
        nonassoc compare(left = additive()):
            op = .EQ | .LT | .GT -> right
    expression(self: mutable ParserState&) -> Token:
        result = infix(Expr)
        return result
    one_off_expression(self: mutable ParserState&) -> Token:
        precedence left(left = token(TokenKind.INT)):
            op = .PLUS | .MINUS -> right
        return left


def grammar_surface_parse_expr(self: mutable ParserState&) -> Token:
    return expression(self)


def grammar_surface_parse_one_off(self: mutable ParserState&) -> Token:
    return one_off_expression(self)