# include "../llcontext_std/contextlang_runtime.llcontext"

packed enum Expr:
	common:
		span: int
	Int(value: int)
	Add(left: Expr, right: Expr)

struct FrozenExprGraph:
	store: Expr.Store[Frozen]
	root: Expr

def build_frozen_expr_graph(owner: Arena) -> FrozenExprGraph:
	store: Expr.Store[Local] = Expr.Store(owner)
	root: mutable Expr = zeroed

	in store:
		left: Expr = new Expr.Int(span: 1, value: 3)
		right: Expr = new Expr.Int(span: 2, value: 4)
		root <- new Expr.Add(span: 3, left: left, right: right)

	frozen: Expr.Store[Frozen] = freeze(move store)
	return FrozenExprGraph(frozen, root)

def expr_sum(graph: FrozenExprGraph) -> i64:
	match graph.root in graph.store:
		Expr.Int(value: value):
			return value.i64() + graph.root.span.i64()
		Expr.Add(left: left, right: right):
			left_sum: i64 = expr_sum(FrozenExprGraph(graph.store, left))
			right_sum: i64 = expr_sum(FrozenExprGraph(graph.store, right))
			return graph.root.span.i64() + left_sum + right_sum
	return 0

def expr_depth(graph: FrozenExprGraph) -> i64:
	match graph.root in graph.store:
		Expr.Int(value: _):
			return 1
		Expr.Add(left: left, right: right):
			left_depth: i64 = expr_depth(FrozenExprGraph(graph.store, left))
			right_depth: i64 = expr_depth(FrozenExprGraph(graph.store, right))
			return 1 + max(left_depth, right_depth)
	return 0

def compiler_parallel_fixture(pool: mutable any ThreadPool&) -> i64 can[Thread.Spawn, Thread.Join, Pool.Submit, Pool.Await, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	region scratch(4096u)
	graph: FrozenExprGraph = build_frozen_expr_graph(scratch)
	thread: Thread[i64, Joinable] = spawn1(expr_sum, graph)
	awaited: Task[i64, Pending] = pool_submit1(pool, expr_depth, graph)

	group: mutable TaskGroup = task_group_new()
	grouped: Task[i64, Pending] = pool_submit1(pool, expr_sum, graph)
	task_group_add((&group).cast[any TaskGroup&], move grouped)
	wait all group

	return join(move thread) + await awaited

def compiler_lock_probe(mu: mutable Mutex) -> i64 can[Sync.Lock, Sync.Unlock]:
	lock mu as g:
		return 1
