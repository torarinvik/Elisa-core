def json_parser_object_iter_doc_impl(iter: any JsonParserObjectIter&) -> heap JsonParserDocumentInternal&:
    return json_parser_object_iter_impl(iter).doc_bits.cast[heap JsonParserDocumentInternal&]()


def json_parser_object_iter_node(iter: any JsonParserObjectIter&) -> JsonNode:
    return json_parser_object_iter_impl(iter).node


def json_parser_value_doc_impl(value: any JsonParserValue&) -> heap JsonParserDocumentInternal&:
    return json_parser_value_impl(value).doc_bits.cast[heap JsonParserDocumentInternal&]()


def json_parser_value_node(value: any JsonParserValue&) -> JsonNode:
    return json_parser_value_impl(value).node


def json_parser_value_from_node(impl: heap JsonParserDocumentInternal&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonParserValue can[Memory.Allocate, Abort.Panic]:
    if json_node_is_invalid(node, store):
        return json_parser_value_null()

    value_impl: any JsonParserValueInternal& = arena_alloc((&impl.arena).cast[any Arena&](), sizeof(JsonParserValueInternal)).cast[any JsonParserValueInternal&]()
    value_impl.doc_bits <- impl.uintptr()
    value_impl.node <- node
    return JsonParserValue(value_impl.cast[any u8&]().uintptr())


def json_parser_array_iter_from_node(impl: heap JsonParserDocumentInternal&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonParserArrayIter can[Memory.Allocate, Abort.Panic]:
    if json_node_is_invalid(node, store):
        return json_parser_array_iter_null()

    iter_impl: any JsonParserArrayIterInternal& = arena_alloc((&impl.arena).cast[any Arena&](), sizeof(JsonParserArrayIterInternal)).cast[any JsonParserArrayIterInternal&]()
    iter_impl.doc_bits <- impl.uintptr()
    iter_impl.node <- node
    return JsonParserArrayIter(iter_impl.cast[any u8&]().uintptr())


def json_parser_object_iter_from_node(impl: heap JsonParserDocumentInternal&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonParserObjectIter can[Memory.Allocate, Abort.Panic]:
    if json_node_is_invalid(node, store):
        return json_parser_object_iter_null()

    iter_impl: any JsonParserObjectIterInternal& = arena_alloc((&impl.arena).cast[any Arena&](), sizeof(JsonParserObjectIterInternal)).cast[any JsonParserObjectIterInternal&]()
    iter_impl.doc_bits <- impl.uintptr()
    iter_impl.node <- node
    return JsonParserObjectIter(iter_impl.cast[any u8&]().uintptr())


def json_parser_document_source(impl: heap JsonParserDocumentInternal&) -> any u8&:
    return impl.source


def json_parser_document_field_node(impl: heap JsonParserDocumentInternal&, key: any u8&, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_object_get(impl.root, json_parser_document_source(impl), key, store)


def json_parser_document_array_field_item_node(impl: heap JsonParserDocumentInternal&, key: any u8&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    array_node: JsonNode = json_parser_document_field_node(impl, key, store)
    if json_node_is_invalid(array_node, store):
        return json_node_invalid(store)
    return json_ast_array_nth(array_node, index, store)


def json_parser_document_object_field_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_object_iter_nth(impl.root, index, store)


def json_parser_document_object_value_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    field_node: JsonNode = json_parser_document_object_field_node_at(impl, index, store)
    if json_node_is_invalid(field_node, store):
        return json_node_invalid(store)
    return json_ast_object_iter_value(field_node, store)


def json_parser_document_array_item_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    iter_node: JsonNode = json_ast_array_iter_nth(impl.root, index, store)
    if json_node_is_invalid(iter_node, store):
        return json_node_invalid(store)
    return json_ast_array_iter_value(iter_node, store)


def json_parser_document_parse_impl(source: any u8&, out: any JsonParserDocument&) -> i64 can[Memory.Allocate, Memory.Release, Abort.Panic]:
    if out[0u].impl_bits != 0u64.uintptr():
        json_parser_document_destroy_impl(out)

    source_len: usize = runtime_strlen(source)
    internal_words: usize = (sizeof(JsonParserDocumentInternal) + sizeof(uintptr) - 1u) / sizeof(uintptr)
    source_words: usize = (source_len + 1u + sizeof(uintptr) - 1u) / sizeof(uintptr)
    first_region: heap Region& = new_region(json_ast_scratch_capacity(source_len) + internal_words + source_words)
    first_region.count <- internal_words

    internal: heap JsonParserDocumentInternal& = packed_store_region_data(first_region).cast[heap JsonParserDocumentInternal&]()
    arena_owner: mutable Arena = Arena(first_region, first_region, 0u)
    source_copy: heap u8& = arena_alloc((&arena_owner).cast[any Arena&](), source_len + 1u).cast[heap u8&]()
    if source_len > 0u:
        memcpy(source_copy.cast[any void&](), source.cast[any void&](), source_len)
    source_copy[source_len] <- 0

    store: JsonNode.Store[Local] = JsonNode.Store(arena_owner)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source_copy.cast[any u8&](), source_len, store)
    if result.checksum < 0:
        arena_to_free: mutable Arena = arena_owner
        out[0u] <- json_parser_document_null()
        arena_free((&arena_to_free).cast[any Arena&]())
        return 0

    internal.source <- source_copy.cast[any u8&]()
    internal.source_len <- source_len
    internal.arena <- arena_owner
    internal.root <- result.node
    internal.checksum <- result.checksum
    out[0u] <- JsonParserDocument(internal.uintptr())
    return 1


def json_parser_document_destroy_impl(doc: any JsonParserDocument&) can[Memory.Release, Abort.Panic]:
    impl_bits: uintptr = doc[0u].impl_bits
    if impl_bits == 0u64.uintptr():
        return

    impl: heap JsonParserDocumentInternal& = impl_bits.cast[heap JsonParserDocumentInternal&]()
    arena_to_free: mutable Arena = impl.arena
    doc[0u].impl_bits <- 0u64.uintptr()
    arena_free((&arena_to_free).cast[any Arena&]())


def json_parser_document_destroy_handle_impl(doc_bits: uintptr) -> i64 can[Memory.Release, Abort.Panic]:
    if doc_bits == 0u64.uintptr():
        return 0

    impl: heap JsonParserDocumentInternal& = doc_bits.cast[heap JsonParserDocumentInternal&]()
    arena_to_free: mutable Arena = impl.arena
    arena_free((&arena_to_free).cast[any Arena&]())
    return 1


def json_parser_document_checksum_impl(doc: any JsonParserDocument&) -> i64:
    if doc[0u].impl_bits == 0u64.uintptr():
