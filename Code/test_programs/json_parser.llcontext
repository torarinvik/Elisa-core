    return json_parser_array_iter_impl(iter).doc_bits.cast[heap JsonParserDocumentInternal&]()


def json_parser_array_iter_node(iter: any JsonParserArrayIter&) -> JsonNode:
    return json_parser_array_iter_impl(iter).node


def json_parser_object_iter_is_live(iter: any JsonParserObjectIter&) -> bool:
    return iter[0u].impl_bits != 0u64.uintptr()


def json_parser_object_iter_impl(iter: any JsonParserObjectIter&) -> any JsonParserObjectIterInternal&:
