# include "../contextlang_runtime.llcontext"

const JSON_CH_NUL = 0
const JSON_CH_TAB = 9
const JSON_CH_NL = 10
const JSON_CH_CR = 13
const JSON_CH_SPACE = 32
const JSON_CH_DQUOTE = 34
const JSON_CH_PLUS = 43
const JSON_CH_COMMA = 44
const JSON_CH_MINUS = 45
const JSON_CH_DOT = 46
const JSON_CH_0 = 48
const JSON_CH_9 = 57
const JSON_CH_COLON = 58
const JSON_CH_E = 69
const JSON_CH_LBRACKET = 91
const JSON_CH_BSLASH = 92
const JSON_CH_RBRACKET = 93
const JSON_CH_a = 97
const JSON_CH_b = 98
const JSON_CH_e = 101
const JSON_CH_f = 102
const JSON_CH_l = 108
const JSON_CH_n = 110
const JSON_CH_r = 114
const JSON_CH_t = 116
const JSON_CH_u = 117
const JSON_CH_LBRACE = 123
const JSON_CH_RBRACE = 125

repr(c) struct JsonCursor:
    source: mutable any u8&
    source_len: mutable usize
    pos: mutable usize


packed enum JsonNode:
    common:
        checksum: i64
    Null
    Bool(value: bool)
    Number
    String
    Array(items: JsonNode)
    Object(fields: JsonNode)
    ArrayItem(value: JsonNode, next: JsonNode)
    Field(key: JsonNode, value: JsonNode, next: JsonNode)
    End


def json_new_cursor(source: any u8&) -> JsonCursor:
    out: mutable JsonCursor = zeroed
    out.source <- source
    out.source_len <- ctx_stage0_runtime_strlen(source)
    out.pos <- 0u
    return out


def json_char_at(source: any u8&, source_len: usize, index: usize) -> i64:
    if index >= source_len:
        return JSON_CH_NUL
    return source[index].i64()


def json_cur_char(cursor: any JsonCursor&) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos)


def json_peek_char(cursor: any JsonCursor&, offset: usize) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos + offset)


def json_advance_char(cursor: any JsonCursor&) -> i64:
    ch: i64 = json_cur_char(cursor)
    if cursor.pos < cursor.source_len:
        cursor.pos <- cursor.pos + 1u
    return ch


def json_is_digit(ch: i64) -> bool:
    return ch >= JSON_CH_0 and ch <= JSON_CH_9


def json_is_hex_digit(ch: i64) -> bool:
    return json_is_digit(ch) or (ch >= 65 and ch <= 70) or (ch >= JSON_CH_a and ch <= JSON_CH_f)


def json_skip_ws(cursor: any JsonCursor&):
    scanning: mutable bool = true
    while scanning:
        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_SPACE or ch == JSON_CH_TAB or ch == JSON_CH_NL or ch == JSON_CH_CR:
            _ = json_advance_char(cursor)
        else:
            scanning <- false


def json_expect_literal(cursor: any JsonCursor&, literal: any u8&) -> bool:
    literal_len: usize = ctx_stage0_runtime_strlen(literal)
    if cursor.pos + literal_len > cursor.source_len:
        return false

    i: mutable usize = 0u
    while i < literal_len:
        if cursor.source[cursor.pos + i].i64() != literal[i].i64():
            return false
        i <- i + 1u

    cursor.pos <- cursor.pos + literal_len
    return true


def json_parse_string(cursor: any JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_DQUOTE:
        return -1

    length: mutable i64 = 0
    done: mutable bool = false
    while not done:
        if cursor.pos >= cursor.source_len:
            return -1

        ch: i64 = json_advance_char(cursor)
        if ch == JSON_CH_DQUOTE:
            return 17 + length

        if ch == JSON_CH_BSLASH:
            if cursor.pos >= cursor.source_len:
                return -1
            esc: i64 = json_advance_char(cursor)
            if esc == JSON_CH_u:
                digits: mutable usize = 0u
                while digits < 4u:
                    if cursor.pos >= cursor.source_len or not json_is_hex_digit(json_cur_char(cursor)):
                        return -1
                    _ = json_advance_char(cursor)
                    digits <- digits + 1u
            length <- length + 1
        elif ch == JSON_CH_NL or ch == JSON_CH_CR:
            return -1
        else:
            length <- length + 1

    return -1


def json_parse_number(cursor: any JsonCursor&) -> i64:
    start: usize = cursor.pos
    ch: mutable i64 = json_cur_char(cursor)
    if ch == JSON_CH_MINUS:
        _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_0:
        _ = json_advance_char(cursor)
    elif json_is_digit(ch):
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)
    else:
        return -1

    if json_cur_char(cursor) == JSON_CH_DOT:
        _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return -1
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_e or ch == JSON_CH_E:
        _ = json_advance_char(cursor)
        ch <- json_cur_char(cursor)
        if ch == JSON_CH_PLUS or ch == JSON_CH_MINUS:
            _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return -1
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    return 23 + (cursor.pos - start).i64()


def json_parse_array(cursor: any JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACKET:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        return 43

    total: mutable i64 = 43
    done: mutable bool = false
    while not done:
        item: i64 = json_parse_value(cursor)
        if item < 0:
            return -1
        total <- total + item
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACKET:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_object(cursor: any JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACE:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        return 47

    total: mutable i64 = 47
    done: mutable bool = false
    while not done:
        key: i64 = json_parse_string(cursor)
        if key < 0:
            return -1
        total <- total + key
        json_skip_ws(cursor)
        if json_advance_char(cursor) != JSON_CH_COLON:
            return -1
        json_skip_ws(cursor)

        value: i64 = json_parse_value(cursor)
        if value < 0:
            return -1
        total <- total + value
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACE:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_true(cursor: any JsonCursor&) -> i64:
    if json_expect_literal(cursor, "true".cast[any u8&]()):
        return 31
    return -1


def json_parse_false(cursor: any JsonCursor&) -> i64:
    if json_expect_literal(cursor, "false".cast[any u8&]()):
        return 37
    return -1


def json_parse_null(cursor: any JsonCursor&) -> i64:
    if json_expect_literal(cursor, "null".cast[any u8&]()):
        return 41
    return -1


def json_node_end(store: JsonNode.Store) -> JsonNode:
    in store:
        return new JsonNode.End(checksum: 0)


def json_node_invalid(store: JsonNode.Store) -> JsonNode:
    in store:
        return new JsonNode.End(checksum: -1)


def json_node_is_invalid(node: JsonNode, store: JsonNode.Store) -> bool:
    in store:
        match node:
            JsonNode.End:
                return node.checksum < 0
        return false


def json_ast_array_items_checksum(node: JsonNode, store: JsonNode.Store) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.ArrayItem(value: value, next: next):
                value_checksum: i64 = json_ast_checksum_node(value, store)
                if value_checksum < 0:
                    return -1
                next_checksum: i64 = json_ast_array_items_checksum(next, store)
                if next_checksum < 0:
                    return -1
                return value_checksum + next_checksum
        return -1


def json_ast_field_checksum(node: JsonNode, store: JsonNode.Store) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.Field(key: key, value: value, next: next):
                key_checksum: i64 = json_ast_checksum_node(key, store)
                if key_checksum < 0:
                    return -1
                value_checksum: i64 = json_ast_checksum_node(value, store)
                if value_checksum < 0:
                    return -1
                next_checksum: i64 = json_ast_field_checksum(next, store)
                if next_checksum < 0:
                    return -1
                return key_checksum + value_checksum + next_checksum
        return -1


def json_ast_checksum_node(node: JsonNode, store: JsonNode.Store) -> i64:
    in store:
        match node:
            JsonNode.Null:
                return 41
            JsonNode.Bool(value: value):
                if value:
                    return 31
                return 37
            JsonNode.Number:
                return node.checksum
            JsonNode.String:
                return node.checksum
            JsonNode.Array(items: items):
                items_checksum: i64 = json_ast_array_items_checksum(items, store)
                if items_checksum < 0:
                    return -1
                return 43 + items_checksum
            JsonNode.Object(fields: fields):
                fields_checksum: i64 = json_ast_field_checksum(fields, store)
                if fields_checksum < 0:
                    return -1
                return 47 + fields_checksum
            JsonNode.End:
                return node.checksum
        return -1


def json_ast_node_count(node: JsonNode, store: JsonNode.Store) -> i64:
    in store:
        match node:
            JsonNode.Null:
                return 1
            JsonNode.Bool(value: value):
                return 1
            JsonNode.Number:
                return 1
            JsonNode.String:
                return 1
            JsonNode.Array(items: items):
                items_count: i64 = json_ast_node_count(items, store)
                if items_count < 0:
                    return -1
                return 1 + items_count
            JsonNode.Object(fields: fields):
                fields_count: i64 = json_ast_node_count(fields, store)
                if fields_count < 0:
                    return -1
                return 1 + fields_count
            JsonNode.ArrayItem(value: value, next: next):
                value_count: i64 = json_ast_node_count(value, store)
                if value_count < 0:
                    return -1
                next_count: i64 = json_ast_node_count(next, store)
                if next_count < 0:
                    return -1
                return 1 + value_count + next_count
            JsonNode.Field(key: key, value: value, next: next):
                key_count: i64 = json_ast_node_count(key, store)
                if key_count < 0:
                    return -1
                value_count: i64 = json_ast_node_count(value, store)
                if value_count < 0:
                    return -1
                next_count: i64 = json_ast_node_count(next, store)
                if next_count < 0:
                    return -1
                return 1 + key_count + value_count + next_count
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 1
        return -1


def json_parse_string_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    checksum: i64 = json_parse_string(cursor)
    if checksum < 0:
        return json_node_invalid(store)
    in store:
        return new JsonNode.String(checksum: checksum)


def json_parse_number_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    checksum: i64 = json_parse_number(cursor)
    if checksum < 0:
        return json_node_invalid(store)
    in store:
        return new JsonNode.Number(checksum: checksum)


def json_parse_true_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    checksum: i64 = json_parse_true(cursor)
    if checksum < 0:
        return json_node_invalid(store)
    in store:
        return new JsonNode.Bool(checksum: checksum, value: true)


def json_parse_false_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    checksum: i64 = json_parse_false(cursor)
    if checksum < 0:
        return json_node_invalid(store)
    in store:
        return new JsonNode.Bool(checksum: checksum, value: false)


def json_parse_null_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    checksum: i64 = json_parse_null(cursor)
    if checksum < 0:
        return json_node_invalid(store)
    in store:
        return new JsonNode.Null(checksum: checksum)


def json_parse_array_items_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    value: JsonNode = json_parse_value_node(cursor, store)
    if json_node_is_invalid(value, store):
        return value

    json_skip_ws(cursor)
    next: mutable JsonNode = json_node_end(store)
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_COMMA:
        _ = json_advance_char(cursor)
        json_skip_ws(cursor)
        next <- json_parse_array_items_node(cursor, store)
        if json_node_is_invalid(next, store):
            return next
    elif ch == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
    else:
        return json_node_invalid(store)

    item_checksum: i64 = value.checksum + next.checksum
    in store:
        return new JsonNode.ArrayItem(checksum: item_checksum, value: value, next: next)


def json_parse_array_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    if json_advance_char(cursor) != JSON_CH_LBRACKET:
        return json_node_invalid(store)

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        in store:
            return new JsonNode.Array(checksum: 43, items: json_node_end(store))

    items: JsonNode = json_parse_array_items_node(cursor, store)
    if json_node_is_invalid(items, store):
        return items
    items_checksum: i64 = items.checksum
    if items_checksum < 0:
        return json_node_invalid(store)

    in store:
        return new JsonNode.Array(checksum: 43 + items_checksum, items: items)


def json_parse_object_fields_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    key: JsonNode = json_parse_string_node(cursor, store)
    if json_node_is_invalid(key, store):
        return key

    json_skip_ws(cursor)
    if json_advance_char(cursor) != JSON_CH_COLON:
        return json_node_invalid(store)
    json_skip_ws(cursor)

    value: JsonNode = json_parse_value_node(cursor, store)
    if json_node_is_invalid(value, store):
        return value

    json_skip_ws(cursor)
    next: mutable JsonNode = json_node_end(store)
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_COMMA:
        _ = json_advance_char(cursor)
        json_skip_ws(cursor)
        next <- json_parse_object_fields_node(cursor, store)
        if json_node_is_invalid(next, store):
            return next
    elif ch == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
    else:
        return json_node_invalid(store)

    field_checksum: i64 = key.checksum + value.checksum + next.checksum
    in store:
        return new JsonNode.Field(checksum: field_checksum, key: key, value: value, next: next)


def json_parse_object_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    if json_advance_char(cursor) != JSON_CH_LBRACE:
        return json_node_invalid(store)

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        in store:
            return new JsonNode.Object(checksum: 47, fields: json_node_end(store))

    fields: JsonNode = json_parse_object_fields_node(cursor, store)
    if json_node_is_invalid(fields, store):
        return fields
    fields_checksum: i64 = fields.checksum
    if fields_checksum < 0:
        return json_node_invalid(store)

    in store:
        return new JsonNode.Object(checksum: 47 + fields_checksum, fields: fields)


def json_parse_value_node(cursor: any JsonCursor&, store: JsonNode.Store) -> JsonNode:
    json_skip_ws(cursor)
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_DQUOTE:
        return json_parse_string_node(cursor, store)
    if ch == JSON_CH_LBRACE:
        return json_parse_object_node(cursor, store)
    if ch == JSON_CH_LBRACKET:
        return json_parse_array_node(cursor, store)
    if ch == JSON_CH_t:
        return json_parse_true_node(cursor, store)
    if ch == JSON_CH_f:
        return json_parse_false_node(cursor, store)
    if ch == JSON_CH_n:
        return json_parse_null_node(cursor, store)
    if ch == JSON_CH_MINUS or json_is_digit(ch):
        return json_parse_number_node(cursor, store)
    return json_node_invalid(store)


def json_parse_value(cursor: any JsonCursor&) -> i64:
    json_skip_ws(cursor)
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_DQUOTE:
        return json_parse_string(cursor)
    if ch == JSON_CH_LBRACE:
        return json_parse_object(cursor)
    if ch == JSON_CH_LBRACKET:
        return json_parse_array(cursor)
    if ch == JSON_CH_t:
        return json_parse_true(cursor)
    if ch == JSON_CH_f:
        return json_parse_false(cursor)
    if ch == JSON_CH_n:
        return json_parse_null(cursor)
    if ch == JSON_CH_MINUS or json_is_digit(ch):
        return json_parse_number(cursor)
    return -1


def json_parser_checksum_impl(source: any u8&) -> i64:
    cursor: mutable JsonCursor = json_new_cursor(source)
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    checksum: i64 = json_parse_value((&cursor).cast[any JsonCursor&]())
    if checksum < 0:
        return -1
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    if cursor.pos != cursor.source_len:
        return -1
    return checksum


def json_parse_document_node(source: any u8&, store: JsonNode.Store) -> JsonNode:
    cursor: mutable JsonCursor = json_new_cursor(source)
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    node: JsonNode = json_parse_value_node((&cursor).cast[any JsonCursor&](), store)
    if json_node_is_invalid(node, store):
        return node
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    if cursor.pos != cursor.source_len:
        return json_node_invalid(store)
    return node


def json_ast_scratch_capacity(source_len: usize) -> usize:
    slots_per_byte_budget: usize = 2u
    capacity: usize = source_len * slots_per_byte_budget + 1024u
    return max(capacity, ARENA_REGION_DEFAULT_CAPACITY)


def json_parser_ast_checksum_impl(source: any u8&) -> i64:
    source_len: usize = ctx_stage0_runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store = JsonNode.Store(scratch)
    node: JsonNode = json_parse_document_node(source, store)
    if json_node_is_invalid(node, store):
        destroy scratch
        return -1
    checksum: i64 = json_ast_checksum_node(node, store)
    destroy scratch
    return checksum


def json_parser_ast_cached_checksum_impl(source: any u8&) -> i64:
    source_len: usize = ctx_stage0_runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store = JsonNode.Store(scratch)
    node: JsonNode = json_parse_document_node(source, store)
    if json_node_is_invalid(node, store):
        destroy scratch
        return -1
    checksum: i64 = node.checksum
    destroy scratch
    return checksum


def json_parser_ast_node_count_impl(source: any u8&) -> i64:
    source_len: usize = ctx_stage0_runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store = JsonNode.Store(scratch)
    node: JsonNode = json_parse_document_node(source, store)
    if json_node_is_invalid(node, store):
        destroy scratch
        return -1
    count: i64 = json_ast_node_count(node, store)
    destroy scratch
    return count


def json_expect_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_checksum_impl(source.cast[any u8&]()) == expected


def json_expect_invalid(source: static u8&) -> bool:
    return json_parser_checksum_impl(source.cast[any u8&]()) < 0


def json_expect_ast_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_ast_checksum_impl(source.cast[any u8&]()) == expected


def json_expect_invalid_ast(source: static u8&) -> bool:
    return json_parser_ast_checksum_impl(source.cast[any u8&]()) < 0


def json_parser_parity_suite_impl() -> int:
    if not json_expect_checksum("{}", 47):
        return 0
    if not json_expect_ast_checksum("{}", 47):
        return 0
    if not json_expect_checksum("[]", 43):
        return 0
    if not json_expect_ast_checksum("[]", 43):
        return 0
    if not json_expect_checksum("[1,2,3]", 115):
        return 0
    if not json_expect_ast_checksum("[1,2,3]", 115):
        return 0
    if not json_expect_checksum("[true,false,null]", 152):
        return 0
    if not json_expect_ast_checksum("[true,false,null]", 152):
        return 0
    if not json_expect_checksum("[-12,3.5,null]", 136):
        return 0
    if not json_expect_ast_checksum("[-12,3.5,null]", 136):
        return 0
    if not json_expect_invalid("[1,2}"):
        return 0
    if not json_expect_invalid_ast("[1,2}"):
        return 0
    if not json_expect_invalid("[1,,2]"):
        return 0
    if not json_expect_invalid_ast("[1,,2]"):
        return 0
    return 1


export func json_parser_parity_suite() -> int = json_parser_parity_suite_impl
export func json_parser_checksum(source: any u8&) -> i64 = json_parser_checksum_impl
export func json_parser_ast_checksum(source: any u8&) -> i64 = json_parser_ast_checksum_impl
export func json_parser_ast_cached_checksum(source: any u8&) -> i64 = json_parser_ast_cached_checksum_impl
export func json_parser_ast_node_count(source: any u8&) -> i64 = json_parser_ast_node_count_impl
