def json_parser_value_number_data_impl(value: any JsonParserValue&, out: any JsonParserNumberData&) -> i64:
    out[0u] <- JsonParserNumberData(-1, 0u64, 0, 0.0)
    if not json_parser_value_is_live(value):
        return 0

    impl: heap JsonParserDocumentInternal& = json_parser_value_doc_impl(value)
    store: JsonNode.Store[Local] = json_parser_document_store(impl)
    node: JsonNode = json_parser_value_node(value)
    number_value: JsonNumberValue = json_ast_number_value_with_len(json_parser_document_source(impl), json_parser_document_source_len(impl), node, store)
    kind_code: i64 = json_ast_number_kind_code(number_value.kind)
    if kind_code < 0:
        return 0

    out[0u].kind <- kind_code
    out[0u].unsigned_value <- number_value.unsigned_value
    out[0u].signed_value <- number_value.signed_value
    if number_value.kind == JsonNumberKind.NON_INTEGRAL or number_value.kind == JsonNumberKind.OUT_OF_RANGE:
        out[0u].float_value <- try json_ast_number_f64_value_with_len(json_parser_document_source(impl), json_parser_document_source_len(impl), node, store) else 0.0
    return 1


