    item_node: JsonNode = json_ast_array_iter_nth(result.node, index, store)
    if json_node_is_invalid(item_node, store):
        destroy scratch
        return 0
    value_node: JsonNode = json_ast_array_iter_value(item_node, store)
    if not json_node_can_materialize_float(value_node, store):
        destroy scratch
        return 0
    float_value: f32 = try json_ast_number_f32_value(source, value_node, store) else 0.0
    out[0u] <- float_value
    destroy scratch
    return 1


