include "../llcontext_std/contextlang_runtime.llcontext"

const JSON_CH_NUL = 0
const JSON_CH_TAB = 9
const JSON_CH_NL = 10
const JSON_CH_CR = 13
const JSON_CH_SPACE = 32
const JSON_CH_DQUOTE = 34
const JSON_CH_PLUS = 43
const JSON_CH_COMMA = 44
const JSON_CH_MINUS = 45
const JSON_CH_DOT = 46
const JSON_CH_SLASH = 47
const JSON_CH_0 = 48
const JSON_CH_1 = 49
const JSON_CH_9 = 57
const JSON_CH_COLON = 58
const JSON_CH_E = 69
const JSON_CH_LBRACKET = 91
const JSON_CH_BSLASH = 92
const JSON_CH_RBRACKET = 93
const JSON_CH_a = 97
const JSON_CH_b = 98
const JSON_CH_e = 101
const JSON_CH_f = 102
const JSON_CH_l = 108
const JSON_CH_n = 110
const JSON_CH_r = 114
const JSON_CH_t = 116
const JSON_CH_u = 117
const JSON_CH_LBRACE = 123
const JSON_CH_RBRACE = 125
const JSON_MAX_INLINE_SOURCE_OFFSET = 4294967295

struct JsonCursor:
    source: mutable u8&
    source_len: mutable usize
    pos: mutable usize


struct JsonParseNodeResult:
    node: mutable JsonNode
    checksum: mutable i64


struct JsonLexemeResult:
    checksum: mutable i64
    source_offset: mutable usize
    source_len: mutable usize


struct JsonField:
    key: mutable JsonNode
    value: mutable JsonNode


struct JsonAstArrayIterCursor:
    items: mutable dview[JsonNode]
    index: mutable usize


struct JsonAstObjectIterCursor:
    fields: mutable dview[JsonField]
    index: mutable usize


@packed_profile(retained_reads)
packed enum JsonNode:
    Invalid
    Null
    Bool(value: bool)
    Num(source_offset: u32)
    Text(source_offset: u32)
    Array(items_ptr: JsonNode&?, item_count: usize)
    Object(fields_ptr: JsonField&?, field_count: usize)


const enum JsonNodeKind of i8:
    INVALID = -1
    NULL = 0
    BOOL = 1
    NUMBER = 2
    STRING = 3
    ARRAY = 4
    OBJECT = 5


const enum JsonNumberKind of i8:
    INVALID = -1
    UNSIGNED = 0
    SIGNED = 1
    NON_INTEGRAL = 2
    OUT_OF_RANGE = 3


struct JsonNumberValue:
    kind: mutable JsonNumberKind
    unsigned_value: mutable u64
    signed_value: mutable i64


struct JsonParserNumberData:
    kind: mutable i64
    unsigned_value: mutable u64
    signed_value: mutable i64
    float_value: mutable f64


error JsonNumberAccessError:
    Invalid


extern strtod(nptr: u8&, endptr: u8&?) -> f64


def readonly[T](view: dview[T]) -> dview[T]:
    return view


struct JsonParserDocumentInternal:
    source: mutable u8&
    source_len: mutable usize
    arena: mutable Arena
    store_row_bytes: mutable usize
    store_state_bits: mutable uintptr
    root: mutable JsonNode
    checksum: mutable i64


struct JsonParserValueInternal:
    doc_bits: mutable uintptr
    node_ptr: mutable void&?


struct JsonParserArrayIterInternal:
    doc_bits: mutable uintptr
    cursor: mutable JsonAstArrayIterCursor


struct JsonParserObjectIterInternal:
    doc_bits: mutable uintptr
    cursor: mutable JsonAstObjectIterCursor


struct JsonParserDocument:
    impl_bits: mutable uintptr


struct JsonParserValue:
    impl_bits: mutable uintptr
    node_ptr: mutable void&?


struct JsonParserArrayIter:
    impl_bits: mutable uintptr
    items_ptr: mutable void&?
    item_count: mutable usize
    index: mutable usize


struct JsonParserObjectIter:
    impl_bits: mutable uintptr
    fields_ptr: mutable void&?
    field_count: mutable usize
    index: mutable usize


def json_new_cursor_with_len(source: u8&, source_len: usize) -> JsonCursor:
    out: mutable JsonCursor = zeroed
    out.source <- source
    out.source_len <- source_len
    out.pos <- 0
    return out


def json_new_cursor(source: u8&) -> JsonCursor:
    return json_new_cursor_with_len(source, runtime_strlen(source))


def json_copy_cursor(cursor: JsonCursor&) -> JsonCursor:
    return JsonCursor(cursor.source, cursor.source_len, cursor.pos)


@inline(always)
def json_char_at(source: u8&, source_len: usize, index: usize) -> i64:
    if index >= source_len:
        return JSON_CH_NUL
    return source[index].i64()


@inline(always)
def json_cur_char(cursor: JsonCursor&) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos)


def json_peek_char(cursor: JsonCursor&, offset: usize) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos + offset)


@inline(always)
def json_advance_char(cursor: mutable JsonCursor&) -> i64:
    ch: i64 = json_cur_char(cursor)
    if cursor.pos < cursor.source_len:
        cursor.pos <- cursor.pos + 1
    return ch


@inline(always)
def json_is_digit(ch: i64) -> bool:
    return ch >= JSON_CH_0 and ch <= JSON_CH_9


def json_is_hex_digit(ch: i64) -> bool:
    return json_is_digit(ch) or (ch >= 65 and ch <= 70) or (ch >= JSON_CH_a and ch <= JSON_CH_f)


@inline(always)
def json_hex_digit_value(ch: i64) -> i64:
    if ch >= JSON_CH_0 and ch <= JSON_CH_9:
        return ch - JSON_CH_0
    if ch >= 65 and ch <= 70:
        return ch - 65 + 10
    if ch >= JSON_CH_a and ch <= JSON_CH_f:
        return ch - JSON_CH_a + 10
    return -1


def json_is_high_surrogate(codepoint: i64) -> bool:
    return codepoint >= 55296 and codepoint <= 56319


def json_is_low_surrogate(codepoint: i64) -> bool:
    return codepoint >= 56320 and codepoint <= 57343


def json_read_hex_quad(cursor: mutable JsonCursor&) -> i64:
    value: mutable i64 = 0
    for digits in 0..<4:
        digit: i64 = json_hex_digit_value(json_cur_char(cursor))
        if digit < 0:
            return -1
        _ = json_advance_char(cursor)
        value <- value * 16 + digit
    return value


def json_read_hex_quad_from_source(source: u8&, source_end: usize, pos: mutable usize&) -> i64:
    if pos[0] + 4 > source_end:
        return -1

    value: mutable i64 = 0
    for digits in 0..<4:
        digit: i64 = json_hex_digit_value(source[pos[0]].i64())
        if digit < 0:
            return -1
        value <- value * 16 + digit
        pos[0] <- pos[0] + 1
    return value


def json_decode_escape_codepoint(cursor: mutable JsonCursor&) -> i64:
    if cursor.pos >= cursor.source_len:
        return -1

    esc: i64 = json_advance_char(cursor)
    if esc == JSON_CH_DQUOTE or esc == JSON_CH_BSLASH or esc == JSON_CH_SLASH:
        return esc
    if esc == JSON_CH_b:
        return 8
    if esc == JSON_CH_f:
        return 12
    if esc == JSON_CH_n:
        return JSON_CH_NL
    if esc == JSON_CH_r:
        return JSON_CH_CR
    if esc == JSON_CH_t:
        return JSON_CH_TAB
    if esc != JSON_CH_u:
        return -1

    first: i64 = json_read_hex_quad(cursor)
    if first < 0:
        return -1
    if json_is_low_surrogate(first):
        return -1
    if not json_is_high_surrogate(first):
        return first

    if json_advance_char(cursor) != JSON_CH_BSLASH:
        return -1
    if json_advance_char(cursor) != JSON_CH_u:
        return -1

    second: i64 = json_read_hex_quad(cursor)
    if not json_is_low_surrogate(second):
        return -1

    return 65536 + ((first - 55296) << 10) + (second - 56320)


def json_decode_escape_codepoint_from_source(source: u8&, source_end: usize, pos: mutable usize&) -> i64:
    if pos[0] >= source_end:
        return -1

    esc: i64 = source[pos[0]].i64()
    pos[0] <- pos[0] + 1

    if esc == JSON_CH_DQUOTE or esc == JSON_CH_BSLASH or esc == JSON_CH_SLASH:
        return esc
    if esc == JSON_CH_b:
        return 8
    if esc == JSON_CH_f:
        return 12
    if esc == JSON_CH_n:
        return JSON_CH_NL
    if esc == JSON_CH_r:
        return JSON_CH_CR
    if esc == JSON_CH_t:
        return JSON_CH_TAB
    if esc != JSON_CH_u:
        return -1

    first: i64 = json_read_hex_quad_from_source(source, source_end, pos)
    if first < 0:
        return -1
    if json_is_low_surrogate(first):
        return -1
    if not json_is_high_surrogate(first):
        return first

    if pos[0] >= source_end or source[pos[0]].i64() != JSON_CH_BSLASH:
        return -1
    pos[0] <- pos[0] + 1
    if pos[0] >= source_end or source[pos[0]].i64() != JSON_CH_u:
        return -1
    pos[0] <- pos[0] + 1

    second: i64 = json_read_hex_quad_from_source(source, source_end, pos)
    if not json_is_low_surrogate(second):
        return -1

    return 65536 + ((first - 55296) << 10) + (second - 56320)


def json_utf8_codepoint_size(codepoint: i64) -> usize:
    if codepoint < 0:
        return 0
    if codepoint <= 127:
        return 1
    if codepoint <= 2047:
        return 2
    if codepoint <= 65535:
        return 3
    if codepoint <= 1114111:
        return 4
    return 0


def json_write_utf8_codepoint(dst: mutable u8&, dst_pos: usize, codepoint: i64) -> usize:
    if codepoint <= 127:
        dst[dst_pos] <- codepoint.u8()
        return 1
    if codepoint <= 2047:
        dst[dst_pos] <- (192 | (codepoint >> 6)).u8()
        dst[dst_pos + 1] <- (128 | (codepoint & 63)).u8()
        return 2
    if codepoint <= 65535:
        dst[dst_pos] <- (224 | (codepoint >> 12)).u8()
        dst[dst_pos + 1] <- (128 | ((codepoint >> 6) & 63)).u8()
        dst[dst_pos + 2] <- (128 | (codepoint & 63)).u8()
        return 3
    dst[dst_pos] <- (240 | (codepoint >> 18)).u8()
    dst[dst_pos + 1] <- (128 | ((codepoint >> 12) & 63)).u8()
    dst[dst_pos + 2] <- (128 | ((codepoint >> 6) & 63)).u8()
    dst[dst_pos + 3] <- (128 | (codepoint & 63)).u8()
    return 4


def json_string_has_escape(source: u8&, source_offset: usize, source_len: usize) -> bool:
    if source_len < 2:
        return false

    pos: mutable usize = source_offset + 1
    end: usize = source_offset + source_len - 1
    while pos < end:
        if source[pos].i64() == JSON_CH_BSLASH:
            return true
        pos <- pos + 1
    return false


def json_decoded_string_len(source: u8&, source_offset: usize, source_len: usize) -> i64:
    if source_len < 2:
        return -1
    if not json_string_has_escape(source, source_offset, source_len):
        return (source_len - 2).i64()

    pos: mutable usize = source_offset + 1
    end: usize = source_offset + source_len - 1
    total: mutable i64 = 0
    while pos < end:
        ch: i64 = source[pos].i64()
        pos <- pos + 1
        if likely ch != JSON_CH_BSLASH:
            total <- total + 1
        else:
            codepoint: i64 = json_decode_escape_codepoint_from_source(source, end, pos.ref[mutable usize&])
            if codepoint < 0:
                return -1
            utf8_size: usize = json_utf8_codepoint_size(codepoint)
            if utf8_size == 0:
                return -1
            total <- total + utf8_size.i64()
    return total


def json_decode_string_into(source: u8&, source_offset: usize, source_len: usize, dst: mutable u8&) -> i64:
    if source_len < 2:
        return -1

    raw_offset: usize = source_offset + 1
    raw_len: usize = source_len - 2
    if not json_string_has_escape(source, source_offset, source_len):
        if raw_len > 0:
            memcpy(dst.cast[mutable void&], (source + raw_offset).cast[void&], raw_len)
        return raw_len.i64()

    pos: mutable usize = raw_offset
    end: usize = source_offset + source_len - 1
    out_pos: mutable usize = 0
    while pos < end:
        ch: i64 = source[pos].i64()
        pos <- pos + 1
        if likely ch != JSON_CH_BSLASH:
            dst[out_pos] <- ch.u8()
            out_pos <- out_pos + 1
        else:
            codepoint: i64 = json_decode_escape_codepoint_from_source(source, end, pos.ref[mutable usize&])
            if codepoint < 0:
                return -1
            out_pos <- out_pos + json_write_utf8_codepoint(dst, out_pos, codepoint)
    return out_pos.i64()


def json_string_matches_literal(source: u8&, source_offset: usize, source_len: usize, literal: u8&) -> bool:
    if source_len < 2:
        return false
    if not json_string_has_escape(source, source_offset, source_len):
        return string_view(source + source_offset + 1, 0, (source_len - 2).i64()) == literal

    literal_len: usize = runtime_strlen(literal)
    pos: mutable usize = source_offset + 1
    end: usize = source_offset + source_len - 1
    literal_pos: mutable usize = 0
    while pos < end:
        ch: i64 = source[pos].i64()
        pos <- pos + 1
        if likely ch != JSON_CH_BSLASH:
            if literal_pos >= literal_len or literal[literal_pos].i64() != ch:
                return false
            literal_pos <- literal_pos + 1
        else:
            codepoint: i64 = json_decode_escape_codepoint_from_source(source, end, pos.ref[mutable usize&])
            if codepoint < 0:
                return false
            utf8: u8[4] = zeroed
            encoded_len: usize = json_write_utf8_codepoint(utf8[0].ref[mutable u8&], 0, codepoint)
            if literal_pos + encoded_len > literal_len:
                return false
            for i in 0..<encoded_len:
                if literal[literal_pos + i].i64() != utf8[i].i64():
                    return false
            literal_pos <- literal_pos + encoded_len
    return literal_pos == literal_len


@inline(always)
def json_skip_ws(cursor: mutable JsonCursor&):
    scanning: mutable bool = true
    while scanning:
        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_SPACE or ch == JSON_CH_TAB or ch == JSON_CH_NL or ch == JSON_CH_CR:
            _ = json_advance_char(cursor)
        else:
            scanning <- false


@inline(always)
def json_expect_literal_with_len(cursor: mutable JsonCursor&, literal: u8&, literal_len: usize) -> bool:
    if cursor.pos + literal_len > cursor.source_len:
        return false

    for i in 0..<literal_len:
        if cursor.source[cursor.pos + i].i64() != literal[i].i64():
            return false

    cursor.pos <- cursor.pos + literal_len
    return true


def json_expect_literal(cursor: mutable JsonCursor&, literal: u8&) -> bool:
    return json_expect_literal_with_len(cursor, literal, runtime_strlen(literal))


def json_invalid_lexeme() -> JsonLexemeResult:
    return JsonLexemeResult(-1, 0, 0)


def json_parse_string_lexeme(cursor: mutable JsonCursor&) -> JsonLexemeResult:
    start: usize = cursor.pos
    if json_advance_char(cursor) != JSON_CH_DQUOTE:
        return json_invalid_lexeme()

    length: mutable i64 = 0
    while true:
        if cursor.pos >= cursor.source_len:
            return json_invalid_lexeme()

        ch: i64 = json_advance_char(cursor)
        if ch == JSON_CH_DQUOTE:
            return JsonLexemeResult(17 + length, start, cursor.pos - start)

        if likely ch != JSON_CH_BSLASH:
            if ch < JSON_CH_SPACE:
                return json_invalid_lexeme()
            length <- length + 1
        else:
            if json_decode_escape_codepoint(cursor) < 0:
                return json_invalid_lexeme()
            length <- length + 1

    return json_invalid_lexeme()


def json_parse_string(cursor: mutable JsonCursor&) -> i64:
    return json_parse_string_lexeme(cursor).checksum


def json_parse_number_lexeme(cursor: mutable JsonCursor&) -> JsonLexemeResult:
    start: usize = cursor.pos
    ch: mutable i64 = json_cur_char(cursor)
    if ch == JSON_CH_MINUS:
        _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_0:
        _ = json_advance_char(cursor)
    elif json_is_digit(ch):
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)
    else:
        return json_invalid_lexeme()

    if json_cur_char(cursor) == JSON_CH_DOT:
        _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return json_invalid_lexeme()
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_e or ch == JSON_CH_E:
        _ = json_advance_char(cursor)
        ch <- json_cur_char(cursor)
        if ch == JSON_CH_PLUS or ch == JSON_CH_MINUS:
            _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return json_invalid_lexeme()
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    return JsonLexemeResult(23 + (cursor.pos - start).i64(), start, cursor.pos - start)


def json_parse_number(cursor: mutable JsonCursor&) -> i64:
    return json_parse_number_lexeme(cursor).checksum


def json_parse_string_lexeme_at(source: u8&, source_len: usize, source_offset: u32) -> JsonLexemeResult:
    if source_offset.u64() > JSON_MAX_INLINE_SOURCE_OFFSET or source_offset.usize() >= source_len:
        return json_invalid_lexeme()
    cursor: mutable JsonCursor = json_new_cursor_with_len(source, source_len)
    cursor.pos <- source_offset.usize()
    return json_parse_string_lexeme(cursor.ref[mutable JsonCursor&])


def json_parse_number_lexeme_at(source: u8&, source_len: usize, source_offset: u32) -> JsonLexemeResult:
    if source_offset.u64() > JSON_MAX_INLINE_SOURCE_OFFSET or source_offset.usize() >= source_len:
        return json_invalid_lexeme()
    cursor: mutable JsonCursor = json_new_cursor_with_len(source, source_len)
    cursor.pos <- source_offset.usize()
    return json_parse_number_lexeme(cursor.ref[mutable JsonCursor&])


def json_parse_value_after_ws(cursor: mutable JsonCursor&) -> i64:
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_DQUOTE:
        return json_parse_string(cursor)
    if ch == JSON_CH_LBRACE:
        return json_parse_object(cursor)
    if ch == JSON_CH_LBRACKET:
        return json_parse_array(cursor)
    if ch == JSON_CH_t:
        return json_parse_true(cursor)
    if ch == JSON_CH_f:
        return json_parse_false(cursor)
    if ch == JSON_CH_n:
        return json_parse_null(cursor)
    if ch == JSON_CH_MINUS or json_is_digit(ch):
        return json_parse_number(cursor)
    return -1


def json_count_array_items_after_ws(cursor: mutable JsonCursor&) -> i64:
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        return 0

    count: mutable i64 = 0
    done: mutable bool = false
    while not done:
        item: i64 = json_parse_value_after_ws(cursor)
        if item < 0:
            return -1
        count <- count + 1
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if likely ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACKET:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return count


def json_count_object_fields_after_ws(cursor: mutable JsonCursor&) -> i64:
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        return 0

    count: mutable i64 = 0
    done: mutable bool = false
    while not done:
        key: i64 = json_parse_string(cursor)
        if key < 0:
            return -1
        json_skip_ws(cursor)
        if json_advance_char(cursor) != JSON_CH_COLON:
            return -1

        json_skip_ws(cursor)
        value: i64 = json_parse_value_after_ws(cursor)
        if value < 0:
            return -1
        count <- count + 1
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if likely ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACE:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return count


def json_parse_array(cursor: mutable JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACKET:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        return 43

    total: mutable i64 = 43
    done: mutable bool = false
    while not done:
        item: i64 = json_parse_value_after_ws(cursor)
        if item < 0:
            return -1
        total <- total + item
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if likely ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACKET:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_object(cursor: mutable JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACE:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        return 47

    total: mutable i64 = 47
    done: mutable bool = false
    while not done:
        key: i64 = json_parse_string(cursor)
        if key < 0:
            return -1
        total <- total + key
        json_skip_ws(cursor)
        if json_advance_char(cursor) != JSON_CH_COLON:
            return -1

        json_skip_ws(cursor)
        value: i64 = json_parse_value_after_ws(cursor)
        if value < 0:
            return -1
        total <- total + value
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if likely ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACE:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_true(cursor: mutable JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "true".cast[u8&], 4):
        return 31
    return -1


def json_parse_false(cursor: mutable JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "false".cast[u8&], 5):
        return 37
    return -1


def json_parse_null(cursor: mutable JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "null".cast[u8&], 4):
        return 41
    return -1


def json_empty_node_view() -> dview[JsonNode]:
    return DynArrayView(null, 0, sizeof(JsonNode))


def json_empty_field_view() -> dview[JsonField]:
    return DynArrayView(null, 0, sizeof(JsonField))


def json_node_items_view(items_ptr: JsonNode&?, item_count: usize) -> dview[JsonNode]:
    if items_ptr == null or item_count == 0:
        return json_empty_node_view()
    return DynArrayView(items_ptr.cast[void&], item_count, sizeof(JsonNode))


def json_field_items_view(fields_ptr: JsonField&?, field_count: usize) -> dview[JsonField]:
    if fields_ptr == null or field_count == 0:
        return json_empty_field_view()
    return DynArrayView(fields_ptr.cast[void&], field_count, sizeof(JsonField))


def json_ast_array_items_view(node: JsonNode, store: JsonNode.Store[Local]) -> dview[JsonNode]:
    if node in store as JsonNode.Array(items_ptr: items_ptr, item_count: item_count):
        return json_node_items_view(items_ptr, item_count)
    return json_empty_node_view()


def json_ast_object_fields_view(node: JsonNode, store: JsonNode.Store[Local]) -> dview[JsonField]:
    if node in store as JsonNode.Object(fields_ptr: fields_ptr, field_count: field_count):
        return json_field_items_view(fields_ptr, field_count)
    return json_empty_field_view()


def json_node_view_ref(items: dview[JsonNode], index: usize) -> JsonNode&:
    assert index < items.len
    assert items.data != null
    return (items.data.cast[u8&] + index * items.elem_size).cast[JsonNode&]


def json_field_view_ref(fields: dview[JsonField], index: usize) -> JsonField&:
    assert index < fields.len
    assert fields.data != null
    return (fields.data.cast[u8&] + index * fields.elem_size).cast[JsonField&]


def json_node_copy_ref(node_ref: JsonNode&) -> JsonNode:
    out: mutable JsonNode = zeroed
    arena_memcpy(out.ref[void&], node_ref.cast[void&], sizeof(JsonNode))
    return move out


def json_field_key_ref(field_ref: JsonField&) -> JsonNode&:
    return field_ref.cast[JsonNode&]


def json_field_value_ref(field_ref: JsonField&) -> JsonNode&:
    return (field_ref.cast[u8&] + sizeof(JsonNode)).cast[JsonNode&]


def json_invalid_array_iter_cursor() -> JsonAstArrayIterCursor:
    return JsonAstArrayIterCursor(json_empty_node_view(), 0)


def json_invalid_object_iter_cursor() -> JsonAstObjectIterCursor:
    return JsonAstObjectIterCursor(json_empty_field_view(), 0)


def json_ast_array_iter_is_valid(cursor: JsonAstArrayIterCursor) -> bool:
    return cursor.index < cursor.items.len


def json_ast_object_iter_is_valid(cursor: JsonAstObjectIterCursor) -> bool:
    return cursor.index < cursor.fields.len


def json_node_invalid(store: JsonNode.Store[Local]) -> JsonNode:
    return JsonNode.Invalid


def json_node_store_words(store: JsonNode.Store[Local]&) -> uintptr&:
    return store.cast[u8&].cast[uintptr&]


def json_node_store_row_bytes(store: JsonNode.Store[Local]&) -> usize:
    return json_node_store_words(store)[1].usize()


def json_node_store_state_bits(store: JsonNode.Store[Local]&) -> uintptr:
    return json_node_store_words(store)[2]


def json_node_store_reserve(arena: mutable Arena&, store: JsonNode.Store[Local]&, needed_rows: usize):
    can Memory.Allocate, Abort.Panic:
        state_bits: uintptr = json_node_store_state_bits(store)
        if state_bits == 0.uintptr():
            return
        ctx_packed_store_reserve(arena, needed_rows, state_bits.cast[u8&].cast[void&])


def json_node_null(store: JsonNode.Store[Local]) -> JsonNode:
    return JsonNode.Null


def json_node_is_invalid(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Invalid:
        return true
    return false


def json_parse_node_result(node: JsonNode, checksum: i64) -> JsonParseNodeResult:
    return JsonParseNodeResult(node, checksum)


def json_reduce_sum_bias(value: i64, bias: i64) -> i64:
    return value + bias


def json_reduce_sum_smoke(values: darray[i64, 4], bias: i64) -> i64:
    base: dview[i64] = values[0:4]
    return reduce_sum(readonly(base), json_reduce_sum_bias, bias)


def json_ast_nodes_count(items: dview[JsonNode], store: JsonNode.Store[Local]) -> i64:
    readonly_items: dview[JsonNode] = readonly(items)
    total: mutable i64 = 0
    for index in 0..<readonly_items.len:
        item: mutable JsonNode = zeroed
        arena_memcpy(item.ref[void&], json_node_view_ref(readonly_items, index).cast[void&], sizeof(JsonNode))
        item_count: i64 = json_ast_node_count(item, store)
        if item_count < 0:
            return -1
        total <- total + item_count

    return total


def json_ast_fields_count(fields: dview[JsonField], store: JsonNode.Store[Local]) -> i64:
    readonly_fields: dview[JsonField] = readonly(fields)
    total: mutable i64 = 0
    for index in 0..<readonly_fields.len:
        field_ref: JsonField& = json_field_view_ref(readonly_fields, index)
        key_node: mutable JsonNode = zeroed
        value_node: mutable JsonNode = zeroed
        arena_memcpy(key_node.ref[void&], field_ref.cast[void&], sizeof(JsonNode))
        arena_memcpy(value_node.ref[void&], (field_ref.cast[u8&] + sizeof(JsonNode)).cast[void&], sizeof(JsonNode))
        key_count: i64 = json_ast_node_count(key_node, store)
        if key_count < 0:
            return -1
        value_count: i64 = json_ast_node_count(value_node, store)
        if value_count < 0:
            return -1
        total <- total + key_count + value_count

    return total


def json_ast_count_or_invalid(count: i64) -> i64:
    return -1 if count < 0 else 1 + count


def json_ast_node_count(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if json_node_is_invalid(node, store):
        return -1

    array_len: i64 = json_ast_array_len(node, store)
    if array_len >= 0:
        items_total: mutable i64 = 0
        cursor: mutable JsonAstArrayIterCursor = json_ast_array_iter_first(node, store)
        while json_ast_array_iter_is_valid(cursor):
            child_count: i64 = json_ast_node_count(json_ast_array_iter_value(cursor, store), store)
            if child_count < 0:
                return -1
            items_total <- items_total + child_count
            cursor <- json_ast_array_iter_next(cursor, store)
        return 1 + items_total

    object_len: i64 = json_ast_object_len(node, store)
    if object_len >= 0:
        fields_total: mutable i64 = 0
        cursor: mutable JsonAstObjectIterCursor = json_ast_object_iter_first(node, store)
        while json_ast_object_iter_is_valid(cursor):
            key_count: i64 = json_ast_node_count(json_ast_object_iter_key(cursor, store), store)
            if key_count < 0:
                return -1
            value_count: i64 = json_ast_node_count(json_ast_object_iter_value(cursor, store), store)
            if value_count < 0:
                return -1
            fields_total <- fields_total + key_count + value_count
            cursor <- json_ast_object_iter_next(cursor, store)
        return 1 + fields_total

    return 1


def json_parse_string_node(cursor: mutable JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    lexeme: JsonLexemeResult = json_parse_string_lexeme(cursor)
    checksum: i64 = lexeme.checksum
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    return json_parse_node_result(JsonNode.Text(source_offset: lexeme.source_offset.u32()), checksum)


def json_parse_number_node(cursor: mutable JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    lexeme: JsonLexemeResult = json_parse_number_lexeme(cursor)
    checksum: i64 = lexeme.checksum
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    return json_parse_node_result(JsonNode.Num(source_offset: lexeme.source_offset.u32()), checksum)


def json_parse_true_node(cursor: mutable JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_true(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    return json_parse_node_result(JsonNode.Bool(value: true), checksum)


def json_parse_false_node(cursor: mutable JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_false(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    return json_parse_node_result(JsonNode.Bool(value: false), checksum)


def json_parse_null_node(cursor: mutable JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_null(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    return json_parse_node_result(JsonNode.Null, checksum)


def json_parse_value_node_after_ws(cursor: mutable JsonCursor&, arena: mutable Arena&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    can Memory.Allocate, Abort.Panic:
        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_DQUOTE:
            return json_parse_string_node(cursor, store, invalid_node)
        if ch == JSON_CH_LBRACE:
            return json_parse_object_node(cursor, arena, store, invalid_node)
        if ch == JSON_CH_LBRACKET:
            return json_parse_array_node(cursor, arena, store, invalid_node)
        if ch == JSON_CH_t:
            return json_parse_true_node(cursor, store, invalid_node)
        if ch == JSON_CH_f:
            return json_parse_false_node(cursor, store, invalid_node)
        if ch == JSON_CH_n:
            return json_parse_null_node(cursor, store, invalid_node)
        if ch == JSON_CH_MINUS or json_is_digit(ch):
            return json_parse_number_node(cursor, store, invalid_node)
        return JsonParseNodeResult(invalid_node, -1)


def json_parse_array_node(cursor: mutable JsonCursor&, arena: mutable Arena&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    can Memory.Allocate, Abort.Panic:
        in arena:
            items: mutable darray[JsonNode] = []
            done: mutable bool = false
            items_checksum: mutable i64 = 0
            if json_advance_char(cursor) != JSON_CH_LBRACKET:
                return json_parse_node_result(invalid_node, -1)

            json_skip_ws(cursor)
            if json_cur_char(cursor) == JSON_CH_RBRACKET:
                _ = json_advance_char(cursor)
                return json_parse_node_result(JsonNode.Array(items_ptr: null, item_count: 0), 43)

            while not done:
                value_result: JsonParseNodeResult = json_parse_value_node_after_ws(cursor, arena, store, invalid_node)
                if value_result.checksum < 0:
                    return value_result

                items.push(value_result.node)
                items_checksum <- items_checksum + value_result.checksum

                json_skip_ws(cursor)
                ch: i64 = json_cur_char(cursor)
                if likely ch == JSON_CH_COMMA:
                    _ = json_advance_char(cursor)
                    json_skip_ws(cursor)
                elif ch == JSON_CH_RBRACKET:
                    _ = json_advance_char(cursor)
                    done <- true
                else:
                    return json_parse_node_result(invalid_node, -1)

            return json_parse_node_result(JsonNode.Array(items_ptr: items.items, item_count: items.count), 43 + items_checksum)


def json_parse_object_node(cursor: mutable JsonCursor&, arena: mutable Arena&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    can Memory.Allocate, Abort.Panic:
        in arena:
            fields: mutable darray[JsonField] = []
            done: mutable bool = false
            fields_checksum: mutable i64 = 0
            key_lexeme: mutable JsonLexemeResult = zeroed
            key_checksum: mutable i64 = 0
            key_node: mutable JsonNode = zeroed
            field_value: mutable JsonNode = zeroed
            field_entry: mutable JsonField = zeroed
            if json_advance_char(cursor) != JSON_CH_LBRACE:
                return json_parse_node_result(invalid_node, -1)

            json_skip_ws(cursor)
            if json_cur_char(cursor) == JSON_CH_RBRACE:
                _ = json_advance_char(cursor)
                return json_parse_node_result(JsonNode.Object(fields_ptr: null, field_count: 0), 47)

            while not done:
                key_lexeme <- json_parse_string_lexeme(cursor)
                key_checksum <- key_lexeme.checksum
                if key_checksum < 0:
                    return JsonParseNodeResult(invalid_node, -1)

                key_node <- JsonNode.Text(source_offset: key_lexeme.source_offset.u32())

                json_skip_ws(cursor)
                if json_advance_char(cursor) != JSON_CH_COLON:
                    return JsonParseNodeResult(invalid_node, -1)
                json_skip_ws(cursor)

                value_result: JsonParseNodeResult = json_parse_value_node_after_ws(cursor, arena, store, invalid_node)
                if value_result.checksum < 0:
                    return value_result

                field_value <- value_result.node
                field_entry <- JsonField(key_node, field_value)
                fields.push(field_entry)
                fields_checksum <- fields_checksum + key_checksum + value_result.checksum

                json_skip_ws(cursor)
                ch: i64 = json_cur_char(cursor)
                if likely ch == JSON_CH_COMMA:
                    _ = json_advance_char(cursor)
                    json_skip_ws(cursor)
                elif ch == JSON_CH_RBRACE:
                    _ = json_advance_char(cursor)
                    done <- true
                else:
                    return JsonParseNodeResult(invalid_node, -1)

            return json_parse_node_result(JsonNode.Object(fields_ptr: fields.items, field_count: fields.count), 47 + fields_checksum)


def json_parse_value_node(cursor: mutable JsonCursor&, arena: mutable Arena&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    can Memory.Allocate, Abort.Panic:
        json_skip_ws(cursor)
        return json_parse_value_node_after_ws(cursor, arena, store, invalid_node)


def json_parse_value(cursor: mutable JsonCursor&) -> i64:
    json_skip_ws(cursor)
    return json_parse_value_after_ws(cursor)


def json_empty_view() -> sview:
    return string_view("".cast[u8&], 0, 0)


def json_invalid_number_value() -> JsonNumberValue:
    return JsonNumberValue(JsonNumberKind.INVALID, 0, 0)


def json_abs_f64(value: f64) -> f64:
    return -value if value < 0.0 else value


def json_number_has_nonzero_digit(source: u8&, source_offset: usize, source_len: usize) -> bool:
    pos: mutable usize = source_offset
    end: usize = source_offset + source_len
    while pos < end:
        ch: i64 = source[pos].i64()
        if ch >= JSON_CH_1 and ch <= JSON_CH_9:
            return true
        pos <- pos + 1
    return false


def json_parse_number_f64_value(source: u8&, source_offset: usize, source_len: usize) -> f64 error[JsonNumberAccessError]:
    if source_len == 0:
        raise JsonNumberAccessError.Invalid

    return strtod(source + source_offset, null)


def json_parse_number_f32_value(source: u8&, source_offset: usize, source_len: usize) -> f32 error[JsonNumberAccessError]:
    parsed: f64 = try json_parse_number_f64_value(source, source_offset, source_len)
    return parsed.f32()


def json_ast_text_lexeme(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonLexemeResult:
    if node in store as JsonNode.Text(source_offset: off):
        return json_parse_string_lexeme_at(source, source_len, off)
    return json_invalid_lexeme()


def json_ast_number_lexeme(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonLexemeResult:
    if node in store as JsonNode.Num(source_offset: off):
        return json_parse_number_lexeme_at(source, source_len, off)
    return json_invalid_lexeme()


def json_ast_is_number_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Num:
        return true
    return false


def json_ast_is_text_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Text:
        return true
    return false


def json_ast_is_array_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Array:
        return true
    return false


def json_ast_is_object_node(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Object:
        return true
    return false


def json_ast_kind(node: JsonNode, store: JsonNode.Store[Local]) -> JsonNodeKind:
    if json_node_is_invalid(node, store):
        return JsonNodeKind.INVALID
    if json_ast_is_null(node, store):
        return JsonNodeKind.NULL
    if json_ast_bool_value(node, store) >= 0:
        return JsonNodeKind.BOOL
    if json_ast_is_number_node(node, store):
        return JsonNodeKind.NUMBER
    if json_ast_is_text_node(node, store):
        return JsonNodeKind.STRING
    if json_ast_is_array_node(node, store):
        return JsonNodeKind.ARRAY
    if json_ast_is_object_node(node, store):
        return JsonNodeKind.OBJECT
    return JsonNodeKind.INVALID


def json_ast_kind_code(kind: JsonNodeKind) -> i64:
    if kind == JsonNodeKind.NULL:
        return 0
    if kind == JsonNodeKind.BOOL:
        return 1
    if kind == JsonNodeKind.NUMBER:
        return 2
    if kind == JsonNodeKind.STRING:
        return 3
    if kind == JsonNodeKind.ARRAY:
        return 4
    if kind == JsonNodeKind.OBJECT:
        return 5
    return -1


def json_ast_number_kind_code(kind: JsonNumberKind) -> i64:
    if kind == JsonNumberKind.UNSIGNED:
        return 0
    if kind == JsonNumberKind.SIGNED:
        return 1
    if kind == JsonNumberKind.NON_INTEGRAL:
        return 2
    if kind == JsonNumberKind.OUT_OF_RANGE:
        return 3
    return -1


def json_ast_source_view_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    text_lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if text_lexeme.checksum >= 0:
        start: i64 = text_lexeme.source_offset.i64()
        return string_view(source, start, start + text_lexeme.source_len.i64())
    number_lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if number_lexeme.checksum >= 0:
        start: i64 = number_lexeme.source_offset.i64()
        return string_view(source, start, start + number_lexeme.source_len.i64())
    return json_empty_view()


def json_ast_source_view(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    return json_ast_source_view_with_len(source, runtime_strlen(source), node, store)


def json_ast_string_view_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        if lexeme.source_len < 2:
            return json_empty_view()
        start: i64 = lexeme.source_offset.i64() + 1
        return string_view(source, start, start + (lexeme.source_len - 2).i64())
    return json_empty_view()


def json_ast_string_view(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    return json_ast_string_view_with_len(source, runtime_strlen(source), node, store)


def json_ast_string_value_from_span(source: u8&, source_offset: usize, source_len: usize) -> heap u8&:
    can Memory.Allocate, Abort.Panic:
        decoded_len: i64 = json_decoded_string_len(source, source_offset, source_len)
        if decoded_len < 0:
            return intern_small_string("".cast[u8&], 0)

        if decoded_len <= 8:
            text: u8[9] = zeroed
            written: i64 = json_decode_string_into(source, source_offset, source_len, text[0].ref[u8&])
            if written < 0:
                return intern_small_string("".cast[u8&], 0)
            text[written.usize()] <- 0
            return intern_small_string(text[0].ref[u8&], written.usize())

        out: heap u8& = alloc_perm((decoded_len + 1).i64()).cast[heap u8&]
        written: i64 = json_decode_string_into(source, source_offset, source_len, out.cast[u8&])
        if written < 0:
            return intern_small_string("".cast[u8&], 0)
        out[written.usize()] <- 0
        register_perm_string_len(out.cast[u8&], written.usize())
        return out


def json_ast_string_is_escaped_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if lexeme.checksum < 0:
        return false
    return json_string_has_escape(source, lexeme.source_offset, lexeme.source_len)


def json_ast_string_is_escaped(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    return json_ast_string_is_escaped_with_len(source, runtime_strlen(source), node, store)


def json_ast_string_len_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return json_decoded_string_len(source, lexeme.source_offset, lexeme.source_len)
    return -1


def json_ast_string_len(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    return json_ast_string_len_with_len(source, runtime_strlen(source), node, store)


def json_ast_string_copy_with_len(source: u8&, source_len: usize, node: JsonNode, out: u8&, capacity: usize, store: JsonNode.Store[Local]) -> i64:
    lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        decoded_len: i64 = json_decoded_string_len(source, lexeme.source_offset, lexeme.source_len)
        if decoded_len < 0:
            return -1
        required_capacity: usize = decoded_len.usize() + 1
        if capacity < required_capacity:
            return decoded_len
        written: i64 = json_decode_string_into(source, lexeme.source_offset, lexeme.source_len, out)
        if written < 0:
            return -1
        out[written.usize()] <- 0
        return written
    return -1


def json_ast_string_copy(source: u8&, node: JsonNode, out: u8&, capacity: usize, store: JsonNode.Store[Local]) -> i64:
    return json_ast_string_copy_with_len(source, runtime_strlen(source), node, out, capacity, store)


def json_ast_number_view_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        start: i64 = lexeme.source_offset.i64()
        return string_view(source, start, start + lexeme.source_len.i64())
    return json_empty_view()


def json_ast_number_view(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> sview:
    return json_ast_number_view_with_len(source, runtime_strlen(source), node, store)


def json_number_has_fraction_or_exponent(source: u8&, source_offset: usize, source_len: usize) -> bool:
    pos: mutable usize = source_offset
    end: usize = source_offset + source_len
    while pos < end:
        ch: i64 = source[pos].i64()
        if ch == JSON_CH_DOT or ch == JSON_CH_E or ch == JSON_CH_e:
            return true
        pos <- pos + 1
    return false


def json_parse_u64_digits(source: u8&, source_offset: usize, source_end: usize) -> u64 error[JsonNumberAccessError]:
    if source_offset >= source_end:
        raise JsonNumberAccessError.Invalid

    max_div10: u64 = 1844674407370955161
    max_mod10: u64 = 5
    value: mutable u64 = 0
    pos: mutable usize = source_offset
    while pos < source_end:
        ch: i64 = source[pos].i64()
        if not json_is_digit(ch):
            raise JsonNumberAccessError.Invalid

        digit: u64 = (ch - JSON_CH_0).u64()
        if value > max_div10 or (value == max_div10 and digit > max_mod10):
            raise JsonNumberAccessError.Invalid

        value <- value * 10 + digit
        pos <- pos + 1

    return value


def json_u64_digits_exceed_max(source: u8&, source_offset: usize, source_end: usize) -> bool:
    digit_count: usize = source_end - source_offset
    if digit_count < 20:
        return false
    if digit_count > 20:
        return true

    max_digits: u8& = "18446744073709551615".cast[u8&]
    pos: mutable usize = source_offset
    max_pos: mutable usize = 0
    while pos < source_end:
        digit: i64 = source[pos].i64()
        max_digit: i64 = max_digits[max_pos].i64()
        if digit < max_digit:
            return false
        if digit > max_digit:
            return true
        pos <- pos + 1
        max_pos <- max_pos + 1
    return false


def json_parse_number_value(source: u8&, source_offset: usize, source_len: usize) -> JsonNumberValue:
    if source_len == 0:
        return json_invalid_number_value()

    i64_max_u64: u64 = 9223372036854775807
    i64_min_abs_u64: u64 = 9223372036854775808
    if json_number_has_fraction_or_exponent(source, source_offset, source_len):
        return JsonNumberValue(JsonNumberKind.NON_INTEGRAL, 0, 0)

    negative: bool = source[source_offset].i64() == JSON_CH_MINUS
    digits_offset: mutable usize = source_offset
    if negative:
        digits_offset <- digits_offset + 1

    digits_end: usize = source_offset + source_len
    if json_u64_digits_exceed_max(source, digits_offset, digits_end):
        return JsonNumberValue(JsonNumberKind.OUT_OF_RANGE, 0, 0)

    parsed: u64 = try json_parse_u64_digits(source, digits_offset, digits_end) else 0

    magnitude: u64 = parsed
    if negative:
        if magnitude > i64_min_abs_u64:
            return JsonNumberValue(JsonNumberKind.OUT_OF_RANGE, 0, 0)
        if magnitude == i64_min_abs_u64:
            min_value: i64 = -9223372036854775807 - 1
            return JsonNumberValue(JsonNumberKind.SIGNED, 0, min_value)
        return JsonNumberValue(JsonNumberKind.SIGNED, 0, -magnitude.i64())

    signed_value: mutable i64 = 0
    if magnitude <= i64_max_u64:
        signed_value <- magnitude.i64()
    return JsonNumberValue(JsonNumberKind.UNSIGNED, magnitude, signed_value)


def json_ast_number_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberValue:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return json_parse_number_value(source, lexeme.source_offset, lexeme.source_len)
    return json_invalid_number_value()


def json_ast_number_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberValue:
    return json_ast_number_value_with_len(source, runtime_strlen(source), node, store)


def json_ast_number_kind_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberKind:
    return json_ast_number_value_with_len(source, source_len, node, store).kind


def json_ast_number_kind(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> JsonNumberKind:
    return json_ast_number_value(source, node, store).kind


def json_ast_number_is_integral(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    kind: JsonNumberKind = json_ast_number_kind(source, node, store)
    return kind == JsonNumberKind.UNSIGNED or kind == JsonNumberKind.SIGNED


def json_ast_number_u64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> u64 error[JsonNumberAccessError]:
    value: JsonNumberValue = json_ast_number_value(source, node, store)
    if value.kind == JsonNumberKind.UNSIGNED:
        return value.unsigned_value
    raise JsonNumberAccessError.Invalid


def json_ast_number_i64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> i64 error[JsonNumberAccessError]:
    value: JsonNumberValue = json_ast_number_value(source, node, store)
    i64_max_u64: u64 = 9223372036854775807
    if value.kind == JsonNumberKind.SIGNED:
        return value.signed_value
    if value.kind == JsonNumberKind.UNSIGNED and value.unsigned_value <= i64_max_u64:
        return value.unsigned_value.i64()
    raise JsonNumberAccessError.Invalid


def json_ast_number_f64_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> f64 error[JsonNumberAccessError]:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return try json_parse_number_f64_value(source, lexeme.source_offset, lexeme.source_len)
    raise JsonNumberAccessError.Invalid


def json_ast_number_f64_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> f64 error[JsonNumberAccessError]:
    return try json_ast_number_f64_value_with_len(source, runtime_strlen(source), node, store)


def json_ast_number_f32_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> f32 error[JsonNumberAccessError]:
    lexeme: JsonLexemeResult = json_ast_number_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return try json_parse_number_f32_value(source, lexeme.source_offset, lexeme.source_len)
    raise JsonNumberAccessError.Invalid


def json_ast_number_f32_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> f32 error[JsonNumberAccessError]:
    return try json_ast_number_f32_value_with_len(source, runtime_strlen(source), node, store)


def json_number_value_can_materialize_u64(value: JsonNumberValue) -> bool:
    return value.kind == JsonNumberKind.UNSIGNED


def json_number_value_can_materialize_i64(value: JsonNumberValue) -> bool:
    i64_max_u64: u64 = 9223372036854775807
    return value.kind == JsonNumberKind.SIGNED or (value.kind == JsonNumberKind.UNSIGNED and value.unsigned_value <= i64_max_u64)


def json_node_can_materialize_float(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Num:
        return true
    return false


def json_ast_string_value_with_len(source: u8&, source_len: usize, node: JsonNode, store: JsonNode.Store[Local]) -> heap u8&:
    can Memory.Allocate, Abort.Panic:
        lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
        if lexeme.checksum >= 0:
            return json_ast_string_value_from_span(source, lexeme.source_offset, lexeme.source_len)
        return intern_small_string("".cast[u8&], 0)


def json_ast_string_value(source: u8&, node: JsonNode, store: JsonNode.Store[Local]) -> heap u8&:
    return json_ast_string_value_with_len(source, runtime_strlen(source), node, store) can Memory.Allocate, Abort.Panic


def json_ast_string_eq_literal_with_len(source: u8&, source_len: usize, node: JsonNode, literal: u8&, store: JsonNode.Store[Local]) -> bool:
    lexeme: JsonLexemeResult = json_ast_text_lexeme(source, source_len, node, store)
    if lexeme.checksum >= 0:
        return json_string_matches_literal(source, lexeme.source_offset, lexeme.source_len, literal)
    return false


def json_ast_string_eq_literal(source: u8&, node: JsonNode, literal: u8&, store: JsonNode.Store[Local]) -> bool:
    return json_ast_string_eq_literal_with_len(source, runtime_strlen(source), node, literal, store)


def json_ast_bool_value(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store as JsonNode.Bool(value: value):
        return 1 if value else 0
    return -1


def json_ast_is_null(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    if node in store as JsonNode.Null:
        return true
    return false


def json_ast_array_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store as JsonNode.Array(items_ptr: _, item_count: item_count):
        return item_count.i64()
    return -1


def json_ast_object_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    if node in store as JsonNode.Object(fields_ptr: _, field_count: field_count):
        return field_count.i64()
    return -1


def json_ast_array_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    items: dview[JsonNode] = json_ast_array_items_view(node, store)
    if index < items.len:
        return json_node_view_ref(items, index)
    return null


def json_ast_array_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_array_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_array_iter_first(node: JsonNode, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    items: dview[JsonNode] = json_ast_array_items_view(node, store)
    if items.len > 0:
        return JsonAstArrayIterCursor(items, 0)
    return json_invalid_array_iter_cursor()


def json_ast_array_iter_value_ref(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_array_iter_is_valid(cursor):
        return null
    return json_node_view_ref(cursor.items, cursor.index)


def json_ast_array_iter_value(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_array_iter_value_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_array_iter_next(cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    if json_ast_array_iter_is_valid(cursor) and cursor.index + 1 < cursor.items.len:
        return JsonAstArrayIterCursor(cursor.items, cursor.index + 1)
    return json_invalid_array_iter_cursor()


def json_ast_object_get_ref(node: JsonNode, source: u8&, key: u8&, store: JsonNode.Store[Local]) -> JsonNode&?:
    readonly_fields: dview[JsonField] = json_ast_object_fields_view(node, store)
    for index in 0..<readonly_fields.len:
        field_ref: JsonField& = json_field_view_ref(readonly_fields, index)
        key_node: JsonNode = json_node_copy_ref(json_field_key_ref(field_ref))
        if json_ast_string_eq_literal(source, key_node, key, store):
            return json_field_value_ref(field_ref)
    return null


def json_ast_object_get(node: JsonNode, source: u8&, key: u8&, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_get_ref(node, source, key, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_object_iter_first(node: JsonNode, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    fields: dview[JsonField] = json_ast_object_fields_view(node, store)
    if fields.len > 0:
        return JsonAstObjectIterCursor(fields, 0)
    return json_invalid_object_iter_cursor()


def json_ast_object_iter_key_ref(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_object_iter_is_valid(cursor):
        return null
    field_ref: JsonField& = json_field_view_ref(cursor.fields, cursor.index)
    return json_field_key_ref(field_ref)


def json_ast_object_iter_key(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_iter_key_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_object_iter_value_ref(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode&?:
    if not json_ast_object_iter_is_valid(cursor):
        return null
    field_ref: JsonField& = json_field_view_ref(cursor.fields, cursor.index)
    return json_field_value_ref(field_ref)


def json_ast_object_iter_value(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_iter_value_ref(cursor, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_object_iter_next(cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    if json_ast_object_iter_is_valid(cursor) and cursor.index + 1 < cursor.fields.len:
        return JsonAstObjectIterCursor(cursor.fields, cursor.index + 1)
    return json_invalid_object_iter_cursor()


def json_ast_array_iter_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonAstArrayIterCursor:
    items: dview[JsonNode] = json_ast_array_items_view(node, store)
    if index < items.len:
        return JsonAstArrayIterCursor(items, index)
    return json_invalid_array_iter_cursor()


def json_ast_object_iter_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonAstObjectIterCursor:
    fields: dview[JsonField] = json_ast_object_fields_view(node, store)
    if index < fields.len:
        return JsonAstObjectIterCursor(fields, index)
    return json_invalid_object_iter_cursor()


def json_ast_object_key_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    return json_ast_object_iter_key_ref(json_ast_object_iter_nth(node, index, store), store)


def json_ast_object_key_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_key_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_ast_object_value_nth_ref(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode&?:
    return json_ast_object_iter_value_ref(json_ast_object_iter_nth(node, index, store), store)


def json_ast_object_value_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    node_ref: JsonNode&? = json_ast_object_value_nth_ref(node, index, store)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    return json_node_invalid(store)


def json_parser_checksum_impl(source: u8&) -> i64:
    cursor: mutable JsonCursor = json_new_cursor(source)
    checksum: i64 = json_parse_value(cursor.ref[mutable JsonCursor&])
    if checksum < 0:
        return -1
    json_skip_ws(cursor.ref[mutable JsonCursor&])
    if cursor.pos != cursor.source_len:
        return -1
    return checksum


def json_parse_document_node_with_len(source: u8&, source_len: usize, arena: mutable Arena&, store: JsonNode.Store[Local]) -> JsonParseNodeResult:
    can Memory.Allocate, Abort.Panic:
        invalid_node: JsonNode = json_node_invalid(store)
        if source_len > JSON_MAX_INLINE_SOURCE_OFFSET.usize():
            return json_parse_node_result(invalid_node, -1)
        cursor: mutable JsonCursor = json_new_cursor_with_len(source, source_len)
        result: JsonParseNodeResult = json_parse_value_node(cursor.ref[mutable JsonCursor&], arena, store, invalid_node)
        if result.checksum < 0:
            return result
        json_skip_ws(cursor.ref[mutable JsonCursor&])
        if cursor.pos != cursor.source_len:
            return json_parse_node_result(invalid_node, -1)
        return result


def json_parse_document_node(source: u8&, arena: mutable Arena&, store: JsonNode.Store[Local]) -> JsonParseNodeResult:
    return json_parse_document_node_with_len(source, runtime_strlen(source), arena, store) can Memory.Allocate, Abort.Panic


def json_ast_scratch_capacity(source_len: usize) -> usize:
    slots_per_byte_budget: usize = 2
    capacity: usize = source_len * slots_per_byte_budget + 1024
    return max(capacity, ARENA_REGION_DEFAULT_CAPACITY)


def json_ast_estimated_node_reserve(source_len: usize) -> usize:
    estimated_rows: usize = source_len / 12 + 64
    return max(estimated_rows, ARENA_DA_INIT_CAP)


def json_parser_document_null() -> JsonParserDocument:
    return JsonParserDocument(0.uintptr())


def json_parser_value_null() -> JsonParserValue:
    out: mutable JsonParserValue = zeroed
    return move out


def json_parser_array_iter_null() -> JsonParserArrayIter:
    out: mutable JsonParserArrayIter = zeroed
    return move out


def json_parser_object_iter_null() -> JsonParserObjectIter:
    out: mutable JsonParserObjectIter = zeroed
    return move out


def json_parser_value_is_live(value: JsonParserValue&) -> bool:
    return value[0].impl_bits != 0.uintptr() and value[0].node_ptr != null


def json_parser_array_iter_is_live(iter: JsonParserArrayIter&) -> bool:
    return iter[0].impl_bits != 0.uintptr()


def json_parser_array_iter_doc_impl(iter: JsonParserArrayIter&) -> heap JsonParserDocumentInternal&:
    return iter[0].impl_bits.cast[heap JsonParserDocumentInternal&]


def json_parser_array_iter_cursor(iter: JsonParserArrayIter&) -> JsonAstArrayIterCursor:
    if not json_parser_array_iter_is_live(iter):
        return json_invalid_array_iter_cursor()
    items: dview[JsonNode] = json_node_items_view(iter[0].items_ptr.cast[JsonNode&?], iter[0].item_count)
    if iter[0].index < items.len:
        return JsonAstArrayIterCursor(items, iter[0].index)
    return json_invalid_array_iter_cursor()


def json_parser_object_iter_is_live(iter: JsonParserObjectIter&) -> bool:
    return iter[0].impl_bits != 0.uintptr()


def json_parser_object_iter_doc_impl(iter: JsonParserObjectIter&) -> heap JsonParserDocumentInternal&:
    return iter[0].impl_bits.cast[heap JsonParserDocumentInternal&]


def json_parser_object_iter_cursor(iter: JsonParserObjectIter&) -> JsonAstObjectIterCursor:
    if not json_parser_object_iter_is_live(iter):
        return json_invalid_object_iter_cursor()
    fields: dview[JsonField] = json_field_items_view(iter[0].fields_ptr.cast[JsonField&?], iter[0].field_count)
    if iter[0].index < fields.len:
        return JsonAstObjectIterCursor(fields, iter[0].index)
    return json_invalid_object_iter_cursor()


def json_parser_value_doc_impl(value: JsonParserValue&) -> heap JsonParserDocumentInternal&:
    return value[0].impl_bits.cast[heap JsonParserDocumentInternal&]


def json_parser_value_node_ref(value: JsonParserValue&) -> JsonNode&?:
    return value[0].node_ptr.cast[JsonNode&?]


def json_parser_value_node(value: JsonParserValue&) -> JsonNode:
    node_ref: JsonNode&? = json_parser_value_node_ref(value)
    if node_ref != null:
        return json_node_copy_ref(node_ref.cast[JsonNode&])
    out: mutable JsonNode = zeroed
    return move out


def json_parser_value_from_node_ref(impl: heap JsonParserDocumentInternal&, node_ref: JsonNode&?) -> JsonParserValue:
    can Memory.Allocate, Abort.Panic:
        if node_ref == null:
            return json_parser_value_null()

        out: mutable JsonParserValue = zeroed
        out.impl_bits <- impl.uintptr()
        out.node_ptr <- node_ref.cast[void&?]
        return move out


def json_parser_array_iter_from_cursor(impl: heap JsonParserDocumentInternal&, cursor: JsonAstArrayIterCursor, store: JsonNode.Store[Local]) -> JsonParserArrayIter:
    can Memory.Allocate, Abort.Panic:
        if not json_ast_array_iter_is_valid(cursor):
            return json_parser_array_iter_null()

        out: mutable JsonParserArrayIter = zeroed
        out.impl_bits <- impl.uintptr()
        out.items_ptr <- cursor.items.data
        out.item_count <- cursor.items.len
        out.index <- cursor.index
        return move out


def json_parser_object_iter_from_cursor(impl: heap JsonParserDocumentInternal&, cursor: JsonAstObjectIterCursor, store: JsonNode.Store[Local]) -> JsonParserObjectIter:
    can Memory.Allocate, Abort.Panic:
        if not json_ast_object_iter_is_valid(cursor):
            return json_parser_object_iter_null()

        out: mutable JsonParserObjectIter = zeroed
        out.impl_bits <- impl.uintptr()
        out.fields_ptr <- cursor.fields.data
        out.field_count <- cursor.fields.len
        out.index <- cursor.index
        return move out


def json_parser_document_source(impl: heap JsonParserDocumentInternal&) -> u8&:
    return impl.source


def json_parser_document_source_len(impl: heap JsonParserDocumentInternal&) -> usize:
    return impl.source_len


def json_parser_document_store(impl: heap JsonParserDocumentInternal&) -> JsonNode.Store[Local]:
    store: mutable JsonNode.Store[Local] = zeroed
    words: mutable uintptr& = json_node_store_words(store.ref[JsonNode.Store[Local]&]).cast[mutable uintptr&]
    words[0] <- impl.arena.ref[u8&].uintptr()
    words[1] <- impl.store_row_bytes.uintptr()
    words[2] <- impl.store_state_bits
    return move store


def json_parser_document_field_node(impl: heap JsonParserDocumentInternal&, key: u8&, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_object_get(impl.root, json_parser_document_source(impl), key, store)


def json_parser_document_array_field_item_node(impl: heap JsonParserDocumentInternal&, key: u8&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    array_node: JsonNode = json_parser_document_field_node(impl, key, store)
    if json_node_is_invalid(array_node, store):
        return json_node_invalid(store)
    return json_ast_array_nth(array_node, index, store)


def json_parser_document_object_key_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_object_key_nth(impl.root, index, store)


def json_parser_document_object_value_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_object_value_nth(impl.root, index, store)


def json_parser_document_array_item_node_at(impl: heap JsonParserDocumentInternal&, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    return json_ast_array_nth(impl.root, index, store)


def json_parser_document_parse_with_len_impl(source: u8&, source_len: usize, out: mutable JsonParserDocument&) -> i64:
    can Memory.Allocate, Memory.Release, Abort.Panic:
        if out[0].impl_bits != 0.uintptr():
            json_parser_document_destroy_impl(out)

        if source_len > JSON_MAX_INLINE_SOURCE_OFFSET.usize():
            out[0] <- json_parser_document_null()
            return 0

        internal_words: usize = (sizeof(JsonParserDocumentInternal) + sizeof(uintptr) - 1) / sizeof(uintptr)
        source_words: usize = (source_len + 1 + sizeof(uintptr) - 1) / sizeof(uintptr)

        first_region: heap Region& = new_region(json_ast_scratch_capacity(source_len) + internal_words + source_words)
        first_region.count <- internal_words

        internal: mutable heap JsonParserDocumentInternal& = packed_store_region_data(first_region).cast[mutable heap JsonParserDocumentInternal&]
        arena_owner: mutable Arena = Arena(first_region, first_region, 0)
        source_copy: heap u8& = arena_alloc(arena_owner.ref[mutable Arena&], source_len + 1).cast[heap u8&]
        if source_len > 0:
            memcpy(source_copy.cast[void&], source.cast[void&], source_len)
        source_copy[source_len] <- 0

        arena: mutable Arena& = arena_owner.ref[mutable Arena&]
        store: JsonNode.Store[Local] = JsonNode.Store(arena_owner)
        json_node_store_reserve(arena, store.ref[JsonNode.Store[Local]&], json_ast_estimated_node_reserve(source_len))
        result: JsonParseNodeResult = json_parse_document_node_with_len(source_copy.cast[u8&], source_len, arena, store)
        if result.checksum < 0:
            arena_to_free: mutable Arena = arena_owner
            out[0] <- json_parser_document_null()
            arena_free(arena_to_free.ref[mutable Arena&])
            return 0

        internal.source <- source_copy.cast[u8&]
        internal.source_len <- source_len
        internal.arena <- arena_owner
        internal.store_row_bytes <- json_node_store_row_bytes(store.ref[JsonNode.Store[Local]&])
        internal.store_state_bits <- json_node_store_state_bits(store.ref[JsonNode.Store[Local]&])
        internal.root <- result.node
        internal.checksum <- result.checksum
        out[0] <- JsonParserDocument(internal.uintptr())
        return 1


def json_parser_document_parse_impl(source: u8&, out: mutable JsonParserDocument&) -> i64:
    return json_parser_document_parse_with_len_impl(source, runtime_strlen(source), out) can Memory.Allocate, Memory.Release, Abort.Panic


def json_parser_document_destroy_impl(doc: mutable JsonParserDocument&):
    can Memory.Release, Abort.Panic:
        impl_bits: uintptr = doc[0].impl_bits
        if impl_bits == 0.uintptr():
            return

        impl: heap JsonParserDocumentInternal& = impl_bits.cast[heap JsonParserDocumentInternal&]
        arena_to_free: mutable Arena = impl.arena
