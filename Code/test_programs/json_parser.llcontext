def json_expect_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_checksum_impl(source.cast[u8&]) == expected


def json_expect_invalid(source: static u8&) -> bool:
    return json_parser_checksum_impl(source.cast[u8&]) < 0


def json_expect_ast_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_ast_checksum_impl(source.cast[u8&]) == expected can Memory.Allocate, Abort.Panic


def json_expect_invalid_ast(source: static u8&) -> bool:
    return json_parser_ast_checksum_impl(source.cast[u8&]) < 0 can Memory.Allocate, Abort.Panic


def json_parser_parity_suite_impl() -> int:
    can Memory.Allocate, Abort.Panic:
        if not json_expect_checksum("{}", 47):
            return 0
        if not json_expect_ast_checksum("{}", 47):
            return 0
        if not json_expect_checksum("[]", 43):
            return 0
        if not json_expect_ast_checksum("[]", 43):
            return 0
        if not json_expect_checksum("[1,2,3]", 115):
            return 0
        if not json_expect_ast_checksum("[1,2,3]", 115):
            return 0
        if not json_expect_checksum("[true,false,null]", 152):
            return 0
        if not json_expect_ast_checksum("[true,false,null]", 152):
            return 0
        if not json_expect_checksum("[-12,3.5,null]", 136):
            return 0
        if not json_expect_ast_checksum("[-12,3.5,null]", 136):
            return 0
        if json_parser_ast_node_count_impl("{\"a\":[1,2,3],\"b\":[4,5],\"c\":null}".cast[u8&]) != 12:
            return 0
        if not json_expect_invalid("[1,2}"):
            return 0
        if not json_expect_invalid_ast("[1,2}"):
            return 0
        if not json_expect_invalid("[1,,2]"):
            return 0
        if not json_expect_invalid_ast("[1,,2]"):
            return 0

        if not json_expect_invalid("\"\\q\""):
            return 0
        if not json_expect_invalid_ast("\"\\q\""):
            return 0
        if not json_expect_invalid("\"\\uD83D\""):
            return 0
        if not json_expect_invalid_ast("\"\\uD83D\""):
            return 0
        if not json_expect_invalid("\"\\uDE00\""):
            return 0
        if not json_expect_invalid_ast("\"\\uDE00\""):
            return 0
        if not json_expect_invalid("\"\\uD83D\\u0041\""):
            return 0
        if not json_expect_invalid_ast("\"\\uD83D\\u0041\""):
            return 0

        source: static u8& = "{\"na\\u006de\":\"line\\nbreak\",\"quote\":\"\\\"\",\"smile\":\"\\u263A\"}"
        source_any: u8& = source.cast[u8&]
        source_len: usize = runtime_strlen(source_any)
        region scratch(json_ast_scratch_capacity(source_len))
        store: JsonNode.Store[Local] = JsonNode.Store(scratch)
        arena: mutable Arena& = scratch.ref[mutable Arena&]
        result: JsonParseNodeResult = json_parse_document_node_with_len(source_any, source_len, arena, store)
        if result.checksum < 0:
            destroy scratch
            return 0

        name_node: JsonNode = json_ast_object_get(result.node, source_any, "name".cast[u8&], store)
        quote_node: JsonNode = json_ast_object_get(result.node, source_any, "quote".cast[u8&], store)
        smile_node: JsonNode = json_ast_object_get(result.node, source_any, "smile".cast[u8&], store)
        if json_node_is_invalid(name_node, store) or json_node_is_invalid(quote_node, store) or json_node_is_invalid(smile_node, store):
            destroy scratch
            return 0
        if not json_ast_string_eq_literal(source_any, name_node, "line\nbreak".cast[u8&], store):
            destroy scratch
            return 0
        if not json_ast_string_eq_literal(source_any, quote_node, "\"".cast[u8&], store):
            destroy scratch
            return 0
        if not json_ast_string_eq_literal(source_any, smile_node, "\u263A".cast[u8&], store):
            destroy scratch
            return 0
        destroy scratch

        numbers_source: static u8& = "{\"small\":123,\"big\":18446744073709551615,\"neg\":-9223372036854775808,\"frac\":1.5,\"exp\":1e3,\"huge\":18446744073709551616,\"tiny\":-9223372036854775809}"
        numbers_any: u8& = numbers_source.cast[u8&]
        numbers_len: usize = runtime_strlen(numbers_any)
        region numbers_scratch(json_ast_scratch_capacity(numbers_len))
        numbers_store: JsonNode.Store[Local] = JsonNode.Store(numbers_scratch)
        numbers_arena: mutable Arena& = numbers_scratch.ref[mutable Arena&]
        numbers_result: JsonParseNodeResult = json_parse_document_node_with_len(numbers_any, numbers_len, numbers_arena, numbers_store)
        if numbers_result.checksum < 0:
            destroy numbers_scratch
            return 0

        small_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "small".cast[u8&], numbers_store)
        big_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "big".cast[u8&], numbers_store)
        neg_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "neg".cast[u8&], numbers_store)
        frac_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "frac".cast[u8&], numbers_store)
        exp_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "exp".cast[u8&], numbers_store)
        huge_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "huge".cast[u8&], numbers_store)
        tiny_node: JsonNode = json_ast_object_get(numbers_result.node, numbers_any, "tiny".cast[u8&], numbers_store)

        small_u64: u64 = try json_ast_number_u64_value(numbers_any, small_node, numbers_store) else 0
        small_i64: i64 = try json_ast_number_i64_value(numbers_any, small_node, numbers_store) else -1
        big_u64: u64 = try json_ast_number_u64_value(numbers_any, big_node, numbers_store) else 0
        big_i64: i64 = try json_ast_number_i64_value(numbers_any, big_node, numbers_store) else -7
        neg_u64: u64 = try json_ast_number_u64_value(numbers_any, neg_node, numbers_store) else 7
        neg_i64: i64 = try json_ast_number_i64_value(numbers_any, neg_node, numbers_store) else 0
        frac_value: JsonNumberValue = json_ast_number_value(numbers_any, frac_node, numbers_store)
        exp_value: JsonNumberValue = json_ast_number_value(numbers_any, exp_node, numbers_store)
        huge_value: JsonNumberValue = json_ast_number_value(numbers_any, huge_node, numbers_store)
        tiny_value: JsonNumberValue = json_ast_number_value(numbers_any, tiny_node, numbers_store)

        if small_u64 != 123:
            destroy numbers_scratch
            return 0
        if small_i64 != 123:
            destroy numbers_scratch
            return 0
        if json_ast_number_kind(numbers_any, small_node, numbers_store) != JsonNumberKind.UNSIGNED:
            destroy numbers_scratch
            return 0
        if big_u64 != 18446744073709551615:
            destroy numbers_scratch
            return 0
        if big_i64 != -7:
            destroy numbers_scratch
            return 0
        if json_ast_number_kind(numbers_any, big_node, numbers_store) != JsonNumberKind.UNSIGNED:
            destroy numbers_scratch
            return 0
        if neg_u64 != 7:
            destroy numbers_scratch
            return 0
        min_i64: i64 = -9223372036854775807 - 1
        if neg_i64 != min_i64:
            destroy numbers_scratch
            return 0
        if json_ast_number_kind(numbers_any, neg_node, numbers_store) != JsonNumberKind.SIGNED:
            destroy numbers_scratch
            return 0
        if frac_value.kind != JsonNumberKind.NON_INTEGRAL or json_ast_number_is_integral(numbers_any, frac_node, numbers_store):
            destroy numbers_scratch
            return 0
        if exp_value.kind != JsonNumberKind.NON_INTEGRAL or json_ast_number_is_integral(numbers_any, exp_node, numbers_store):
            destroy numbers_scratch
            return 0
        if huge_value.kind != JsonNumberKind.OUT_OF_RANGE or json_ast_number_is_integral(numbers_any, huge_node, numbers_store):
            destroy numbers_scratch
            return 0
        if tiny_value.kind != JsonNumberKind.OUT_OF_RANGE or json_ast_number_is_integral(numbers_any, tiny_node, numbers_store):
            destroy numbers_scratch
            return 0

        destroy numbers_scratch

        return 1


const JSON_PARALLEL_MODE_CHECKSUM = 0
const JSON_PARALLEL_MODE_AST = 1
const JSON_PARALLEL_MODE_AST_CACHED = 2
const JSON_PARALLEL_MAX_WORKERS = 128

struct JsonParallelJob:
    source_bits: uintptr
    repeats: usize
    result_bits: uintptr
    mode: i64


def json_parallel_parse_once(source: u8&, mode: i64) -> i64:
    can Memory.Allocate, Abort.Panic:
        if mode == JSON_PARALLEL_MODE_CHECKSUM:
            return json_parser_checksum_impl(source)
        if mode == JSON_PARALLEL_MODE_AST:
            return json_parser_ast_checksum_impl(source)
        if mode == JSON_PARALLEL_MODE_AST_CACHED:
            return json_parser_ast_cached_checksum_impl(source)
        return -1


def json_parallel_worker(job: JsonParallelJob) -> i64:
    can Memory.Allocate, Abort.Panic:
        source: u8& = job.source_bits.cast[u8&]
        result_slot: mutable i64& = job.result_bits.cast[mutable i64&]
        total: mutable i64 = 0
        for iteration in 0..<job.repeats:
            value: i64 = json_parallel_parse_once(source, job.mode)
            if value < 0:
                result_slot[0] <- -1
                return -1
            total <- total + value
        result_slot[0] <- total
        return total


def json_parser_parallel_max_workers_impl() -> i64:
    return JSON_PARALLEL_MAX_WORKERS.i64()


def json_parallel_checksum_impl(source: u8&, worker_count: usize, iterations: usize, mode: i64) -> i64:
    can Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
        if worker_count == 0 or iterations == 0 or worker_count > JSON_PARALLEL_MAX_WORKERS:
            return -1

        worker_total: mutable usize = worker_count
        if worker_total > iterations:
            worker_total <- iterations

        partials: i64[128] = zeroed
        source_bits: uintptr = source.uintptr()
        base_repeats: usize = iterations / worker_total
        extra_repeats: usize = iterations % worker_total

        pool workers(worker_total):
            group: mutable TaskGroup = task_group_new()
            for slot in 0..<worker_total:
                repeats: mutable usize = base_repeats
                if slot < extra_repeats:
                    repeats <- repeats + 1

                result_bits: uintptr = partials[slot].ref[i64&].uintptr()
                job: JsonParallelJob = JsonParallelJob(source_bits, repeats, result_bits, mode)
                task: Task[i64, Pending] = submit json_parallel_worker(job)
                task_group_add(group.ref[TaskGroup&], move task)

            wait all group

        total: mutable i64 = 0
        for slot in 0..<worker_total:
            if partials[slot] < 0:
                return -1
            total <- total + partials[slot]
        return total


def json_parser_parallel_checksum_impl(source: u8&, worker_count: usize, iterations: usize) -> i64:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_CHECKSUM) can Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange


def json_parser_parallel_ast_checksum_impl(source: u8&, worker_count: usize, iterations: usize) -> i64:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_AST) can Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange


def json_parser_parallel_ast_cached_checksum_impl(source: u8&, worker_count: usize, iterations: usize) -> i64:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_AST_CACHED) can Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange


