# include "../contextlang_runtime.llcontext"

const JSON_CH_NUL = 0
const JSON_CH_TAB = 9
const JSON_CH_NL = 10
const JSON_CH_CR = 13
const JSON_CH_SPACE = 32
const JSON_CH_DQUOTE = 34
const JSON_CH_PLUS = 43
const JSON_CH_COMMA = 44
const JSON_CH_MINUS = 45
const JSON_CH_DOT = 46
const JSON_CH_0 = 48
const JSON_CH_9 = 57
const JSON_CH_COLON = 58
const JSON_CH_E = 69
const JSON_CH_LBRACKET = 91
const JSON_CH_BSLASH = 92
const JSON_CH_RBRACKET = 93
const JSON_CH_a = 97
const JSON_CH_b = 98
const JSON_CH_e = 101
const JSON_CH_f = 102
const JSON_CH_l = 108
const JSON_CH_n = 110
const JSON_CH_r = 114
const JSON_CH_t = 116
const JSON_CH_u = 117
const JSON_CH_LBRACE = 123
const JSON_CH_RBRACE = 125

repr(c) struct JsonCursor:
    source: mutable any u8&
    source_len: mutable usize
    pos: mutable usize


repr(c) struct JsonParseNodeResult:
    node: mutable JsonNode
    checksum: mutable i64


repr(c) struct JsonLexemeResult:
    checksum: mutable i64
    source_offset: mutable usize
    source_len: mutable usize


packed enum JsonNode:
    common:
        checksum: i64
        source_offset: usize
        source_len: usize
    Null
    Bool(value: bool)
    Number
    String
    Array(items: JsonNode)
    Object(fields: JsonNode)
    ArrayItem(value: JsonNode, next: JsonNode)
    Field(key: JsonNode, value: JsonNode, next: JsonNode)
    End


const enum JsonNodeKind of i8:
    INVALID = -1
    NULL = 0
    BOOL = 1
    NUMBER = 2
    STRING = 3
    ARRAY = 4
    OBJECT = 5
    ARRAY_ITEM = 6
    FIELD = 7
    END = 8


def json_new_cursor_with_len(source: any u8&, source_len: usize) -> JsonCursor:
    out: mutable JsonCursor = zeroed
    out.source <- source
    out.source_len <- source_len
    out.pos <- 0u
    return out


def json_new_cursor(source: any u8&) -> JsonCursor:
    return json_new_cursor_with_len(source, runtime_strlen(source))


def json_char_at(source: any u8&, source_len: usize, index: usize) -> i64:
    if index >= source_len:
        return JSON_CH_NUL
    return source[index].i64()


def json_cur_char(cursor: any JsonCursor&) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos)


def json_peek_char(cursor: any JsonCursor&, offset: usize) -> i64:
    return json_char_at(cursor.source, cursor.source_len, cursor.pos + offset)


def json_advance_char(cursor: any JsonCursor&) -> i64:
    ch: i64 = json_cur_char(cursor)
    if cursor.pos < cursor.source_len:
        cursor.pos <- cursor.pos + 1u
    return ch


def json_is_digit(ch: i64) -> bool:
    return ch >= JSON_CH_0 and ch <= JSON_CH_9


def json_is_hex_digit(ch: i64) -> bool:
    return json_is_digit(ch) or (ch >= 65 and ch <= 70) or (ch >= JSON_CH_a and ch <= JSON_CH_f)


def json_skip_ws(cursor: any JsonCursor&):
    scanning: mutable bool = true
    while scanning:
        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_SPACE or ch == JSON_CH_TAB or ch == JSON_CH_NL or ch == JSON_CH_CR:
            _ = json_advance_char(cursor)
        else:
            scanning <- false


def json_expect_literal_with_len(cursor: any JsonCursor&, literal: any u8&, literal_len: usize) -> bool:
    if cursor.pos + literal_len > cursor.source_len:
        return false

    i: mutable usize = 0u
    while i < literal_len:
        if cursor.source[cursor.pos + i].i64() != literal[i].i64():
            return false
        i <- i + 1u

    cursor.pos <- cursor.pos + literal_len
    return true


def json_expect_literal(cursor: any JsonCursor&, literal: any u8&) -> bool:
    return json_expect_literal_with_len(cursor, literal, runtime_strlen(literal))


def json_invalid_lexeme() -> JsonLexemeResult:
    return JsonLexemeResult(-1, 0u, 0u)


def json_parse_string_lexeme(cursor: any JsonCursor&) -> JsonLexemeResult:
    start: usize = cursor.pos
    if json_advance_char(cursor) != JSON_CH_DQUOTE:
        return json_invalid_lexeme()

    length: mutable i64 = 0
    done: mutable bool = false
    while not done:
        if cursor.pos >= cursor.source_len:
            return json_invalid_lexeme()

        ch: i64 = json_advance_char(cursor)
        if ch == JSON_CH_DQUOTE:
            return JsonLexemeResult(17 + length, start, cursor.pos - start)

        if ch == JSON_CH_BSLASH:
            if cursor.pos >= cursor.source_len:
                return json_invalid_lexeme()
            esc: i64 = json_advance_char(cursor)
            if esc == JSON_CH_u:
                digits: mutable usize = 0u
                while digits < 4u:
                    if cursor.pos >= cursor.source_len or not json_is_hex_digit(json_cur_char(cursor)):
                        return json_invalid_lexeme()
                    _ = json_advance_char(cursor)
                    digits <- digits + 1u
            length <- length + 1
        elif ch == JSON_CH_NL or ch == JSON_CH_CR:
            return json_invalid_lexeme()
        else:
            length <- length + 1

    return json_invalid_lexeme()


def json_parse_string(cursor: any JsonCursor&) -> i64:
    return json_parse_string_lexeme(cursor).checksum


def json_parse_number_lexeme(cursor: any JsonCursor&) -> JsonLexemeResult:
    start: usize = cursor.pos
    ch: mutable i64 = json_cur_char(cursor)
    if ch == JSON_CH_MINUS:
        _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_0:
        _ = json_advance_char(cursor)
    elif json_is_digit(ch):
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)
    else:
        return json_invalid_lexeme()

    if json_cur_char(cursor) == JSON_CH_DOT:
        _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return json_invalid_lexeme()
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    ch <- json_cur_char(cursor)
    if ch == JSON_CH_e or ch == JSON_CH_E:
        _ = json_advance_char(cursor)
        ch <- json_cur_char(cursor)
        if ch == JSON_CH_PLUS or ch == JSON_CH_MINUS:
            _ = json_advance_char(cursor)
        if not json_is_digit(json_cur_char(cursor)):
            return json_invalid_lexeme()
        while json_is_digit(json_cur_char(cursor)):
            _ = json_advance_char(cursor)

    return JsonLexemeResult(23 + (cursor.pos - start).i64(), start, cursor.pos - start)


def json_parse_number(cursor: any JsonCursor&) -> i64:
    return json_parse_number_lexeme(cursor).checksum


def json_parse_value_after_ws(cursor: any JsonCursor&) -> i64:
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_DQUOTE:
        return json_parse_string(cursor)
    if ch == JSON_CH_LBRACE:
        return json_parse_object(cursor)
    if ch == JSON_CH_LBRACKET:
        return json_parse_array(cursor)
    if ch == JSON_CH_t:
        return json_parse_true(cursor)
    if ch == JSON_CH_f:
        return json_parse_false(cursor)
    if ch == JSON_CH_n:
        return json_parse_null(cursor)
    if ch == JSON_CH_MINUS or json_is_digit(ch):
        return json_parse_number(cursor)
    return -1


def json_parse_array(cursor: any JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACKET:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        return 43

    total: mutable i64 = 43
    done: mutable bool = false
    while not done:
        item: i64 = json_parse_value_after_ws(cursor)
        if item < 0:
            return -1
        total <- total + item
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACKET:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_object(cursor: any JsonCursor&) -> i64:
    if json_advance_char(cursor) != JSON_CH_LBRACE:
        return -1

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        return 47

    total: mutable i64 = 47
    done: mutable bool = false
    while not done:
        key: i64 = json_parse_string(cursor)
        if key < 0:
            return -1
        total <- total + key
        json_skip_ws(cursor)
        if json_advance_char(cursor) != JSON_CH_COLON:
            return -1

        json_skip_ws(cursor)
        value: i64 = json_parse_value_after_ws(cursor)
        if value < 0:
            return -1
        total <- total + value
        json_skip_ws(cursor)

        ch: i64 = json_cur_char(cursor)
        if ch == JSON_CH_COMMA:
            _ = json_advance_char(cursor)
            json_skip_ws(cursor)
        elif ch == JSON_CH_RBRACE:
            _ = json_advance_char(cursor)
            done <- true
        else:
            return -1

    return total


def json_parse_true(cursor: any JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "true".cast[any u8&](), 4u):
        return 31
    return -1


def json_parse_false(cursor: any JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "false".cast[any u8&](), 5u):
        return 37
    return -1


def json_parse_null(cursor: any JsonCursor&) -> i64:
    if json_expect_literal_with_len(cursor, "null".cast[any u8&](), 4u):
        return 41
    return -1


def json_node_end(store: JsonNode.Store[Local]) -> JsonNode:
    in store:
        return new JsonNode.End(checksum: 0, source_offset: 0u, source_len: 0u)


def json_node_invalid(store: JsonNode.Store[Local]) -> JsonNode:
    in store:
        return new JsonNode.End(checksum: -1, source_offset: 0u, source_len: 0u)


def json_node_is_invalid(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    return node.checksum < 0


def json_parse_node_result(node: JsonNode, checksum: i64) -> JsonParseNodeResult:
    return JsonParseNodeResult(node, checksum)


def json_ast_array_items_checksum(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.ArrayItem(value: value, next: next):
                value_checksum: i64 = json_ast_checksum_node(value, store)
                if value_checksum < 0:
                    return -1
                next_checksum: i64 = json_ast_array_items_checksum(next, store)
                if next_checksum < 0:
                    return -1
                return value_checksum + next_checksum
        return -1


def json_ast_field_checksum(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.Field(key: key, value: value, next: next):
                key_checksum: i64 = json_ast_checksum_node(key, store)
                if key_checksum < 0:
                    return -1
                value_checksum: i64 = json_ast_checksum_node(value, store)
                if value_checksum < 0:
                    return -1
                next_checksum: i64 = json_ast_field_checksum(next, store)
                if next_checksum < 0:
                    return -1
                return key_checksum + value_checksum + next_checksum
        return -1


def json_ast_checksum_node(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    return node.checksum


def json_ast_node_count(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.Null:
                return 1
            JsonNode.Bool(value: value):
                return 1
            JsonNode.Number:
                return 1
            JsonNode.String:
                return 1
            JsonNode.Array(items: items):
                items_count: i64 = json_ast_node_count(items, store)
                if items_count < 0:
                    return -1
                return 1 + items_count
            JsonNode.Object(fields: fields):
                fields_count: i64 = json_ast_node_count(fields, store)
                if fields_count < 0:
                    return -1
                return 1 + fields_count
            JsonNode.ArrayItem(value: value, next: next):
                value_count: i64 = json_ast_node_count(value, store)
                if value_count < 0:
                    return -1
                next_count: i64 = json_ast_node_count(next, store)
                if next_count < 0:
                    return -1
                return 1 + value_count + next_count
            JsonNode.Field(key: key, value: value, next: next):
                key_count: i64 = json_ast_node_count(key, store)
                if key_count < 0:
                    return -1
                value_count: i64 = json_ast_node_count(value, store)
                if value_count < 0:
                    return -1
                next_count: i64 = json_ast_node_count(next, store)
                if next_count < 0:
                    return -1
                return 1 + key_count + value_count + next_count
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 1
        return -1


def json_parse_string_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    lexeme: JsonLexemeResult = json_parse_string_lexeme(cursor)
    checksum: i64 = lexeme.checksum
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    in store:
        return json_parse_node_result(new JsonNode.String(checksum: checksum, source_offset: lexeme.source_offset, source_len: lexeme.source_len), checksum)


def json_parse_number_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    lexeme: JsonLexemeResult = json_parse_number_lexeme(cursor)
    checksum: i64 = lexeme.checksum
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    in store:
        return json_parse_node_result(new JsonNode.Number(checksum: checksum, source_offset: lexeme.source_offset, source_len: lexeme.source_len), checksum)


def json_parse_true_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_true(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    in store:
        return json_parse_node_result(new JsonNode.Bool(checksum: checksum, source_offset: start, source_len: cursor.pos - start, value: true), checksum)


def json_parse_false_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_false(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    in store:
        return json_parse_node_result(new JsonNode.Bool(checksum: checksum, source_offset: start, source_len: cursor.pos - start, value: false), checksum)


def json_parse_null_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    checksum: i64 = json_parse_null(cursor)
    if checksum < 0:
        return json_parse_node_result(invalid_node, -1)
    in store:
        return json_parse_node_result(new JsonNode.Null(checksum: checksum, source_offset: start, source_len: cursor.pos - start), checksum)


def json_parse_value_node_after_ws(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_DQUOTE:
        return json_parse_string_node(cursor, store, invalid_node)
    if ch == JSON_CH_LBRACE:
        return json_parse_object_node(cursor, store, end_node, invalid_node)
    if ch == JSON_CH_LBRACKET:
        return json_parse_array_node(cursor, store, end_node, invalid_node)
    if ch == JSON_CH_t:
        return json_parse_true_node(cursor, store, invalid_node)
    if ch == JSON_CH_f:
        return json_parse_false_node(cursor, store, invalid_node)
    if ch == JSON_CH_n:
        return json_parse_null_node(cursor, store, invalid_node)
    if ch == JSON_CH_MINUS or json_is_digit(ch):
        return json_parse_number_node(cursor, store, invalid_node)
    return JsonParseNodeResult(invalid_node, -1)


def json_parse_array_items_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    value_result: JsonParseNodeResult = json_parse_value_node_after_ws(cursor, store, end_node, invalid_node)
    value_checksum: i64 = value_result.checksum
    if value_checksum < 0:
        return value_result

    json_skip_ws(cursor)
    next_node: mutable JsonNode = end_node
    next_checksum: mutable i64 = 0
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_COMMA:
        _ = json_advance_char(cursor)
        json_skip_ws(cursor)
        next_result: JsonParseNodeResult = json_parse_array_items_node(cursor, store, end_node, invalid_node)
        next_checksum <- next_result.checksum
        if next_checksum < 0:
            return next_result
        next_node <- next_result.node
    elif ch == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
    else:
        return json_parse_node_result(invalid_node, -1)

    item_checksum: i64 = value_checksum + next_checksum
    in store:
        return json_parse_node_result(new JsonNode.ArrayItem(checksum: item_checksum, source_offset: 0u, source_len: 0u, value: value_result.node, next: next_node), item_checksum)


def json_parse_array_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    if json_advance_char(cursor) != JSON_CH_LBRACKET:
        return json_parse_node_result(invalid_node, -1)

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACKET:
        _ = json_advance_char(cursor)
        in store:
            return json_parse_node_result(new JsonNode.Array(checksum: 43, source_offset: start, source_len: cursor.pos - start, items: end_node), 43)

    items_result: JsonParseNodeResult = json_parse_array_items_node(cursor, store, end_node, invalid_node)
    items_checksum: i64 = items_result.checksum
    if items_checksum < 0:
        return items_result

    in store:
        return json_parse_node_result(new JsonNode.Array(checksum: 43 + items_checksum, source_offset: start, source_len: cursor.pos - start, items: items_result.node), 43 + items_checksum)


def json_parse_object_fields_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    key_lexeme: JsonLexemeResult = json_parse_string_lexeme(cursor)
    key_checksum: i64 = key_lexeme.checksum
    if key_checksum < 0:
        return JsonParseNodeResult(invalid_node, -1)

    key_node: mutable JsonNode = invalid_node
    in store:
        key_node <- new JsonNode.String(checksum: key_checksum, source_offset: key_lexeme.source_offset, source_len: key_lexeme.source_len)

    json_skip_ws(cursor)
    if json_advance_char(cursor) != JSON_CH_COLON:
        return JsonParseNodeResult(invalid_node, -1)
    json_skip_ws(cursor)

    value_result: JsonParseNodeResult = json_parse_value_node_after_ws(cursor, store, end_node, invalid_node)
    value_checksum: i64 = value_result.checksum
    if value_checksum < 0:
        return value_result

    json_skip_ws(cursor)
    next_node: mutable JsonNode = end_node
    next_checksum: mutable i64 = 0
    ch: i64 = json_cur_char(cursor)
    if ch == JSON_CH_COMMA:
        _ = json_advance_char(cursor)
        json_skip_ws(cursor)
        next_result: JsonParseNodeResult = json_parse_object_fields_node(cursor, store, end_node, invalid_node)
        next_checksum <- next_result.checksum
        if next_checksum < 0:
            return next_result
        next_node <- next_result.node
    elif ch == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
    else:
        return JsonParseNodeResult(invalid_node, -1)

    field_checksum: i64 = key_checksum + value_checksum + next_checksum
    in store:
        return JsonParseNodeResult(new JsonNode.Field(checksum: field_checksum, source_offset: 0u, source_len: 0u, key: key_node, value: value_result.node, next: next_node), field_checksum)


def json_parse_object_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    start: usize = cursor.pos
    if json_advance_char(cursor) != JSON_CH_LBRACE:
        return json_parse_node_result(invalid_node, -1)

    json_skip_ws(cursor)
    if json_cur_char(cursor) == JSON_CH_RBRACE:
        _ = json_advance_char(cursor)
        in store:
            return json_parse_node_result(new JsonNode.Object(checksum: 47, source_offset: start, source_len: cursor.pos - start, fields: end_node), 47)

    fields_result: JsonParseNodeResult = json_parse_object_fields_node(cursor, store, end_node, invalid_node)
    fields_checksum: i64 = fields_result.checksum
    if fields_checksum < 0:
        return fields_result

    in store:
        return json_parse_node_result(new JsonNode.Object(checksum: 47 + fields_checksum, source_offset: start, source_len: cursor.pos - start, fields: fields_result.node), 47 + fields_checksum)


def json_parse_value_node(cursor: any JsonCursor&, store: JsonNode.Store[Local], end_node: JsonNode, invalid_node: JsonNode) -> JsonParseNodeResult:
    json_skip_ws(cursor)
    return json_parse_value_node_after_ws(cursor, store, end_node, invalid_node)


def json_parse_value(cursor: any JsonCursor&) -> i64:
    json_skip_ws(cursor)
    return json_parse_value_after_ws(cursor)


def json_empty_view() -> StringView:
    return StringView("".cast[any u8&](), 0)


def json_ast_kind(node: JsonNode, store: JsonNode.Store[Local]) -> JsonNodeKind:
    in store:
        match node:
            JsonNode.Null:
                return JsonNodeKind.NULL
            JsonNode.Bool(value: value):
                return JsonNodeKind.BOOL
            JsonNode.Number:
                return JsonNodeKind.NUMBER
            JsonNode.String:
                return JsonNodeKind.STRING
            JsonNode.Array(items: items):
                return JsonNodeKind.ARRAY
            JsonNode.Object(fields: fields):
                return JsonNodeKind.OBJECT
            JsonNode.ArrayItem(value: value, next: next):
                return JsonNodeKind.ARRAY_ITEM
            JsonNode.Field(key: key, value: value, next: next):
                return JsonNodeKind.FIELD
            JsonNode.End:
                if node.checksum < 0:
                    return JsonNodeKind.INVALID
                return JsonNodeKind.END
    return JsonNodeKind.INVALID


def json_ast_source_view(source: any u8&, node: JsonNode, store: JsonNode.Store[Local]) -> StringView:
    if json_node_is_invalid(node, store):
        return json_empty_view()
    return StringView(source + node.source_offset, node.source_len.i64())


def json_ast_string_view(source: any u8&, node: JsonNode, store: JsonNode.Store[Local]) -> StringView:
    in store:
        match node:
            JsonNode.String:
                if node.source_len < 2u:
                    return json_empty_view()
                return StringView(source + node.source_offset + 1u, (node.source_len - 2u).i64())
    return json_empty_view()


def json_ast_number_view(source: any u8&, node: JsonNode, store: JsonNode.Store[Local]) -> StringView:
    in store:
        match node:
            JsonNode.Number:
                return StringView(source + node.source_offset, node.source_len.i64())
    return json_empty_view()


def json_ast_string_eq_literal(source: any u8&, node: JsonNode, literal: any u8&, store: JsonNode.Store[Local]) -> bool:
    return string_view_eq(json_ast_string_view(source, node, store), literal) != 0


def json_ast_bool_value(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.Bool(value: value):
                return 1 if value else 0
    return -1


def json_ast_is_null(node: JsonNode, store: JsonNode.Store[Local]) -> bool:
    return json_ast_kind(node, store) == JsonNodeKind.NULL


def json_ast_array_items_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.ArrayItem(value: value, next: next):
                next_len: i64 = json_ast_array_items_len(next, store)
                if next_len < 0:
                    return -1
                return 1 + next_len
    return -1


def json_ast_array_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.Array(items: items):
                return json_ast_array_items_len(items, store)
    return -1


def json_ast_field_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.End:
                if node.checksum < 0:
                    return -1
                return 0
            JsonNode.Field(key: key, value: value, next: next):
                next_len: i64 = json_ast_field_len(next, store)
                if next_len < 0:
                    return -1
                return 1 + next_len
    return -1


def json_ast_object_len(node: JsonNode, store: JsonNode.Store[Local]) -> i64:
    in store:
        match node:
            JsonNode.Object(fields: fields):
                return json_ast_field_len(fields, store)
    return -1


def json_ast_array_items_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonNode:
    in store:
        match node:
            JsonNode.ArrayItem(value: value, next: next):
                if index == 0u:
                    return value
                return json_ast_array_items_nth(next, index - 1u, store, invalid_node)
            JsonNode.End:
                return invalid_node
    return invalid_node


def json_ast_array_nth(node: JsonNode, index: usize, store: JsonNode.Store[Local]) -> JsonNode:
    invalid_node: JsonNode = json_node_invalid(store)
    in store:
        match node:
            JsonNode.Array(items: items):
                return json_ast_array_items_nth(items, index, store, invalid_node)
    return invalid_node


def json_ast_object_fields_get(node: JsonNode, source: any u8&, key: any u8&, store: JsonNode.Store[Local], invalid_node: JsonNode) -> JsonNode:
    in store:
        match node:
            JsonNode.Field(key: field_key, value: value, next: next):
                if json_ast_string_eq_literal(source, field_key, key, store):
                    return value
                return json_ast_object_fields_get(next, source, key, store, invalid_node)
            JsonNode.End:
                return invalid_node
    return invalid_node


def json_ast_object_get(node: JsonNode, source: any u8&, key: any u8&, store: JsonNode.Store[Local]) -> JsonNode:
    invalid_node: JsonNode = json_node_invalid(store)
    in store:
        match node:
            JsonNode.Object(fields: fields):
                return json_ast_object_fields_get(fields, source, key, store, invalid_node)
    return invalid_node


def json_parser_checksum_impl(source: any u8&) -> i64:
    cursor: mutable JsonCursor = json_new_cursor(source)
    checksum: i64 = json_parse_value((&cursor).cast[any JsonCursor&]())
    if checksum < 0:
        return -1
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    if cursor.pos != cursor.source_len:
        return -1
    return checksum


def json_parse_document_node_with_len(source: any u8&, source_len: usize, store: JsonNode.Store[Local]) -> JsonParseNodeResult:
    cursor: mutable JsonCursor = json_new_cursor_with_len(source, source_len)
    end_node: JsonNode = json_node_end(store)
    invalid_node: JsonNode = json_node_invalid(store)
    result: JsonParseNodeResult = json_parse_value_node((&cursor).cast[any JsonCursor&](), store, end_node, invalid_node)
    if result.checksum < 0:
        return result
    json_skip_ws((&cursor).cast[any JsonCursor&]())
    if cursor.pos != cursor.source_len:
        return json_parse_node_result(invalid_node, -1)
    return result


def json_parse_document_node(source: any u8&, store: JsonNode.Store[Local]) -> JsonParseNodeResult:
    return json_parse_document_node_with_len(source, runtime_strlen(source), store)


def json_ast_scratch_capacity(source_len: usize) -> usize:
    slots_per_byte_budget: usize = 2u
    capacity: usize = source_len * slots_per_byte_budget + 1024u
    return max(capacity, ARENA_REGION_DEFAULT_CAPACITY)


def json_parser_ast_checksum_impl(source: any u8&) -> i64:
    source_len: usize = runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source, source_len, store)
    checksum: i64 = result.checksum
    if checksum < 0:
        destroy scratch
        return -1
    destroy scratch
    return checksum


def json_parser_ast_cached_checksum_impl(source: any u8&) -> i64:
    source_len: usize = runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source, source_len, store)
    checksum: i64 = result.checksum
    if checksum < 0:
        destroy scratch
        return -1
    destroy scratch
    return checksum


def json_parser_ast_node_count_impl(source: any u8&) -> i64:
    source_len: usize = runtime_strlen(source)
    region scratch(json_ast_scratch_capacity(source_len))
    store: JsonNode.Store[Local] = JsonNode.Store(scratch)
    result: JsonParseNodeResult = json_parse_document_node_with_len(source, source_len, store)
    if result.checksum < 0:
        destroy scratch
        return -1
    count: i64 = json_ast_node_count(result.node, store)
    destroy scratch
    return count


def json_expect_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_checksum_impl(source.cast[any u8&]()) == expected


def json_expect_invalid(source: static u8&) -> bool:
    return json_parser_checksum_impl(source.cast[any u8&]()) < 0


def json_expect_ast_checksum(source: static u8&, expected: i64) -> bool:
    return json_parser_ast_checksum_impl(source.cast[any u8&]()) == expected


def json_expect_invalid_ast(source: static u8&) -> bool:
    return json_parser_ast_checksum_impl(source.cast[any u8&]()) < 0


def json_parser_parity_suite_impl() -> int:
    if not json_expect_checksum("{}", 47):
        return 0
    if not json_expect_ast_checksum("{}", 47):
        return 0
    if not json_expect_checksum("[]", 43):
        return 0
    if not json_expect_ast_checksum("[]", 43):
        return 0
    if not json_expect_checksum("[1,2,3]", 115):
        return 0
    if not json_expect_ast_checksum("[1,2,3]", 115):
        return 0
    if not json_expect_checksum("[true,false,null]", 152):
        return 0
    if not json_expect_ast_checksum("[true,false,null]", 152):
        return 0
    if not json_expect_checksum("[-12,3.5,null]", 136):
        return 0
    if not json_expect_ast_checksum("[-12,3.5,null]", 136):
        return 0
    if not json_expect_invalid("[1,2}"):
        return 0
    if not json_expect_invalid_ast("[1,2}"):
        return 0
    if not json_expect_invalid("[1,,2]"):
        return 0
    if not json_expect_invalid_ast("[1,,2]"):
        return 0
    return 1


const JSON_PARALLEL_MODE_CHECKSUM = 0
const JSON_PARALLEL_MODE_AST = 1
const JSON_PARALLEL_MODE_AST_CACHED = 2
const JSON_PARALLEL_MAX_WORKERS = 128u

repr(c) struct JsonParallelJob:
    source_bits: uintptr
    repeats: usize
    result_bits: uintptr
    mode: i64


def json_parallel_parse_once(source: any u8&, mode: i64) -> i64:
    if mode == JSON_PARALLEL_MODE_CHECKSUM:
        return json_parser_checksum_impl(source)
    if mode == JSON_PARALLEL_MODE_AST:
        return json_parser_ast_checksum_impl(source)
    if mode == JSON_PARALLEL_MODE_AST_CACHED:
        return json_parser_ast_cached_checksum_impl(source)
    return -1


def json_parallel_worker(job: JsonParallelJob) -> i64:
    source: any u8& = job.source_bits.cast[any u8&]()
    result_slot: any i64& = job.result_bits.cast[any i64&]()
    remaining: mutable usize = job.repeats
    total: mutable i64 = 0
    while remaining > 0u:
        value: i64 = json_parallel_parse_once(source, job.mode)
        if value < 0:
            result_slot[0u] <- -1
            return -1
        total <- total + value
        remaining <- remaining - 1u
    result_slot[0u] <- total
    return total


def json_parser_parallel_max_workers_impl() -> i64:
    return JSON_PARALLEL_MAX_WORKERS.i64()


def json_parallel_checksum_impl(source: any u8&, worker_count: usize, iterations: usize, mode: i64) -> i64 can[Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
    if worker_count == 0u or iterations == 0u or worker_count > JSON_PARALLEL_MAX_WORKERS:
        return -1

    worker_total: mutable usize = worker_count
    if worker_total > iterations:
        worker_total <- iterations

    partials: i64[128] = zeroed
    source_bits: uintptr = source.uintptr()
    base_repeats: usize = iterations / worker_total
    extra_repeats: usize = iterations % worker_total

    pool workers(worker_total):
        group: TaskGroup = task_group_new()
        slot: mutable usize = 0u
        while slot < worker_total:
            repeats: mutable usize = base_repeats
            if slot < extra_repeats:
                repeats <- repeats + 1u

            result_bits: uintptr = (&partials[slot]).cast[any i64&]().uintptr()
            job: JsonParallelJob = JsonParallelJob(source_bits, repeats, result_bits, mode)
            task: Task[i64, Pending] = submit json_parallel_worker(job)
            task_group_add((&group).cast[any TaskGroup&](), move task)
            slot <- slot + 1u

        wait all group

    total: mutable i64 = 0
    slot: mutable usize = 0u
    while slot < worker_total:
        if partials[slot] < 0:
            return -1
        total <- total + partials[slot]
        slot <- slot + 1u
    return total


def json_parser_parallel_checksum_impl(source: any u8&, worker_count: usize, iterations: usize) -> i64 can[Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_CHECKSUM)


def json_parser_parallel_ast_checksum_impl(source: any u8&, worker_count: usize, iterations: usize) -> i64 can[Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_AST)


def json_parser_parallel_ast_cached_checksum_impl(source: any u8&, worker_count: usize, iterations: usize) -> i64 can[Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
    return json_parallel_checksum_impl(source, worker_count, iterations, JSON_PARALLEL_MODE_AST_CACHED)


export func json_parser_parity_suite() -> int = json_parser_parity_suite_impl
export func json_parser_checksum(source: any u8&) -> i64 = json_parser_checksum_impl
export func json_parser_ast_checksum(source: any u8&) -> i64 = json_parser_ast_checksum_impl
export func json_parser_ast_cached_checksum(source: any u8&) -> i64 = json_parser_ast_cached_checksum_impl
export func json_parser_ast_node_count(source: any u8&) -> i64 = json_parser_ast_node_count_impl
export func json_parser_parallel_max_workers() -> i64 = json_parser_parallel_max_workers_impl
export func json_parser_parallel_checksum(source: any u8&, worker_count: usize, iterations: usize) -> i64 = json_parser_parallel_checksum_impl
export func json_parser_parallel_ast_checksum(source: any u8&, worker_count: usize, iterations: usize) -> i64 = json_parser_parallel_ast_checksum_impl
export func json_parser_parallel_ast_cached_checksum(source: any u8&, worker_count: usize, iterations: usize) -> i64 = json_parser_parallel_ast_cached_checksum_impl
