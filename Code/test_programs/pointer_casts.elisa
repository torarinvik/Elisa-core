def ptr_bits(ptr: u8&) -> uintptr:
    trusted Unsafe.PointerCast:
        return ptr.uintptr()


def bits_ptr(bits: uintptr) -> u8&:
    trusted Unsafe.PointerCast:
        return bits.cast[u8&]


def advance_raw(ptr: void&, offset: usize) -> void&:
    trusted Unsafe.PointerCast:
        return (ptr.cast[u8&] + offset).cast[void&]
