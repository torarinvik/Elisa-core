# include "../frontend_llcontext/contextlang_frontend.llcontext"


global mutable frontend_lexer_bench_arena: Arena = zeroed


def frontend_expect_token_count(tokens: darray[FrontendToken], expected: usize) -> bool:
    return tokens.count == expected


def frontend_kind_eq(actual: FrontendTokenKind, expected: FrontendTokenKind) -> bool:
    match expected:
        FrontendTokenKind.Eof:
            match actual:
                FrontendTokenKind.Eof:
                    return true
        FrontendTokenKind.Newline:
            match actual:
                FrontendTokenKind.Newline:
                    return true
        FrontendTokenKind.Indent:
            match actual:
                FrontendTokenKind.Indent:
                    return true
        FrontendTokenKind.Dedent:
            match actual:
                FrontendTokenKind.Dedent:
                    return true
        FrontendTokenKind.Ident:
            match actual:
                FrontendTokenKind.Ident:
                    return true
        FrontendTokenKind.IntLit:
            match actual:
                FrontendTokenKind.IntLit:
                    return true
        FrontendTokenKind.HexLit:
            match actual:
                FrontendTokenKind.HexLit:
                    return true
        FrontendTokenKind.Def:
            match actual:
                FrontendTokenKind.Def:
                    return true
        FrontendTokenKind.Colon:
            match actual:
                FrontendTokenKind.Colon:
                    return true
        FrontendTokenKind.LParen:
            match actual:
                FrontendTokenKind.LParen:
                    return true
        FrontendTokenKind.RParen:
            match actual:
                FrontendTokenKind.RParen:
                    return true
        FrontendTokenKind.Comma:
            match actual:
                FrontendTokenKind.Comma:
                    return true
        FrontendTokenKind.Ellipsis:
            match actual:
                FrontendTokenKind.Ellipsis:
                    return true
        FrontendTokenKind.LArrow:
            match actual:
                FrontendTokenKind.LArrow:
                    return true
        FrontendTokenKind.Arrow:
            match actual:
                FrontendTokenKind.Arrow:
                    return true
        FrontendTokenKind.LShift:
            match actual:
                FrontendTokenKind.LShift:
                    return true
        FrontendTokenKind.RShift:
            match actual:
                FrontendTokenKind.RShift:
                    return true
    return false


def frontend_expect_kind(tokens: darray[FrontendToken], index: usize, expected: FrontendTokenKind) -> bool:
    if index >= tokens.count:
        return false
    return frontend_kind_eq(tokens[index].kind, expected)


def frontend_expect_text(tokens: darray[FrontendToken], index: usize, expected: static u8&) -> bool:
    if index >= tokens.count:
        return false
    return ctx_stage0_string_view_eq(tokens[index].text, expected.cast[any u8&]()) != 0


def frontend_expect_suffix(tokens: darray[FrontendToken], index: usize, expected: static u8&) -> bool:
    if index >= tokens.count:
        return false
    return ctx_stage0_string_view_eq(tokens[index].suffix, expected.cast[any u8&]()) != 0


def frontend_tokenize_test_source(a: any Arena&, source: any u8&) -> darray[FrontendToken]:
    return frontend_tokenize(a, "frontend_lexer_test.llcontext".cast[any u8&](), source)


def frontend_case_simple_ident() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[7] = [104u8, 101u8, 108u8, 108u8, 111u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 3u):
        return false
    if not frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident):
        return false
    if not frontend_expect_kind(tokens, 1u, FrontendTokenKind.Newline):
        return false
    if not frontend_expect_kind(tokens, 2u, FrontendTokenKind.Eof):
        return false
    return frontend_expect_text(tokens, 0u, "hello")


def frontend_case_arrow_ops() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[14] = [120u8, 32u8, 60u8, 45u8, 32u8, 121u8, 32u8, 45u8, 62u8, 32u8, 122u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 7u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LArrow) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Arrow) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Eof)


def frontend_case_number_literals() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[25] = [52u8, 50u8, 32u8, 48u8, 120u8, 102u8, 102u8, 32u8, 49u8, 50u8, 51u8, 117u8, 54u8, 52u8, 32u8, 48u8, 120u8, 65u8, 66u8, 105u8, 51u8, 50u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 6u):
        return false
    if not frontend_expect_kind(tokens, 0u, FrontendTokenKind.IntLit):
        return false
    if not frontend_expect_kind(tokens, 1u, FrontendTokenKind.HexLit):
        return false
    if not frontend_expect_kind(tokens, 2u, FrontendTokenKind.IntLit):
        return false
    if not frontend_expect_kind(tokens, 3u, FrontendTokenKind.HexLit):
        return false
    if not frontend_expect_kind(tokens, 4u, FrontendTokenKind.Newline):
        return false
    if not frontend_expect_kind(tokens, 5u, FrontendTokenKind.Eof):
        return false
    if not frontend_expect_suffix(tokens, 2u, "u64"):
        return false
    return frontend_expect_suffix(tokens, 3u, "i32")


def frontend_case_indent_dedent() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[39] = [100u8, 101u8, 102u8, 32u8, 102u8, 111u8, 111u8, 58u8, 10u8, 32u8, 32u8, 32u8, 32u8, 120u8, 32u8, 60u8, 45u8, 32u8, 49u8, 10u8, 32u8, 32u8, 32u8, 32u8, 121u8, 32u8, 60u8, 45u8, 32u8, 50u8, 10u8, 122u8, 32u8, 60u8, 45u8, 32u8, 51u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 19u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Def) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Colon) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Indent) and frontend_expect_kind(tokens, 9u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 13u, FrontendTokenKind.Dedent) and frontend_expect_kind(tokens, 18u, FrontendTokenKind.Eof)


def frontend_case_comment_and_ellipsis() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[9] = [35u8, 120u8, 10u8, 46u8, 46u8, 46u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 3u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ellipsis) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Eof)


def frontend_case_shift_ops() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[13] = [120u8, 32u8, 60u8, 60u8, 32u8, 51u8, 32u8, 62u8, 62u8, 32u8, 50u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 7u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LShift) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.IntLit) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.RShift) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.IntLit) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Eof)


def frontend_case_paren_suppresses_newline() -> bool:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]()
    bytes: u8[15] = [102u8, 111u8, 111u8, 40u8, 97u8, 44u8, 10u8, 32u8, 32u8, 32u8, 32u8, 98u8, 41u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&]())
    if not frontend_expect_token_count(tokens, 8u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LParen) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Comma) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.RParen) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 7u, FrontendTokenKind.Eof)


def frontend_lexer_parity_suite_impl() -> int:
    if not frontend_case_simple_ident():
        return 0
    if not frontend_case_arrow_ops():
        return 0
    if not frontend_case_number_literals():
        return 0
    if not frontend_case_indent_dedent():
        return 0
    if not frontend_case_comment_and_ellipsis():
        return 0
    if not frontend_case_shift_ops():
        return 0
    if not frontend_case_paren_suppresses_newline():
        return 0
    return 1


def frontend_count_tokens(a: any Arena&, filename: any u8&, source: any u8&) -> usize:
    lexer: mutable FrontendLexer = frontend_new_lexer(a, filename, source)
    count: mutable usize = 0u

    while true:
        token: FrontendToken = frontend_next_token((&lexer).cast[any FrontendLexer&]())
        count <- count + 1u
        match token.kind:
            FrontendTokenKind.Eof:
                return count

    return count


def frontend_lexer_token_count_impl(source: any u8&) -> i64:
    arena: any Arena& = (&frontend_lexer_bench_arena).cast[any Arena&]()
    arena_reset(arena)
    return frontend_count_tokens(arena, "frontend_lexer_bench.llcontext".cast[any u8&](), source).i64()


export func frontend_lexer_parity_suite() -> int = frontend_lexer_parity_suite_impl
export func frontend_lexer_token_count(source: any u8&) -> i64 = frontend_lexer_token_count_impl
