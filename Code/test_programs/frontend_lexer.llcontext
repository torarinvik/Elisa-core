# include "../frontend_llcontext/contextlang_frontend.llcontext"


global mutable frontend_lexer_bench_arena: Arena = zeroed

const FRONTEND_TOKEN_HASH_OFFSET = 1469598103934665603u64
const FRONTEND_TOKEN_HASH_PRIME = 1099511628211u64


def frontend_expect_token_count(tokens: darray[FrontendToken], expected: usize) -> bool:
    return tokens.count == expected


def frontend_kind_eq(actual: FrontendTokenKind, expected: FrontendTokenKind) -> bool:
    match expected:
        FrontendTokenKind.Eof:
            match actual:
                FrontendTokenKind.Eof:
                    return true
        FrontendTokenKind.Newline:
            match actual:
                FrontendTokenKind.Newline:
                    return true
        FrontendTokenKind.Indent:
            match actual:
                FrontendTokenKind.Indent:
                    return true
        FrontendTokenKind.Dedent:
            match actual:
                FrontendTokenKind.Dedent:
                    return true
        FrontendTokenKind.Ident:
            match actual:
                FrontendTokenKind.Ident:
                    return true
        FrontendTokenKind.IntLit:
            match actual:
                FrontendTokenKind.IntLit:
                    return true
        FrontendTokenKind.FloatLit:
            match actual:
                FrontendTokenKind.FloatLit:
                    return true
        FrontendTokenKind.HexLit:
            match actual:
                FrontendTokenKind.HexLit:
                    return true
        FrontendTokenKind.True:
            match actual:
                FrontendTokenKind.True:
                    return true
        FrontendTokenKind.False:
            match actual:
                FrontendTokenKind.False:
                    return true
        FrontendTokenKind.Zeroed:
            match actual:
                FrontendTokenKind.Zeroed:
                    return true
        FrontendTokenKind.Def:
            match actual:
                FrontendTokenKind.Def:
                    return true
        FrontendTokenKind.Any:
            match actual:
                FrontendTokenKind.Any:
                    return true
        FrontendTokenKind.Region:
            match actual:
                FrontendTokenKind.Region:
                    return true
        FrontendTokenKind.Destroy:
            match actual:
                FrontendTokenKind.Destroy:
                    return true
        FrontendTokenKind.New:
            match actual:
                FrontendTokenKind.New:
                    return true
        FrontendTokenKind.Colon:
            match actual:
                FrontendTokenKind.Colon:
                    return true
        FrontendTokenKind.Assign:
            match actual:
                FrontendTokenKind.Assign:
                    return true
        FrontendTokenKind.LParen:
            match actual:
                FrontendTokenKind.LParen:
                    return true
        FrontendTokenKind.RParen:
            match actual:
                FrontendTokenKind.RParen:
                    return true
        FrontendTokenKind.LBracket:
            match actual:
                FrontendTokenKind.LBracket:
                    return true
        FrontendTokenKind.RBracket:
            match actual:
                FrontendTokenKind.RBracket:
                    return true
        FrontendTokenKind.Comma:
            match actual:
                FrontendTokenKind.Comma:
                    return true
        FrontendTokenKind.Ampersand:
            match actual:
                FrontendTokenKind.Ampersand:
                    return true
        FrontendTokenKind.Ellipsis:
            match actual:
                FrontendTokenKind.Ellipsis:
                    return true
        FrontendTokenKind.LArrow:
            match actual:
                FrontendTokenKind.LArrow:
                    return true
        FrontendTokenKind.Arrow:
            match actual:
                FrontendTokenKind.Arrow:
                    return true
        FrontendTokenKind.LShift:
            match actual:
                FrontendTokenKind.LShift:
                    return true
        FrontendTokenKind.RShift:
            match actual:
                FrontendTokenKind.RShift:
                    return true
    return false


def frontend_expect_kind(tokens: darray[FrontendToken], index: usize, expected: FrontendTokenKind) -> bool:
    if index >= tokens.count:
        return false
    return frontend_kind_eq(tokens[index].kind, expected)


def frontend_expect_text(tokens: darray[FrontendToken], index: usize, expected: static u8&) -> bool:
    if index >= tokens.count:
        return false
    return tokens[index].text == expected


def frontend_expect_suffix(tokens: darray[FrontendToken], index: usize, expected: static u8&) -> bool:
    if index >= tokens.count:
        return false
    return tokens[index].suffix == expected


