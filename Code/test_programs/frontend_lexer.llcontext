def frontend_case_char_literals() -> bool:
    can Memory.Allocate, Abort.Panic:
        region scratch(4096)
        a: mutable Arena& = scratch.ref[mutable Arena&]
        bytes: u8[26] = [39, 97, 39, 32, 39, 92, 110, 39, 32, 39, 92, 120, 52, 49, 39, 32, 39, 92, 117, 48, 48, 52, 49, 39, 10, 0]
        tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, bytes[0].ref[u8&])
        if not frontend_expect_token_count(tokens, 6):
            return false
        return frontend_expect_kind(tokens, 0, FrontendTokenKind.CharLit) and frontend_expect_kind(tokens, 1, FrontendTokenKind.CharLit) and frontend_expect_kind(tokens, 2, FrontendTokenKind.CharLit) and frontend_expect_kind(tokens, 3, FrontendTokenKind.CharLit) and frontend_expect_kind(tokens, 4, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 5, FrontendTokenKind.Eof)


def frontend_token_hash_mix(hash: u64, value: u64) -> u64:
    return (hash ^ value) * FRONTEND_TOKEN_HASH_PRIME


def frontend_hash_token(hash: u64, token: FrontendToken) -> u64:
    return frontend_token_hash_mix(hash, frontend_token_kind_code(token.kind))


def frontend_token_checksum(tokens: darray[FrontendToken]) -> u64:
    hash: mutable u64 = frontend_token_hash_mix(FRONTEND_TOKEN_HASH_OFFSET, tokens.count.u64())
    for i in 0..<tokens.count:
        hash <- frontend_hash_token(hash, tokens[i])
    return hash


def frontend_tokenize_test_source(a: mutable Arena&, source: u8&) -> darray[FrontendToken]:
    tokens: darray[FrontendToken] = frontend_tokenize(a, "frontend_lexer_test.llcontext".cast[u8&], source) can Memory.Allocate, Abort.Panic
    return tokens


def frontend_expect_lookup_keyword(text: static u8&, expected: FrontendTokenKind) -> bool:
    return frontend_kind_eq(frontend_lookup_keyword(string_view(text.cast[u8&], 0, runtime_strlen(text.cast[u8&]).i64())), expected)


def frontend_expect_lookup_keyword_entries(entries: FrontendKeywordEntry&, count: usize) -> bool:
    for i in 0..<count:
        entry: FrontendKeywordEntry = entries[i]
        if not frontend_expect_lookup_keyword(entry.text, entry.kind):
            return false
    return true


def frontend_case_simple_ident() -> bool:
    can Memory.Allocate, Abort.Panic:
        region scratch(4096)
        a: mutable Arena& = scratch.ref[mutable Arena&]
        bytes: u8[7] = [104, 101, 108, 108, 111, 10, 0]
        tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, bytes[0].ref[u8&])
        if not frontend_expect_token_count(tokens, 3):
            return false
        if not frontend_expect_kind(tokens, 0, FrontendTokenKind.Ident):
            return false
        if not frontend_expect_kind(tokens, 1, FrontendTokenKind.Newline):
            return false
        if not frontend_expect_kind(tokens, 2, FrontendTokenKind.Eof):
            return false
        if 0 >= tokens.count:
            return false
        return frontend_sv_eq_literal(tokens[0].text, "hello")


def frontend_case_arrow_ops() -> bool:
    can Memory.Allocate, Abort.Panic:
        region scratch(4096)
        a: mutable Arena& = scratch.ref[mutable Arena&]
        bytes: u8[14] = [120, 32, 60, 45, 32, 121, 32, 45, 62, 32, 122, 10, 0, 0]
        tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, bytes[0].ref[u8&])
        if not frontend_expect_token_count(tokens, 7):
            return false
        return frontend_expect_kind(tokens, 0, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1, FrontendTokenKind.LArrow) and frontend_expect_kind(tokens, 2, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 3, FrontendTokenKind.Arrow) and frontend_expect_kind(tokens, 4, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 5, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 6, FrontendTokenKind.Eof)


def frontend_case_number_literals() -> bool:
    can Memory.Allocate, Abort.Panic:
        region scratch(4096)
        a: mutable Arena& = scratch.ref[mutable Arena&]
        bytes: u8[25] = [52, 50, 32, 48, 120, 102, 102, 32, 49, 50, 51, 117, 54, 52, 32, 48, 120, 65, 66, 105, 51, 50, 10, 0, 0]
        tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, bytes[0].ref[u8&])
        if not frontend_expect_token_count(tokens, 6):
            return false
        if not frontend_expect_kind(tokens, 0, FrontendTokenKind.IntLit):
            return false
        if not frontend_expect_kind(tokens, 1, FrontendTokenKind.HexLit):
            return false
        if not frontend_expect_kind(tokens, 2, FrontendTokenKind.IntLit):
            return false
        if not frontend_expect_kind(tokens, 3, FrontendTokenKind.HexLit):
            return false
        if not frontend_expect_kind(tokens, 4, FrontendTokenKind.Newline):
            return false
        if not frontend_expect_kind(tokens, 5, FrontendTokenKind.Eof):
            return false
        if 2 >= tokens.count:
            return false
        if not frontend_sv_eq_literal(tokens[2].suffix, "u64"):
            return false
        if 3 >= tokens.count:
            return false
        return frontend_sv_eq_literal(tokens[3].suffix, "i32")


