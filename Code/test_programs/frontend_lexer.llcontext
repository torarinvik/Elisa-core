def frontend_token_hash_mix(hash: u64, value: u64) -> u64:
    return (hash ^ value) * FRONTEND_TOKEN_HASH_PRIME


def frontend_hash_token(hash: u64, token: FrontendToken) -> u64:
    return frontend_token_hash_mix(hash, frontend_token_kind_code(token.kind))


def frontend_token_checksum(tokens: darray[FrontendToken]) -> u64:
    hash: mutable u64 = frontend_token_hash_mix(FRONTEND_TOKEN_HASH_OFFSET, tokens.count.u64())
    i: mutable usize = 0u
    while i < tokens.count:
        hash <- frontend_hash_token(hash, tokens[i])
        i <- i + 1u
    return hash


def frontend_tokenize_test_source(a: any Arena&, source: any u8&) -> darray[FrontendToken] can[Memory.Allocate, Abort.Panic]:
    return frontend_tokenize(a, "frontend_lexer_test.llcontext".cast[any u8&], source)


def frontend_case_simple_ident() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[7] = [104u8, 101u8, 108u8, 108u8, 111u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 3u):
        return false
    if not frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident):
        return false
    if not frontend_expect_kind(tokens, 1u, FrontendTokenKind.Newline):
        return false
    if not frontend_expect_kind(tokens, 2u, FrontendTokenKind.Eof):
        return false
    if 0u >= tokens.count:
        return false
    return frontend_sv_eq_literal(tokens[0u].text, "hello")


def frontend_case_arrow_ops() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[14] = [120u8, 32u8, 60u8, 45u8, 32u8, 121u8, 32u8, 45u8, 62u8, 32u8, 122u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 7u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LArrow) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Arrow) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Eof)


def frontend_case_number_literals() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[25] = [52u8, 50u8, 32u8, 48u8, 120u8, 102u8, 102u8, 32u8, 49u8, 50u8, 51u8, 117u8, 54u8, 52u8, 32u8, 48u8, 120u8, 65u8, 66u8, 105u8, 51u8, 50u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 6u):
        return false
    if not frontend_expect_kind(tokens, 0u, FrontendTokenKind.IntLit):
        return false
    if not frontend_expect_kind(tokens, 1u, FrontendTokenKind.HexLit):
        return false
    if not frontend_expect_kind(tokens, 2u, FrontendTokenKind.IntLit):
        return false
    if not frontend_expect_kind(tokens, 3u, FrontendTokenKind.HexLit):
        return false
    if not frontend_expect_kind(tokens, 4u, FrontendTokenKind.Newline):
        return false
    if not frontend_expect_kind(tokens, 5u, FrontendTokenKind.Eof):
        return false
    if 2u >= tokens.count:
        return false
    if not frontend_sv_eq_literal(tokens[2u].suffix, "u64"):
        return false
    if 3u >= tokens.count:
        return false
    return frontend_sv_eq_literal(tokens[3u].suffix, "i32")


def frontend_case_indent_dedent() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[39] = [100u8, 101u8, 102u8, 32u8, 102u8, 111u8, 111u8, 58u8, 10u8, 32u8, 32u8, 32u8, 32u8, 120u8, 32u8, 60u8, 45u8, 32u8, 49u8, 10u8, 32u8, 32u8, 32u8, 32u8, 121u8, 32u8, 60u8, 45u8, 32u8, 50u8, 10u8, 122u8, 32u8, 60u8, 45u8, 32u8, 51u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 19u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Def) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Colon) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Indent) and frontend_expect_kind(tokens, 9u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 13u, FrontendTokenKind.Dedent) and frontend_expect_kind(tokens, 18u, FrontendTokenKind.Eof)


def frontend_case_comment_and_ellipsis() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[9] = [35u8, 120u8, 10u8, 46u8, 46u8, 46u8, 10u8, 0u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 3u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ellipsis) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Eof)


def frontend_case_shift_ops() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[13] = [120u8, 32u8, 60u8, 60u8, 32u8, 51u8, 32u8, 62u8, 62u8, 32u8, 50u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 7u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LShift) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.IntLit) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.RShift) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.IntLit) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Eof)


def frontend_case_paren_suppresses_newline() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[15] = [102u8, 111u8, 111u8, 40u8, 97u8, 44u8, 10u8, 32u8, 32u8, 32u8, 32u8, 98u8, 41u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    if not frontend_expect_token_count(tokens, 8u):
        return false
    return frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.LParen) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Comma) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.RParen) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 7u, FrontendTokenKind.Eof)


def frontend_case_region_alloc_syntax() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[59] = [114u8, 101u8, 103u8, 105u8, 111u8, 110u8, 32u8, 112u8, 97u8, 114u8, 115u8, 101u8, 10u8, 118u8, 97u8, 108u8, 117u8, 101u8, 58u8, 32u8, 97u8, 110u8, 121u8, 32u8, 105u8, 51u8, 50u8, 38u8, 32u8, 61u8, 32u8, 110u8, 101u8, 119u8, 91u8, 112u8, 97u8, 114u8, 115u8, 101u8, 93u8, 32u8, 49u8, 10u8, 100u8, 101u8, 115u8, 116u8, 114u8, 111u8, 121u8, 32u8, 112u8, 97u8, 114u8, 115u8, 101u8, 10u8, 0u8]
    tokens: darray[FrontendToken] = frontend_tokenize_test_source(a, (&bytes[0u]).cast[any u8&])
    ok: bool = frontend_expect_token_count(tokens, 19u) and frontend_expect_kind(tokens, 0u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 1u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 2u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 3u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 4u, FrontendTokenKind.Colon) and frontend_expect_kind(tokens, 5u, FrontendTokenKind.Any) and frontend_expect_kind(tokens, 6u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 7u, FrontendTokenKind.Ampersand) and frontend_expect_kind(tokens, 8u, FrontendTokenKind.Assign) and frontend_expect_kind(tokens, 9u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 10u, FrontendTokenKind.LBracket) and frontend_expect_kind(tokens, 11u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 12u, FrontendTokenKind.RBracket) and frontend_expect_kind(tokens, 13u, FrontendTokenKind.IntLit) and frontend_expect_kind(tokens, 14u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 15u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 16u, FrontendTokenKind.Ident) and frontend_expect_kind(tokens, 17u, FrontendTokenKind.Newline) and frontend_expect_kind(tokens, 18u, FrontendTokenKind.Eof)
    destroy scratch
    return ok


def frontend_case_kind_only_keyword_path() -> bool can[Memory.Allocate, Abort.Panic]:
    region scratch(4096u)
    a: any Arena& = (&scratch).cast[any Arena&]
    bytes: u8[53] = [102u8, 97u8, 108u8, 115u8, 101u8, 32u8, 116u8, 114u8, 117u8, 101u8, 32u8, 122u8, 101u8, 114u8, 111u8, 101u8, 100u8, 32u8, 114u8, 101u8, 103u8, 105u8, 111u8, 110u8, 32u8, 110u8, 101u8, 119u8, 32u8, 100u8, 101u8, 115u8, 116u8, 114u8, 111u8, 121u8, 32u8, 49u8, 50u8, 51u8, 117u8, 54u8, 52u8, 32u8, 48u8, 120u8, 65u8, 66u8, 105u8, 51u8, 50u8, 10u8, 0u8]
    lexer: mutable FrontendLexer = frontend_new_lexer(a, "frontend_kind_only_test.llcontext".cast[any u8&], (&bytes[0u]).cast[any u8&])

    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.False):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.True):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Zeroed):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Ident):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Ident):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Ident):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.IntLit):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.HexLit):
        return false
    if not frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Newline):
        return false
    return frontend_kind_eq(frontend_next_token_kind((&lexer).cast[any FrontendLexer&]), FrontendTokenKind.Eof)


def frontend_lexer_parity_suite_impl() -> int can[Memory.Allocate, Abort.Panic]:
    if not frontend_case_simple_ident():
        return 0
    if not frontend_case_arrow_ops():
        return 0
    if not frontend_case_number_literals():
        return 0
    if not frontend_case_indent_dedent():
        return 0
    if not frontend_case_comment_and_ellipsis():
        return 0
    if not frontend_case_shift_ops():
        return 0
    if not frontend_case_paren_suppresses_newline():
        return 0
    if not frontend_case_region_alloc_syntax():
        return 0
    if not frontend_case_kind_only_keyword_path():
        return 0
    return 1


def frontend_count_tokens(a: any Arena&, filename: any u8&, source: any u8&) -> usize can[Memory.Allocate, Abort.Panic]:
    return frontend_count_tokens_with_len(a, filename, source, runtime_strlen(source))


def frontend_count_tokens_with_len(a: any Arena&, filename: any u8&, source: any u8&, source_len: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    lexer: mutable FrontendLexer = frontend_new_lexer_with_len(a, filename, source, source_len)
    count: mutable usize = 0u

    while true:
        kind: FrontendTokenKind = frontend_next_token_kind((&lexer).cast[any FrontendLexer&])
        count <- count + 1u
        match kind:
            FrontendTokenKind.Eof:
                return count

    return count


def frontend_lexer_token_count_impl(source: any u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return frontend_lexer_token_count_with_len_impl(source, runtime_strlen(source))


def frontend_lexer_token_count_with_len_impl(source: any u8&, source_len: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
    arena: any Arena& = (&frontend_lexer_bench_arena).cast[any Arena&]
    arena_reset(arena)
    return frontend_count_tokens_with_len(arena, "frontend_lexer_bench.llcontext".cast[any u8&], source, source_len).i64()


def frontend_lexer_token_checksum_impl(source: any u8&) -> u64 can[Memory.Allocate, Abort.Panic]:
    return frontend_lexer_token_checksum_with_len_impl(source, runtime_strlen(source))


def frontend_lexer_token_checksum_with_len_impl(source: any u8&, source_len: usize) -> u64 can[Memory.Allocate, Abort.Panic]:
    arena: any Arena& = (&frontend_lexer_bench_arena).cast[any Arena&]
    arena_reset(arena)
    tokens: darray[FrontendToken] = frontend_tokenize_with_len(arena, "frontend_lexer_bench.llcontext".cast[any u8&], source, source_len)
    return frontend_token_checksum(tokens)


def frontend_lexer_token_kind_at_impl(source: any u8&, index: usize) -> u64 can[Memory.Allocate, Abort.Panic]:
    return frontend_lexer_token_kind_at_with_len_impl(source, runtime_strlen(source), index)


def frontend_lexer_token_kind_at_with_len_impl(source: any u8&, source_len: usize, index: usize) -> u64 can[Memory.Allocate, Abort.Panic]:
    arena: any Arena& = (&frontend_lexer_bench_arena).cast[any Arena&]
    arena_reset(arena)
    tokens: darray[FrontendToken] = frontend_tokenize_with_len(arena, "frontend_lexer_bench.llcontext".cast[any u8&], source, source_len)
    if index >= tokens.count:
        return 0u64
    return frontend_token_kind_code(tokens[index].kind)


def frontend_lexer_copy_token_kinds_impl(source: any u8&, out: any u64&, capacity: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    return frontend_lexer_copy_token_kinds_with_len_impl(source, runtime_strlen(source), out, capacity)


def frontend_lexer_copy_token_kinds_with_len_impl(source: any u8&, source_len: usize, out: any u64&, capacity: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    arena: any Arena& = (&frontend_lexer_bench_arena).cast[any Arena&]
    arena_reset(arena)
    tokens: darray[FrontendToken] = frontend_tokenize_with_len(arena, "frontend_lexer_bench.llcontext".cast[any u8&], source, source_len)
    if capacity < tokens.count:
        return tokens.count

    i: mutable usize = 0u
    while i < tokens.count:
        out[i] <- frontend_token_kind_code(tokens[i].kind)
        i <- i + 1u
    return tokens.count

export func frontend_lexer_parity_suite() -> int = frontend_lexer_parity_suite_impl
export func frontend_lexer_token_count(source: any u8&) -> i64 = frontend_lexer_token_count_impl
export func frontend_lexer_token_count_with_len(source: any u8&, source_len: usize) -> i64 = frontend_lexer_token_count_with_len_impl
export func frontend_lexer_token_checksum(source: any u8&) -> u64 = frontend_lexer_token_checksum_impl
export func frontend_lexer_token_checksum_with_len(source: any u8&, source_len: usize) -> u64 = frontend_lexer_token_checksum_with_len_impl
export func frontend_lexer_token_kind_at(source: any u8&, index: usize) -> u64 = frontend_lexer_token_kind_at_impl
export func frontend_lexer_token_kind_at_with_len(source: any u8&, source_len: usize, index: usize) -> u64 = frontend_lexer_token_kind_at_with_len_impl
export func frontend_lexer_copy_token_kinds(source: any u8&, out: any u64&, capacity: usize) -> usize = frontend_lexer_copy_token_kinds_impl
export func frontend_lexer_copy_token_kinds_with_len(source: any u8&, source_len: usize, out: any u64&, capacity: usize) -> usize = frontend_lexer_copy_token_kinds_with_len_impl
