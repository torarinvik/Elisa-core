def large_document_tests[@r](a: mutable Arena& @r):
    can Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast, Atomics.Exchange, Atomics.Store, Global.Read, Global.Write:
        check_grid(a, 50, 50)
        check_grid(a, 300, 3)
        check_grid(a, 3, 700)

# ------------------------------------------------------------
# C-string surfaces
# ------------------------------------------------------------

def cstr_tests[@r](a: mutable Arena& @r):
    can Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast, Atomics.Exchange, Atomics.Store, Global.Read, Global.Write:
        fallback: JsonValueHandle[r] = json_handle_bool(a, false)
        # json_parse_cstr is json_parse over a NUL-terminated string.
        doc: JsonValueHandle[r] = try json_parse_cstr(a, "{\"a\":[1,2]}") else fallback
        assert_eq(json_handle_object_len(doc), 1)
        assert_eq(json_handle_array_len(try json_handle_get(doc, sview("a", 0, -1)) else fallback), 2)
        catch json_parse_cstr(a, "{\"a\":}"):
            ok:
                fail("json_parse_cstr accepted a malformed document")
            error e:
                assert_true(true)

        # json_handle_as_cstr borrows the decoded bytes, which are always NUL-terminated.
        text: JsonValueHandle[r] = parse_or_fail(a, "\"hi\\u00e9\"")
        decoded: cstr = try json_handle_as_cstr(text) else "".cast[cstr]
        assert_true(decoded == "hié")
        catch json_handle_as_cstr(doc):
            ok:
                fail("an object is not a string")
            error e:
                assert_true(true)
        # An embedded NUL truncates the C view but not the sview.
        with_nul: JsonValueHandle[r] = parse_or_fail(a, "\"a\\u0000b\"")
        assert_eq((try json_handle_as_string(with_nul) else sview("", 0, 0)).len, 3)
        truncated: cstr = try json_handle_as_cstr(with_nul) else "".cast[cstr]
        assert_true(truncated == "a")

# ------------------------------------------------------------
# CPython parity (GENERATED)
# ------------------------------------------------------------
#
# For each document: the canonical dump must equal CPython's, and serialising
# and re-parsing must reproduce that same dump.

def parity_tests[@r](a: mutable Arena& @r):
    can Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast, Atomics.Exchange, Atomics.Store, Global.Read, Global.Write:
        # null
        check_parity(a, "null", "N")
        check_roundtrip(a, "null", "N")
        # true
        check_parity(a, "true", "B:1")
        check_roundtrip(a, "true", "B:1")
        # false
        check_parity(a, "false", "B:0")
        check_roundtrip(a, "false", "B:0")
        # zero
        check_parity(a, "0", "D:0")
        check_roundtrip(a, "0", "D:0")
        # neg_zero
        check_parity(a, "-0", "D:-0")
        check_roundtrip(a, "-0", "D:-0")
        # one
        check_parity(a, "1", "D:1")
        check_roundtrip(a, "1", "D:1")
        # neg_one
        check_parity(a, "-1", "D:-1")
        check_roundtrip(a, "-1", "D:-1")
        # big_int
        check_parity(a, "9007199254740993", "D:9007199254740992")
        check_roundtrip(a, "9007199254740993", "D:9007199254740992")
        # frac
        check_parity(a, "1.5", "D:1.5")
        check_roundtrip(a, "1.5", "D:1.5")
        # neg_frac
        check_parity(a, "-0.25", "D:-0.25")
        check_roundtrip(a, "-0.25", "D:-0.25")
        # small_frac
        check_parity(a, "0.1", "D:0.10000000000000001")
        check_roundtrip(a, "0.1", "D:0.10000000000000001")
        # third
        check_parity(a, "0.3333333333333333", "D:0.33333333333333331")
        check_roundtrip(a, "0.3333333333333333", "D:0.33333333333333331")
        # exp_pos
        check_parity(a, "1e3", "D:1000")
        check_roundtrip(a, "1e3", "D:1000")
        # exp_plus
        check_parity(a, "1E+3", "D:1000")
        check_roundtrip(a, "1E+3", "D:1000")
        # exp_neg
        check_parity(a, "1e-3", "D:0.001")
        check_roundtrip(a, "1e-3", "D:0.001")
        # exp_frac
        check_parity(a, "-1.25e2", "D:-125")
        check_roundtrip(a, "-1.25e2", "D:-125")
        # exp_big
        check_parity(a, "1e308", "D:1e+308")
        check_roundtrip(a, "1e308", "D:1e+308")
        # exp_tiny
        check_parity(a, "5e-324", "D:4.9406564584124654e-324")
        check_roundtrip(a, "5e-324", "D:4.9406564584124654e-324")
        # many_digits
        check_parity(a, "1.234567890123456789", "D:1.2345678901234567")
        check_roundtrip(a, "1.234567890123456789", "D:1.2345678901234567")
        # zero_frac_exp
        check_parity(a, "0.0e0", "D:0")
        check_roundtrip(a, "0.0e0", "D:0")
        # empty_string
        check_parity(a, "\"\"", "S:0:")
        check_roundtrip(a, "\"\"", "S:0:")
        # plain_string
        check_parity(a, "\"hello\"", "S:5:68656c6c6f")
        check_roundtrip(a, "\"hello\"", "S:5:68656c6c6f")
        # string_spaces
        check_parity(a, "\"a b c\"", "S:5:6120622063")
        check_roundtrip(a, "\"a b c\"", "S:5:6120622063")
        # escape_quote
        check_parity(a, "\"a\\\"b\"", "S:3:612262")
        check_roundtrip(a, "\"a\\\"b\"", "S:3:612262")
        # escape_backslash
        check_parity(a, "\"a\\\\b\"", "S:3:615c62")
        check_roundtrip(a, "\"a\\\\b\"", "S:3:615c62")
        # escape_solidus
        check_parity(a, "\"a\\/b\"", "S:3:612f62")
        check_roundtrip(a, "\"a\\/b\"", "S:3:612f62")
        # escape_backspace
        check_parity(a, "\"a\\bb\"", "S:3:610862")
        check_roundtrip(a, "\"a\\bb\"", "S:3:610862")
        # escape_formfeed
        check_parity(a, "\"a\\fb\"", "S:3:610c62")
        check_roundtrip(a, "\"a\\fb\"", "S:3:610c62")
        # escape_newline
        check_parity(a, "\"a\\nb\"", "S:3:610a62")
        check_roundtrip(a, "\"a\\nb\"", "S:3:610a62")
        # escape_return
        check_parity(a, "\"a\\rb\"", "S:3:610d62")
        check_roundtrip(a, "\"a\\rb\"", "S:3:610d62")
        # escape_tab
        check_parity(a, "\"a\\tb\"", "S:3:610962")
        check_roundtrip(a, "\"a\\tb\"", "S:3:610962")
        # escape_all
        check_parity(a, "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", "S:8:225c2f080c0a0d09")
        check_roundtrip(a, "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", "S:8:225c2f080c0a0d09")
        # unicode_ascii
        check_parity(a, "\"\\u0041\"", "S:1:41")
        check_roundtrip(a, "\"\\u0041\"", "S:1:41")
        # unicode_nul_free_low
        check_parity(a, "\"\\u0001\"", "S:1:01")
        check_roundtrip(a, "\"\\u0001\"", "S:1:01")
        # unicode_latin
        check_parity(a, "\"\\u00e9\"", "S:2:c3a9")
        check_roundtrip(a, "\"\\u00e9\"", "S:2:c3a9")
        # unicode_bmp
        check_parity(a, "\"\\u20ac\"", "S:3:e282ac")
        check_roundtrip(a, "\"\\u20ac\"", "S:3:e282ac")
        # unicode_cjk
        check_parity(a, "\"\\u4e2d\\u6587\"", "S:6:e4b8ade69687")
        check_roundtrip(a, "\"\\u4e2d\\u6587\"", "S:6:e4b8ade69687")
        # surrogate_pair
        check_parity(a, "\"\\ud83d\\ude00\"", "S:4:f09f9880")
        check_roundtrip(a, "\"\\ud83d\\ude00\"", "S:4:f09f9880")
        # surrogate_pair_max
        check_parity(a, "\"\\udbff\\udfff\"", "S:4:f48fbfbf")
        check_roundtrip(a, "\"\\udbff\\udfff\"", "S:4:f48fbfbf")
        # surrogate_mixed
        check_parity(a, "\"a\\ud83d\\ude00b\"", "S:6:61f09f988062")
        check_roundtrip(a, "\"a\\ud83d\\ude00b\"", "S:6:61f09f988062")
        # raw_utf8
        check_parity(a, "\"café 中文 😀\"", "S:17:636166c3a920e4b8ade6968720f09f9880")
        check_roundtrip(a, "\"café 中文 😀\"", "S:17:636166c3a920e4b8ade6968720f09f9880")
        # empty_array
        check_parity(a, "[]", "A:0()")
        check_roundtrip(a, "[]", "A:0()")
        # empty_object
        check_parity(a, "{}", "O:0()")
        check_roundtrip(a, "{}", "O:0()")
        # array_scalars
        check_parity(a, "[1,2,3]", "A:3(D:1 D:2 D:3)")
        check_roundtrip(a, "[1,2,3]", "A:3(D:1 D:2 D:3)")
        # array_mixed
        check_parity(a, "[null,true,false,0,\"s\",[],{}]", "A:7(N B:1 B:0 D:0 S:1:73 A:0() O:0())")
        check_roundtrip(a, "[null,true,false,0,\"s\",[],{}]", "A:7(N B:1 B:0 D:0 S:1:73 A:0() O:0())")
        # array_nested
        check_parity(a, "[[1,[2,[3,[4]]]]]", "A:1(A:2(D:1 A:2(D:2 A:2(D:3 A:1(D:4)))))")
        check_roundtrip(a, "[[1,[2,[3,[4]]]]]", "A:1(A:2(D:1 A:2(D:2 A:2(D:3 A:1(D:4)))))")
        # object_simple
        check_parity(a, "{\"a\":1}", "O:1(S:1:61=D:1)")
        check_roundtrip(a, "{\"a\":1}", "O:1(S:1:61=D:1)")
        # object_multi
        check_parity(a, "{\"a\":1,\"b\":2,\"c\":3}", "O:3(S:1:61=D:1 S:1:62=D:2 S:1:63=D:3)")
        check_roundtrip(a, "{\"a\":1,\"b\":2,\"c\":3}", "O:3(S:1:61=D:1 S:1:62=D:2 S:1:63=D:3)")
        # object_nested
        check_parity(a, "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":null}]}}}", "O:1(S:1:61=O:1(S:1:62=O:1(S:1:63=A:3(D:1 D:2 O:1(S:1:64=N)))))")
        check_roundtrip(a, "{\"a\":{\"b\":{\"c\":[1,2,{\"d\":null}]}}}", "O:1(S:1:61=O:1(S:1:62=O:1(S:1:63=A:3(D:1 D:2 O:1(S:1:64=N)))))")
        # object_empty_key
        check_parity(a, "{\"\":1}", "O:1(S:0:=D:1)")
        check_roundtrip(a, "{\"\":1}", "O:1(S:0:=D:1)")
        # object_escaped_key
        check_parity(a, "{\"a\\nb\":1,\"\\u00e9\":2}", "O:2(S:3:610a62=D:1 S:2:c3a9=D:2)")
        check_roundtrip(a, "{\"a\\nb\":1,\"\\u00e9\":2}", "O:2(S:3:610a62=D:1 S:2:c3a9=D:2)")
        # object_dup_keys
        check_parity(a, "{\"a\":1,\"a\":2}", "O:2(S:1:61=D:1 S:1:61=D:2)")
        check_roundtrip(a, "{\"a\":1,\"a\":2}", "O:2(S:1:61=D:1 S:1:61=D:2)")
        # whitespace_everywhere
        check_parity(a, " \t\r\n{ \"a\" : [ 1 , 2 ] , \"b\" : null } \t\r\n", "O:2(S:1:61=A:2(D:1 D:2) S:1:62=N)")
        check_roundtrip(a, " \t\r\n{ \"a\" : [ 1 , 2 ] , \"b\" : null } \t\r\n", "O:2(S:1:61=A:2(D:1 D:2) S:1:62=N)")
        # deep_ish
        check_parity(a, "[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]", "A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(D:1))))))))))))))))))))")
        check_roundtrip(a, "[[[[[[[[[[[[[[[[[[[[1]]]]]]]]]]]]]]]]]]]]", "A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(A:1(D:1))))))))))))))))))))")
        # doc
        check_parity(a, "{\"name\":\"elisa\",\"version\":2,\"tags\":[\"lang\",\"compiler\"],\"meta\":{\"stable\":false,\"score\":-12.5e-2},\"none\":null}", "O:5(S:4:6e616d65=S:5:656c697361 S:7:76657273696f6e=D:2 S:4:74616773=A:2(S:4:6c616e67 S:8:636f6d70696c6572) S:4:6d657461=O:2(S:6:737461626c65=B:0 S:5:73636f7265=D:-0.125) S:4:6e6f6e65=N)")
        check_roundtrip(a, "{\"name\":\"elisa\",\"version\":2,\"tags\":[\"lang\",\"compiler\"],\"meta\":{\"stable\":false,\"score\":-12.5e-2},\"none\":null}", "O:5(S:4:6e616d65=S:5:656c697361 S:7:76657273696f6e=D:2 S:4:74616773=A:2(S:4:6c616e67 S:8:636f6d70696c6572) S:4:6d657461=O:2(S:6:737461626c65=B:0 S:5:73636f7265=D:-0.125) S:4:6e6f6e65=N)")

# ------------------------------------------------------------
# Malformed input (GENERATED)
# ------------------------------------------------------------
#
# Every document here is one CPython's json module also rejects. The expected
# code/position pair is the module's own contract; the variant each code maps to
# is listed alongside. All ten JsonError variants are covered.

def malformed_tests[@r](a: mutable Arena& @r):
    can Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast, Atomics.Exchange, Atomics.Store, Global.Read, Global.Write:
        # empty_input -> UNEXPECTED_END
        check_rejected(a, "", 1, 0)
        # only_ws -> UNEXPECTED_END
        check_rejected(a, "   \t\n", 1, 5)
        # bare_word -> INVALID_LITERAL
        check_rejected(a, "nul", 3, 0)
        # bad_true -> INVALID_LITERAL
        check_rejected(a, "tru", 3, 0)
        # bad_false -> INVALID_LITERAL
        check_rejected(a, "fals", 3, 0)
        # lone_quote -> INVALID_STRING
        check_rejected(a, "\"", 5, 0)
        # unterminated_string -> INVALID_STRING
        check_rejected(a, "\"abc", 5, 0)
        # raw_control_in_string -> INVALID_STRING
        check_rejected(a, "\"a\nb\"", 5, 2)
        # bad_escape -> INVALID_ESCAPE
        check_rejected(a, "\"a\\qb\"", 6, 2)
        # short_unicode_escape -> INVALID_ESCAPE
        check_rejected(a, "\"\\u12\"", 6, 1)
        # bad_unicode_digits -> INVALID_ESCAPE
        check_rejected(a, "\"\\u12g4\"", 6, 1)
        # trailing_backslash -> INVALID_ESCAPE
        check_rejected(a, "\"abc\\", 6, 4)
        # leading_plus -> UNEXPECTED_CHAR
        check_rejected(a, "+1", 2, 0)
        # leading_zero -> TRAILING_DATA
        check_rejected(a, "01", 9, 1)
        # bare_dot -> UNEXPECTED_CHAR
        check_rejected(a, ".5", 2, 0)
        # trailing_dot -> INVALID_NUMBER
        check_rejected(a, "5.", 4, 0)
        # exp_no_digits -> INVALID_NUMBER
        check_rejected(a, "1e", 4, 0)
        # exp_only_sign -> INVALID_NUMBER
        check_rejected(a, "1e+", 4, 0)
        # lone_minus -> INVALID_NUMBER
        check_rejected(a, "-", 4, 0)
        # minus_no_digit -> INVALID_NUMBER
        check_rejected(a, "-a", 4, 0)
        # hex_number -> TRAILING_DATA
        check_rejected(a, "0x10", 9, 1)
        # array_unclosed -> UNEXPECTED_END
        check_rejected(a, "[1,2", 1, 4)
        # array_trailing_comma -> UNEXPECTED_CHAR
        check_rejected(a, "[1,]", 2, 3)
        # array_missing_comma -> EXPECTED_COMMA_OR_END
        check_rejected(a, "[1 2]", 8, 3)
        # array_bad_close -> EXPECTED_COMMA_OR_END
        check_rejected(a, "[1}", 8, 2)
        # object_unclosed -> UNEXPECTED_END
        check_rejected(a, "{\"a\":1", 1, 6)
        # object_trailing_comma -> UNEXPECTED_CHAR
        check_rejected(a, "{\"a\":1,}", 2, 7)
        # object_missing_colon -> EXPECTED_COLON
        check_rejected(a, "{\"a\" 1}", 7, 5)
        # object_unquoted_key -> UNEXPECTED_CHAR
        check_rejected(a, "{a:1}", 2, 1)
        # object_missing_comma -> EXPECTED_COMMA_OR_END
        check_rejected(a, "{\"a\":1 \"b\":2}", 8, 7)
        # object_bad_close -> EXPECTED_COMMA_OR_END
        check_rejected(a, "{\"a\":1]", 8, 6)
        # object_no_value -> UNEXPECTED_CHAR
        check_rejected(a, "{\"a\":}", 2, 5)
        # trailing_data -> TRAILING_DATA
        check_rejected(a, "1 2", 9, 2)
        # two_docs -> TRAILING_DATA
        check_rejected(a, "{} {}", 9, 3)
        # trailing_bracket -> TRAILING_DATA
        check_rejected(a, "[]]", 9, 2)
        # nan_literal -> UNEXPECTED_CHAR
        check_rejected(a, "NaN", 2, 0)
        # infinity_literal -> UNEXPECTED_CHAR
        check_rejected(a, "Infinity", 2, 0)
        # single_quotes -> UNEXPECTED_CHAR
        check_rejected(a, "'a'", 2, 0)

# ------------------------------------------------------------
# Deliberately stricter than CPython (GENERATED)
# ------------------------------------------------------------
#
# CPython's json module ACCEPTS these; this module rejects them on purpose.
# Lone surrogates cannot be encoded as well-formed UTF-8, and a parsed string
# stores decoded bytes, so they have nowhere to go.

def stricter_than_python_tests[@r](a: mutable Arena& @r):
    can Memory.Allocate, Abort.Panic, Console.Format, Unsafe.PointerCast, Atomics.Exchange, Atomics.Store, Global.Read, Global.Write:
        # lone_high_surrogate -> INVALID_ESCAPE
        check_rejected(a, "\"\\ud83d\"", 6, 1)
        # lone_low_surrogate -> INVALID_ESCAPE
        check_rejected(a, "\"\\udc00\"", 6, 1)
        # high_then_plain -> INVALID_ESCAPE
        check_rejected(a, "\"\\ud83dx\"", 6, 1)
        # high_then_bmp -> INVALID_ESCAPE
        check_rejected(a, "\"\\ud83d\\u0041\"", 6, 1)

