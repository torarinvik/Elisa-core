enum TokenKind:
    EOF
    INT
    PLUS
    MINUS
    EQ
    SEMICOLON


struct Token:
    kind: TokenKind


struct ParserState:
    cursor: mutable usize


def current_token(self: ParserState&) -> Token:
    return Token{kind: TokenKind.EOF}


def advance_token(self: mutable ParserState&) -> void:
    self.cursor <- self.cursor + 1


def token_kind_for_text(text: cstr) -> TokenKind:
    match text:
        "+":
            return TokenKind.PLUS
        "-":
            return TokenKind.MINUS
        "=":
            return TokenKind.EQ
        ";":
            return TokenKind.SEMICOLON
        _:
            return TokenKind.EOF


def expect(self: mutable ParserState&, text: cstr) -> Token:
    return Token{kind: token_kind_for_text(text)}


def expect_kind(self: mutable ParserState&, kind: TokenKind) -> Token:
    return Token{kind: kind}


def record_parse_error(self: mutable ParserState&, message: cstr) -> void:
    pass


grammar ArithmeticBase over Token using ParserState:
    cursor self
    token_kind TokenKind
    eof TokenKind.EOF
    token_field kind
    current current_token
    advance advance_token
    expect expect
    expect_kind expect_kind
    record_error record_parse_error
    token:
        INT
        PLUS "+"
        MINUS "-"
        EQ "="
        SEMICOLON ";"
    recovery ExprRecovery:
        message "expected expression"
        until .SEMICOLON, token(TokenKind.EOF)
        fallback zeroed as Token
    infix table ExprTable(compare):
        atom = token(TokenKind.INT)
        additive(add_left = atom()):
            op = .PLUS | .MINUS right = atom() -> right
        compare(compare_left = additive()):
            op = .EQ right = additive() -> right
    expression(self: mutable ParserState&) -> Token:
        result = infix(ExprTable)
        return result


grammar StatementGrammar over Token using ParserState uses ArithmeticBase:
    cursor self
    token_kind TokenKind
    eof TokenKind.EOF
    token_field kind
    current current_token
    advance advance_token
    expect expect
    expect_kind expect_kind
    record_error record_parse_error
    statement(self: mutable ParserState&) -> Token:
        value = infix(ExprTable)
        return value
    recovering_atom(self: mutable ParserState&) -> Token:
        value = token(TokenKind.INT) recover ExprRecovery
        return value


def grammar_uses_parse_statement(self: mutable ParserState&) -> Token:
    return statement(self)


def grammar_uses_recovering_atom(self: mutable ParserState&) -> Token:
    return recovering_atom(self)