enum Expr:
	Int(value: int)
	Add(left: Expr&, right: Expr&)

def eval(node: Expr&) -> int:
	match node[0]:
		Expr.Int(value):
			return value
		Expr.Add(left, right):
			return eval(left) + eval(right)

def make_sum() -> int:
	region scratch(1024)
	one_value: Expr = Expr.Int(1)
	two_value: Expr = Expr.Int(2)
	one: scratch Expr& = new[scratch] one_value
	two: scratch Expr& = new[scratch] two_value
	tree: scratch Expr& = new[scratch] Expr.Add(one.cast[Expr&], two.cast[Expr&])
	out: int = eval(tree.cast[Expr&])
	destroy scratch
	return out
