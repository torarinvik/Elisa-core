def json_parser_ast_field_string_eq_impl(source: u8&, key: u8&, literal: u8&) -> i64:
    trusted Unsafe.PointerCast:
        can Memory.Allocate, Abort.Panic:
            source_len: usize = runtime_strlen(source)
            region scratch(json_ast_scratch_capacity(source_len))
            store: JsonNode.Store[Local] = JsonNode.Store(scratch)
            arena: mutable Arena& = (&scratch).cast[mutable Arena&]
            result: JsonParseNodeResult = json_parse_document_node_with_len(source, source_len, arena, store)
            if result.checksum < 0:
                destroy scratch
                return -1
            field_node: JsonNode = json_ast_object_get(result.node, source, key, store)
            if json_node_is_invalid(field_node, store):
                destroy scratch
                return -1
            out: i64 = 1 if json_ast_string_eq_literal(source, field_node, literal, store) else 0
            destroy scratch
            return out
