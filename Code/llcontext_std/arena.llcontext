# ============================================================
# Arena allocator - low level Contextlang runtime dialect
# ============================================================

const ARENA_BACKEND_LIBC_MALLOC = 0
const ARENA_BACKEND_LINUX_MMAP = 1
const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2
const ARENA_BACKEND_WASM_HEAPBASE = 3

const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

const ARENA_REGION_DEFAULT_CAPACITY: usize = 8 * 1024
const ARENA_WASM_PAGE_SIZE: usize = 64 * 1024

error RuntimeError:
    OutOfMemory

# ------------------------------------------------------------
# Basic low-level types
# ------------------------------------------------------------

struct Region:
    next: mutable heap Region&?
    count: mutable usize
    capacity: mutable usize
    owner_tag: mutable uintptr
    owner_next: mutable heap Region&?
    global_index: mutable usize
    data: tail uintptr

struct Arena:
    begin:mutable heap Region&?
    end:mutable heap Region&?
    end_index: mutable usize

struct ArenaMark:
    region: heap Region&?
    count: usize

# ------------------------------------------------------------
# Backend FFI declarations
# ------------------------------------------------------------

static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
    extern malloc(size: usize) -> heap void&? can[Memory.Allocate]
    extern free(ptr: heap void&) can[Memory.Release]

static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const PROT_READ = 0x1
    const PROT_WRITE = 0x2
    const MAP_PRIVATE = 0x02
    const MAP_ANONYMOUS = 0x20

    extern mmap(
        addr: heap void&?,
        length: usize,
        prot: int,
        flags: int,
        fd: int,
        offset: isize
    ) -> heap void&?

    extern munmap(addr: heap void&, length: usize) -> int
    extern MAP_FAILED() -> heap void&?

static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04

    extern GetCurrentProcess() -> any void&
    extern VirtualAllocEx(
        process: any void&,
        address: heap void&?,
        size: usize,
        alloc_type: int,
        protect: int
    ) -> heap void&?

    extern VirtualFreeEx(
        process: any void&,
        address: heap void&,
        size: usize,
        free_type: int
    ) -> bool

static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
    extern __heap_base: heap u8&
    extern wasm_memory_size(index: int) -> int
    extern wasm_memory_grow(index: int, pages: usize) -> int

    global mutable bump_pointer: heap u8& = __heap_base

# ------------------------------------------------------------
# Small utilities
# ------------------------------------------------------------

def assert(condition: bool) can[Abort.Panic]:
    if not condition:
        panic("assert failed")

def max(a: usize, b: usize) -> usize:
    return a if a > b else b

def inv_handle(ptr: heap void&?) -> bool:
    return ptr == null

# ------------------------------------------------------------
# Pointer-state helpers
# ------------------------------------------------------------

def sfree[T](ptr: heap T&) -> heap T! can[Memory.Release]:
    free(ptr.cast[heap void&])
    return null

# ------------------------------------------------------------
# Region allocation / freeing
# ------------------------------------------------------------

def new_region_with_owner(capacity: usize, owner_tag: uintptr) -> heap Region& can[Memory.Allocate, Abort.Panic]:
    size_bytes: usize = sizeof(Region) + sizeof(uintptr) * capacity

    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        raw: heap void&? = malloc(size_bytes)
        assert raw != null
        r: heap Region& = raw.cast[heap Region&]

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        raw: heap void&? = mmap(
            null,
            size_bytes,
            PROT_READ | PROT_WRITE,
            MAP_ANONYMOUS | MAP_PRIVATE,
            -1,
            0
        )
        assert raw != MAP_FAILED()
        r: heap Region& = raw.cast[heap Region&]

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        raw: heap void&? = VirtualAllocEx(
            GetCurrentProcess(),
            null,
            size_bytes,
            MEM_COMMIT | MEM_RESERVE,
            PAGE_READWRITE
        )
        assert not inv_handle(raw)
        r: heap Region& = raw.cast[heap Region&]

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        r: heap Region& = bump_pointer.cast[heap Region&]
        current_memory_size: usize = ARENA_WASM_PAGE_SIZE * wasm_memory_size(0).usize()
        desired_memory_size: usize = bump_pointer.usize() + size_bytes

        if desired_memory_size > current_memory_size:
            delta_bytes: usize = desired_memory_size - current_memory_size
            delta_pages: usize = (delta_bytes + (ARENA_WASM_PAGE_SIZE - 1)) / ARENA_WASM_PAGE_SIZE

            grow_result: int = wasm_memory_grow(0, delta_pages)
            assert grow_result >= 0

        bump_pointer <- bump_pointer + size_bytes

    static else:
        static error("Unknown arena backend")

    r.next <- null
    r.count <- 0
    r.capacity <- capacity
    r.owner_tag <- owner_tag
    r.owner_next <- null
    r.global_index <- 0
    return r

def new_region(capacity: usize) -> heap Region& can[Memory.Allocate, Abort.Panic]:
    return new_region_with_owner(capacity, 0u64.uintptr())

def free_region(r: heap Region&) can[Memory.Release, Abort.Panic]:
    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        free(r.cast[heap void&])

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        size_bytes: usize = sizeof(Region) + sizeof(uintptr) * r.capacity
        ret: int = munmap(r.cast[heap void&], size_bytes)
        assert ret == 0

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        ok: bool = VirtualFreeEx(
            GetCurrentProcess(),
            r.cast[heap void&],
            0,
            MEM_RELEASE
        )
        assert ok

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        pass

def arena_alloc(a: any Arena&, size_bytes: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if a.end == null:
        assert a.begin == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end as & <- new_region(capacity)
        a.begin <- a.end
        a.end_index <- 0
        a.end.global_index <- 0

    assert a.end != null

    while (a.end.owner_tag != 0u64.uintptr() or a.end.count + size > a.end.capacity) and a.end.next != null:
        a.end <- a.end.next
        a.end_index <- a.end_index + 1

    if a.end.owner_tag != 0u64.uintptr() or a.end.count + size > a.end.capacity:
        assert a.end.next == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end.next as & <- new_region(capacity)
        a.end <- a.end.next
        a.end_index <- a.end_index + 1
        a.end.global_index <- a.end_index

    data_base: heap u8& = (a.end.cast[heap u8&] + sizeof(Region)).cast[heap u8&]
    offset_bytes: usize = a.end.count * sizeof(uintptr)
    result: heap void& = (data_base + offset_bytes).cast[heap void&]
    a.end.count <- a.end.count + size
    return result

def arena_realloc(a: any Arena&, oldptr: any void&, oldsz: usize, newsz: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    if newsz <= oldsz:
        return oldptr.cast[heap void&]

    newptr: heap void& = arena_alloc(a, newsz)
    newptr_bytes: heap u8& = newptr.cast[heap u8&]
    oldptr_bytes: any u8& = oldptr.cast[any u8&]

    i: mutable usize = 0
    while i < oldsz:
        newptr_bytes[i] <- oldptr_bytes[i]
        i <- i + 1

    return newptr

# ------------------------------------------------------------
# Memory/string helpers
# ------------------------------------------------------------

def arena_strlen(s: any u8&) -> usize:
    n:mutable usize = 0
    while s[n] != 0:
        n <- n + 1
    return n

def arena_memcpy(dest: any void&, src: any void&, n: usize) -> any void&:
    d: any u8& = dest.cast[any u8&]
    s: any u8& = src.cast[any u8&]

	i: mutable usize = 0
    while i < n:
        d[i] <- s[i]
        i <- i + 1

    return dest

def arena_memeq(lhs: any void&, rhs: any void&, n: usize) -> bool:
    left: any u8& = lhs.cast[any u8&]
    right: any u8& = rhs.cast[any u8&]

    i: mutable usize = 0
    while i < n:
        if left[i] != right[i]:
            return false
        i <- i + 1

    return true

def arena_strdup(a: any Arena&, cstr: any u8&) -> heap u8& can[Memory.Allocate, Abort.Panic]:
    n: usize = arena_strlen(cstr)
    dup: heap u8& = arena_alloc(a, n + 1).cast[heap u8&]
    arena_memcpy(dup.cast[any void&], cstr.cast[any void&], n)
    dup[n] <- 0
    return dup

def arena_memdup(a: any Arena&, data: any void&, size: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    dup: heap void& = arena_alloc(a, size)
    _ = arena_memcpy(dup.cast[any void&], data, size)
    return dup

# ------------------------------------------------------------
# Snapshot / rewind / reset / free / trim
# ------------------------------------------------------------

def arena_snapshot(a: any Arena&) -> ArenaMark:
    if a.end == null:
        assert a.begin == null
        return ArenaMark(null, 0)

    return ArenaMark(a.end, a.end.count)

def arena_reset(a: any Arena&):
    r: mutable heap Region&? = a.begin
    while r != null:
        r.count <- 0
        r <- r.next

    a.end <- a.begin
    a.end_index <- 0

def arena_rewind(a: any Arena&, m: ArenaMark):
    if m.region == null:
        arena_reset(a)
        return

    region: heap Region& = m.region
    region.count <- m.count

    r: mutable heap Region&? = region.next
    while r != null:
        r.count <- 0
        r <- r.next

    a.end as & <- region

    region_index: mutable usize = 0
    current: mutable heap Region&? = a.begin
    while current != null and current != region:
        current <- current.next
        region_index <- region_index + 1

    assert current != null
    a.end_index <- region_index

def arena_free(a: any Arena&) can[Memory.Release, Abort.Panic]:
    r: mutable heap Region&? = a.begin

    while r != null:
        r0: mutable heap Region& = r
        r <- r.next
        free_region(r0)

    a.begin as ! <- null
    a.end as ! <- null
    a.end_index <- 0

def arena_trim(a: any Arena&) can[Memory.Release, Abort.Panic]:
    if a.end == null:
        return

    r: mutable heap Region&? = a.end.next
    while r != null:
        r0: mutable heap Region& = r
        r <- r.next
        free_region(r0)

    a.end.next as ! <- null

# ------------------------------------------------------------
# Optional stdio formatting stubs
# ------------------------------------------------------------

extern va_list
extern va_copy(args: va_list) -> va_list
extern va_end(args: va_list)

extern vsnprintf(
    buffer: any u8&?,
    buffer_size: usize,
    format: any u8&,
    args: va_list
) -> int

def arena_vsprintf(a: any Arena&, format: any u8&, args: va_list) -> heap u8& can[Memory.Allocate, Console.Format, Abort.Panic]:
    args_copy: va_list = va_copy(args)
    n: int = vsnprintf(null, 0, format, args_copy)
    va_end(args_copy)

    assert n >= 0

    result: heap u8& = arena_alloc(a, n.usize() + 1).cast[heap u8&]
    _ = vsnprintf(result.cast[any u8&?], n.usize() + 1, format, args)
    return result
