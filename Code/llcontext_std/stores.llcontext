# ============================================================
# Packed store helpers - low level Contextlang runtime dialect
# ============================================================

# include "./heap.llcontext"

const PACKED_STORE_MIN_ROWS_PER_REGION: usize = 64

struct PackedStoreAllocResult:
    row: mutable heap void&?
    handle: mutable uintptr

struct PackedStoreIndexAllocResult:
    row: mutable heap void&?
    index: mutable u32

struct PackedStoreVariantRows:
    tag: mutable u32
    rows: mutable darray[uintptr]

struct PackedStoreState:
    head_region: mutable heap Region&?
    alloc_region: mutable heap Region&?
    alloc_region_index: mutable usize
    decode_region: mutable heap Region&?
    decode_region_index: mutable usize
    tail_region: mutable heap Region&?
    regions: mutable darray[heap Region&?]
    handles: mutable darray[uintptr]
    indices: mutable darray[u32]
    tags: mutable darray[u32]
    variant_slots: mutable darray[u32]
    variant_rows: mutable darray[PackedStoreVariantRows]
    prefix_words: mutable usize
    prefix_columns: mutable darray[uintptr]
    prefix_column_capacity: mutable usize
    side_words: mutable usize
    side_columns: mutable darray[uintptr]
    side_column_capacity: mutable usize
    row_words: mutable usize
    preferred_region_capacity: mutable usize

@inline(always)
def packed_store_region_data(r: heap Region&) -> heap u8&:
    return (r.cast[heap u8&] + sizeof(Region)).cast[heap u8&]

def packed_store_region_table(state: mutable any PackedStoreState&) -> mutable any darray[heap Region&?]&:
    return (&state.regions).cast[any darray[heap Region&?]&]

def packed_store_handle_table(state: mutable any PackedStoreState&) -> mutable any darray[uintptr]&:
    return (&state.handles).cast[any darray[uintptr]&]

def packed_store_index_table(state: mutable any PackedStoreState&) -> mutable any darray[u32]&:
    return (&state.indices).cast[any darray[u32]&]

def packed_store_tag_table(state: mutable any PackedStoreState&) -> mutable any darray[u32]&:
    return (&state.tags).cast[any darray[u32]&]

def packed_store_variant_slot_table(state: mutable any PackedStoreState&) -> mutable any darray[u32]&:
    return (&state.variant_slots).cast[any darray[u32]&]

def packed_store_variant_rows_table(state: mutable any PackedStoreState&) -> mutable any darray[PackedStoreVariantRows]&:
    return (&state.variant_rows).cast[any darray[PackedStoreVariantRows]&]

def packed_store_prefix_column_table(state: mutable any PackedStoreState&) -> mutable any darray[uintptr]&:
    return (&state.prefix_columns).cast[any darray[uintptr]&]

def packed_store_side_column_table(state: mutable any PackedStoreState&) -> mutable any darray[uintptr]&:
    return (&state.side_columns).cast[any darray[uintptr]&]

def packed_store_ensure_metadata_capacity(a: mutable any Arena&, state: mutable any PackedStoreState&, needed_rows: usize) can[Memory.Allocate, Abort.Panic]:
    handles: mutable any darray[uintptr]& = packed_store_handle_table(state)
    indices: mutable any darray[u32]& = packed_store_index_table(state)
    tags: mutable any darray[u32]& = packed_store_tag_table(state)
    variant_slots: mutable any darray[u32]& = packed_store_variant_slot_table(state)

    in a:
        _ = handles.reserve(needed_rows)
        _ = indices.reserve(needed_rows)
        _ = tags.reserve(needed_rows)
        _ = variant_slots.reserve(needed_rows)

    packed_store_ensure_prefix_columns(a, state, needed_rows)
    packed_store_ensure_side_columns(a, state, needed_rows)

def packed_store_append_handle(a: mutable any Arena&, state: mutable any PackedStoreState&, handle: uintptr) can[Memory.Allocate, Abort.Panic]:
    handles: mutable any darray[uintptr]& = packed_store_handle_table(state)
    in a:
        handles.push(handle)

def packed_store_append_index(a: mutable any Arena&, state: mutable any PackedStoreState&, index: u32) can[Memory.Allocate, Abort.Panic]:
    indices: mutable any darray[u32]& = packed_store_index_table(state)
    in a:
        indices.push(index)

def packed_store_append_tag(a: mutable any Arena&, state: mutable any PackedStoreState&, tag: u32) can[Memory.Allocate, Abort.Panic]:
    tags: mutable any darray[u32]& = packed_store_tag_table(state)
    in a:
        tags.push(tag)

def packed_store_append_variant_slot(a: mutable any Arena&, state: mutable any PackedStoreState&, slot: u32) can[Memory.Allocate, Abort.Panic]:
    variant_slots: mutable any darray[u32]& = packed_store_variant_slot_table(state)
    in a:
        variant_slots.push(slot)

def packed_store_find_variant_rows(state: mutable any PackedStoreState&, tag: u32) -> mutable any PackedStoreVariantRows&?:
    variants: any darray[PackedStoreVariantRows]& = packed_store_variant_rows_table(state)
    if variants.items == null:
        return null

    for i in 0..<variants.count:
        if variants.items[i].tag == tag:
            return &variants.items[i]

    return null

def packed_store_get_or_create_variant_rows(a: mutable any Arena&, state: mutable any PackedStoreState&, tag: u32) -> mutable any PackedStoreVariantRows& can[Memory.Allocate, Abort.Panic]:
    found: any PackedStoreVariantRows&? = packed_store_find_variant_rows(state, tag)
    if found != null:
        return found

    variants: mutable any darray[PackedStoreVariantRows]& = packed_store_variant_rows_table(state)
    created: mutable PackedStoreVariantRows = zeroed
    created.tag <- tag
    in a:
        variants.push(created)

    assert variants.items != null
    return &variants.items[variants.count - 1]

def packed_store_append_variant_row(a: mutable any Arena&, state: mutable any PackedStoreState&, tag: u32, row: any void&) -> u32 can[Memory.Allocate, Abort.Panic]:
    variant_rows: any PackedStoreVariantRows& = packed_store_get_or_create_variant_rows(a, state, tag)
    rows: mutable any darray[uintptr]& = (&variant_rows.rows).cast[mutable any darray[uintptr]&]
    slot: u32 = rows.count.u32()
    in a:
        rows.push(row.cast[any u8&].uintptr())
    return slot

def packed_store_variant_row_ptr(state: mutable any PackedStoreState&, tag: u32, slot: u32) -> mutable any void& can[Abort.Panic]:
    variant_rows: any PackedStoreVariantRows&? = packed_store_find_variant_rows(state, tag)
    assert variant_rows != null

    rows: any darray[uintptr]& = (&variant_rows.rows).cast[any darray[uintptr]&]
    slot_index: usize = slot.usize()
    assert rows.items != null
    assert slot_index < rows.count

    row_ptrs: any uintptr& = rows.items
    return row_ptrs[slot_index].cast[heap u8&].cast[mutable any void&]

def packed_store_ensure_prefix_columns(a: mutable any Arena&, state: mutable any PackedStoreState&, needed_rows: usize) can[Memory.Allocate, Abort.Panic]:
    if state.prefix_words == 0:
        return

    columns: mutable any darray[uintptr]& = packed_store_prefix_column_table(state)
    in a:
        for column_index in columns.count..<state.prefix_words:
            columns.push(0.uintptr())

    if state.prefix_column_capacity >= needed_rows:
        return

    new_capacity: mutable usize = ARENA_DA_INIT_CAP if state.prefix_column_capacity == 0 else state.prefix_column_capacity * 2
    while new_capacity < needed_rows:
        new_capacity <- new_capacity * 2

    old_size: usize = state.prefix_column_capacity * sizeof(uintptr)
    new_size: usize = new_capacity * sizeof(uintptr)
    assert columns.items != null
    column_ptrs: any uintptr& = columns.items
    for i in 0..<state.prefix_words:
        if column_ptrs[i] == 0.uintptr():
            column_ptrs[i] <- arena_alloc(a, new_size).cast[heap uintptr&].cast[heap u8&].uintptr()
        else:
            current_ptr: heap uintptr& = column_ptrs[i].cast[heap u8&].cast[heap uintptr&]
            column_ptrs[i] <- arena_realloc(
                a,
                current_ptr.cast[mutable any void&],
                old_size,
                new_size
            ).cast[heap uintptr&].cast[heap u8&].uintptr()
    state.prefix_column_capacity <- new_capacity

def packed_store_append_prefix_words(a: mutable any Arena&, state: mutable any PackedStoreState&, row: any void&) can[Memory.Allocate, Abort.Panic]:
    if state.prefix_words == 0:
        return
    needed_rows: usize = state.handles.count
    assert state.prefix_column_capacity >= needed_rows
    assert state.prefix_columns.items != null
    column_ptrs: any uintptr& = state.prefix_columns.items
    row_words: any uintptr& = row.cast[any uintptr&]
    row_index: usize = needed_rows - 1
    assert state.prefix_columns.count >= state.prefix_words

    if state.prefix_words == 1:
        assert column_ptrs[0] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- row_words[0]
        return

    if state.prefix_words == 2:
        assert column_ptrs[0] != 0.uintptr()
        assert column_ptrs[1] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column1: mutable any uintptr& = column_ptrs[1].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- row_words[0]
        column1[row_index] <- row_words[1]
        return

    if state.prefix_words == 3:
        assert column_ptrs[0] != 0.uintptr()
        assert column_ptrs[1] != 0.uintptr()
        assert column_ptrs[2] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column1: mutable any uintptr& = column_ptrs[1].cast[heap u8&].cast[any uintptr&]
        column2: mutable any uintptr& = column_ptrs[2].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- row_words[0]
        column1[row_index] <- row_words[1]
        column2[row_index] <- row_words[2]
        return

    for i in 0..<state.prefix_words:
        assert column_ptrs[i] != 0.uintptr()
        column: mutable any uintptr& = column_ptrs[i].cast[heap u8&].cast[any uintptr&]
        column[row_index] <- row_words[i]

def packed_store_ensure_side_columns(a: mutable any Arena&, state: mutable any PackedStoreState&, needed_rows: usize) can[Memory.Allocate, Abort.Panic]:
    if state.side_words == 0:
        return

    columns: mutable any darray[uintptr]& = packed_store_side_column_table(state)
    in a:
        for column_index in columns.count..<state.side_words:
            columns.push(0.uintptr())

    if state.side_column_capacity >= needed_rows:
        return

    new_capacity: mutable usize = ARENA_DA_INIT_CAP if state.side_column_capacity == 0 else state.side_column_capacity * 2
    while new_capacity < needed_rows:
        new_capacity <- new_capacity * 2

    old_size: usize = state.side_column_capacity * sizeof(uintptr)
    new_size: usize = new_capacity * sizeof(uintptr)
    assert columns.items != null
    column_ptrs: any uintptr& = columns.items
    for i in 0..<state.side_words:
        if column_ptrs[i] == 0.uintptr():
            column_ptrs[i] <- arena_alloc(a, new_size).cast[heap uintptr&].cast[heap u8&].uintptr()
        else:
            current_ptr: heap uintptr& = column_ptrs[i].cast[heap u8&].cast[heap uintptr&]
            column_ptrs[i] <- arena_realloc(
                a,
                current_ptr.cast[mutable any void&],
                old_size,
                new_size
            ).cast[heap uintptr&].cast[heap u8&].uintptr()
    state.side_column_capacity <- new_capacity

def packed_store_append_side_words(a: mutable any Arena&, state: mutable any PackedStoreState&, words: any void&) can[Memory.Allocate, Abort.Panic]:
    if state.side_words == 0:
        return
    needed_rows: usize = state.handles.count
    assert state.side_column_capacity >= needed_rows
    assert state.side_columns.items != null
    column_ptrs: any uintptr& = state.side_columns.items
    source_words: any uintptr& = words.cast[any uintptr&]
    row_index: usize = needed_rows - 1
    assert state.side_columns.count >= state.side_words

    if state.side_words == 1:
        assert column_ptrs[0] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- source_words[0]
        return

    if state.side_words == 2:
        assert column_ptrs[0] != 0.uintptr()
        assert column_ptrs[1] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column1: mutable any uintptr& = column_ptrs[1].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- source_words[0]
        column1[row_index] <- source_words[1]
        return

    if state.side_words == 3:
        assert column_ptrs[0] != 0.uintptr()
        assert column_ptrs[1] != 0.uintptr()
        assert column_ptrs[2] != 0.uintptr()
        column0: mutable any uintptr& = column_ptrs[0].cast[heap u8&].cast[any uintptr&]
        column1: mutable any uintptr& = column_ptrs[1].cast[heap u8&].cast[any uintptr&]
        column2: mutable any uintptr& = column_ptrs[2].cast[heap u8&].cast[any uintptr&]
        column0[row_index] <- source_words[0]
        column1[row_index] <- source_words[1]
        column2[row_index] <- source_words[2]
        return

    for i in 0..<state.side_words:
        assert column_ptrs[i] != 0.uintptr()
        column: mutable any uintptr& = column_ptrs[i].cast[heap u8&].cast[any uintptr&]
        column[row_index] <- source_words[i]

def packed_store_register_region(a: mutable any Arena&, state: mutable any PackedStoreState&, r: heap Region&?, global_index: usize) can[Memory.Allocate, Abort.Panic]:
    assert r != null

    regions: mutable any darray[heap Region&?]& = packed_store_region_table(state)

    in a:
        for region_slot in regions.count..<(global_index + 1):
            regions.push(null)

    assert regions.items != null
    regions.items[global_index] <- r

@inline(always)
def packed_store_lookup_region(state: mutable any PackedStoreState&, global_index: usize) -> heap Region&?:
    if state.regions.items == null:
        return null
    if global_index >= state.regions.count:
        return null
    return state.regions.items[global_index]

def ctx_packed_store_state_new(a: mutable any Arena&, row_bytes: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state: heap PackedStoreState& = arena_alloc(a, sizeof(PackedStoreState)).cast[heap PackedStoreState&]
    row_words: usize = (row_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)
    preferred_region_capacity: mutable usize = ARENA_REGION_DEFAULT_CAPACITY
    hinted_capacity: usize = row_words * PACKED_STORE_MIN_ROWS_PER_REGION

    if preferred_region_capacity < hinted_capacity:
        preferred_region_capacity <- hinted_capacity
    if preferred_region_capacity < row_words:
        preferred_region_capacity <- row_words

    state.head_region <- null
    state.alloc_region <- null
    state.alloc_region_index <- 0
    state.decode_region <- null
    state.decode_region_index <- 0
    state.tail_region <- null
    state.regions <- zeroed
    state.handles <- zeroed
    state.indices <- zeroed
    state.tags <- zeroed
    state.variant_slots <- zeroed
    state.variant_rows <- zeroed
    state.prefix_words <- row_words
    state.prefix_columns <- zeroed
    state.prefix_column_capacity <- 0
    state.side_words <- 0
    state.side_columns <- zeroed
    state.side_column_capacity <- 0
    state.row_words <- row_words
    state.preferred_region_capacity <- preferred_region_capacity
    return state.cast[heap void&]

def ctx_packed_store_state_new_with_prefix_words(a: mutable any Arena&, row_bytes: usize, prefix_words: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state_bits: heap void& = ctx_packed_store_state_new(a, row_bytes)
    state: heap PackedStoreState& = state_bits.cast[heap PackedStoreState&]
    if prefix_words < state.row_words:
        state.prefix_words <- prefix_words
    else:
        state.prefix_words <- state.row_words
    return state_bits

def ctx_packed_store_state_new_with_side_words(a: mutable any Arena&, row_bytes: usize, side_words: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state_bits: heap void& = ctx_packed_store_state_new(a, row_bytes)
    state: heap PackedStoreState& = state_bits.cast[heap PackedStoreState&]
    state.side_words <- side_words
    return state_bits

def ctx_packed_store_state_new_with_prefix_and_side_words(a: mutable any Arena&, row_bytes: usize, prefix_words: usize, side_words: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state_bits: heap void& = ctx_packed_store_state_new_with_prefix_words(a, row_bytes, prefix_words)
    state: heap PackedStoreState& = state_bits.cast[heap PackedStoreState&]
    state.side_words <- side_words
    return state_bits

def ctx_packed_store_state_new_variant_sparse(a: mutable any Arena&, row_bytes: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state: heap PackedStoreState& = arena_alloc(a, sizeof(PackedStoreState)).cast[heap PackedStoreState&]
    row_words: usize = (row_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)
    preferred_region_capacity: mutable usize = ARENA_REGION_DEFAULT_CAPACITY
    hinted_capacity: usize = row_words * PACKED_STORE_MIN_ROWS_PER_REGION

    if preferred_region_capacity < hinted_capacity:
        preferred_region_capacity <- hinted_capacity
    if preferred_region_capacity < row_words:
        preferred_region_capacity <- row_words

    state.head_region <- null
    state.alloc_region <- null
    state.alloc_region_index <- 0
    state.decode_region <- null
    state.decode_region_index <- 0
    state.tail_region <- null
    state.regions <- zeroed
    state.handles <- zeroed
    state.indices <- zeroed
    state.tags <- zeroed
    state.variant_slots <- zeroed
    state.variant_rows <- zeroed
    state.prefix_words <- 0
    state.prefix_columns <- zeroed
    state.prefix_column_capacity <- 0
    state.side_words <- 0
    state.side_columns <- zeroed
    state.side_column_capacity <- 0
    state.row_words <- row_words
    state.preferred_region_capacity <- preferred_region_capacity
    return state.cast[heap void&]

def ctx_packed_store_state_new_variant_sparse_with_side_words(a: mutable any Arena&, row_bytes: usize, side_words: usize) -> mutable heap void& can[Memory.Allocate, Abort.Panic]:
    state_bits: heap void& = ctx_packed_store_state_new_variant_sparse(a, row_bytes)
    state: heap PackedStoreState& = state_bits.cast[heap PackedStoreState&]
    state.side_words <- side_words
    return state_bits

def ctx_packed_store_alloc_result_slow(a: mutable any Arena&, size: usize, owner_tag: uintptr, state: mutable any PackedStoreState&) can[Memory.Allocate, Abort.Panic]:
    if state.alloc_region == null:
        capacity: mutable usize = state.preferred_region_capacity
        if capacity < size:
            capacity <- size

        if a.end == null:
            assert a.begin == null
            a.end as & <- new_region_with_owner(capacity, owner_tag)
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
        else:
            a.end.next as & <- new_region_with_owner(capacity, owner_tag)
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index

        state.head_region <- a.end
        state.alloc_region <- a.end
        state.alloc_region_index <- a.end_index
        state.tail_region <- a.end
        packed_store_register_region(a, state, a.end, a.end_index)
        return

    assert state.alloc_region != null
    assert state.tail_region != null

    cursor: mutable heap Region&? = state.alloc_region.owner_next
    found_region: mutable heap Region&? = null
    found_region_index: mutable usize = 0

    while cursor != null:
        if cursor.count + size <= cursor.capacity:
            found_region <- cursor
            found_region_index <- cursor.global_index
            cursor <- null
        else:
            cursor <- cursor.owner_next

    if found_region != null:
        state.alloc_region <- found_region
        state.alloc_region_index <- found_region_index
        return

    capacity: mutable usize = state.preferred_region_capacity
    grown_capacity: usize = state.alloc_region.capacity * 2
    if capacity < grown_capacity:
        capacity <- grown_capacity
    if capacity < size:
        capacity <- size

    assert a.end != null
    a.end.next as & <- new_region_with_owner(capacity, owner_tag)
    a.end <- a.end.next
    a.end_index <- a.end_index + 1
    a.end.global_index <- a.end_index
    state.tail_region.owner_next as & <- a.end
    state.tail_region <- a.end
    state.alloc_region <- a.end
    state.alloc_region_index <- a.end_index
    packed_store_register_region(a, state, a.end, a.end_index)

def ctx_packed_store_alloc_fixed_result_slow(a: mutable any Arena&, owner_tag: uintptr, state: mutable any PackedStoreState&) can[Memory.Allocate, Abort.Panic]:
    size: usize = state.row_words
    assert size > 0

    if state.alloc_region == null:
        capacity: mutable usize = state.preferred_region_capacity
        if capacity < size:
            capacity <- size

        if a.end == null:
            assert a.begin == null
            a.end as & <- new_region_with_owner(capacity, owner_tag)
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
        else:
            a.end.next as & <- new_region_with_owner(capacity, owner_tag)
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index

        state.head_region <- a.end
        state.alloc_region <- a.end
        state.alloc_region_index <- a.end_index
        state.tail_region <- a.end
        packed_store_register_region(a, state, a.end, a.end_index)
        return

    assert state.alloc_region != null
    assert state.tail_region != null

    capacity: mutable usize = state.preferred_region_capacity
    grown_capacity: usize = state.alloc_region.capacity * 2
    if capacity < grown_capacity:
        capacity <- grown_capacity
    if capacity < size:
        capacity <- size

    assert a.end != null
    a.end.next as & <- new_region_with_owner(capacity, owner_tag)
    a.end <- a.end.next
    a.end_index <- a.end_index + 1
    a.end.global_index <- a.end_index
    state.tail_region.owner_next as & <- a.end
    state.tail_region <- a.end
    state.alloc_region <- a.end
    state.alloc_region_index <- a.end_index
    packed_store_register_region(a, state, a.end, a.end_index)

def ctx_packed_store_alloc_fixed_result(a: mutable any Arena&, state_bits: mutable any void&) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    owner_tag: uintptr = state_bits.cast[any u8&].uintptr()
    size: usize = state.row_words
    assert size > 0

    if state.alloc_region == null or state.alloc_region.count + size > state.alloc_region.capacity:
        ctx_packed_store_alloc_fixed_result_slow(a, owner_tag, state)

    assert state.alloc_region != null

    data_base: heap u8& = packed_store_region_data(state.alloc_region)
    offset_bytes: uintptr = (state.alloc_region.count * sizeof(uintptr)).uintptr()
    ptr: heap void& = (data_base + state.alloc_region.count * sizeof(uintptr)).cast[heap void&]
    state.alloc_region.count <- state.alloc_region.count + size
    state.decode_region <- state.alloc_region
    state.decode_region_index <- state.alloc_region_index

    if a.end == null:
        a.end as & <- state.alloc_region
        a.end_index <- state.alloc_region_index

    offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
    handle: uintptr = (state.alloc_region_index.uintptr() << 32.uintptr()) | ((offset_words + 1.uintptr()) << 1.uintptr())
    global_index: u32 = state.handles.count.u32()
    needed_rows: usize = state.handles.count + 1
    packed_store_ensure_metadata_capacity(a, state, needed_rows)

    in a:
        state.handles.push(handle)
        state.indices.push(global_index)
    return PackedStoreAllocResult(ptr, handle)

def ctx_packed_store_alloc_fixed_tagged_result(a: mutable any Arena&, state_bits: mutable any void&, tag: u32) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_result(a, state_bits)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]

    needed_rows: mutable usize = state.tags.count + 1
    if needed_rows < state.handles.count:
        needed_rows <- state.handles.count

    packed_store_ensure_metadata_capacity(a, state, needed_rows)
    in a:
        state.tags.push(tag)
    return result

def ctx_packed_store_alloc_result(a: mutable any Arena&, size_bytes: usize, state_bits: mutable any void&) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    owner_tag: uintptr = state_bits.cast[any u8&].uintptr()
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if size > state.row_words:
        state.row_words <- size

        hinted_capacity: usize = state.row_words * PACKED_STORE_MIN_ROWS_PER_REGION
        if state.preferred_region_capacity < hinted_capacity:
            state.preferred_region_capacity <- hinted_capacity
        if state.preferred_region_capacity < state.row_words:
            state.preferred_region_capacity <- state.row_words

    if state.alloc_region == null or state.alloc_region.count + size > state.alloc_region.capacity:
        ctx_packed_store_alloc_result_slow(a, size, owner_tag, state)

    assert state.alloc_region != null

    data_base: heap u8& = packed_store_region_data(state.alloc_region)
    offset_bytes: uintptr = (state.alloc_region.count * sizeof(uintptr)).uintptr()
    ptr: heap void& = (data_base + state.alloc_region.count * sizeof(uintptr)).cast[heap void&]
    state.alloc_region.count <- state.alloc_region.count + size
    state.decode_region <- state.alloc_region
    state.decode_region_index <- state.alloc_region_index

    if a.end == null:
        a.end as & <- state.alloc_region
        a.end_index <- state.alloc_region_index

    offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
    handle: uintptr = (state.alloc_region_index.uintptr() << 32.uintptr()) | ((offset_words + 1.uintptr()) << 1.uintptr())
    global_index: u32 = state.handles.count.u32()
    needed_rows: usize = state.handles.count + 1
    packed_store_ensure_metadata_capacity(a, state, needed_rows)

    in a:
        state.handles.push(handle)
        state.indices.push(global_index)
    return PackedStoreAllocResult(ptr, handle)

def ctx_packed_store_alloc_fixed_index_result(a: mutable any Arena&, state_bits: mutable any void&) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_result(a, state_bits)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    assert state.indices.items != null
    assert state.indices.count > 0
    indices: any u32& = state.indices.items
    return PackedStoreIndexAllocResult(result.row, indices[state.indices.count - 1])

def ctx_packed_store_alloc_fixed_tagged_index_result(a: mutable any Arena&, state_bits: mutable any void&, tag: u32) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_tagged_result(a, state_bits, tag)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    assert state.indices.items != null
    assert state.indices.count > 0
    indices: any u32& = state.indices.items
    return PackedStoreIndexAllocResult(result.row, indices[state.indices.count - 1])

def ctx_packed_store_alloc_index_result(a: mutable any Arena&, size_bytes: usize, state_bits: mutable any void&) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_result(a, size_bytes, state_bits)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    assert state.indices.items != null
    assert state.indices.count > 0
    indices: any u32& = state.indices.items
    return PackedStoreIndexAllocResult(result.row, indices[state.indices.count - 1])

def ctx_packed_store_alloc_tagged_variant_sparse_result(a: mutable any Arena&, size_bytes: usize, state_bits: mutable any void&, tag: u32) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    row_words: mutable usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)
    if row_words == 0:
        row_words <- 1
    if row_words > state.row_words:
        state.row_words <- row_words

    row_size_bytes: usize = row_words * sizeof(uintptr)
    row: heap void& = arena_alloc(a, row_size_bytes)
    global_index: u32 = state.handles.count.u32()
    needed_rows: usize = state.handles.count + 1
    packed_store_ensure_metadata_capacity(a, state, needed_rows)

    slot: u32 = packed_store_append_variant_row(a, state, tag, row.cast[any void&])

    in a:
        state.handles.push(row.cast[any u8&].uintptr())
        state.indices.push(global_index)
        state.tags.push(tag)
        state.variant_slots.push(slot)

    return PackedStoreIndexAllocResult(row, global_index)

def ctx_packed_store_alloc_fixed_tagged_variant_sparse_result(a: mutable any Arena&, state_bits: mutable any void&, tag: u32) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    return ctx_packed_store_alloc_tagged_variant_sparse_result(a, state.row_words * sizeof(uintptr), state_bits, tag)

def ctx_packed_store_count(state_bits: mutable any void&) -> usize:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    return state.handles.count

def ctx_packed_store_reserve(a: mutable any Arena&, needed_rows: usize, state_bits: mutable any void&) can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]

    if needed_rows <= state.handles.capacity:
        return

    packed_store_ensure_metadata_capacity(a, state, needed_rows)

def ctx_packed_store_encode_variant_sparse(ptr: any void&, state_bits: mutable any void&) -> u32 can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    raw: uintptr = ptr.cast[any u8&].uintptr()
    assert state.handles.items != null

    handles: any uintptr& = state.handles.items
    for i in 0..<state.handles.count:
        if handles[i] == raw:
            return i.u32()

    panic("variant-sparse packed store encode missing row pointer")

def ctx_packed_store_decode_variant_sparse(index: u32, state_bits: mutable any void&) -> mutable any void& can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.handles.count
    assert state.handles.items != null

    handles: any uintptr& = state.handles.items
    return handles[index_usize].cast[heap u8&].cast[mutable any void&]

def ctx_packed_store_read_variant_sparse_tag(state_bits: mutable any void&, index: u32) -> u32:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.tags.count
    assert state.tags.items != null

    tags: any u32& = state.tags.items
    return tags[index_usize]

def ctx_packed_store_read_variant_sparse_word(index: u32, state_bits: mutable any void&, word_offset: usize) -> uintptr can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.tags.count
    assert state.tags.items != null
    assert state.variant_slots.items != null

    tags: any u32& = state.tags.items
    slots: any u32& = state.variant_slots.items
    row_words: any uintptr& = packed_store_variant_row_ptr(state, tags[index_usize], slots[index_usize]).cast[any uintptr&]
    return row_words[word_offset]

def ctx_packed_store_record_side_words(a: mutable any Arena&, words: any void&, state_bits: mutable any void&) can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    packed_store_append_side_words(a, state, words)

def ctx_packed_store_read_side_word(state_bits: mutable any void&, index: u32, word_offset: usize) -> uintptr can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.handles.count
    assert word_offset < state.side_words
    assert state.side_columns.items != null

    column_ptrs: any uintptr& = state.side_columns.items
    assert column_ptrs[word_offset] != 0.uintptr()
    column: any uintptr& = column_ptrs[word_offset].cast[heap u8&].cast[any uintptr&]
    return column[index_usize]

def ctx_packed_store_word_handle_at(state_bits: mutable any void&, index: usize) -> uintptr:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    assert state.handles.items != null
    assert index < state.handles.count
    handles: any uintptr& = state.handles.items
    return handles[index]

def ctx_packed_store_row_ptr_at(state_bits: mutable any void&, index: usize) -> mutable any void&:
    handle: uintptr = ctx_packed_store_word_handle_at(state_bits, index)
    assert handle != 0.uintptr()
    return handle.cast[any u8&].cast[mutable any void&]

def ctx_packed_store_index_at(state_bits: mutable any void&, index: usize) -> u32:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    assert state.indices.items != null
    assert index < state.indices.count
    indices: any u32& = state.indices.items
    return indices[index]

def ctx_packed_store_view(state_bits: mutable any void&, start: usize, end: usize) -> dview[uintptr]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    handles: any darray[uintptr]& = packed_store_handle_table(state)
    return arena_da_view(handles, start, end)

def ctx_packed_store_indices_view[T](state_bits: mutable any void&, start: usize, end: usize) -> dview[T]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    indices: any darray[u32]& = packed_store_index_table(state)
    return arena_da_view(indices.cast[any darray[T]&], start, end)

def ctx_packed_store_tags_view[T](state_bits: mutable any void&, start: usize, end: usize) -> dview[T]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    tags: any darray[u32]& = packed_store_tag_table(state)
    return arena_da_view(tags.cast[any darray[T]&], start, end)

def ctx_packed_store_record_row_ptr(a: mutable any Arena&, row: any void&, state_bits: mutable any void&) can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    packed_store_append_handle(a, state_bits.cast[any PackedStoreState&], row.cast[any u8&].uintptr())

def ctx_packed_store_record_prefix_words(a: mutable any Arena&, row: any void&, state_bits: mutable any void&) can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    packed_store_append_prefix_words(a, state_bits.cast[any PackedStoreState&], row)

def ctx_packed_store_record_tag(a: mutable any Arena&, tag: u32, state_bits: mutable any void&) can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    needed_rows: mutable usize = state.tags.count + 1
    if needed_rows < state.handles.count:
        needed_rows <- state.handles.count
    packed_store_ensure_metadata_capacity(a, state, needed_rows)
    in a:
        state.tags.push(tag)

def ctx_packed_store_alloc(a: mutable any Arena&, size_bytes: usize, state_bits: mutable any void&) -> uintptr can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_result(a, size_bytes, state_bits)
    return result.handle

def ctx_packed_store_encode(a: mutable any Arena&, ptr: any void&, state_bits: mutable any void&) -> uintptr can[Abort.Panic]:
    raw: uintptr = ptr.cast[any u8&].uintptr()

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]

        if state.alloc_region != null:
            alloc_data_base: heap u8& = packed_store_region_data(state.alloc_region)
            alloc_data_begin: uintptr = alloc_data_base.uintptr()
            alloc_data_end: uintptr = alloc_data_begin + (state.alloc_region.capacity * sizeof(uintptr)).uintptr()

            if raw >= alloc_data_begin and raw < alloc_data_end:
                alloc_offset_bytes: uintptr = raw - alloc_data_begin
                alloc_offset_words: uintptr = alloc_offset_bytes / sizeof(uintptr).uintptr()
                return (state.alloc_region_index.uintptr() << 32.uintptr()) | ((alloc_offset_words + 1.uintptr()) << 1.uintptr())

        if state.decode_region != null:
            decode_data_base: heap u8& = packed_store_region_data(state.decode_region)
            decode_data_begin: uintptr = decode_data_base.uintptr()
            decode_data_end: uintptr = decode_data_begin + (state.decode_region.capacity * sizeof(uintptr)).uintptr()

            if raw >= decode_data_begin and raw < decode_data_end:
                decode_offset_bytes: uintptr = raw - decode_data_begin
                decode_offset_words: uintptr = decode_offset_bytes / sizeof(uintptr).uintptr()
                return (state.decode_region_index.uintptr() << 32.uintptr()) | ((decode_offset_words + 1.uintptr()) << 1.uintptr())

        owner_cursor: mutable heap Region&? = state.head_region
        while owner_cursor != null:
            owner_data_base: heap u8& = packed_store_region_data(owner_cursor)
            owner_data_begin: uintptr = owner_data_base.uintptr()
            owner_data_end: uintptr = owner_data_begin + (owner_cursor.capacity * sizeof(uintptr)).uintptr()

            if raw >= owner_data_begin and raw < owner_data_end:
                owner_offset_bytes: uintptr = raw - owner_data_begin
                owner_offset_words: uintptr = owner_offset_bytes / sizeof(uintptr).uintptr()
                return (owner_cursor.global_index.uintptr() << 32.uintptr()) | ((owner_offset_words + 1.uintptr()) << 1.uintptr())

            owner_cursor <- owner_cursor.owner_next

    if a.end != null:
        end_data_base: heap u8& = packed_store_region_data(a.end)
        end_data_begin: uintptr = end_data_base.uintptr()
        end_data_end: uintptr = end_data_begin + (a.end.capacity * sizeof(uintptr)).uintptr()

        if raw >= end_data_begin and raw < end_data_end:
            end_offset_bytes: uintptr = raw - end_data_begin
            end_offset_words: uintptr = end_offset_bytes / sizeof(uintptr).uintptr()
            return (a.end_index.uintptr() << 32.uintptr()) | ((end_offset_words + 1.uintptr()) << 1.uintptr())

    r: mutable heap Region&? = a.begin

    while r != null:
        data_base: heap u8& = packed_store_region_data(r)
        data_begin: uintptr = data_base.uintptr()
        data_end: uintptr = data_begin + (r.capacity * sizeof(uintptr)).uintptr()

        if raw >= data_begin and raw < data_end:
            offset_bytes: uintptr = raw - data_begin
            offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
            return (r.global_index.uintptr() << 32.uintptr()) | ((offset_words + 1.uintptr()) << 1.uintptr())

        r <- r.next

    panic("packed store encode pointer outside arena")

def ctx_packed_store_decode(a: mutable any Arena&, handle: uintptr, state_bits: mutable any void&) -> mutable any void& can[Abort.Panic]:
    assert handle != 0.uintptr()
    if handle & 1.uintptr() != 0.uintptr():
        panic("packed store decode cannot materialize inline word handles")

    region_index: usize = (handle >> 32.uintptr()).usize()
    offset_words_plus_one: usize = ((handle & 0xffffffffu64.uintptr()) >> 1.uintptr()).usize()
    assert offset_words_plus_one > 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        if state.alloc_region != null and state.alloc_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < state.alloc_region.capacity

            data_base: heap u8& = packed_store_region_data(state.alloc_region)
            return (data_base + offset_words * sizeof(uintptr)).cast[mutable any void&]

        if state.decode_region != null and state.decode_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < state.decode_region.capacity

            data_base: heap u8& = packed_store_region_data(state.decode_region)
            return (data_base + offset_words * sizeof(uintptr)).cast[mutable any void&]

        indexed_region: heap Region&? = packed_store_lookup_region(state, region_index)
        if indexed_region != null:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < indexed_region.capacity

            state.decode_region <- indexed_region
            state.decode_region_index <- region_index

            data_base: heap u8& = packed_store_region_data(indexed_region)
            return (data_base + offset_words * sizeof(uintptr)).cast[mutable any void&]

    r: mutable heap Region&? = a.begin
    i: mutable usize = 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        owner_cursor: mutable heap Region&? = null
        owner_cursor_index: mutable usize = 0

        if state.head_region != null and state.head_region.global_index <= region_index:
            owner_cursor <- state.head_region
            owner_cursor_index <- state.head_region.global_index
            r <- state.head_region
            i <- state.head_region.global_index

        if state.alloc_region != null and state.alloc_region_index <= region_index:
            if owner_cursor == null or state.alloc_region_index > owner_cursor_index:
                owner_cursor <- state.alloc_region
                owner_cursor_index <- state.alloc_region_index
            if r == null or state.alloc_region_index > i:
                r <- state.alloc_region
                i <- state.alloc_region_index

        if state.decode_region != null and state.decode_region_index <= region_index:
            if owner_cursor == null or state.decode_region_index > owner_cursor_index:
                owner_cursor <- state.decode_region
                owner_cursor_index <- state.decode_region_index
            if r == null or state.decode_region_index > i:
                r <- state.decode_region
                i <- state.decode_region_index

        if owner_cursor != null:
            while owner_cursor != null and owner_cursor.global_index < region_index:
                owner_cursor <- owner_cursor.owner_next

            if owner_cursor != null and owner_cursor.global_index == region_index:
                offset_words: usize = offset_words_plus_one - 1
                assert offset_words < owner_cursor.capacity

                state.decode_region <- owner_cursor
                state.decode_region_index <- region_index

                data_base: heap u8& = packed_store_region_data(owner_cursor)
                return (data_base + offset_words * sizeof(uintptr)).cast[mutable any void&]

    while i < region_index and r != null:
        r <- r.next
        i <- i + 1

    assert r != null
    offset_words: usize = offset_words_plus_one - 1
    assert offset_words < r.capacity

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        state.decode_region <- r
        state.decode_region_index <- region_index

    data_base: heap u8& = packed_store_region_data(r)
    return (data_base + offset_words * sizeof(uintptr)).cast[mutable any void&]

def ctx_packed_store_read_tag(a: mutable any Arena&, handle: uintptr, state_bits: mutable any void&) -> u32:
    assert handle != 0.uintptr()
    if handle & 1.uintptr() != 0.uintptr():
        return (handle >> 49.uintptr()).u32()

    region_index: usize = (handle >> 32.uintptr()).usize()
    offset_words_plus_one: usize = ((handle & 0xffffffffu64.uintptr()) >> 1.uintptr()).usize()
    assert offset_words_plus_one > 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        if state.alloc_region != null and state.alloc_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < state.alloc_region.capacity

            data_base: heap u8& = packed_store_region_data(state.alloc_region)
            row_tag: any u32& = (data_base + offset_words * sizeof(uintptr)).cast[any u32&]
            return row_tag[0]

        if state.decode_region != null and state.decode_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < state.decode_region.capacity

            data_base: heap u8& = packed_store_region_data(state.decode_region)
            row_tag: any u32& = (data_base + offset_words * sizeof(uintptr)).cast[any u32&]
            return row_tag[0]

        indexed_region: heap Region&? = packed_store_lookup_region(state, region_index)
        if indexed_region != null:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words < indexed_region.capacity

            state.decode_region <- indexed_region
            state.decode_region_index <- region_index

            data_base: heap u8& = packed_store_region_data(indexed_region)
            row_tag: any u32& = (data_base + offset_words * sizeof(uintptr)).cast[any u32&]
            return row_tag[0]

    r: mutable heap Region&? = a.begin
    i: mutable usize = 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        owner_cursor: mutable heap Region&? = null
        owner_cursor_index: mutable usize = 0

        if state.head_region != null and state.head_region.global_index <= region_index:
            owner_cursor <- state.head_region
            owner_cursor_index <- state.head_region.global_index
            r <- state.head_region
            i <- state.head_region.global_index

        if state.alloc_region != null and state.alloc_region_index <= region_index:
            if owner_cursor == null or state.alloc_region_index > owner_cursor_index:
                owner_cursor <- state.alloc_region
                owner_cursor_index <- state.alloc_region_index
            if r == null or state.alloc_region_index > i:
                r <- state.alloc_region
                i <- state.alloc_region_index

        if state.decode_region != null and state.decode_region_index <= region_index:
            if owner_cursor == null or state.decode_region_index > owner_cursor_index:
                owner_cursor <- state.decode_region
                owner_cursor_index <- state.decode_region_index
            if r == null or state.decode_region_index > i:
                r <- state.decode_region
                i <- state.decode_region_index

        if owner_cursor != null:
            while owner_cursor != null and owner_cursor.global_index < region_index:
                owner_cursor <- owner_cursor.owner_next

            if owner_cursor != null and owner_cursor.global_index == region_index:
                offset_words: usize = offset_words_plus_one - 1
                assert offset_words < owner_cursor.capacity

                state.decode_region <- owner_cursor
                state.decode_region_index <- region_index

                data_base: heap u8& = packed_store_region_data(owner_cursor)
                row_tag: any u32& = (data_base + offset_words * sizeof(uintptr)).cast[any u32&]
                return row_tag[0]

    while i < region_index and r != null:
        r <- r.next
        i <- i + 1

    assert r != null
    offset_words: usize = offset_words_plus_one - 1
    assert offset_words < r.capacity

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        state.decode_region <- r
        state.decode_region_index <- region_index

    data_base: heap u8& = packed_store_region_data(r)
    row_tag: any u32& = (data_base + offset_words * sizeof(uintptr)).cast[any u32&]
    return row_tag[0]

def ctx_packed_store_encode_index(a: mutable any Arena&, ptr: any void&, state_bits: mutable any void&) -> u32 can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    encoded: uintptr = ctx_packed_store_encode(a, ptr, state_bits)
    assert state.handles.items != null
    handles: any uintptr& = state.handles.items
    for i in 0..<state.handles.count:
        if handles[i] == encoded:
            return i.u32()
    panic("packed store encode index missing handle")

def ctx_packed_store_decode_index(a: mutable any Arena&, index: u32, state_bits: mutable any void&) -> mutable any void& can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.handles.count
    assert state.handles.items != null
    handles: any uintptr& = state.handles.items
    return ctx_packed_store_decode(a, handles[index_usize], state_bits)

def ctx_packed_store_read_index_tag(state_bits: mutable any void&, index: u32) -> u32:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.tags.count
    assert state.tags.items != null
    tags: any u32& = state.tags.items
    return tags[index_usize]

def ctx_packed_store_read_word(a: mutable any Arena&, handle: uintptr, state_bits: mutable any void&, word_offset: usize) -> uintptr can[Abort.Panic]:
    assert handle != 0.uintptr()
    if handle & 1.uintptr() != 0.uintptr():
        panic("packed store read_word cannot read inline word handles")

    region_index: usize = (handle >> 32.uintptr()).usize()
    offset_words_plus_one: usize = ((handle & 0xffffffffu64.uintptr()) >> 1.uintptr()).usize()
    assert offset_words_plus_one > 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        if state.alloc_region != null and state.alloc_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words + word_offset < state.alloc_region.capacity

            data_base: heap u8& = packed_store_region_data(state.alloc_region)
            row_words: any uintptr& = (data_base + offset_words * sizeof(uintptr)).cast[any uintptr&]
            return row_words[word_offset]

        if state.decode_region != null and state.decode_region_index == region_index:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words + word_offset < state.decode_region.capacity

            data_base: heap u8& = packed_store_region_data(state.decode_region)
            row_words: any uintptr& = (data_base + offset_words * sizeof(uintptr)).cast[any uintptr&]
            return row_words[word_offset]

        indexed_region: heap Region&? = packed_store_lookup_region(state, region_index)
        if indexed_region != null:
            offset_words: usize = offset_words_plus_one - 1
            assert offset_words + word_offset < indexed_region.capacity

            state.decode_region <- indexed_region
            state.decode_region_index <- region_index

            data_base: heap u8& = packed_store_region_data(indexed_region)
            row_words: any uintptr& = (data_base + offset_words * sizeof(uintptr)).cast[any uintptr&]
            return row_words[word_offset]

    r: mutable heap Region&? = a.begin
    i: mutable usize = 0

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        owner_cursor: mutable heap Region&? = null
        owner_cursor_index: mutable usize = 0

        if state.head_region != null and state.head_region.global_index <= region_index:
            owner_cursor <- state.head_region
            owner_cursor_index <- state.head_region.global_index
            r <- state.head_region
            i <- state.head_region.global_index

        if state.alloc_region != null and state.alloc_region_index <= region_index:
            if owner_cursor == null or state.alloc_region_index > owner_cursor_index:
                owner_cursor <- state.alloc_region
                owner_cursor_index <- state.alloc_region_index
            if r == null or state.alloc_region_index > i:
                r <- state.alloc_region
                i <- state.alloc_region_index

        if state.decode_region != null and state.decode_region_index <= region_index:
            if owner_cursor == null or state.decode_region_index > owner_cursor_index:
                owner_cursor <- state.decode_region
                owner_cursor_index <- state.decode_region_index
            if r == null or state.decode_region_index > i:
                r <- state.decode_region
                i <- state.decode_region_index

        if owner_cursor != null:
            while owner_cursor != null and owner_cursor.global_index < region_index:
                owner_cursor <- owner_cursor.owner_next

            if owner_cursor != null and owner_cursor.global_index == region_index:
                offset_words: usize = offset_words_plus_one - 1
                assert offset_words + word_offset < owner_cursor.capacity

                state.decode_region <- owner_cursor
                state.decode_region_index <- region_index

                data_base: heap u8& = packed_store_region_data(owner_cursor)
                row_words: any uintptr& = (data_base + offset_words * sizeof(uintptr)).cast[any uintptr&]
                return row_words[word_offset]

    while i < region_index and r != null:
        r <- r.next
        i <- i + 1

    assert r != null
    offset_words: usize = offset_words_plus_one - 1
    assert offset_words + word_offset < r.capacity

    if state_bits != null:
        state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
        state.decode_region <- r
        state.decode_region_index <- region_index

    data_base: heap u8& = packed_store_region_data(r)
    row_words: any uintptr& = (data_base + offset_words * sizeof(uintptr)).cast[any uintptr&]
    return row_words[word_offset]

@inline(always)
def ctx_packed_store_read_index_word(a: mutable any Arena&, index: u32, state_bits: mutable any void&, word_offset: usize) -> uintptr can[Abort.Panic]:
    assert state_bits != null
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]
    index_usize: usize = index.usize()
    assert index_usize < state.handles.count
    if word_offset < state.prefix_words:
        assert state.prefix_columns.items != null
        columns: any uintptr& = state.prefix_columns.items
        assert word_offset < state.prefix_columns.count
        assert columns[word_offset] != 0.uintptr()
        column: any uintptr& = columns[word_offset].cast[heap u8&].cast[any uintptr&]
        return column[index_usize]
    assert state.handles.items != null
    handles: any uintptr& = state.handles.items
    return ctx_packed_store_read_word(a, handles[index_usize], state_bits, word_offset)
