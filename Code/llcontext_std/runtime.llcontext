# ============================================================
# Contextlang Runtime - public wrappers and stage 1 adapters
# ============================================================

# ------------------------------------------------------------
# Type-to-string public API
# ------------------------------------------------------------

def int_to_string(value: i64) -> heap u8& can[Memory.Allocate, Console.Format, Abort.Panic]:
    return int_to_string_into(perm_arena.ref[Arena&], value) can Memory.Allocate, Console.Format, Abort.Panic

def int_to_string_scratch(value: i64) -> heap u8& can[Memory.Allocate, Console.Format, Abort.Panic]:
    return int_to_string_into(scratch_arena.ref[Arena&], value) can Memory.Allocate, Console.Format, Abort.Panic

def bool_to_string(value: int) -> u8&:
    return bool_to_string_into(perm_arena.ref[Arena&], value)

def bool_to_string_scratch(value: int) -> u8&:
    return bool_to_string_into(scratch_arena.ref[Arena&], value)

def char_to_string(value: i64) -> heap u8& can[Memory.Allocate, Abort.Panic]:
    return char_to_string_into(perm_arena.ref[Arena&], value) can Memory.Allocate, Abort.Panic

def char_to_string_scratch(value: i64) -> heap u8& can[Memory.Allocate, Abort.Panic]:
    return char_to_string_into(scratch_arena.ref[Arena&], value) can Memory.Allocate, Abort.Panic

# ------------------------------------------------------------
# Basic string predicates
# ------------------------------------------------------------

def string_len(value: u8&?) -> i64:
    return runtime_strlen(value).i64()

def streq(lhs: u8&?, rhs: u8&?) -> int:
    left: u8& = lhs if lhs != null else "".cast[u8&]
    right: u8& = rhs if rhs != null else "".cast[u8&]

    if left == right:
        return 1

    return 1 if strcmp(left, right) == 0 else 0

# ============================================================
# Stage 1 runtime forwarding wrappers
# ============================================================

def rt_concat2(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> dstr[shape_result] can[Memory.Allocate, Abort.Panic]:
    return concat2(lhs, rhs) can Memory.Allocate, Abort.Panic

def rt_concat2_scratch(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> dstr[shape_result] can[Memory.Allocate, Abort.Panic]:
    return concat2_scratch(lhs, rhs) can Memory.Allocate, Abort.Panic

def rt_string_builder_new(initial: u8&?) -> mutable heap StringBuilder& can[Memory.Allocate, Abort.Panic]:
    return string_builder_new(initial) can Memory.Allocate, Abort.Panic

def rt_string_builder_append(builder: mutable heap StringBuilder&?, suffix: u8&?) -> mutable heap StringBuilder& can[Memory.Allocate, Abort.Panic]:
    return string_builder_append(builder, suffix) can Memory.Allocate, Abort.Panic

def rt_string_builder_finish(builder: heap StringBuilder&?) -> dstr[shape_out] can[Memory.Allocate, Abort.Panic]:
    return string_builder_finish(builder).cast[u8&] can Memory.Allocate, Abort.Panic

def rt_int_to_string(value: i64) -> dstr[shape_out] can[Memory.Allocate, Console.Format, Abort.Panic]:
    return int_to_string(value) can Memory.Allocate, Console.Format, Abort.Panic

def rt_int_to_string_scratch(value: i64) -> dstr[shape_out] can[Memory.Allocate, Console.Format, Abort.Panic]:
    return int_to_string_scratch(value) can Memory.Allocate, Console.Format, Abort.Panic

def rt_bool_to_string(value: int) -> dstr[shape_out]:
    return bool_to_string(value)

def rt_bool_to_string_scratch(value: int) -> dstr[shape_out]:
    return bool_to_string_scratch(value)

def rt_char_to_string(value: i64) -> dstr[shape_out] can[Memory.Allocate, Abort.Panic]:
    return char_to_string(value) can Memory.Allocate, Abort.Panic

def rt_char_to_string_scratch(value: i64) -> dstr[shape_out] can[Memory.Allocate, Abort.Panic]:
    return char_to_string_scratch(value) can Memory.Allocate, Abort.Panic

def ctx_strlen(value: dstr[shape_in]) -> i64:
    return string_len(value)

def ctx_streq(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> int:
    return streq(lhs, rhs)

def ctx_string_slice_eq(value: dstr[shape_in], start: i64, end: i64, other: dstr[shape_other]) -> int:
    return string_slice_eq(value, start, end, other)

def ctx_string_slices_eq(lhs: dstr[shape_left], lhs_start: i64, lhs_end: i64, rhs: dstr[shape_right], rhs_start: i64, rhs_end: i64) -> int:
    return string_slices_eq(lhs, lhs_start, lhs_end, rhs, rhs_start, rhs_end)

def ctx_string_index(value: dstr[shape_in], index: i64) -> i64:
    return string_index(value, index)

def ctx_string_slice(value: dstr[shape_in], start: i64, end: i64) -> dstr[shape_out] can[Memory.Allocate, Abort.Panic]:
    return string_slice(value, start, end) can Memory.Allocate, Abort.Panic

def ctx_string_view(value: dstr[shape_in], start: i64, end: i64) -> sview:
    return string_view(value, start, end)

def ctx_string_view_len(view: sview) -> i64:
    return string_view_len(view)

def ctx_string_view_slice(view: sview, start: i64, end: i64) -> sview:
    return string_view_slice(view, start, end)

def ctx_string_view_prefix(view: sview, end: i64) -> sview:
    return string_view_prefix(view, end)

def ctx_string_view_suffix(view: sview, start: i64) -> sview:
    return string_view_suffix(view, start)

def ctx_string_view_index(view: sview, index: i64) -> i64:
    return string_view_index(view, index)

def ctx_string_view_eq(view: sview, other: dstr[shape_other]) -> int:
    return string_view_eq(view, other)

def ctx_string_views_eq(lhs: sview, rhs: sview) -> int:
    return string_views_eq(lhs, rhs)

def ctx_string_from_view(view: sview) -> dstr[shape_out] can[Memory.Allocate, Abort.Panic]:
    return string_view_copy(view).cast[u8&] can Memory.Allocate, Abort.Panic

def rt_reset_scratch():
    reset_scratch()

def rt_puts(value: u8&?) -> int can[Console.Write]:
    return puts(value if value != null else "".cast[u8&]) can Console.Write

# ------------------------------------------------------------
# Fatal error handler (weak linkage)
# ------------------------------------------------------------

# weak
def ctx_llvm_codegen_fatal(msg: u8&?) can[Console, Abort.Exit]:
    can Console, Abort.Exit:
        actual_msg: u8& = msg if msg != null else "<null>".cast[u8&]
        fprintf(stderr, "ctx_llvm_codegen_fatal: %s\n".cast[u8&], actual_msg)
        exit(1)