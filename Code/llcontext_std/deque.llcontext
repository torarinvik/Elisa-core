# ============================================================
# Deque helpers - low level Contextlang runtime dialect
# ============================================================

# include "./arena.llcontext"

const ARENA_DEQUE_INIT_CAP: usize = 16

struct Deque[T]:
    items: mutable any T&?
    head: mutable usize
    count: mutable usize
    capacity: mutable usize

def arena_deque_init[T]() -> Deque[T]:
    out: mutable Deque[T] = zeroed
    return out

def arena_deque_init_buffer[T](buffer: any T&, capacity: usize) -> Deque[T]:
    out: mutable Deque[T] = zeroed
    out.items as & <- buffer
    out.head <- 0u
    out.count <- 0u
    out.capacity <- capacity
    return out

def arena_deque_with_capacity[T](a: any Arena&, capacity: usize) -> Deque[T] can[Memory.Allocate, Abort.Panic]:
    if capacity == 0u:
        out0: mutable Deque[T] = zeroed
        return out0

    out: mutable Deque[T] = zeroed
    out.items as & <- arena_alloc(a, capacity * sizeof(T)).cast[any T&]
    out.head <- 0u
    out.count <- 0u
    out.capacity <- capacity
    return out

def arena_deque_len[T](d: any Deque[T]&) -> usize:
    return d.count

def arena_deque_capacity[T](d: any Deque[T]&) -> usize:
    return d.capacity

def arena_deque_is_empty[T](d: any Deque[T]&) -> bool:
    return d.count == 0u

def arena_deque_clear[T](d: any Deque[T]&):
    d.head <- 0u
    d.count <- 0u

def arena_deque_buffer_index[T](d: any Deque[T]&, logical_index: usize) -> usize can[Abort.Panic]:
    assert d.capacity > 0u
    assert logical_index < d.capacity

    head_len: usize = d.capacity - d.head
    if logical_index < head_len:
        return d.head + logical_index

    return logical_index - head_len

def arena_deque_copy_linearized[T](d: any Deque[T]&, dst: any T&):
    if d.count == 0u:
        return

    assert d.items != null

    if d.head <= d.capacity - d.count:
        arena_memcpy(
            dst.cast[any void&],
            (d.items + d.head).cast[any void&],
            d.count * sizeof(T)
        )
        return

    head_count: usize = d.capacity - d.head
    tail_count: usize = d.count - head_count

    arena_memcpy(
        dst.cast[any void&],
        (d.items + d.head).cast[any void&],
        head_count * sizeof(T)
    )
    arena_memcpy(
        (dst + head_count).cast[any void&],
        d.items.cast[any void&],
        tail_count * sizeof(T)
    )

def arena_deque_reserve[T](a: any Arena&, d: any Deque[T]&, needed: usize) -> any Deque[T]& can[Memory.Allocate, Abort.Panic]:
    if needed <= d.capacity:
        return d

    new_capacity: mutable usize = d.capacity
    if new_capacity == 0u:
        new_capacity <- ARENA_DEQUE_INIT_CAP

    while needed > new_capacity:
        new_capacity <- new_capacity * 2u

    new_items: any T& = arena_alloc(a, new_capacity * sizeof(T)).cast[any T&]
    arena_deque_copy_linearized(d, new_items)

    d.items as & <- new_items
    d.head <- 0u
    d.capacity <- new_capacity
    return d

def arena_deque_ensure_unused[T](a: any Arena&, d: any Deque[T]&, additional: usize) -> any Deque[T]& can[Memory.Allocate, Abort.Panic]:
    needed: usize = d.count + additional
    assert needed >= d.count
    return arena_deque_reserve(a, d, needed)

def arena_deque_push_front_assume_capacity[T](d: any Deque[T]&, item: T) can[Abort.Panic]:
    assert d.items != null
    assert d.count < d.capacity

    if d.head == 0u:
        d.head <- d.capacity

    d.head <- d.head - 1u
    d.items[d.head] <- item
    d.count <- d.count + 1u

def arena_deque_push_back_assume_capacity[T](d: any Deque[T]&, item: T) can[Abort.Panic]:
    assert d.items != null
    assert d.count < d.capacity

    physical_index: usize = arena_deque_buffer_index(d, d.count)
    d.items[physical_index] <- item
    d.count <- d.count + 1u

def arena_deque_push_front_bounded[T](d: any Deque[T]&, item: T) -> bool can[Abort.Panic]:
    if d.count >= d.capacity:
        return false

    arena_deque_push_front_assume_capacity(d, item)
    return true

def arena_deque_push_back_bounded[T](d: any Deque[T]&, item: T) -> bool can[Abort.Panic]:
    if d.count >= d.capacity:
        return false

    arena_deque_push_back_assume_capacity(d, item)
    return true

def arena_deque_push_front[T](a: any Arena&, d: any Deque[T]&, item: T) -> any Deque[T]& can[Memory.Allocate, Abort.Panic]:
    _ = arena_deque_ensure_unused(a, d, 1u)
    arena_deque_push_front_assume_capacity(d, item)
    return d

def arena_deque_push_back[T](a: any Arena&, d: any Deque[T]&, item: T) -> any Deque[T]& can[Memory.Allocate, Abort.Panic]:
    _ = arena_deque_ensure_unused(a, d, 1u)
    arena_deque_push_back_assume_capacity(d, item)
    return d

def arena_deque_front[T](d: any Deque[T]&) -> any T&?:
    if d.count == 0u or d.items == null:
        return null

    return &d.items[d.head]

def arena_deque_back[T](d: any Deque[T]&) -> any T&? can[Abort.Panic]:
    if d.count == 0u or d.items == null:
        return null

    physical_index: usize = arena_deque_buffer_index(d, d.count - 1u)
    return &d.items[physical_index]

def arena_deque_at[T](d: any Deque[T]&, index: usize) -> any T& can[Abort.Panic]:
    assert index < d.count
    assert d.items != null

    physical_index: usize = arena_deque_buffer_index(d, index)
    return &d.items[physical_index]

def arena_deque_pop_front[T](d: any Deque[T]&, out: any T&) -> bool can[Abort.Panic]:
    if d.count == 0u or d.items == null:
        return false

    out[0u] <- d.items[d.head]
    if d.count == 1u:
        d.count <- 0u
        d.head <- 0u
        return true

    d.head <- arena_deque_buffer_index(d, 1u)
    d.count <- d.count - 1u
    return true

def arena_deque_pop_back[T](d: any Deque[T]&, out: any T&) -> bool can[Abort.Panic]:
    if d.count == 0u or d.items == null:
        return false

    physical_index: usize = arena_deque_buffer_index(d, d.count - 1u)
    out[0u] <- d.items[physical_index]
    d.count <- d.count - 1u
    if d.count == 0u:
        d.head <- 0u
    return true