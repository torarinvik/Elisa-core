# ============================================================
# Arena allocator - low level Contextlang runtime dialect
# ============================================================

const ARENA_BACKEND_LIBC_MALLOC = 0
const ARENA_BACKEND_LINUX_MMAP = 1
const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2
const ARENA_BACKEND_WASM_HEAPBASE = 3

const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

const ARENA_REGION_DEFAULT_CAPACITY: usize = 8 * 1024
const ARENA_DA_INIT_CAP: usize = 256
const ARENA_WASM_PAGE_SIZE: usize = 64 * 1024

const DICT_BUCKET_EMPTY: u8 = 0u8
const DICT_BUCKET_FULL: u8 = 1u8
const DICT_BUCKET_TOMBSTONE: u8 = 2u8
const DICT_INIT_CAP: usize = 8

error RuntimeError:
    OutOfMemory

# ------------------------------------------------------------
# Basic low-level types
# ------------------------------------------------------------

repr(c) struct Region:
    next: mutable any Region&?
    count: mutable usize
    capacity: mutable usize
    data: tail uintptr

repr(c) struct Arena:
    begin:mutable any Region&?
    end:mutable any Region&?
    end_index: mutable usize

repr(c) struct ArenaMark:
    region: any Region&?
    count: usize

repr(c) struct PackedStoreState:
    region: mutable any Region&?
    region_index: mutable usize

repr(c) struct DynArray[T]:
    items: mutable any T&?
    count: mutable usize
    capacity: mutable usize

repr(c) struct DynArrayView:
    data: mutable any void&?
    len: mutable usize
    elem_size: mutable usize

repr(c) struct DictBucket[T]:
    state: mutable u8
    hash: mutable u64
    key_data: mutable any u8&?
    key_len: mutable i64
    value: mutable T

repr(c) struct DynDict[T]:
    items: mutable any DictBucket[T]&?
    count: mutable usize
    used: mutable usize
    capacity: mutable usize
    arena: mutable any Arena&?

repr(c) struct DictProbeResult:
    index: mutable usize
    found: mutable bool

# ------------------------------------------------------------
# Backend FFI declarations
# ------------------------------------------------------------

static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
    extern malloc(size: usize) -> any void&?
    extern free(ptr: any void&)

static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const PROT_READ = 0x1
    const PROT_WRITE = 0x2
    const MAP_PRIVATE = 0x02
    const MAP_ANONYMOUS = 0x20

    extern mmap(
        addr: any void&?,
        length: usize,
        prot: int,
        flags: int,
        fd: int,
        offset: isize
    ) -> any void&?

    extern munmap(addr: any void&, length: usize) -> int
    extern MAP_FAILED() -> any void&?

static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04

    extern GetCurrentProcess() -> any void&
    extern VirtualAllocEx(
        process: any void&,
        address: any void&?,
        size: usize,
        alloc_type: int,
        protect: int
    ) -> any void&?

    extern VirtualFreeEx(
        process: any void&,
        address: any void&,
        size: usize,
        free_type: int
    ) -> bool

static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
    extern __heap_base: any u8&
    extern wasm_memory_size(index: int) -> int
    extern wasm_memory_grow(index: int, pages: usize) -> int

    global mutable bump_pointer: any u8& = __heap_base

# ------------------------------------------------------------
# Small utilities
# ------------------------------------------------------------

def assert(condition: bool):
    if not condition:
        panic("assert failed")

def max(a: usize, b: usize) -> usize:
    return a if a > b else b

def inv_handle(ptr: any void&?) -> bool:
    return ptr == null

# ------------------------------------------------------------
# Pointer-state helpers
# ------------------------------------------------------------

def sfree[T](ptr: any T&) -> any T!:
    free(ptr.cast[any void&]())
    return null

# ------------------------------------------------------------
# Region allocation / freeing
# ------------------------------------------------------------

def new_region(capacity: usize) -> any Region&:
    size_bytes: usize = sizeof(Region) + sizeof(uintptr) * capacity

    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        raw: any void&? = malloc(size_bytes)
        assert raw != null
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        raw: any void&? = mmap(
            null,
            size_bytes,
            PROT_READ | PROT_WRITE,
            MAP_ANONYMOUS | MAP_PRIVATE,
            -1,
            0
        )
        assert raw != MAP_FAILED()
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        raw: any void&? = VirtualAllocEx(
            GetCurrentProcess(),
            null,
            size_bytes,
            MEM_COMMIT | MEM_RESERVE,
            PAGE_READWRITE
        )
        assert not inv_handle(raw)
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        r: any Region& = bump_pointer.cast[any Region&]()
        current_memory_size: usize = ARENA_WASM_PAGE_SIZE * wasm_memory_size(0).usize()
        desired_memory_size: usize = bump_pointer.usize() + size_bytes

        if desired_memory_size > current_memory_size:
            delta_bytes: usize = desired_memory_size - current_memory_size
            delta_pages: usize = (delta_bytes + (ARENA_WASM_PAGE_SIZE - 1)) / ARENA_WASM_PAGE_SIZE

            grow_result: int = wasm_memory_grow(0, delta_pages)
            assert grow_result >= 0

        bump_pointer <- bump_pointer + size_bytes

    static else:
        static error("Unknown arena backend")

    r.next <- null
    r.count <- 0
    r.capacity <- capacity
    return r

def free_region(r: any Region&):
    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        free(r.cast[any void&]())

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        size_bytes: usize = sizeof(Region) + sizeof(uintptr) * r.capacity
        ret: int = munmap(r.cast[any void&](), size_bytes)
        assert ret == 0

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        ok: bool = VirtualFreeEx(
            GetCurrentProcess(),
            r.cast[any void&](),
            0,
            MEM_RELEASE
        )
        assert ok

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        pass

# ------------------------------------------------------------
# Core arena allocation
# ------------------------------------------------------------

def arena_alloc(a: any Arena&, size_bytes: usize) -> any void&:
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if a.end == null:
        assert a.begin == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end as & <- new_region(capacity)
        a.begin <- a.end
        a.end_index <- 0

    assert a.end != null

    while a.end.count + size > a.end.capacity and a.end.next != null:
        a.end <- a.end.next
        a.end_index <- a.end_index + 1

    if a.end.count + size > a.end.capacity:
        assert a.end.next == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end.next as & <- new_region(capacity)
        a.end <- a.end.next
        a.end_index <- a.end_index + 1

    data_base: any u8& = (a.end.cast[any u8&]() + sizeof(Region)).cast[any u8&]()
    offset_bytes: usize = a.end.count * sizeof(uintptr)
    result: any void& = (data_base + offset_bytes).cast[any void&]()
    a.end.count <- a.end.count + size
    return result

def arena_realloc(a: any Arena&, oldptr: any void&, oldsz: usize, newsz: usize) -> any void&:
    if newsz <= oldsz:
        return oldptr

    newptr: any void& = arena_alloc(a, newsz)
    newptr_bytes: any u8& = newptr.cast[any u8&]()
    oldptr_bytes: any u8& = oldptr.cast[any u8&]()

    i: mutable usize = 0
    while i < oldsz:
        newptr_bytes[i] <- oldptr_bytes[i]
        i <- i + 1

    return newptr

# ------------------------------------------------------------
# Memory/string helpers
# ------------------------------------------------------------

def arena_strlen(s: any u8&) -> usize:
    n:mutable usize = 0
    while s[n] != 0:
        n <- n + 1
    return n

def arena_memcpy(dest: any void&, src: any void&, n: usize) -> any void&:
    d: any u8& = dest.cast[any u8&]()
    s: any u8& = src.cast[any u8&]()

	i: mutable usize = 0
    while i < n:
        d[i] <- s[i]
        i <- i + 1

    return dest

def arena_memeq(lhs: any void&, rhs: any void&, n: usize) -> bool:
    left: any u8& = lhs.cast[any u8&]()
    right: any u8& = rhs.cast[any u8&]()

    i: mutable usize = 0
    while i < n:
        if left[i] != right[i]:
            return false
        i <- i + 1

    return true

def arena_strdup(a: any Arena&, cstr: any u8&) -> any u8&:
    n: usize = arena_strlen(cstr)
    dup: any u8& = arena_alloc(a, n + 1).cast[any u8&]()
    arena_memcpy(dup.cast[any void&](), cstr.cast[any void&](), n)
    dup[n] <- 0
    return dup

def arena_memdup(a: any Arena&, data: any void&, size: usize) -> any void&:
    return arena_memcpy(arena_alloc(a, size), data, size)

def packed_store_region_data(r: any Region&) -> any u8&:
    return (r.cast[any u8&]() + sizeof(Region)).cast[any u8&]()

def ctx_packed_store_state_new(a: any Arena&) -> any void&:
    state: any PackedStoreState& = arena_alloc(a, sizeof(PackedStoreState)).cast[any PackedStoreState&]()
    state.region <- a.end
    state.region_index <- a.end_index
    return state.cast[any void&]()

def ctx_packed_store_alloc(a: any Arena&, size_bytes: usize, state_bits: any void&) -> uintptr:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()
    ptr: any void& = arena_alloc(a, size_bytes)
    assert a.end != null

    state.region <- a.end
    state.region_index <- a.end_index

    assert state.region != null

    data_base: any u8& = packed_store_region_data(state.region)
    offset_bytes: uintptr = ptr.cast[any u8&]().uintptr() - data_base.uintptr()
    offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
    return (state.region_index.uintptr() << 32u64.uintptr()) | (offset_words + 1u64.uintptr())

def ctx_packed_store_encode(a: any Arena&, ptr: any void&) -> uintptr:
    raw: uintptr = ptr.cast[any u8&]().uintptr()

    if a.end != null:
        end_data_base: any u8& = packed_store_region_data(a.end)
        end_data_begin: uintptr = end_data_base.uintptr()
        end_data_end: uintptr = end_data_begin + (a.end.capacity * sizeof(uintptr)).uintptr()

        if raw >= end_data_begin and raw < end_data_end:
            end_offset_bytes: uintptr = raw - end_data_begin
            end_offset_words: uintptr = end_offset_bytes / sizeof(uintptr).uintptr()
            return (a.end_index.uintptr() << 32u64.uintptr()) | (end_offset_words + 1u64.uintptr())

    region_index: mutable usize = 0
    r: mutable any Region&? = a.begin

    while r != null:
        data_base: any u8& = packed_store_region_data(r)
        data_begin: uintptr = data_base.uintptr()
        data_end: uintptr = data_begin + (r.capacity * sizeof(uintptr)).uintptr()

        if raw >= data_begin and raw < data_end:
            offset_bytes: uintptr = raw - data_begin
            offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
            return (region_index.uintptr() << 32u64.uintptr()) | (offset_words + 1u64.uintptr())

        region_index <- region_index + 1
        r <- r.next

    panic("packed store encode pointer outside arena")

def ctx_packed_store_decode(a: any Arena&, handle: uintptr) -> any void&:
    assert handle != 0u64.uintptr()

    region_index: usize = (handle >> 32u64.uintptr()).usize()
    offset_words_plus_one: usize = (handle & 0xffffffffu64.uintptr()).usize()
    assert offset_words_plus_one > 0

    r: mutable any Region&? = a.begin
    i: mutable usize = 0
    while i < region_index and r != null:
        r <- r.next
        i <- i + 1

    assert r != null

    offset_words: usize = offset_words_plus_one - 1
    assert offset_words < r.capacity

    data_base: any u8& = packed_store_region_data(r)
    return (data_base + offset_words * sizeof(uintptr)).cast[any void&]()

# ------------------------------------------------------------
# Snapshot / rewind / reset / free / trim
# ------------------------------------------------------------

def arena_snapshot(a: any Arena&) -> ArenaMark:
    if a.end == null:
        assert a.begin == null
        return ArenaMark(null, 0)

    return ArenaMark(a.end, a.end.count)

def arena_reset(a: any Arena&):
    r: mutable any Region&? = a.begin
    while r != null:
        r.count <- 0
        r <- r.next

    a.end <- a.begin
    a.end_index <- 0

def arena_rewind(a: any Arena&, m: ArenaMark):
    if m.region == null:
        arena_reset(a)
        return

    region: any Region& = m.region
    region.count <- m.count

    r: mutable any Region&? = region.next
    while r != null:
        r.count <- 0
        r <- r.next

    a.end as & <- region

    region_index: mutable usize = 0
    current: mutable any Region&? = a.begin
    while current != null and current != region:
        current <- current.next
        region_index <- region_index + 1

    assert current != null
    a.end_index <- region_index

def arena_free(a: any Arena&):
    r: mutable any Region&? = a.begin

    while r != null:
        r0: mutable any Region& = r
        r <- r.next
        free_region(r0)

    a.begin as ! <- null
    a.end as ! <- null
    a.end_index <- 0

def arena_trim(a: any Arena&):
    if a.end == null:
        return

    r: mutable any Region&? = a.end.next
    while r != null:
        r0: mutable any Region& = r
        r <- r.next
        free_region(r0)

    a.end.next as ! <- null

# ------------------------------------------------------------
# Dynamic array helpers (replacement for C macros)
# ------------------------------------------------------------

def arena_dict_next_capacity(min_capacity: usize) -> usize:
    if min_capacity == 0:
        return 0

    cap: mutable usize = DICT_INIT_CAP
    while cap < min_capacity:
        cap <- cap * 2
    return cap

def arena_dict_hash_dstr(key: dstr[key_shape]) -> u64:
    hash: mutable u64 = 1469598103934665603u64
    key_len: usize = arena_strlen(key)
    i: mutable usize = 0

    while i < key_len:
        hash ^= key[i].u64()
        hash *= 1099511628211u64
        i <- i + 1

    return hash

def arena_dict_key_eq[T](bucket: any DictBucket[T]&, key: dstr[key_shape], hash: u64, key_len: usize) -> bool:
    key_bytes: any u8& = key

    if bucket.hash != hash:
        return false

    if bucket.key_len != key_len.i64():
        return false

    if key_len == 0:
        return true

    if bucket.key_data == key_bytes:
        return true

    if bucket.key_data == null:
        return false

    return arena_memeq(bucket.key_data.cast[any void&](), key_bytes.cast[any void&](), key_len)

def arena_dict_probe_slot[T](m: any dict[dstr[key_shape], T]&, key: dstr[key_shape], hash: u64, key_len: usize) -> DictProbeResult:
    if m.capacity == 0 or m.items == null:
        return DictProbeResult(0, false)

    items: any DictBucket[T]& = m.items
    mask: usize = m.capacity - 1
    index: mutable usize = (hash & mask.u64()).usize()
    first_tombstone: mutable usize = 0
    have_tombstone: mutable bool = false
    probes: mutable usize = 0

    while probes < m.capacity:
        bucket: any DictBucket[T]& = &items[index]

        if bucket.state == DICT_BUCKET_EMPTY:
            if have_tombstone:
                return DictProbeResult(first_tombstone, false)
            return DictProbeResult(index, false)

        if bucket.state == DICT_BUCKET_TOMBSTONE:
            if not have_tombstone:
                first_tombstone <- index
                have_tombstone <- true
        elif arena_dict_key_eq(bucket, key, hash, key_len):
            return DictProbeResult(index, true)

        index <- (index + 1) & mask
        probes <- probes + 1

    if have_tombstone:
        return DictProbeResult(first_tombstone, false)

    return DictProbeResult(0, false)

def arena_dict_zero_buckets[T](items: any DictBucket[T]&, capacity: usize):
    i: mutable usize = 0
    while i < capacity:
        items[i] <- zeroed
        i <- i + 1

def arena_dict_copy_key(a: any Arena&, key: dstr[key_shape]) -> any u8&:
    key_len: usize = arena_strlen(key)
    key_bytes: any u8& = key

    if key_len == 0:
        return "".cast[any u8&]()

    out: any u8& = arena_alloc(a, key_len + 1).cast[any u8&]()
    arena_memcpy(out.cast[any void&](), key_bytes.cast[any void&](), key_len)
    out[key_len] <- 0
    return out

def arena_dict_insert_existing_bucket[T](m: any dict[dstr[key_shape], T]&, bucket: DictBucket[T]) -> any DictBucket[T]&:
    assert m.capacity > 0
    assert m.items != null

    items: any DictBucket[T]& = m.items
    key: dstr[key_shape] = bucket.key_data if bucket.key_data != null else ""
    probe: DictProbeResult = arena_dict_probe_slot(m, key, bucket.hash, bucket.key_len.usize())

    items[probe.index] <- bucket
    if not probe.found:
        m.count <- m.count + 1
        m.used <- m.used + 1

    return &items[probe.index]

def arena_dict_should_rehash[T](m: any dict[dstr[key_shape], T]&, extra_live: usize) -> bool:
    if m.capacity == 0:
        return true

    needed_used: usize = m.used + extra_live
    if needed_used * 4 >= m.capacity * 3:
        return true

    if m.used > m.count and m.count * 2 < m.used:
        return true

    return false

def arena_dict_new[T](a: any Arena&, initial_capacity: usize) -> dict[dstr[key_shape], T]:
    out: mutable dict[dstr[key_shape], T] = zeroed
    out.arena as & <- a

    capacity: usize = arena_dict_next_capacity(initial_capacity)
    if capacity == 0:
        return out

    items: any DictBucket[T]& = arena_alloc(a, capacity * sizeof(DictBucket[T])).cast[any DictBucket[T]&]()
    arena_dict_zero_buckets(items, capacity)

    out.items as & <- items
    out.capacity <- capacity
    return out

def arena_dict_reserve[T](a: any Arena&, m: any dict[dstr[key_shape], T]&, min_capacity: usize) -> void error[RuntimeError]:
    target_capacity: usize = arena_dict_next_capacity(min_capacity)
    if target_capacity == 0:
        return

    should_rebuild: bool = m.used > m.count and m.count * 2 < m.used
    if target_capacity <= m.capacity and not should_rebuild:
        return

    owner: any Arena& = m.arena if m.arena != null else a
    new_items: any DictBucket[T]& = arena_alloc(owner, target_capacity * sizeof(DictBucket[T])).cast[any DictBucket[T]&]()
    arena_dict_zero_buckets(new_items, target_capacity)

    rebuilt: mutable dict[dstr[key_shape], T] = zeroed
    rebuilt.items as & <- new_items
    rebuilt.capacity <- target_capacity
    rebuilt.arena as & <- owner

    if m.items != null:
        old_items: any DictBucket[T]& = m.items
        i: mutable usize = 0
        while i < m.capacity:
            if old_items[i].state == DICT_BUCKET_FULL:
                _ = arena_dict_insert_existing_bucket((&rebuilt).cast[any dict[dstr[key_shape], T]&](), old_items[i])
            i <- i + 1

    m.items as & <- rebuilt.items
    m.count <- rebuilt.count
    m.used <- rebuilt.used
    m.capacity <- rebuilt.capacity
    m.arena as & <- owner
    return

def arena_dict_get[T](m: any dict[dstr[key_shape], T]&, key: dstr[key_shape]) -> any T&?:
    if m.capacity == 0 or m.items == null:
        return null

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    if not probe.found:
        return null

    items: any DictBucket[T]& = m.items
    return &items[probe.index].value

def arena_dict_put[T](a: any Arena&, m: any dict[dstr[key_shape], T]&, key: dstr[key_shape], value: T) -> any T&? error[RuntimeError]:
    owner: any Arena& = m.arena if m.arena != null else a
    if m.arena == null:
        m.arena as & <- owner

    if arena_dict_should_rehash(m, 1):
        target_capacity: mutable usize = DICT_INIT_CAP if m.capacity == 0 else m.capacity * 2
        if target_capacity < m.count + 1:
            target_capacity <- m.count + 1
        try arena_dict_reserve(owner, m, target_capacity)

    if m.items == null or m.capacity == 0:
        try arena_dict_reserve(owner, m, DICT_INIT_CAP)

    assert m.items != null
    assert m.capacity > 0

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    items: any DictBucket[T]& = m.items
    bucket: any DictBucket[T]& = &items[probe.index]

    if probe.found:
        bucket.value <- value
        return &bucket.value

    if bucket.state == DICT_BUCKET_EMPTY:
        m.used <- m.used + 1

    bucket.state <- DICT_BUCKET_FULL
    bucket.hash <- hash
    bucket.key_len <- key_len.i64()
    bucket.key_data as & <- arena_dict_copy_key(owner, key)
    bucket.value <- value
    m.count <- m.count + 1
    return &bucket.value

def arena_dict_contains[T](m: any dict[dstr[key_shape], T]&, key: dstr[key_shape]) -> bool:
    return arena_dict_get(m, key) != null

def arena_dict_remove[T](m: any dict[dstr[key_shape], T]&, key: dstr[key_shape]) -> bool:
    if m.capacity == 0 or m.items == null:
        return false

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    if not probe.found:
        return false

    items: any DictBucket[T]& = m.items
    bucket: any DictBucket[T]& = &items[probe.index]
    bucket.state <- DICT_BUCKET_TOMBSTONE
    bucket.hash <- 0u64
    bucket.key_data <- null
    bucket.key_len <- 0
    bucket.value <- zeroed
    m.count <- m.count - 1
    return true

def arena_dict_clear[T](m: any dict[dstr[key_shape], T]&):
    if m.items == null or m.capacity == 0:
        m.count <- 0
        m.used <- 0
        return

    items: any DictBucket[T]& = m.items
    arena_dict_zero_buckets(items, m.capacity)
    m.count <- 0
    m.used <- 0

def arena_dict_new__i64(a: any Arena&, initial_capacity: usize) -> DynDict[i64]:
    out: mutable DynDict[i64] = zeroed
    out.arena as & <- a

    capacity: usize = arena_dict_next_capacity(initial_capacity)
    if capacity == 0:
        return out

    items: any DictBucket[i64]& = arena_alloc(a, capacity * sizeof(DictBucket[i64])).cast[any DictBucket[i64]&]()
    arena_dict_zero_buckets(items, capacity)

    out.items as & <- items
    out.capacity <- capacity
    return out

def arena_dict_reserve__i64(a: any Arena&, m: any DynDict[i64]&, min_capacity: usize) -> void error[RuntimeError]:
    target_capacity: usize = arena_dict_next_capacity(min_capacity)
    if target_capacity == 0:
        return

    should_rebuild: bool = m.used > m.count and m.count * 2 < m.used
    if target_capacity <= m.capacity and not should_rebuild:
        return

    owner: any Arena& = m.arena if m.arena != null else a
    new_items: any DictBucket[i64]& = arena_alloc(owner, target_capacity * sizeof(DictBucket[i64])).cast[any DictBucket[i64]&]()
    arena_dict_zero_buckets(new_items, target_capacity)

    rebuilt: mutable DynDict[i64] = zeroed
    rebuilt.items as & <- new_items
    rebuilt.capacity <- target_capacity
    rebuilt.arena as & <- owner

    if m.items != null:
        old_items: any DictBucket[i64]& = m.items
        i: mutable usize = 0
        while i < m.capacity:
            if old_items[i].state == DICT_BUCKET_FULL:
                _ = arena_dict_insert_existing_bucket((&rebuilt).cast[any DynDict[i64]&](), old_items[i])
            i <- i + 1

    m.items as & <- rebuilt.items
    m.count <- rebuilt.count
    m.used <- rebuilt.used
    m.capacity <- rebuilt.capacity
    m.arena as & <- owner
    return

def arena_dict_get__i64(m: any DynDict[i64]&, key: any u8&) -> any i64&?:
    if m.capacity == 0 or m.items == null:
        return null

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    if not probe.found:
        return null

    items: any DictBucket[i64]& = m.items
    return &items[probe.index].value

def arena_dict_put__i64(a: any Arena&, m: any DynDict[i64]&, key: any u8&, value: i64) -> any i64&? error[RuntimeError]:
    owner: any Arena& = m.arena if m.arena != null else a
    if m.arena == null:
        m.arena as & <- owner

    if arena_dict_should_rehash(m, 1):
        target_capacity: mutable usize = DICT_INIT_CAP if m.capacity == 0 else m.capacity * 2
        if target_capacity < m.count + 1:
            target_capacity <- m.count + 1
        try arena_dict_reserve__i64(owner, m, target_capacity)

    if m.items == null or m.capacity == 0:
        try arena_dict_reserve__i64(owner, m, DICT_INIT_CAP)

    assert m.items != null
    assert m.capacity > 0

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    items: any DictBucket[i64]& = m.items
    bucket: any DictBucket[i64]& = &items[probe.index]

    if probe.found:
        bucket.value <- value
        return &bucket.value

    if bucket.state == DICT_BUCKET_EMPTY:
        m.used <- m.used + 1

    bucket.state <- DICT_BUCKET_FULL
    bucket.hash <- hash
    bucket.key_len <- key_len.i64()
    bucket.key_data as & <- arena_dict_copy_key(owner, key)
    bucket.value <- value
    m.count <- m.count + 1
    return &bucket.value

def arena_dict_contains__i64(m: any DynDict[i64]&, key: any u8&) -> bool:
    return arena_dict_get__i64(m, key) != null

def arena_dict_remove__i64(m: any DynDict[i64]&, key: any u8&) -> bool:
    if m.capacity == 0 or m.items == null:
        return false

    hash: u64 = arena_dict_hash_dstr(key)
    key_len: usize = arena_strlen(key)
    probe: DictProbeResult = arena_dict_probe_slot(m, key, hash, key_len)
    if not probe.found:
        return false

    items: any DictBucket[i64]& = m.items
    bucket: any DictBucket[i64]& = &items[probe.index]
    bucket.state <- DICT_BUCKET_TOMBSTONE
    bucket.hash <- 0u64
    bucket.key_data <- null
    bucket.key_len <- 0
    bucket.value <- zeroed
    m.count <- m.count - 1
    return true

def arena_dict_clear__i64(m: any DynDict[i64]&):
    if m.items == null or m.capacity == 0:
        m.count <- 0
        m.used <- 0
        return

    items: any DictBucket[i64]& = m.items
    arena_dict_zero_buckets(items, m.capacity)
    m.count <- 0
    m.used <- 0

def arena_da_view[T](da: any darray[T, shape_in]&, start: usize, end: usize) -> dview[T]:
    elem_size: usize = sizeof(T)
    if da.items == null or da.count == 0:
        return DynArrayView(null, 0, elem_size)

    lo: mutable usize = start if start < da.count else da.count
    hi: mutable usize = end if end < da.count else da.count
    if hi < lo:
        hi <- lo

    if hi == lo:
        return DynArrayView(null, 0, elem_size)

    return DynArrayView((da.items + lo).cast[any void&](), hi - lo, elem_size)

def arena_da_view_len[T](view: dview[T]) -> usize:
    return view.len

def arena_da_view_slice[T](view: dview[T], start: usize, end: usize) -> dview[T]:
    if view.data == null or view.len == 0:
        return DynArrayView(null, 0, view.elem_size)

    lo: mutable usize = start if start < view.len else view.len
    hi: mutable usize = end if end < view.len else view.len
    if hi < lo:
        hi <- lo

    if hi == lo:
        return DynArrayView(null, 0, view.elem_size)

    offset: usize = lo * view.elem_size
    return DynArrayView((view.data.cast[any u8&]() + offset).cast[any void&](), hi - lo, view.elem_size)

def arena_da_view_get[T](view: dview[T], index: usize) -> T:
    assert index < view.len
    assert view.data != null

    offset: usize = index * view.elem_size
    base: any T& = (view.data.cast[any u8&]() + offset).cast[any T&]()
    return base[0]

def arena_da_from_view[T](a: any Arena&, view: dview[T]) -> darray[T, shape_out]:
    if view.len == 0:
        return zeroed

    items: any T& = arena_alloc(a, view.len * sizeof(T)).cast[any T&]()
    assert view.data != null
    arena_memcpy(items.cast[any void&](), view.data.cast[any void&](), view.len * view.elem_size)

    out: mutable darray[T, shape_out] = zeroed
    out.items as & <- items
    out.count <- view.len
    out.capacity <- view.len
    return out

def arena_da_append[T](a: any Arena&, da: any darray[T, shape_in]&, item: T) -> any darray[T, shape_out]&:
    if da.count >= da.capacity:
        new_capacity: usize = ARENA_DA_INIT_CAP if da.capacity == 0 else da.capacity * 2

        old_size: usize = da.capacity * sizeof(T)
        new_size: usize = new_capacity * sizeof(T)

        if da.items == null:
            da.items as & <- arena_alloc(a, new_size).cast[any T&]()
        else:
            da.items as & <- arena_realloc(
                a,
                da.items.cast[any void&](),
                old_size,
                new_size
            ).cast[any T&]()

        da.capacity <- new_capacity

    assert da.items != null

    da.items[da.count] <- item
    da.count <- da.count + 1
    return da

def arena_da_append_many[T](a: any Arena&, da: any darray[T, shape_in]&, new_items: any T&, new_items_count: usize) -> any darray[T, shape_out]&:
    needed: usize = da.count + new_items_count

    if needed > da.capacity:
        new_capacity: mutable usize = da.capacity
        if new_capacity == 0:
            new_capacity <- ARENA_DA_INIT_CAP

        while needed > new_capacity:
            new_capacity <- new_capacity * 2

        old_size: usize = da.capacity * sizeof(T)
        new_size: usize = new_capacity * sizeof(T)

        if da.items == null:
            da.items as & <- arena_alloc(a, new_size).cast[any T&]()
        else:
            da.items as & <- arena_realloc(
                a,
                da.items.cast[any void&](),
                old_size,
                new_size
            ).cast[any T&]()

        da.capacity <- new_capacity

    assert da.items != null

    arena_memcpy(
        (da.items + da.count).cast[any void&](),
        new_items.cast[any void&](),
        new_items_count * sizeof(T)
    )

    da.count <- da.count + new_items_count
    return da

def arena_sb_append_buf(a: any Arena&, sb: any darray[u8, shape_in]&, buf: any u8&, n: usize) -> any darray[u8, shape_out]&:
    return arena_da_append_many(a, sb, buf, n)

def arena_sb_append_cstr(a: any Arena&, sb: any darray[u8, shape_in]&, cstr: any u8&) -> any darray[u8, shape_out]&:
    n: usize = arena_strlen(cstr)
    return arena_da_append_many(a, sb, cstr, n)

def arena_sb_append_null(a: any Arena&, sb: any darray[u8, shape_in]&) -> any darray[u8, shape_out]&:
    return arena_da_append(a, sb, 0u8)

# ------------------------------------------------------------
# Optional stdio formatting stubs
# ------------------------------------------------------------

extern va_list
extern va_copy(args: va_list) -> va_list
extern va_end(args: va_list)

extern vsnprintf(
    buffer: any u8&?,
    buffer_size: usize,
    format: any u8&,
    args: va_list
) -> int

def arena_vsprintf(a: any Arena&, format: any u8&, args: va_list) -> any u8&:
    args_copy: va_list = va_copy(args)
    n: int = vsnprintf(null, 0, format, args_copy)
    va_end(args_copy)

    assert n >= 0

    result: any u8& = arena_alloc(a, n.usize() + 1).cast[any u8&]()
    _ = vsnprintf(result, n.usize() + 1, format, args)
    return result
