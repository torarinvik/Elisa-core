    return PackedStoreIndexAllocResult(result.row, indices[state.indices.count - 1u])

def ctx_packed_store_alloc_index_result(a: any Arena&, size_bytes: usize, state_bits: any void&) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_result(a, size_bytes, state_bits)
