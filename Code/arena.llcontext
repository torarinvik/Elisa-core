# ============================================================
# Arena allocator - low level Contextlang runtime dialect
# ============================================================

const ARENA_BACKEND_LIBC_MALLOC = 0
const ARENA_BACKEND_LINUX_MMAP = 1
const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2
const ARENA_BACKEND_WASM_HEAPBASE = 3

const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

const ARENA_REGION_DEFAULT_CAPACITY: usize = 8 * 1024
const ARENA_DA_INIT_CAP: usize = 256
const ARENA_WASM_PAGE_SIZE: usize = 64 * 1024
const PACKED_STORE_MIN_ROWS_PER_REGION: usize = 64

const DICT_BUCKET_EMPTY: u8 = 0u8
const DICT_BUCKET_FULL: u8 = 1u8
const DICT_BUCKET_TOMBSTONE: u8 = 2u8
const DICT_INIT_CAP: usize = 8

error RuntimeError:
    OutOfMemory

# ------------------------------------------------------------
# Basic low-level types
# ------------------------------------------------------------

struct Region:
    next: mutable heap Region&?
    count: mutable usize
    capacity: mutable usize
    owner_tag: mutable uintptr
    owner_next: mutable heap Region&?
    global_index: mutable usize
    data: tail uintptr

struct Arena:
    begin:mutable heap Region&?
    end:mutable heap Region&?
    end_index: mutable usize

struct ArenaMark:
    region: heap Region&?
    count: usize

struct PackedStoreAllocResult:
    row: mutable heap void&?
    handle: mutable uintptr

struct PackedStoreIndexAllocResult:
    row: mutable heap void&?
    index: mutable u32

struct PackedStoreState:
    head_region: mutable heap Region&?
    alloc_region: mutable heap Region&?
    alloc_region_index: mutable usize
    decode_region: mutable heap Region&?
    decode_region_index: mutable usize
    tail_region: mutable heap Region&?
    regions: mutable darray[heap Region&?]
    handles: mutable darray[uintptr]
    indices: mutable darray[u32]
    tags: mutable darray[u32]
    prefix_words: mutable usize
    prefix_columns: mutable darray[uintptr]
    prefix_column_capacity: mutable usize
    row_words: mutable usize
    preferred_region_capacity: mutable usize

struct DynArray[T]:
    items: mutable any T&?
    count: mutable usize
    capacity: mutable usize

struct DynArrayView:
    data: mutable any void&?
    len: mutable usize
    elem_size: mutable usize

struct DictBucket[T]:
    state: mutable u8
    hash: mutable u64
    key_data: mutable any u8&?
    key_len: mutable i64
    value: mutable T

struct DynDict[T]:
    items: mutable any DictBucket[T]&?
    count: mutable usize
    used: mutable usize
    capacity: mutable usize
    arena: mutable any Arena&?

struct DictProbeResult:
    index: mutable usize
    found: mutable bool

# ------------------------------------------------------------
# Backend FFI declarations
# ------------------------------------------------------------

static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
    extern malloc(size: usize) -> heap void&? can[Memory.Allocate]
    extern free(ptr: heap void&) can[Memory.Release]

static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const PROT_READ = 0x1
    const PROT_WRITE = 0x2
    const MAP_PRIVATE = 0x02
    const MAP_ANONYMOUS = 0x20

    extern mmap(
        addr: heap void&?,
        length: usize,
        prot: int,
        flags: int,
        fd: int,
        offset: isize
    ) -> heap void&?

    extern munmap(addr: heap void&, length: usize) -> int
    extern MAP_FAILED() -> heap void&?

static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04

    extern GetCurrentProcess() -> any void&
    extern VirtualAllocEx(
        process: any void&,
        address: heap void&?,
        size: usize,
        alloc_type: int,
        protect: int
    ) -> heap void&?

    extern VirtualFreeEx(
        process: any void&,
        address: heap void&,
        size: usize,
        free_type: int
    ) -> bool

static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
    extern __heap_base: heap u8&
    extern wasm_memory_size(index: int) -> int
    extern wasm_memory_grow(index: int, pages: usize) -> int

    global mutable bump_pointer: heap u8& = __heap_base

# ------------------------------------------------------------
# Small utilities
# ------------------------------------------------------------

def assert(condition: bool) can[Abort.Panic]:
    if not condition:
        panic("assert failed")

def max(a: usize, b: usize) -> usize:
    return a if a > b else b

def inv_handle(ptr: heap void&?) -> bool:
    return ptr == null

# ------------------------------------------------------------
# Pointer-state helpers
# ------------------------------------------------------------

def sfree[T](ptr: heap T&) -> heap T! can[Memory.Release]:
    free(ptr.cast[heap void&]())
    return null

# ------------------------------------------------------------
# Region allocation / freeing
# ------------------------------------------------------------

def new_region_with_owner(capacity: usize, owner_tag: uintptr) -> heap Region& can[Memory.Allocate, Abort.Panic]:
    size_bytes: usize = sizeof(Region) + sizeof(uintptr) * capacity

    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        raw: heap void&? = malloc(size_bytes)
        assert raw != null
        r: heap Region& = raw.cast[heap Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        raw: heap void&? = mmap(
            null,
            size_bytes,
            PROT_READ | PROT_WRITE,
            MAP_ANONYMOUS | MAP_PRIVATE,
            -1,
            0
        )
        assert raw != MAP_FAILED()
        r: heap Region& = raw.cast[heap Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        raw: heap void&? = VirtualAllocEx(
            GetCurrentProcess(),
            null,
            size_bytes,
            MEM_COMMIT | MEM_RESERVE,
            PAGE_READWRITE
        )
        assert not inv_handle(raw)
        r: heap Region& = raw.cast[heap Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        r: heap Region& = bump_pointer.cast[heap Region&]()
        current_memory_size: usize = ARENA_WASM_PAGE_SIZE * wasm_memory_size(0).usize()
        desired_memory_size: usize = bump_pointer.usize() + size_bytes

        if desired_memory_size > current_memory_size:
            delta_bytes: usize = desired_memory_size - current_memory_size
            delta_pages: usize = (delta_bytes + (ARENA_WASM_PAGE_SIZE - 1)) / ARENA_WASM_PAGE_SIZE

            grow_result: int = wasm_memory_grow(0, delta_pages)
            assert grow_result >= 0

        bump_pointer <- bump_pointer + size_bytes

    static else:
        static error("Unknown arena backend")

    r.next <- null
    r.count <- 0
    r.capacity <- capacity
    r.owner_tag <- owner_tag
    r.owner_next <- null
    r.global_index <- 0
    return r

def new_region(capacity: usize) -> heap Region& can[Memory.Allocate, Abort.Panic]:
    return new_region_with_owner(capacity, 0u64.uintptr())

def free_region(r: heap Region&) can[Memory.Release, Abort.Panic]:
    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        free(r.cast[heap void&]())

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        size_bytes: usize = sizeof(Region) + sizeof(uintptr) * r.capacity
        ret: int = munmap(r.cast[heap void&](), size_bytes)
        assert ret == 0

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        ok: bool = VirtualFreeEx(
            GetCurrentProcess(),
            r.cast[heap void&](),
            0,
            MEM_RELEASE
        )
        assert ok

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        pass

# ------------------------------------------------------------
# Core arena allocation
# ------------------------------------------------------------

def arena_alloc(a: any Arena&, size_bytes: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if a.end == null:
        assert a.begin == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end as & <- new_region(capacity)
        a.begin <- a.end
        a.end_index <- 0
        a.end.global_index <- 0

    assert a.end != null

    while (a.end.owner_tag != 0u64.uintptr() or a.end.count + size > a.end.capacity) and a.end.next != null:
        a.end <- a.end.next
        a.end_index <- a.end_index + 1

    if a.end.owner_tag != 0u64.uintptr() or a.end.count + size > a.end.capacity:
        assert a.end.next == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end.next as & <- new_region(capacity)
        a.end <- a.end.next
        a.end_index <- a.end_index + 1
        a.end.global_index <- a.end_index

    data_base: heap u8& = (a.end.cast[heap u8&]() + sizeof(Region)).cast[heap u8&]()
    offset_bytes: usize = a.end.count * sizeof(uintptr)
    result: heap void& = (data_base + offset_bytes).cast[heap void&]()
    a.end.count <- a.end.count + size
    return result

def arena_realloc(a: any Arena&, oldptr: any void&, oldsz: usize, newsz: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    if newsz <= oldsz:
        return oldptr.cast[heap void&]()

    newptr: heap void& = arena_alloc(a, newsz)
    newptr_bytes: heap u8& = newptr.cast[heap u8&]()
    oldptr_bytes: any u8& = oldptr.cast[any u8&]()

    i: mutable usize = 0
    while i < oldsz:
        newptr_bytes[i] <- oldptr_bytes[i]
        i <- i + 1

    return newptr

# ------------------------------------------------------------
# Memory/string helpers
# ------------------------------------------------------------

def arena_strlen(s: any u8&) -> usize:
    n:mutable usize = 0
    while s[n] != 0:
        n <- n + 1
    return n

def arena_memcpy(dest: any void&, src: any void&, n: usize) -> any void&:
    d: any u8& = dest.cast[any u8&]()
    s: any u8& = src.cast[any u8&]()

	i: mutable usize = 0
    while i < n:
        d[i] <- s[i]
        i <- i + 1

    return dest

def arena_memeq(lhs: any void&, rhs: any void&, n: usize) -> bool:
    left: any u8& = lhs.cast[any u8&]()
    right: any u8& = rhs.cast[any u8&]()

    i: mutable usize = 0
    while i < n:
        if left[i] != right[i]:
            return false
        i <- i + 1

    return true

def arena_strdup(a: any Arena&, cstr: any u8&) -> heap u8& can[Memory.Allocate, Abort.Panic]:
    n: usize = arena_strlen(cstr)
    dup: heap u8& = arena_alloc(a, n + 1).cast[heap u8&]()
    arena_memcpy(dup.cast[any void&](), cstr.cast[any void&](), n)
    dup[n] <- 0
    return dup

def arena_memdup(a: any Arena&, data: any void&, size: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    dup: heap void& = arena_alloc(a, size)
    _ = arena_memcpy(dup.cast[any void&](), data, size)
    return dup

def packed_store_region_data(r: heap Region&) -> heap u8&:
    return (r.cast[heap u8&]() + sizeof(Region)).cast[heap u8&]()

def packed_store_region_table(state: any PackedStoreState&) -> any darray[heap Region&?]&:
    return (&state.regions).cast[any darray[heap Region&?]&]()

def packed_store_handle_table(state: any PackedStoreState&) -> any darray[uintptr]&:
    return (&state.handles).cast[any darray[uintptr]&]()

def packed_store_index_table(state: any PackedStoreState&) -> any darray[u32]&:
    return (&state.indices).cast[any darray[u32]&]()

def packed_store_tag_table(state: any PackedStoreState&) -> any darray[u32]&:
    return (&state.tags).cast[any darray[u32]&]()

def packed_store_prefix_column_table(state: any PackedStoreState&) -> any darray[uintptr]&:
    return (&state.prefix_columns).cast[any darray[uintptr]&]()

def arena_da_reserve[T](a: any Arena&, da: any darray[T, shape_in]&, needed: usize) -> any darray[T, shape_out]& can[Memory.Allocate, Abort.Panic]:
    if needed <= da.capacity:
        return da

    new_capacity: mutable usize = da.capacity
    if new_capacity == 0u:
        new_capacity <- ARENA_DA_INIT_CAP

    while needed > new_capacity:
        new_capacity <- new_capacity * 2u

    old_size: usize = da.capacity * sizeof(T)
    new_size: usize = new_capacity * sizeof(T)

    if da.items == null:
        da.items as & <- arena_alloc(a, new_size).cast[any T&]()
    else:
        da.items as & <- arena_realloc(
            a,
            da.items.cast[any void&](),
            old_size,
            new_size
        ).cast[any T&]()

    da.capacity <- new_capacity
    return da

def packed_store_ensure_metadata_capacity(a: any Arena&, state: any PackedStoreState&, needed_rows: usize) can[Memory.Allocate, Abort.Panic]:
    handles: any darray[uintptr]& = packed_store_handle_table(state)
    indices: any darray[u32]& = packed_store_index_table(state)
    tags: any darray[u32]& = packed_store_tag_table(state)

    _ = arena_da_reserve(a, handles, needed_rows)
    _ = arena_da_reserve(a, indices, needed_rows)
    _ = arena_da_reserve(a, tags, needed_rows)

    packed_store_ensure_prefix_columns(a, state, needed_rows)

def packed_store_append_handle(a: any Arena&, state: any PackedStoreState&, handle: uintptr) can[Memory.Allocate, Abort.Panic]:
    handles: any darray[uintptr]& = packed_store_handle_table(state)
    _ = arena_da_append(a, handles, handle)

def packed_store_append_index(a: any Arena&, state: any PackedStoreState&, index: u32) can[Memory.Allocate, Abort.Panic]:
    indices: any darray[u32]& = packed_store_index_table(state)
    _ = arena_da_append(a, indices, index)

def packed_store_append_tag(a: any Arena&, state: any PackedStoreState&, tag: u32) can[Memory.Allocate, Abort.Panic]:
    tags: any darray[u32]& = packed_store_tag_table(state)
    _ = arena_da_append(a, tags, tag)

def packed_store_ensure_prefix_columns(a: any Arena&, state: any PackedStoreState&, needed_rows: usize) can[Memory.Allocate, Abort.Panic]:
    if state.prefix_words == 0u:
        return

    columns: any darray[uintptr]& = packed_store_prefix_column_table(state)
    while columns.count < state.prefix_words:
        _ = arena_da_append(a, columns, 0u64.uintptr())

    if state.prefix_column_capacity >= needed_rows:
        return

    new_capacity: mutable usize = ARENA_DA_INIT_CAP if state.prefix_column_capacity == 0u else state.prefix_column_capacity * 2u
    while new_capacity < needed_rows:
        new_capacity <- new_capacity * 2u

    old_size: usize = state.prefix_column_capacity * sizeof(uintptr)
    new_size: usize = new_capacity * sizeof(uintptr)
    assert columns.items != null
    column_ptrs: any uintptr& = columns.items
    i: mutable usize = 0u
    while i < state.prefix_words:
        if column_ptrs[i] == 0u64.uintptr():
            column_ptrs[i] <- arena_alloc(a, new_size).cast[heap uintptr&]().cast[heap u8&]().uintptr()
        else:
            current_ptr: heap uintptr& = column_ptrs[i].cast[heap u8&]().cast[heap uintptr&]()
            column_ptrs[i] <- arena_realloc(
                a,
                current_ptr.cast[any void&](),
                old_size,
                new_size
            ).cast[heap uintptr&]().cast[heap u8&]().uintptr()
        i <- i + 1u

    state.prefix_column_capacity <- new_capacity

def packed_store_append_prefix_words(a: any Arena&, state: any PackedStoreState&, row: any void&) can[Memory.Allocate, Abort.Panic]:
    if state.prefix_words == 0u:
        return
    needed_rows: usize = state.handles.count
    packed_store_ensure_prefix_columns(a, state, needed_rows)
    assert state.prefix_columns.items != null
    column_ptrs: any uintptr& = state.prefix_columns.items
    row_words: any uintptr& = row.cast[any uintptr&]()
    row_index: usize = needed_rows - 1u
    i: mutable usize = 0u
    while i < state.prefix_words:
        assert column_ptrs[i] != 0u64.uintptr()
        column: any uintptr& = column_ptrs[i].cast[heap u8&]().cast[any uintptr&]()
        column[row_index] <- row_words[i]
        i <- i + 1u

def packed_store_register_region(a: any Arena&, state: any PackedStoreState&, r: heap Region&?, global_index: usize) can[Memory.Allocate, Abort.Panic]:
    assert r != null

    regions: any darray[heap Region&?]& = packed_store_region_table(state)

    while regions.count <= global_index:
        _ = arena_da_append(a, regions, null)

    assert regions.items != null
    regions.items[global_index] <- r

def packed_store_lookup_region(state: any PackedStoreState&, global_index: usize) -> heap Region&?:
    if state.regions.items == null:
        return null
    if global_index >= state.regions.count:
        return null
    return state.regions.items[global_index]

def ctx_packed_store_state_new(a: any Arena&, row_bytes: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
    state: heap PackedStoreState& = arena_alloc(a, sizeof(PackedStoreState)).cast[heap PackedStoreState&]()
    row_words: usize = (row_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)
    preferred_region_capacity: mutable usize = ARENA_REGION_DEFAULT_CAPACITY
    hinted_capacity: usize = row_words * PACKED_STORE_MIN_ROWS_PER_REGION

    if preferred_region_capacity < hinted_capacity:
        preferred_region_capacity <- hinted_capacity
    if preferred_region_capacity < row_words:
        preferred_region_capacity <- row_words

    state.head_region <- null
    state.alloc_region <- null
    state.alloc_region_index <- 0
    state.decode_region <- null
    state.decode_region_index <- 0
    state.tail_region <- null
    state.regions <- zeroed
    state.handles <- zeroed
    state.indices <- zeroed
    state.tags <- zeroed
    state.prefix_words <- row_words
    state.prefix_columns <- zeroed
    state.prefix_column_capacity <- 0u
    state.row_words <- row_words
    state.preferred_region_capacity <- preferred_region_capacity
    return state.cast[heap void&]()

def ctx_packed_store_alloc_result_slow(a: any Arena&, size: usize, owner_tag: uintptr, state: any PackedStoreState&) can[Memory.Allocate, Abort.Panic]:
    if state.alloc_region == null:
        capacity: mutable usize = state.preferred_region_capacity
        if capacity < size:
            capacity <- size

        if a.end == null:
            assert a.begin == null
            a.end as & <- new_region_with_owner(capacity, owner_tag)
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
        else:
            a.end.next as & <- new_region_with_owner(capacity, owner_tag)
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index

        state.head_region <- a.end
        state.alloc_region <- a.end
        state.alloc_region_index <- a.end_index
        state.tail_region <- a.end
        packed_store_register_region(a, state, a.end, a.end_index)
        return

    assert state.alloc_region != null
    assert state.tail_region != null

    cursor: mutable heap Region&? = state.alloc_region.owner_next
    found_region: mutable heap Region&? = null
    found_region_index: mutable usize = 0

    while cursor != null:
        if cursor.count + size <= cursor.capacity:
            found_region <- cursor
            found_region_index <- cursor.global_index
            cursor <- null
        else:
            cursor <- cursor.owner_next

    if found_region != null:
        state.alloc_region <- found_region
        state.alloc_region_index <- found_region_index
        return

    capacity: mutable usize = state.preferred_region_capacity
    grown_capacity: usize = state.alloc_region.capacity * 2
    if capacity < grown_capacity:
        capacity <- grown_capacity
    if capacity < size:
        capacity <- size

    assert a.end != null
    a.end.next as & <- new_region_with_owner(capacity, owner_tag)
    a.end <- a.end.next
    a.end_index <- a.end_index + 1
    a.end.global_index <- a.end_index
    state.tail_region.owner_next as & <- a.end
    state.tail_region <- a.end
    state.alloc_region <- a.end
    state.alloc_region_index <- a.end_index
    packed_store_register_region(a, state, a.end, a.end_index)

def ctx_packed_store_alloc_fixed_result_slow(a: any Arena&, owner_tag: uintptr, state: any PackedStoreState&) can[Memory.Allocate, Abort.Panic]:
    size: usize = state.row_words
    assert size > 0

    if state.alloc_region == null:
        capacity: mutable usize = state.preferred_region_capacity
        if capacity < size:
            capacity <- size

        if a.end == null:
            assert a.begin == null
            a.end as & <- new_region_with_owner(capacity, owner_tag)
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
        else:
            a.end.next as & <- new_region_with_owner(capacity, owner_tag)
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index

        state.head_region <- a.end
        state.alloc_region <- a.end
        state.alloc_region_index <- a.end_index
        state.tail_region <- a.end
        packed_store_register_region(a, state, a.end, a.end_index)
        return

    assert state.alloc_region != null
    assert state.tail_region != null

    capacity: mutable usize = state.preferred_region_capacity
    grown_capacity: usize = state.alloc_region.capacity * 2
    if capacity < grown_capacity:
        capacity <- grown_capacity
    if capacity < size:
        capacity <- size

    assert a.end != null
    a.end.next as & <- new_region_with_owner(capacity, owner_tag)
    a.end <- a.end.next
    a.end_index <- a.end_index + 1
    a.end.global_index <- a.end_index
    state.tail_region.owner_next as & <- a.end
    state.tail_region <- a.end
    state.alloc_region <- a.end
    state.alloc_region_index <- a.end_index
    packed_store_register_region(a, state, a.end, a.end_index)

def ctx_packed_store_alloc_fixed_result(a: any Arena&, state_bits: any void&) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()
    owner_tag: uintptr = state_bits.cast[any u8&]().uintptr()
    size: usize = state.row_words
    assert size > 0

    if state.alloc_region == null or state.alloc_region.count + size > state.alloc_region.capacity:
        ctx_packed_store_alloc_fixed_result_slow(a, owner_tag, state)

    assert state.alloc_region != null

    data_base: heap u8& = packed_store_region_data(state.alloc_region)
    offset_bytes: uintptr = (state.alloc_region.count * sizeof(uintptr)).uintptr()
    ptr: heap void& = (data_base + state.alloc_region.count * sizeof(uintptr)).cast[heap void&]()
    state.alloc_region.count <- state.alloc_region.count + size
    state.decode_region <- state.alloc_region
    state.decode_region_index <- state.alloc_region_index

    if a.end == null:
        a.end as & <- state.alloc_region
        a.end_index <- state.alloc_region_index

    offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
    handle: uintptr = (state.alloc_region_index.uintptr() << 32u64.uintptr()) | (offset_words + 1u64.uintptr())
    needed_rows: usize = state.handles.count + 1u
    packed_store_ensure_metadata_capacity(a, state, needed_rows)

    assert state.handles.items != null
    state.handles.items[state.handles.count] <- handle
    state.handles.count <- state.handles.count + 1u

    assert state.indices.items != null
    state.indices.items[state.indices.count] <- (state.handles.count - 1u).u32()
    state.indices.count <- state.indices.count + 1u
    return PackedStoreAllocResult(ptr, handle)

def ctx_packed_store_alloc_fixed_tagged_result(a: any Arena&, state_bits: any void&, tag: u32) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_result(a, state_bits)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()

    needed_rows: mutable usize = state.tags.count + 1u
    if needed_rows < state.handles.count:
        needed_rows <- state.handles.count

    packed_store_ensure_metadata_capacity(a, state, needed_rows)
    assert state.tags.items != null
    state.tags.items[state.tags.count] <- tag
    state.tags.count <- state.tags.count + 1u
    return result

def ctx_packed_store_alloc_result(a: any Arena&, size_bytes: usize, state_bits: any void&) -> PackedStoreAllocResult can[Memory.Allocate, Abort.Panic]:
    assert state_bits != null

    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()
    owner_tag: uintptr = state_bits.cast[any u8&]().uintptr()
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if size > state.row_words:
        state.row_words <- size

        hinted_capacity: usize = state.row_words * PACKED_STORE_MIN_ROWS_PER_REGION
        if state.preferred_region_capacity < hinted_capacity:
            state.preferred_region_capacity <- hinted_capacity
        if state.preferred_region_capacity < state.row_words:
            state.preferred_region_capacity <- state.row_words

    if state.alloc_region == null or state.alloc_region.count + size > state.alloc_region.capacity:
        ctx_packed_store_alloc_result_slow(a, size, owner_tag, state)

    assert state.alloc_region != null

    data_base: heap u8& = packed_store_region_data(state.alloc_region)
    offset_bytes: uintptr = (state.alloc_region.count * sizeof(uintptr)).uintptr()
    ptr: heap void& = (data_base + state.alloc_region.count * sizeof(uintptr)).cast[heap void&]()
    state.alloc_region.count <- state.alloc_region.count + size
    state.decode_region <- state.alloc_region
    state.decode_region_index <- state.alloc_region_index

    if a.end == null:
        a.end as & <- state.alloc_region
        a.end_index <- state.alloc_region_index

    offset_words: uintptr = offset_bytes / sizeof(uintptr).uintptr()
    handle: uintptr = (state.alloc_region_index.uintptr() << 32u64.uintptr()) | (offset_words + 1u64.uintptr())
    needed_rows: usize = state.handles.count + 1u
    packed_store_ensure_metadata_capacity(a, state, needed_rows)

    assert state.handles.items != null
    state.handles.items[state.handles.count] <- handle
    state.handles.count <- state.handles.count + 1u

    assert state.indices.items != null
    state.indices.items[state.indices.count] <- (state.handles.count - 1u).u32()
    state.indices.count <- state.indices.count + 1u
    return PackedStoreAllocResult(ptr, handle)

def ctx_packed_store_alloc_fixed_index_result(a: any Arena&, state_bits: any void&) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_result(a, state_bits)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()
    assert state.indices.items != null
    assert state.indices.count > 0u
    indices: any u32& = state.indices.items
    return PackedStoreIndexAllocResult(result.row, indices[state.indices.count - 1u])

def ctx_packed_store_alloc_fixed_tagged_index_result(a: any Arena&, state_bits: any void&, tag: u32) -> PackedStoreIndexAllocResult can[Memory.Allocate, Abort.Panic]:
    result: PackedStoreAllocResult = ctx_packed_store_alloc_fixed_tagged_result(a, state_bits, tag)
    state: any PackedStoreState& = state_bits.cast[any PackedStoreState&]()
    assert state.indices.items != null
    assert state.indices.count > 0u
