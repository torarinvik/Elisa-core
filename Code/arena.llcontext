# ============================================================
# Arena allocator - low level Contextlang runtime dialect
# ============================================================

const ARENA_BACKEND_LIBC_MALLOC = 0
const ARENA_BACKEND_LINUX_MMAP = 1
const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2
const ARENA_BACKEND_WASM_HEAPBASE = 3

const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

const ARENA_REGION_DEFAULT_CAPACITY: usize = 8 * 1024
const ARENA_DA_INIT_CAP: usize = 256
const ARENA_WASM_PAGE_SIZE: usize = 64 * 1024

# ------------------------------------------------------------
# Basic low-level types
# ------------------------------------------------------------

repr(c) struct Region:
    next: mutable any Region&?
    count: mutable usize
    capacity: usize
    data: tail uintptr

repr(c) struct Arena:
    begin:mutable any Region&?
    end:mutable any Region&?

repr(c) struct ArenaMark:
    region: any Region&?
    count: usize

repr(c) struct DynArray[T]:
    items: mutable any T&?
    count: mutable usize
    capacity: mutable usize

repr(c) struct DynArrayView:
    data: mutable any void&?
    len: mutable usize
    elem_size: mutable usize

# ------------------------------------------------------------
# Backend FFI declarations
# ------------------------------------------------------------

static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
    extern malloc(size: usize) -> any void&?
    extern free(ptr: any void&)

static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const PROT_READ = 0x1
    const PROT_WRITE = 0x2
    const MAP_PRIVATE = 0x02
    const MAP_ANONYMOUS = 0x20

    extern mmap(
        addr: any void&?,
        length: usize,
        prot: int,
        flags: int,
        fd: int,
        offset: isize
    ) -> any void&?

    extern munmap(addr: any void&, length: usize) -> int
    extern MAP_FAILED() -> any void&?

static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04

    extern GetCurrentProcess() -> any void&
    extern VirtualAllocEx(
        process: any void&,
        address: any void&?,
        size: usize,
        alloc_type: int,
        protect: int
    ) -> any void&?

    extern VirtualFreeEx(
        process: any void&,
        address: any void&,
        size: usize,
        free_type: int
    ) -> bool

static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
    extern __heap_base: any u8&
    extern wasm_memory_size(index: int) -> int
    extern wasm_memory_grow(index: int, pages: usize) -> int

    global mutable bump_pointer: any u8& = __heap_base

# ------------------------------------------------------------
# Small utilities
# ------------------------------------------------------------

def assert(condition: bool):
    if not condition:
        panic("assert failed")

def max(a: usize, b: usize) -> usize:
    return a if a > b else b

def inv_handle(ptr: any void&?) -> bool:
    return ptr == null

# ------------------------------------------------------------
# Pointer-state helpers
# ------------------------------------------------------------

def sfree[T](ptr: any T&) -> any T!:
    free(ptr.cast[any void&]())
    return null

# ------------------------------------------------------------
# Region allocation / freeing
# ------------------------------------------------------------

def new_region(capacity: usize) -> any Region&:
    size_bytes: usize = sizeof(Region) + sizeof(uintptr) * capacity

    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        raw: any void&? = malloc(size_bytes)
        assert raw != null
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        raw: any void&? = mmap(
            null,
            size_bytes,
            PROT_READ | PROT_WRITE,
            MAP_ANONYMOUS | MAP_PRIVATE,
            -1,
            0
        )
        assert raw != MAP_FAILED()
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        raw: any void&? = VirtualAllocEx(
            GetCurrentProcess(),
            null,
            size_bytes,
            MEM_COMMIT | MEM_RESERVE,
            PAGE_READWRITE
        )
        assert not inv_handle(raw)
        r: any Region& = raw.cast[any Region&]()

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        r: any Region& = bump_pointer.cast[any Region&]()
        current_memory_size: usize = ARENA_WASM_PAGE_SIZE * wasm_memory_size(0).usize()
        desired_memory_size: usize = bump_pointer.usize() + size_bytes

        if desired_memory_size > current_memory_size:
            delta_bytes: usize = desired_memory_size - current_memory_size
            delta_pages: usize = (delta_bytes + (ARENA_WASM_PAGE_SIZE - 1)) / ARENA_WASM_PAGE_SIZE

            grow_result: int = wasm_memory_grow(0, delta_pages)
            assert grow_result >= 0

        bump_pointer <- bump_pointer + size_bytes

    static else:
        static error("Unknown arena backend")

    r.next <- null
    r.count <- 0
    return r

def free_region(r: any Region&):
    static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
        free(r.cast[any void&]())

    static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
        size_bytes: usize = sizeof(Region) + sizeof(uintptr) * r.capacity
        ret: int = munmap(r.cast[any void&](), size_bytes)
        assert ret == 0

    static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
        ok: bool = VirtualFreeEx(
            GetCurrentProcess(),
            r.cast[any void&](),
            0,
            MEM_RELEASE
        )
        assert ok

    static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
        pass

# ------------------------------------------------------------
# Core arena allocation
# ------------------------------------------------------------

def arena_alloc(a: any Arena&, size_bytes: usize) -> any void&:
    size: usize = (size_bytes + sizeof(uintptr) - 1) / sizeof(uintptr)

    if a.end == null:
        assert a.begin == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end as & <- new_region(capacity)
        a.begin <- a.end

    assert a.end != null

    while a.end.count + size > a.end.capacity and a.end.next != null:
        a.end <- a.end.next

    if a.end.count + size > a.end.capacity:
        assert a.end.next == null

        capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
        if capacity < size:
            capacity <- size

        a.end.next as & <- new_region(capacity)
        a.end <- a.end.next

    result: any void& = (&a.end.data[a.end.count]).cast[any void&]()
    a.end.count <- a.end.count + size
    return result

def arena_realloc(a: any Arena&, oldptr: any void&, oldsz: usize, newsz: usize) -> any void&:
    if newsz <= oldsz:
        return oldptr

    newptr: any void& = arena_alloc(a, newsz)
    newptr_bytes: any u8& = newptr.cast[any u8&]()
    oldptr_bytes: any u8& = oldptr.cast[any u8&]()

    i: mutable usize = 0
    while i < oldsz:
        newptr_bytes[i] <- oldptr_bytes[i]
        i <- i + 1

    return newptr

# ------------------------------------------------------------
# Memory/string helpers
# ------------------------------------------------------------

def arena_strlen(s: any u8&) -> usize:
    n:mutable usize = 0
    while s[n] != 0:
        n <- n + 1
    return n

def arena_memcpy(dest: any void&, src: any void&, n: usize) -> any void&:
    d: any u8& = dest.cast[any u8&]()
    s: any u8& = src.cast[any u8&]()

	i: mutable usize = 0
    while i < n:
        d[i] <- s[i]
        i <- i + 1

    return dest

def arena_strdup(a: any Arena&, cstr: any u8&) -> any u8&:
    n: usize = arena_strlen(cstr)
    dup: any u8& = arena_alloc(a, n + 1).cast[any u8&]()
    arena_memcpy(dup.cast[any void&](), cstr.cast[any void&](), n)
    dup[n] <- 0
    return dup

def arena_memdup(a: any Arena&, data: any void&, size: usize) -> any void&:
    return arena_memcpy(arena_alloc(a, size), data, size)

# ------------------------------------------------------------
# Snapshot / rewind / reset / free / trim
# ------------------------------------------------------------

def arena_snapshot(a: any Arena&) -> ArenaMark:
    if a.end == null:
        assert a.begin == null
        return ArenaMark(null, 0)

    return ArenaMark(a.end, a.end.count)

def arena_reset(a: any Arena&):
    r: mutable any Region&? = a.begin
    while r != null:
        r.count <- 0
        r <- r.next

    a.end <- a.begin

def arena_rewind(a: any Arena&, m: ArenaMark):
    if m.region == null:
        arena_reset(a)
        return

    region: any Region& = m.region
    region.count <- m.count

    r: mutable any Region&? = region.next
    while r != null:
        r.count <- 0
        r <- r.next

    a.end as & <- region

def arena_free(a: any Arena&):
    r: mutable any Region&? = a.begin

    while r != null:
        r0: mutable any Region& = r
        r <- r.next
        r0 as ! <- sfree(r0)

    a.begin as ! <- null
    a.end as ! <- null

def arena_trim(a: any Arena&):
    if a.end == null:
        return

    r: mutable any Region&? = a.end.next
    while r != null:
        r0: mutable any Region& = r
        r <- r.next
        r0 as ! <- sfree(r0)

    a.end.next as ! <- null

# ------------------------------------------------------------
# Dynamic array helpers (replacement for C macros)
# ------------------------------------------------------------

def arena_da_view[T](da: any DArray[T, shape_in]&, start: usize, end: usize) -> DArrayView[T]:
    elem_size: usize = sizeof(T)
    if da.items == null or da.count == 0:
        return DynArrayView(null, 0, elem_size)

    lo: mutable usize = start if start < da.count else da.count
    hi: mutable usize = end if end < da.count else da.count
    if hi < lo:
        hi <- lo

    if hi == lo:
        return DynArrayView(null, 0, elem_size)

    return DynArrayView((da.items + lo).cast[any void&](), hi - lo, elem_size)

def arena_da_view_len[T](view: DArrayView[T]) -> usize:
    return view.len

def arena_da_view_slice[T](view: DArrayView[T], start: usize, end: usize) -> DArrayView[T]:
    if view.data == null or view.len == 0:
        return DynArrayView(null, 0, view.elem_size)

    lo: mutable usize = start if start < view.len else view.len
    hi: mutable usize = end if end < view.len else view.len
    if hi < lo:
        hi <- lo

    if hi == lo:
        return DynArrayView(null, 0, view.elem_size)

    offset: usize = lo * view.elem_size
    return DynArrayView((view.data.cast[any u8&]() + offset).cast[any void&](), hi - lo, view.elem_size)

def arena_da_view_get[T](view: DArrayView[T], index: usize) -> T:
    assert index < view.len
    assert view.data != null

    offset: usize = index * view.elem_size
    base: any T& = (view.data.cast[any u8&]() + offset).cast[any T&]()
    return base[0]

def arena_da_from_view[T](a: any Arena&, view: DArrayView[T]) -> DArray[T, shape_out]:
    if view.len == 0:
        return zeroed

    items: any T& = arena_alloc(a, view.len * sizeof(T)).cast[any T&]()
    assert view.data != null
    arena_memcpy(items.cast[any void&](), view.data.cast[any void&](), view.len * view.elem_size)

    out: mutable DArray[T, shape_out] = zeroed
    out.items as & <- items
    out.count <- view.len
    out.capacity <- view.len
    return out

def arena_da_append[T](a: any Arena&, da: any DArray[T, shape_in]&, item: T) -> any DArray[T, shape_out]&:
    if da.count >= da.capacity:
        new_capacity: usize = ARENA_DA_INIT_CAP if da.capacity == 0 else da.capacity * 2

        old_size: usize = da.capacity * sizeof(T)
        new_size: usize = new_capacity * sizeof(T)

        if da.items == null:
            da.items as & <- arena_alloc(a, new_size).cast[any T&]()
        else:
            da.items as & <- arena_realloc(
                a,
                da.items.cast[any void&](),
                old_size,
                new_size
            ).cast[any T&]()

        da.capacity <- new_capacity

    assert da.items != null

    da.items[da.count] <- item
    da.count <- da.count + 1
    return da

def arena_da_append_many[T](a: any Arena&, da: any DArray[T, shape_in]&, new_items: any T&, new_items_count: usize) -> any DArray[T, shape_out]&:
    needed: usize = da.count + new_items_count

    if needed > da.capacity:
        new_capacity: mutable usize = da.capacity
        if new_capacity == 0:
            new_capacity <- ARENA_DA_INIT_CAP

        while needed > new_capacity:
            new_capacity <- new_capacity * 2

        old_size: usize = da.capacity * sizeof(T)
        new_size: usize = new_capacity * sizeof(T)

        if da.items == null:
            da.items as & <- arena_alloc(a, new_size).cast[any T&]()
        else:
            da.items as & <- arena_realloc(
                a,
                da.items.cast[any void&](),
                old_size,
                new_size
            ).cast[any T&]()

        da.capacity <- new_capacity

    assert da.items != null

    arena_memcpy(
        (da.items + da.count).cast[any void&](),
        new_items.cast[any void&](),
        new_items_count * sizeof(T)
    )

    da.count <- da.count + new_items_count
    return da

def arena_sb_append_buf(a: any Arena&, sb: any DArray[u8, shape_in]&, buf: any u8&, n: usize) -> any DArray[u8, shape_out]&:
    return arena_da_append_many(a, sb, buf, n)

def arena_sb_append_cstr(a: any Arena&, sb: any DArray[u8, shape_in]&, cstr: any u8&) -> any DArray[u8, shape_out]&:
    n: usize = arena_strlen(cstr)
    return arena_da_append_many(a, sb, cstr, n)

def arena_sb_append_null(a: any Arena&, sb: any DArray[u8, shape_in]&) -> any DArray[u8, shape_out]&:
    return arena_da_append(a, sb, 0u8)

# ------------------------------------------------------------
# Optional stdio formatting stubs
# ------------------------------------------------------------

extern va_list
extern va_copy(args: va_list) -> va_list
extern va_end(args: va_list)

extern vsnprintf(
    buffer: any u8&?,
    buffer_size: usize,
    format: any u8&,
    args: va_list
) -> int

def arena_vsprintf(a: any Arena&, format: any u8&, args: va_list) -> any u8&:
    args_copy: va_list = va_copy(args)
    n: int = vsnprintf(null, 0, format, args_copy)
    va_end(args_copy)

    assert n >= 0

    result: any u8& = arena_alloc(a, n.usize() + 1).cast[any u8&]()
    _ = vsnprintf(result, n.usize() + 1, format, args)
    return result
