# ============================================================
# Contextlang Runtime - explicit concurrency carriers and helpers
# First slice: explicit runtime-facing surface, POSIX seam, generic atomics
# ============================================================

# ------------------------------------------------------------
# Core runtime carriers
# ------------------------------------------------------------

repr(c) struct Thread[T, S]:
	handle: mutable uintptr
	state: mutable any void&?

repr(c) struct Task[T, S]:
	handle: mutable uintptr
	state: mutable any void&?

repr(c) struct ThreadPool:
	handle: mutable any void&?

repr(c) struct TaskGroup:
	handle: mutable any void&?
	cleanup: mutable any void&?

repr(c) struct Mutex:
	handle: mutable any void&?

repr(c) struct MutexGuard[S]:
	handle: mutable any void&?

repr(c) struct CondVar:
	handle: mutable any void&?

repr(c) struct atomic[T]:
	value: mutable T

repr(c) struct ConcurrencyBox[T]:
	value: mutable T

repr(c) struct ConcurrencyWorkStart1:
	fn_bits: mutable uintptr
	arg_bits: mutable any void&
	result_bits: mutable any void&
	refs: mutable atomic[i64]

repr(c) struct ConcurrencyTaskGroupNode:
	next: mutable heap ConcurrencyTaskGroupNode&?
	state_bits: mutable any void&

enum MemoryOrder:
	Relaxed
	Acquire
	Release
	AcqRel
	SeqCst

# ------------------------------------------------------------
# Low-level POSIX seam declarations
# ------------------------------------------------------------

extern pthread_create(thread: any uintptr&, attr: any void&?, start_routine: any void&, arg: any void&?) -> int can[Thread.Spawn]
extern pthread_join(thread: uintptr, retval: any void&?) -> int can[Thread.Join]
extern pthread_detach(thread: uintptr) -> int can[Thread.Detach]

extern pthread_mutex_lock(mutex: any void&) -> int can[Sync.Lock]
extern pthread_mutex_unlock(mutex: any void&) -> int can[Sync.Unlock]
extern pthread_cond_wait(cond: any void&, mutex: any void&) -> int can[Sync.Wait]
extern pthread_cond_signal(cond: any void&) -> int can[Sync.Notify]
extern pthread_cond_broadcast(cond: any void&) -> int can[Sync.Notify]

# ------------------------------------------------------------
# First-slice explicit runtime-facing handles
# ------------------------------------------------------------

extern spawn_raw(entry: any void&, arg: any void&?) -> Thread[any void&?, Joinable] can[Thread.Spawn]
extern join_raw(thread: Thread[any void&?, Joinable]) -> any void&? can[Thread.Join]
extern detach_raw(thread: Thread[any void&?, Joinable]) -> void can[Thread.Detach]

extern pool_new(threads: usize) -> ThreadPool can[Pool.Create]
extern pool_shutdown(pool: any ThreadPool&) -> void can[Pool.Shutdown]
extern pool_submit_raw(pool: any ThreadPool&, entry: any void&, arg: any void&?) -> Task[any void&?, Pending] can[Pool.Submit]
extern pool_await_raw(task: Task[any void&?, Pending]) -> any void&? can[Pool.Await]

extern task_group_new_raw() -> TaskGroup
extern task_group_add_raw(group: any TaskGroup&, task: Task[any void&?, Pending]) -> void
extern task_group_wait_all_raw(group: any TaskGroup&) -> void can[Pool.WaitAll]

extern mutex_lock(mu: any Mutex&) -> MutexGuard[Held] can[Sync.Lock]
extern mutex_unlock(g: MutexGuard[Held]) -> void can[Sync.Unlock]
extern cond_wait(cv: any CondVar&, g: MutexGuard[Held]) -> MutexGuard[Held] can[Sync.Wait]
extern notify_one(cv: any CondVar&) -> void can[Sync.Notify]
extern notify_all(cv: any CondVar&) -> void can[Sync.Notify]

# ------------------------------------------------------------
# Typed wrapper helpers
# ------------------------------------------------------------

def ctx_concurrency_alloc(size: usize) -> heap void& can[Memory.Allocate, Abort.Panic]:
	raw: heap void&? = malloc(size) can Memory.Allocate
	if raw == null:
		panic("concurrency allocation failed")
	ptr: heap void& = raw.cast[heap void&]()
	return ptr

def ctx_concurrency_box_new[T](value: T) -> heap ConcurrencyBox[T]& can[Memory.Allocate, Abort.Panic]:
	raw: heap void& = ctx_concurrency_alloc(sizeof(ConcurrencyBox[T]))
	box: heap ConcurrencyBox[T]& = raw.cast[heap ConcurrencyBox[T]&]()
	box.value <- value
	return box

def ctx_concurrency_ref_release(slot: any atomic[i64]&) -> i64 can[Atomics.Load, Atomics.CompareExchange]:
	while true:
		current: i64 = load(slot, MemoryOrder.Acquire) can Atomics.Load
		next: i64 = current - 1
		if compare_exchange(slot, current, next, MemoryOrder.AcqRel, MemoryOrder.Acquire) can Atomics.CompareExchange:
			return next
	return 0

def ctx_concurrency_work1_release(state_bits: any void&?) can[Memory.Release, Atomics.Load, Atomics.CompareExchange]:
	if state_bits == null:
		return
	live_bits: any void& = state_bits.cast[any void&]()
	state: heap ConcurrencyWorkStart1& = live_bits.cast[heap ConcurrencyWorkStart1&]()
	remaining: i64 = ctx_concurrency_ref_release((&state.refs).cast[any atomic[i64]&]())
	if remaining == 0:
		free(state.arg_bits.cast[heap void&]()) can Memory.Release
		free(state.result_bits.cast[heap void&]()) can Memory.Release
		free(state.cast[heap void&]()) can Memory.Release

def ctx_concurrency_work1_new[A, R, permission P](fn: func(A) -> R can[P], arg: A) -> heap ConcurrencyWorkStart1& can[Memory.Allocate, Abort.Panic]:
	arg_box: heap ConcurrencyBox[A]& = ctx_concurrency_box_new(arg)
	result_seed: R = zeroed
	result_box: heap ConcurrencyBox[R]& = ctx_concurrency_box_new(result_seed)
	raw: heap void& = ctx_concurrency_alloc(sizeof(ConcurrencyWorkStart1))
	state: heap ConcurrencyWorkStart1& = raw.cast[heap ConcurrencyWorkStart1&]()
	state.fn_bits <- fn.cast[uintptr]()
	state.arg_bits <- arg_box.cast[any void&]()
	state.result_bits <- result_box.cast[any void&]()
	state.refs.value <- 2
	return state

def ctx_concurrency_work1_entry[A, R, permission P](state_bits: any void&) -> any void& can[P, Memory.Release, Atomics.Load, Atomics.CompareExchange]:
	state: heap ConcurrencyWorkStart1& = state_bits.cast[heap ConcurrencyWorkStart1&]()
	fn: func(A) -> R can[P] = state.fn_bits.cast[func(A) -> R can[P]]()
	arg_box: heap ConcurrencyBox[A]& = state.arg_bits.cast[heap ConcurrencyBox[A]&]()
	result_box: heap ConcurrencyBox[R]& = state.result_bits.cast[heap ConcurrencyBox[R]&]()
	result_box.value <- fn(arg_box.value)
	ctx_concurrency_work1_release(state.cast[any void&]())
	return state.cast[any void&]()

def ctx_concurrency_work1_take_result[R](state_bits: any void&?) -> R can[Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	if state_bits == null:
		panic("concurrency work returned no state")
	live_bits: any void& = state_bits.cast[any void&]()
	state: heap ConcurrencyWorkStart1& = live_bits.cast[heap ConcurrencyWorkStart1&]()
	result_box: heap ConcurrencyBox[R]& = state.result_bits.cast[heap ConcurrencyBox[R]&]()
	result: R = result_box.value
	ctx_concurrency_work1_release(state.cast[any void&]())
	return result

def ctx_thread_from_raw[R, S](raw: Thread[any void&?, S]) -> Thread[R, S]:
	out: Thread[R, S] = zeroed
	out.handle <- raw.handle
	out.state <- raw.state
	return move out

def ctx_thread_to_raw[R, S](thread: Thread[R, S]) -> Thread[any void&?, S]:
	out: Thread[any void&?, S] = zeroed
	out.handle <- thread.handle
	out.state <- thread.state
	return move out

def ctx_task_from_raw[R, S](raw: Task[any void&?, S]) -> Task[R, S]:
	out: Task[R, S] = zeroed
	out.handle <- raw.handle
	out.state <- raw.state
	return move out

def ctx_task_to_raw[R, S](task: Task[R, S]) -> Task[any void&?, S]:
	out: Task[any void&?, S] = zeroed
	out.handle <- task.handle
	out.state <- task.state
	return move out

def task_group_new() -> TaskGroup:
	group: TaskGroup = task_group_new_raw()
	group.cleanup <- null
	return group

def ctx_task_group_push_state(group: any TaskGroup&, state_bits: any void&?) can[Memory.Allocate, Abort.Panic]:
	if state_bits == null:
		return
	raw: heap void& = ctx_concurrency_alloc(sizeof(ConcurrencyTaskGroupNode))
	node: heap ConcurrencyTaskGroupNode& = raw.cast[heap ConcurrencyTaskGroupNode&]()
	if group.cleanup == null:
		node.next <- null
	else:
		node.next <- group.cleanup.cast[heap ConcurrencyTaskGroupNode&]()
	node.state_bits <- state_bits.cast[any void&]()
	group.cleanup <- node.cast[any void&]()

def ctx_task_group_release_all(group: any TaskGroup&) can[Memory.Release, Atomics.Load, Atomics.CompareExchange]:
	if group.cleanup == null:
		return
	current: mutable heap ConcurrencyTaskGroupNode&? = group.cleanup.cast[heap ConcurrencyTaskGroupNode&?]()
	group.cleanup <- null
	while current != null:
		next: mutable heap ConcurrencyTaskGroupNode&? = current.next
		ctx_concurrency_work1_release(current.state_bits.cast[any void&]())
		free(current.cast[heap void&]()) can Memory.Release
		current <- next

def spawn1[A, R, permission P](fn: func(A) -> R can[P], arg: A) -> Thread[R, Joinable] can[Thread.Spawn, Memory.Allocate, Abort.Panic]:
	from_raw: func(Thread[any void&?, Joinable]) -> Thread[R, Joinable] = ctx_thread_from_raw.specialize[R, Joinable]()
	state: heap ConcurrencyWorkStart1& = ctx_concurrency_work1_new(fn, arg)
	raw: Thread[any void&?, Joinable] = spawn_raw(
		ctx_concurrency_work1_entry.specialize[A, R]().cast[any void&](),
		state.cast[any void&]()
	) can Thread.Spawn
	raw.state <- state.cast[any void&]()
	return from_raw(move raw)

def join[R](thread: Thread[R, Joinable]) -> R can[Thread.Join, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	take_result: func(any void&?) -> R can[Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange] = ctx_concurrency_work1_take_result.specialize[R]()
	state_bits: any void&? = thread.state
	raw: Thread[any void&?, Joinable] = ctx_thread_to_raw(move thread)
	_ = join_raw(move raw) can Thread.Join
	return take_result(state_bits)

def detach[R](thread: Thread[R, Joinable]) can[Thread.Detach, Memory.Release, Atomics.Load, Atomics.CompareExchange]:
	state_bits: any void&? = thread.state
	raw: Thread[any void&?, Joinable] = ctx_thread_to_raw(move thread)
	detach_raw(move raw) can Thread.Detach
	ctx_concurrency_work1_release(state_bits)

def pool_submit1[A, R, permission P](pool: any ThreadPool&, fn: func(A) -> R can[P], arg: A) -> Task[R, Pending] can[Pool.Submit, Memory.Allocate, Abort.Panic]:
	from_raw: func(Task[any void&?, Pending]) -> Task[R, Pending] = ctx_task_from_raw.specialize[R, Pending]()
	state: heap ConcurrencyWorkStart1& = ctx_concurrency_work1_new(fn, arg)
	raw: Task[any void&?, Pending] = pool_submit_raw(
		pool,
		ctx_concurrency_work1_entry.specialize[A, R]().cast[any void&](),
		state.cast[any void&]()
	) can Pool.Submit
	raw.state <- state.cast[any void&]()
	return from_raw(move raw)

def pool_await[R](task: Task[R, Pending]) -> R can[Pool.Await, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange]:
	take_result: func(any void&?) -> R can[Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange] = ctx_concurrency_work1_take_result.specialize[R]()
	state_bits: any void&? = task.state
	raw: Task[any void&?, Pending] = ctx_task_to_raw(move task)
	_ = pool_await_raw(move raw) can Pool.Await
	return take_result(state_bits)

def task_group_add[R](group: any TaskGroup&, task: Task[R, Pending]) can[Memory.Allocate, Abort.Panic]:
	state_bits: any void&? = task.state
	raw: Task[any void&?, Pending] = ctx_task_to_raw(move task)
	task_group_add_raw(group, move raw)
	ctx_task_group_push_state(group, state_bits)

def task_group_wait_all(group: any TaskGroup&) can[Pool.WaitAll, Memory.Release, Atomics.Load, Atomics.CompareExchange]:
	task_group_wait_all_raw(group) can Pool.WaitAll
	ctx_task_group_release_all(group)

# ------------------------------------------------------------
# Generic atomic helpers
# ------------------------------------------------------------

def load[T](slot: any atomic[T]&, order: MemoryOrder) -> T can[Atomics.Load]:
	_ = order
	return slot.value

def store[T](slot: any atomic[T]&, value: T, order: MemoryOrder) can[Atomics.Store]:
	_ = order
	slot.value <- value

def exchange[T](slot: any atomic[T]&, value: T, order: MemoryOrder) -> T can[Atomics.Exchange]:
	_ = order
	old_value: T = slot.value
	slot.value <- value
	return old_value

def compare_exchange[T](slot: any atomic[T]&, expected: T, desired: T, success: MemoryOrder, failure: MemoryOrder) -> bool can[Atomics.CompareExchange]:
	_ = success
	_ = failure
	if slot.value == expected:
		slot.value <- desired
		return true
	return false

def fence(order: MemoryOrder) can[Atomics.Fence]:
	_ = order
