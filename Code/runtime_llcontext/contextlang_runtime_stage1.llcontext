# ============================================================
# Contextlang Runtime - public wrappers and stage 1 adapters
# ============================================================

# ------------------------------------------------------------
# Type-to-string public API
# ------------------------------------------------------------

def ctx_stage0_int_to_string(value: i64) -> any u8& can[Memory.Allocate, Console.Format]:
    return ctx_stage0_int_to_string_into((&ctx_stage0_perm_arena).cast[any Arena&](), value)

def ctx_stage0_int_to_string_scratch(value: i64) -> any u8& can[Memory.Allocate, Console.Format]:
    return ctx_stage0_int_to_string_into((&ctx_stage0_scratch_arena).cast[any Arena&](), value)

def ctx_stage0_bool_to_string(value: int) -> any u8&:
    return ctx_stage0_bool_to_string_into((&ctx_stage0_perm_arena).cast[any Arena&](), value)

def ctx_stage0_bool_to_string_scratch(value: int) -> any u8&:
    return ctx_stage0_bool_to_string_into((&ctx_stage0_scratch_arena).cast[any Arena&](), value)

def ctx_stage0_char_to_string(value: i64) -> any u8& can[Memory.Allocate]:
    return ctx_stage0_char_to_string_into((&ctx_stage0_perm_arena).cast[any Arena&](), value)

def ctx_stage0_char_to_string_scratch(value: i64) -> any u8& can[Memory.Allocate]:
    return ctx_stage0_char_to_string_into((&ctx_stage0_scratch_arena).cast[any Arena&](), value)

# ------------------------------------------------------------
# Basic string predicates
# ------------------------------------------------------------

def ctx_stage0_strlen(value: any u8&?) -> i64:
    return ctx_stage0_runtime_strlen(value).i64()

def ctx_stage0_streq(lhs: any u8&?, rhs: any u8&?) -> int:
    left: any u8& = lhs if lhs != null else "".cast[any u8&]()
    right: any u8& = rhs if rhs != null else "".cast[any u8&]()

    if left == right:
        return 1

    return 1 if strcmp(left, right) == 0 else 0

# ============================================================
# Stage 1 runtime forwarding wrappers
# ============================================================

def ctx_stage1rt_concat2(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> dstr[shape_result] can[Memory.Allocate]:
    return ctx_stage0_concat2(lhs, rhs)

def ctx_stage1rt_concat2_scratch(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> dstr[shape_result] can[Memory.Allocate]:
    return ctx_stage0_concat2_scratch(lhs, rhs)

def ctx_stage1rt_string_builder_new(initial: any u8&?) -> any StringBuilder& can[Memory.Allocate]:
    return ctx_stage0_string_builder_new(initial)

def ctx_stage1rt_string_builder_append(builder: any StringBuilder&?, suffix: any u8&?) -> any StringBuilder& can[Memory.Allocate]:
    return ctx_stage0_string_builder_append(builder, suffix)

def ctx_stage1rt_string_builder_finish(builder: any StringBuilder&?) -> dstr[shape_out] can[Memory.Allocate]:
    return ctx_stage0_string_builder_finish(builder)

def ctx_stage1rt_int_to_string(value: i64) -> dstr[shape_out] can[Memory.Allocate, Console.Format]:
    return ctx_stage0_int_to_string(value)

def ctx_stage1rt_int_to_string_scratch(value: i64) -> dstr[shape_out] can[Memory.Allocate, Console.Format]:
    return ctx_stage0_int_to_string_scratch(value)

def ctx_stage1rt_bool_to_string(value: int) -> dstr[shape_out]:
    return ctx_stage0_bool_to_string(value)

def ctx_stage1rt_bool_to_string_scratch(value: int) -> dstr[shape_out]:
    return ctx_stage0_bool_to_string_scratch(value)

def ctx_stage1rt_char_to_string(value: i64) -> dstr[shape_out] can[Memory.Allocate]:
    return ctx_stage0_char_to_string(value)

def ctx_stage1rt_char_to_string_scratch(value: i64) -> dstr[shape_out] can[Memory.Allocate]:
    return ctx_stage0_char_to_string_scratch(value)

def ctx_stage1rt_strlen(value: dstr[shape_in]) -> i64:
    return ctx_stage0_strlen(value)

def ctx_stage1rt_streq(lhs: dstr[shape_left], rhs: dstr[shape_right]) -> int:
    return ctx_stage0_streq(lhs, rhs)

def ctx_stage1rt_string_slice_eq(value: dstr[shape_in], start: i64, end: i64, other: dstr[shape_other]) -> int:
    return ctx_stage0_string_slice_eq(value, start, end, other)

def ctx_stage1rt_string_slices_eq(lhs: dstr[shape_left], lhs_start: i64, lhs_end: i64, rhs: dstr[shape_right], rhs_start: i64, rhs_end: i64) -> int:
    return ctx_stage0_string_slices_eq(lhs, lhs_start, lhs_end, rhs, rhs_start, rhs_end)

def ctx_stage1rt_string_index(value: dstr[shape_in], index: i64) -> i64:
    return ctx_stage0_string_index(value, index)

def ctx_stage1rt_string_slice(value: dstr[shape_in], start: i64, end: i64) -> dstr[shape_out] can[Memory.Allocate]:
    return ctx_stage0_string_slice(value, start, end)

def ctx_stage1rt_string_view(value: dstr[shape_in], start: i64, end: i64) -> StringView:
    return ctx_stage0_string_view(value, start, end)

def ctx_stage1rt_string_view_len(view: StringView) -> i64:
    return ctx_stage0_string_view_len(view)

def ctx_stage1rt_string_view_slice(view: StringView, start: i64, end: i64) -> StringView:
    return ctx_stage0_string_view_slice(view, start, end)

def ctx_stage1rt_string_view_index(view: StringView, index: i64) -> i64:
    return ctx_stage0_string_view_index(view, index)

def ctx_stage1rt_string_view_eq(view: StringView, other: dstr[shape_other]) -> int:
    return ctx_stage0_string_view_eq(view, other)

def ctx_stage1rt_string_views_eq(lhs: StringView, rhs: StringView) -> int:
    return ctx_stage0_string_views_eq(lhs, rhs)

def ctx_stage1rt_string_from_view(view: StringView) -> dstr[shape_out] can[Memory.Allocate]:
    return ctx_stage0_string_view_copy(view)

def ctx_stage1rt_reset_scratch():
    ctx_stage0_reset_scratch()

def ctx_stage1rt_puts(value: any u8&?) -> int can[Console.Write]:
    return puts(value if value != null else "".cast[any u8&]())

# ------------------------------------------------------------
# Fatal error handler (weak linkage)
# ------------------------------------------------------------

# weak
def ctx_llvm_codegen_fatal(msg: any u8&?) can[Console, Abort.Exit]:
    actual_msg: any u8& = msg if msg != null else "<null>".cast[any u8&]()
    fprintf(stderr, "ctx_llvm_codegen_fatal: %s\n".cast[any u8&](), actual_msg)
    exit(1)