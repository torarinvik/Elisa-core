# ============================================================
# Self-hosted frontend lexer
# ============================================================


def frontend_require_arena(lexer: mutable any FrontendLexer&) -> mutable any Arena& can[Abort.Panic]:
    assert lexer.arena != null
    return lexer.arena


@inline(always)
def frontend_pending_is_empty(lexer: any FrontendLexer&) -> bool:
    is_empty: func(any Deque[FrontendToken]&) -> bool = arena_deque_is_empty.specialize[FrontendToken]()
    return is_empty((&lexer.pending_tokens).cast[any Deque[FrontendToken]&])


def frontend_pending_push_back(lexer: mutable any FrontendLexer&, token: FrontendToken) can[Memory.Allocate, Abort.Panic]:
    push_back: func(mutable any Arena&, mutable any Deque[FrontendToken]&, FrontendToken) -> mutable any Deque[FrontendToken]& can[Memory.Allocate, Abort.Panic] = arena_deque_push_back.specialize[FrontendToken]()
    _ = push_back(frontend_require_arena(lexer), (&lexer.pending_tokens).cast[mutable any Deque[FrontendToken]&], token)


def frontend_pending_pop_front(lexer: mutable any FrontendLexer&) -> FrontendToken can[Abort.Panic]:
    pop_front: func(mutable any Deque[FrontendToken]&, mutable any FrontendToken&) -> bool can[Abort.Panic] = arena_deque_pop_front.specialize[FrontendToken]()
    token: mutable FrontendToken = zeroed
    ok: bool = pop_front((&lexer.pending_tokens).cast[mutable any Deque[FrontendToken]&], (&token).cast[mutable any FrontendToken&])
    assert ok
    return token


def frontend_new_lexer_with_len(a: mutable any Arena&, filename: any u8&, source: any u8&, source_len: usize) -> FrontendLexer can[Memory.Allocate, Abort.Panic]:
    out: mutable FrontendLexer = zeroed
    out.arena as & <- a
    out.filename <- filename
    out.source <- source
    out.source_len <- source_len
    out.pos <- 0u
    out.line <- 1
    out.col <- 1
    out.at_line_start <- true
    out.paren_depth <- 0
    _ = arena_da_append(a, (&out.indent_stack).cast[mutable any darray[usize]&], 0u)
    return out


def frontend_new_lexer(a: mutable any Arena&, filename: any u8&, source: any u8&) -> FrontendLexer can[Memory.Allocate, Abort.Panic]:
    return frontend_new_lexer_with_len(a, filename, source, runtime_strlen(source))


@inline(always)
def frontend_cur_pos(lexer: any FrontendLexer&) -> FrontendPos:
    return FrontendPos(lexer.line, lexer.col, lexer.pos)


@inline(always)
def frontend_is_eof(lexer: any FrontendLexer&) -> bool:
    return lexer.pos >= lexer.source_len


@inline(always)
def frontend_char_at(source: any u8&, source_len: usize, index: usize) -> i64:
    if index >= source_len:
        return FRONTEND_CH_NUL
    return source[index].i64()


@inline(always)
def frontend_cur_char(lexer: any FrontendLexer&) -> i64:
    return frontend_char_at(lexer.source, lexer.source_len, lexer.pos)


@inline(always)
def frontend_peek_char_at(lexer: any FrontendLexer&, offset: usize) -> i64:
    return frontend_char_at(lexer.source, lexer.source_len, lexer.pos + offset)


@inline(always)
def frontend_make_source_view(source: any u8&, start: usize, end: usize) -> StringView:
    if end <= start:
        return frontend_empty_view()
    return string_view(source, start.i64(), end.i64())


@inline(always)
def frontend_make_lexer_view(lexer: any FrontendLexer&, start: usize, end: usize) -> StringView:
    return frontend_make_source_view(lexer.source, start, end)


@inline(always)
def frontend_advance_char(lexer: mutable any FrontendLexer&) -> i64:
    if frontend_is_eof(lexer):
        return FRONTEND_CH_NUL

    ch: i64 = frontend_cur_char(lexer)
    lexer.pos <- lexer.pos + 1u
    if ch == FRONTEND_CH_NL:
        lexer.line <- lexer.line + 1
        lexer.col <- 1
    else:
        lexer.col <- lexer.col + 1
    return ch


@inline(always)
def frontend_match_char(lexer: mutable any FrontendLexer&, expected: i64) -> bool:
    if frontend_cur_char(lexer) == expected:
        _ = frontend_advance_char(lexer)
        return true
    return false


@inline(always)
def frontend_pending_has_tokens(lexer: any FrontendLexer&) -> bool:
    return not frontend_pending_is_empty(lexer)


def frontend_push_pending(lexer: mutable any FrontendLexer&, token: FrontendToken) can[Memory.Allocate, Abort.Panic]:
    frontend_pending_push_back(lexer, token)


def frontend_pop_pending(lexer: mutable any FrontendLexer&) -> FrontendToken can[Abort.Panic]:
    return frontend_pending_pop_front(lexer)


def frontend_emit_pending_token(lexer: mutable any FrontendLexer&, kind: FrontendTokenKind) can[Memory.Allocate, Abort.Panic]:
    token: FrontendToken = frontend_make_token(kind, frontend_cur_pos(lexer), frontend_empty_view(), frontend_empty_view())
    frontend_push_pending(lexer, token)


def frontend_skip_line_comment(lexer: mutable any FrontendLexer&):
    while not frontend_is_eof(lexer) and frontend_cur_char(lexer) != FRONTEND_CH_NL:
        _ = frontend_advance_char(lexer)


def frontend_measure_indent(lexer: mutable any FrontendLexer&) -> usize:
    indent: mutable usize = 0u
    while not frontend_is_eof(lexer):
        ch: i64 = frontend_cur_char(lexer)
        if ch == FRONTEND_CH_SPACE:
            indent <- indent + 1u
            _ = frontend_advance_char(lexer)
        elif ch == FRONTEND_CH_TAB:
            indent <- indent + FRONTEND_TAB_WIDTH
            _ = frontend_advance_char(lexer)
        else:
            return indent
    return indent


def frontend_indent_top(lexer: any FrontendLexer&) -> usize:
    if lexer.indent_stack.count == 0u:
        return 0u
    return lexer.indent_stack[lexer.indent_stack.count - 1u]


def frontend_push_indent(lexer: mutable any FrontendLexer&, value: usize) can[Memory.Allocate, Abort.Panic]:
    _ = arena_da_append(frontend_require_arena(lexer), (&lexer.indent_stack).cast[mutable any darray[usize]&], value)


def frontend_pop_indent(lexer: mutable any FrontendLexer&):
    if lexer.indent_stack.count > 0u:
        lexer.indent_stack.count <- lexer.indent_stack.count - 1u


def frontend_handle_indentation(lexer: mutable any FrontendLexer&) can[Memory.Allocate, Abort.Panic]:
    indent: mutable usize = frontend_measure_indent(lexer)

    scanning: mutable bool = true
    while scanning:
        if frontend_is_eof(lexer) or frontend_cur_char(lexer) == FRONTEND_CH_NL:
            return

        if frontend_cur_char(lexer) == FRONTEND_CH_HASH:
            frontend_skip_line_comment(lexer)
            if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_NL:
                _ = frontend_advance_char(lexer)
                while not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_NL:
                    _ = frontend_advance_char(lexer)
            indent <- frontend_measure_indent(lexer)
        else:
            scanning <- false

    current: usize = frontend_indent_top(lexer)
    if indent > current:
        frontend_push_indent(lexer, indent)
        frontend_emit_pending_token(lexer, FrontendTokenKind.Indent)
        return

    if indent < current:
        while lexer.indent_stack.count > 1u and frontend_indent_top(lexer) > indent:
            frontend_pop_indent(lexer)
            frontend_emit_pending_token(lexer, FrontendTokenKind.Dedent)

        if frontend_indent_top(lexer) != indent:
            frontend_emit_pending_token(lexer, FrontendTokenKind.Dedent)


@inline(always)
def frontend_is_digit(ch: i64) -> bool:
    return ch >= 48 and ch <= 57


@inline(always)
def frontend_is_hex_digit(ch: i64) -> bool:
    return frontend_is_digit(ch) or (ch >= FRONTEND_CH_a and ch <= FRONTEND_CH_f) or (ch >= FRONTEND_CH_A and ch <= FRONTEND_CH_F)


@inline(always)
def frontend_is_ascii_alpha(ch: i64) -> bool:
    return (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90)


@inline(always)
def frontend_is_ascii_alnum(ch: i64) -> bool:
    return frontend_is_ascii_alpha(ch) or frontend_is_digit(ch)


@inline(always)
def frontend_is_ident_start(ch: i64) -> bool:
    return ch == FRONTEND_CH_UNDERSCORE or frontend_is_ascii_alpha(ch)


@inline(always)
def frontend_is_ident_char(ch: i64) -> bool:
    return ch == FRONTEND_CH_UNDERSCORE or frontend_is_ascii_alnum(ch)


@inline(always)
def frontend_sv_first_char(view: StringView) -> i64:
    if view.len <= 0:
        return FRONTEND_CH_NUL
    return view.data[0u].i64()


@inline(always)
def frontend_sv_is_1(view: StringView, a: i64) -> bool:
    return view.len == 1 and view.data[0u].i64() == a


@inline(always)
def frontend_sv_is_2(view: StringView, a: i64, b: i64) -> bool:
    return view.len == 2 and view.data[0u].i64() == a and view.data[1u].i64() == b


@inline(always)
def frontend_sv_is_3(view: StringView, a: i64, b: i64, c: i64) -> bool:
    return view.len == 3 and view.data[0u].i64() == a and view.data[1u].i64() == b and view.data[2u].i64() == c


@inline(always)
def frontend_sv_is_4(view: StringView, a: i64, b: i64, c: i64, d: i64) -> bool:
    return view.len == 4 and view.data[0u].i64() == a and view.data[1u].i64() == b and view.data[2u].i64() == c and view.data[3u].i64() == d


@inline(always)
def frontend_sv_is_5(view: StringView, a: i64, b: i64, c: i64, d: i64, e: i64) -> bool:
    return view.len == 5 and view.data[0u].i64() == a and view.data[1u].i64() == b and view.data[2u].i64() == c and view.data[3u].i64() == d and view.data[4u].i64() == e


@inline(always)
def frontend_sv_is_6(view: StringView, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> bool:
    return view.len == 6 and view.data[0u].i64() == a and view.data[1u].i64() == b and view.data[2u].i64() == c and view.data[3u].i64() == d and view.data[4u].i64() == e and view.data[5u].i64() == f


@inline(always)
def frontend_sv_is_7(view: StringView, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> bool:
    return view.len == 7 and view.data[0u].i64() == a and view.data[1u].i64() == b and view.data[2u].i64() == c and view.data[3u].i64() == d and view.data[4u].i64() == e and view.data[5u].i64() == f and view.data[6u].i64() == g


@inline(always)
def frontend_valid_suffix(view: StringView) -> bool:
    first: i64 = frontend_sv_first_char(view)
    if first == FRONTEND_CH_u:
        return frontend_sv_is_1(view, FRONTEND_CH_u) or frontend_sv_is_2(view, FRONTEND_CH_u, 56) or frontend_sv_is_3(view, FRONTEND_CH_u, 49, 54) or frontend_sv_is_3(view, FRONTEND_CH_u, 51, 50) or frontend_sv_is_3(view, FRONTEND_CH_u, 54, 52) or frontend_sv_is_5(view, FRONTEND_CH_u, 115, 105, 122, 101)
    if first == FRONTEND_CH_i:
        return frontend_sv_is_2(view, FRONTEND_CH_i, 56) or frontend_sv_is_3(view, FRONTEND_CH_i, 49, 54) or frontend_sv_is_3(view, FRONTEND_CH_i, 51, 50) or frontend_sv_is_3(view, FRONTEND_CH_i, 54, 52) or frontend_sv_is_5(view, FRONTEND_CH_i, 115, 105, 122, 101)
    if first == FRONTEND_CH_f:
        return frontend_sv_is_3(view, FRONTEND_CH_f, 51, 50) or frontend_sv_is_3(view, FRONTEND_CH_f, 54, 52)
    return false


@inline(always)
def frontend_try_read_type_suffix(lexer: mutable any FrontendLexer&) -> StringView:
    start: usize = lexer.pos
    first: i64 = frontend_cur_char(lexer)
    if first != FRONTEND_CH_u and first != FRONTEND_CH_i and first != FRONTEND_CH_f:
        return frontend_empty_view()

    probe: mutable usize = start + 1u
    while probe < lexer.source_len and frontend_is_ascii_alnum(frontend_char_at(lexer.source, lexer.source_len, probe)):
        probe <- probe + 1u

    suffix: StringView = frontend_make_lexer_view(lexer, start, probe)
    if not frontend_valid_suffix(suffix):
        return frontend_empty_view()

    lexer.pos <- probe
    lexer.col <- lexer.col + (probe - start).i64()
    return suffix


struct FrontendKeywordEntry:
    text: mutable static u8&
    kind: mutable FrontendTokenKind


@inline(always)
def frontend_lookup_keyword_bucket(entries: any FrontendKeywordEntry&, count: usize, text: StringView) -> FrontendTokenKind:
    for i in 0u..<count:
        entry: FrontendKeywordEntry = entries[i]
        if frontend_sv_eq_literal(text, entry.text):
            return entry.kind
    return FrontendTokenKind.Ident


@inline(always)
def frontend_lookup_keyword(text: StringView) -> FrontendTokenKind:
    if text.len == 2:
        entries: FrontendKeywordEntry[5] = [
            FrontendKeywordEntry("as", FrontendTokenKind.As),
            FrontendKeywordEntry("if", FrontendTokenKind.If),
            FrontendKeywordEntry("in", FrontendTokenKind.In),
            FrontendKeywordEntry("or", FrontendTokenKind.Or),
            FrontendKeywordEntry("to", FrontendTokenKind.To)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 5u, text)

    if text.len == 3:
        entries: FrontendKeywordEntry[5] = [
            FrontendKeywordEntry("and", FrontendTokenKind.And),
            FrontendKeywordEntry("any", FrontendTokenKind.Any),
            FrontendKeywordEntry("def", FrontendTokenKind.Def),
            FrontendKeywordEntry("not", FrontendTokenKind.Not),
            FrontendKeywordEntry("try", FrontendTokenKind.Try)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 5u, text)

    if text.len == 4:
        entries: FrontendKeywordEntry[9] = [
            FrontendKeywordEntry("elif", FrontendTokenKind.Elif),
            FrontendKeywordEntry("else", FrontendTokenKind.Else),
            FrontendKeywordEntry("enum", FrontendTokenKind.Enum),
            FrontendKeywordEntry("heap", FrontendTokenKind.Heap),
            FrontendKeywordEntry("null", FrontendTokenKind.Null),
            FrontendKeywordEntry("pass", FrontendTokenKind.Pass),
            FrontendKeywordEntry("repr", FrontendTokenKind.Repr),
            FrontendKeywordEntry("tail", FrontendTokenKind.Tail),
            FrontendKeywordEntry("true", FrontendTokenKind.True)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 9u, text)

    if text.len == 5:
        entries: FrontendKeywordEntry[8] = [
            FrontendKeywordEntry("const", FrontendTokenKind.Const),
            FrontendKeywordEntry("error", FrontendTokenKind.Error),
            FrontendKeywordEntry("false", FrontendTokenKind.False),
            FrontendKeywordEntry("match", FrontendTokenKind.Match),
            FrontendKeywordEntry("panic", FrontendTokenKind.Panic),
            FrontendKeywordEntry("raise", FrontendTokenKind.Raise),
            FrontendKeywordEntry("stack", FrontendTokenKind.Stack),
            FrontendKeywordEntry("while", FrontendTokenKind.While)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 8u, text)

    if text.len == 6:
        entries: FrontendKeywordEntry[9] = [
            FrontendKeywordEntry("export", FrontendTokenKind.Export),
            FrontendKeywordEntry("extern", FrontendTokenKind.Extern),
            FrontendKeywordEntry("global", FrontendTokenKind.Global),
            FrontendKeywordEntry("packed", FrontendTokenKind.Packed),
            FrontendKeywordEntry("return", FrontendTokenKind.Return),
            FrontendKeywordEntry("sizeof", FrontendTokenKind.Sizeof),
            FrontendKeywordEntry("static", FrontendTokenKind.Static),
            FrontendKeywordEntry("struct", FrontendTokenKind.Struct),
            FrontendKeywordEntry("zeroed", FrontendTokenKind.Zeroed)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 9u, text)

    if text.len == 7:
        entries: FrontendKeywordEntry[2] = [
            FrontendKeywordEntry("aligned", FrontendTokenKind.Aligned),
            FrontendKeywordEntry("mutable", FrontendTokenKind.Mutable)
        ]
        return frontend_lookup_keyword_bucket((&entries[0u]).cast[any FrontendKeywordEntry&], 2u, text)

    return FrontendTokenKind.Ident


@inline(always)
def frontend_maybe_keyword_first_char(ch: i64) -> bool:
    return ch == 97 or ch == 99 or ch == 100 or ch == 101 or ch == 102 or ch == 103 or ch == 104 or ch == 105 or ch == 109 or ch == 110 or ch == 111 or ch == 112 or ch == 114 or ch == 115 or ch == 116 or ch == 119 or ch == 122


def frontend_read_string(lexer: mutable any FrontendLexer&) -> FrontendToken:
    pos: FrontendPos = frontend_cur_pos(lexer)
    _ = frontend_advance_char(lexer)
    start: usize = lexer.pos

    while not frontend_is_eof(lexer) and frontend_cur_char(lexer) != FRONTEND_CH_DQUOTE and frontend_cur_char(lexer) != FRONTEND_CH_NL:
        if frontend_cur_char(lexer) == FRONTEND_CH_BSLASH:
            _ = frontend_advance_char(lexer)
            if frontend_is_eof(lexer):
                text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
                return frontend_make_token(FrontendTokenKind.StringLit, pos, text, frontend_empty_view())
        _ = frontend_advance_char(lexer)

    text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_DQUOTE:
        _ = frontend_advance_char(lexer)

    return frontend_make_token(FrontendTokenKind.StringLit, pos, text, frontend_empty_view())


def frontend_read_char(lexer: mutable any FrontendLexer&) -> FrontendToken:
    pos: FrontendPos = frontend_cur_pos(lexer)
    _ = frontend_advance_char(lexer)
    start: usize = lexer.pos

    while not frontend_is_eof(lexer) and frontend_cur_char(lexer) != FRONTEND_CH_SQUOTE and frontend_cur_char(lexer) != FRONTEND_CH_NL:
        if frontend_cur_char(lexer) == FRONTEND_CH_BSLASH:
            _ = frontend_advance_char(lexer)
            if frontend_is_eof(lexer):
                text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
                return frontend_make_token(FrontendTokenKind.CharLit, pos, text, frontend_empty_view())
        _ = frontend_advance_char(lexer)

    text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_SQUOTE:
        _ = frontend_advance_char(lexer)

    return frontend_make_token(FrontendTokenKind.CharLit, pos, text, frontend_empty_view())


def frontend_read_number(lexer: mutable any FrontendLexer&) -> FrontendToken:
    pos: FrontendPos = frontend_cur_pos(lexer)
    start: usize = lexer.pos

    if frontend_cur_char(lexer) == 48 and (frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_x or frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_X):
        _ = frontend_advance_char(lexer)
        _ = frontend_advance_char(lexer)
        while not frontend_is_eof(lexer) and frontend_is_hex_digit(frontend_cur_char(lexer)):
            _ = frontend_advance_char(lexer)
        text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
        suffix: StringView = frontend_try_read_type_suffix(lexer)
        return frontend_make_token(FrontendTokenKind.HexLit, pos, text, suffix)

    while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
        _ = frontend_advance_char(lexer)

    is_float: mutable bool = false
    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_DOT and frontend_is_digit(frontend_peek_char_at(lexer, 1u)):
        is_float <- true
        _ = frontend_advance_char(lexer)
        while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
            _ = frontend_advance_char(lexer)

    if not frontend_is_eof(lexer) and (frontend_cur_char(lexer) == FRONTEND_CH_e or frontend_cur_char(lexer) == FRONTEND_CH_E):
        exp_next: i64 = frontend_peek_char_at(lexer, 1u)
        exp_valid: mutable bool = frontend_is_digit(exp_next)
        if exp_next == FRONTEND_CH_PLUS or exp_next == FRONTEND_CH_MINUS:
            exp_valid <- frontend_is_digit(frontend_peek_char_at(lexer, 2u))
        if exp_valid:
            is_float <- true
            _ = frontend_advance_char(lexer)
            if not frontend_is_eof(lexer) and (frontend_cur_char(lexer) == FRONTEND_CH_PLUS or frontend_cur_char(lexer) == FRONTEND_CH_MINUS):
                _ = frontend_advance_char(lexer)
            while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
                _ = frontend_advance_char(lexer)

    text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
    suffix: StringView = frontend_try_read_type_suffix(lexer)
    if is_float or frontend_sv_eq_literal(suffix, "f32") or frontend_sv_eq_literal(suffix, "f64"):
        return frontend_make_token(FrontendTokenKind.FloatLit, pos, text, suffix)
    return frontend_make_token(FrontendTokenKind.IntLit, pos, text, suffix)


def frontend_read_ident(lexer: mutable any FrontendLexer&) -> FrontendToken:
    pos: FrontendPos = frontend_cur_pos(lexer)
    start: usize = lexer.pos
    while not frontend_is_eof(lexer) and frontend_is_ident_char(frontend_cur_char(lexer)):
        _ = frontend_advance_char(lexer)
    text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
    return frontend_make_token(frontend_lookup_keyword(text), pos, text, frontend_empty_view())


@inline(always)
def frontend_skip_spaces(lexer: mutable any FrontendLexer&):
    while not frontend_is_eof(lexer) and (frontend_cur_char(lexer) == FRONTEND_CH_SPACE or frontend_cur_char(lexer) == FRONTEND_CH_TAB):
        _ = frontend_advance_char(lexer)


@inline(always)
def frontend_skip_string_kind(lexer: mutable any FrontendLexer&) -> FrontendTokenKind:
    _ = frontend_advance_char(lexer)

    while not frontend_is_eof(lexer) and frontend_cur_char(lexer) != FRONTEND_CH_DQUOTE and frontend_cur_char(lexer) != FRONTEND_CH_NL:
        if frontend_cur_char(lexer) == FRONTEND_CH_BSLASH:
            _ = frontend_advance_char(lexer)
            if frontend_is_eof(lexer):
                return FrontendTokenKind.StringLit
        _ = frontend_advance_char(lexer)

    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_DQUOTE:
        _ = frontend_advance_char(lexer)

    return FrontendTokenKind.StringLit


@inline(always)
def frontend_skip_char_kind(lexer: mutable any FrontendLexer&) -> FrontendTokenKind:
    _ = frontend_advance_char(lexer)

    while not frontend_is_eof(lexer) and frontend_cur_char(lexer) != FRONTEND_CH_SQUOTE and frontend_cur_char(lexer) != FRONTEND_CH_NL:
        if frontend_cur_char(lexer) == FRONTEND_CH_BSLASH:
            _ = frontend_advance_char(lexer)
            if frontend_is_eof(lexer):
                return FrontendTokenKind.CharLit
        _ = frontend_advance_char(lexer)

    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_SQUOTE:
        _ = frontend_advance_char(lexer)

    return FrontendTokenKind.CharLit


@inline(always)
def frontend_read_number_kind(lexer: mutable any FrontendLexer&) -> FrontendTokenKind:
    if frontend_cur_char(lexer) == 48 and (frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_x or frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_X):
        _ = frontend_advance_char(lexer)
        _ = frontend_advance_char(lexer)
        while not frontend_is_eof(lexer) and frontend_is_hex_digit(frontend_cur_char(lexer)):
            _ = frontend_advance_char(lexer)
        _ = frontend_try_read_type_suffix(lexer)
        return FrontendTokenKind.HexLit

    while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
        _ = frontend_advance_char(lexer)

    is_float: mutable bool = false
    if not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_DOT and frontend_is_digit(frontend_peek_char_at(lexer, 1u)):
        is_float <- true
        _ = frontend_advance_char(lexer)
        while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
            _ = frontend_advance_char(lexer)

    if not frontend_is_eof(lexer) and (frontend_cur_char(lexer) == FRONTEND_CH_e or frontend_cur_char(lexer) == FRONTEND_CH_E):
        exp_next: i64 = frontend_peek_char_at(lexer, 1u)
        exp_valid: mutable bool = frontend_is_digit(exp_next)
        if exp_next == FRONTEND_CH_PLUS or exp_next == FRONTEND_CH_MINUS:
            exp_valid <- frontend_is_digit(frontend_peek_char_at(lexer, 2u))
        if exp_valid:
            is_float <- true
            _ = frontend_advance_char(lexer)
            if not frontend_is_eof(lexer) and (frontend_cur_char(lexer) == FRONTEND_CH_PLUS or frontend_cur_char(lexer) == FRONTEND_CH_MINUS):
                _ = frontend_advance_char(lexer)
            while not frontend_is_eof(lexer) and frontend_is_digit(frontend_cur_char(lexer)):
                _ = frontend_advance_char(lexer)

    suffix: StringView = frontend_try_read_type_suffix(lexer)
    if is_float or frontend_sv_eq_literal(suffix, "f32") or frontend_sv_eq_literal(suffix, "f64"):
        return FrontendTokenKind.FloatLit
    return FrontendTokenKind.IntLit


@inline(always)
def frontend_read_ident_kind(lexer: mutable any FrontendLexer&) -> FrontendTokenKind:
    start: usize = lexer.pos
    while not frontend_is_eof(lexer) and frontend_is_ident_char(frontend_cur_char(lexer)):
        _ = frontend_advance_char(lexer)

    length: usize = lexer.pos - start
    if length < 2u or length > 7u:
        return FrontendTokenKind.Ident

    first: i64 = lexer.source[start].i64()
    if not frontend_maybe_keyword_first_char(first):
        return FrontendTokenKind.Ident

    text: StringView = frontend_make_lexer_view(lexer, start, lexer.pos)
    return frontend_lookup_keyword(text)


@inline(always)
def frontend_next_token_kind(lexer: mutable any FrontendLexer&) -> FrontendTokenKind can[Memory.Allocate, Abort.Panic]:
    if frontend_pending_has_tokens(lexer):
        token: FrontendToken = frontend_pop_pending(lexer)
        return token.kind

    if lexer.at_line_start:
        lexer.at_line_start <- false
        if lexer.paren_depth == 0:
            frontend_handle_indentation(lexer)
            if frontend_pending_has_tokens(lexer):
                token: FrontendToken = frontend_pop_pending(lexer)
                return token.kind

    frontend_skip_spaces(lexer)

    if frontend_is_eof(lexer):
        if lexer.indent_stack.count > 1u:
            frontend_pop_indent(lexer)
            return FrontendTokenKind.Dedent
        return FrontendTokenKind.Eof

    ch: i64 = frontend_cur_char(lexer)
    if ch == FRONTEND_CH_NL:
        _ = frontend_advance_char(lexer)
        lexer.at_line_start <- true
        while not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_NL:
            _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            return frontend_next_token_kind(lexer)
        return FrontendTokenKind.Newline

    if ch == FRONTEND_CH_HASH:
        frontend_skip_line_comment(lexer)
        return frontend_next_token_kind(lexer)

    if ch == FRONTEND_CH_DQUOTE:
        return frontend_skip_string_kind(lexer)

    if ch == FRONTEND_CH_SQUOTE:
        return frontend_skip_char_kind(lexer)

    if frontend_is_digit(ch):
        return frontend_read_number_kind(lexer)

    if frontend_is_ident_start(ch):
        return frontend_read_ident_kind(lexer)

    if ch == FRONTEND_CH_LT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_MINUS):
            return FrontendTokenKind.LArrow
        if frontend_match_char(lexer, FRONTEND_CH_LT):
            if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
                return FrontendTokenKind.LShiftEq
            return FrontendTokenKind.LShift
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.LtEq
        return FrontendTokenKind.Lt

    if ch == FRONTEND_CH_GT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_GT):
            if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
                return FrontendTokenKind.RShiftEq
            return FrontendTokenKind.RShift
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.GtEq
        return FrontendTokenKind.Gt

    if ch == FRONTEND_CH_ASSIGN:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.EqEq
        return FrontendTokenKind.Assign

    if ch == FRONTEND_CH_BANG:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.BangEq
        return FrontendTokenKind.Bang

    if ch == FRONTEND_CH_MINUS:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_GT):
            return FrontendTokenKind.Arrow
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.MinusEq
        return FrontendTokenKind.Minus

    if ch == FRONTEND_CH_STAR:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.StarEq
        return FrontendTokenKind.Star

    if ch == FRONTEND_CH_SLASH:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.SlashEq
        return FrontendTokenKind.Slash

    if ch == FRONTEND_CH_PERCENT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.PercentEq
        return FrontendTokenKind.Percent

    if ch == FRONTEND_CH_CARET:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.CaretEq
        return FrontendTokenKind.Caret

    if ch == 124:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.PipeEq
        return FrontendTokenKind.Pipe

    if ch == FRONTEND_CH_AMP:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return FrontendTokenKind.AmpEq
        return FrontendTokenKind.Ampersand

    if ch == FRONTEND_CH_DOT:
        _ = frontend_advance_char(lexer)
        if frontend_cur_char(lexer) == FRONTEND_CH_DOT:
            if frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_DOT:
                _ = frontend_advance_char(lexer)
                _ = frontend_advance_char(lexer)
                return FrontendTokenKind.Ellipsis
            _ = frontend_advance_char(lexer)
            if frontend_match_char(lexer, FRONTEND_CH_LT):
                return FrontendTokenKind.RangeLt
            if frontend_match_char(lexer, FRONTEND_CH_GT):
                return FrontendTokenKind.RangeGt
            return FrontendTokenKind.Range
        return FrontendTokenKind.Dot

    if ch == FRONTEND_CH_COLON:
        _ = frontend_advance_char(lexer)
        return FrontendTokenKind.Colon

    if ch == FRONTEND_CH_COMMA:
        _ = frontend_advance_char(lexer)
        return FrontendTokenKind.Comma

    if ch == FRONTEND_CH_LPAREN:
        _ = frontend_advance_char(lexer)
        lexer.paren_depth <- lexer.paren_depth + 1
        return FrontendTokenKind.LParen

    if ch == FRONTEND_CH_RPAREN:
        _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            lexer.paren_depth <- lexer.paren_depth - 1
        return FrontendTokenKind.RParen

    if ch == FRONTEND_CH_LBRACKET:
        _ = frontend_advance_char(lexer)
        lexer.paren_depth <- lexer.paren_depth + 1
        return FrontendTokenKind.LBracket

    if ch == FRONTEND_CH_RBRACKET:
        _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            lexer.paren_depth <- lexer.paren_depth - 1
        return FrontendTokenKind.RBracket

    if ch == FRONTEND_CH_QUESTION:
        _ = frontend_advance_char(lexer)
        return FrontendTokenKind.Question

    if ch == FRONTEND_CH_TILDE:
        _ = frontend_advance_char(lexer)
        return FrontendTokenKind.Tilde

    if ch == FRONTEND_CH_AT:
        _ = frontend_advance_char(lexer)
        return FrontendTokenKind.At

    _ = frontend_advance_char(lexer)
    return FrontendTokenKind.Ident


def frontend_next_token(lexer: mutable any FrontendLexer&) -> FrontendToken can[Memory.Allocate, Abort.Panic]:
    if frontend_pending_has_tokens(lexer):
        return frontend_pop_pending(lexer)

    if lexer.at_line_start:
        lexer.at_line_start <- false
        if lexer.paren_depth == 0:
            frontend_handle_indentation(lexer)
            if frontend_pending_has_tokens(lexer):
                return frontend_pop_pending(lexer)

    frontend_skip_spaces(lexer)

    if frontend_is_eof(lexer):
        if lexer.indent_stack.count > 1u:
            frontend_pop_indent(lexer)
            return frontend_make_token(FrontendTokenKind.Dedent, frontend_cur_pos(lexer), frontend_empty_view(), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Eof, frontend_cur_pos(lexer), frontend_empty_view(), frontend_empty_view())

    ch: i64 = frontend_cur_char(lexer)
    if ch == FRONTEND_CH_NL:
        pos: FrontendPos = frontend_cur_pos(lexer)
        _ = frontend_advance_char(lexer)
        lexer.at_line_start <- true
        while not frontend_is_eof(lexer) and frontend_cur_char(lexer) == FRONTEND_CH_NL:
            _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            return frontend_next_token(lexer)
        return frontend_make_token(FrontendTokenKind.Newline, pos, frontend_empty_view(), frontend_empty_view())

    if ch == FRONTEND_CH_HASH:
        frontend_skip_line_comment(lexer)
        return frontend_next_token(lexer)

    if ch == FRONTEND_CH_DQUOTE:
        return frontend_read_string(lexer)

    if ch == FRONTEND_CH_SQUOTE:
        return frontend_read_char(lexer)

    if frontend_is_digit(ch):
        return frontend_read_number(lexer)

    if frontend_is_ident_start(ch):
        return frontend_read_ident(lexer)

    pos: FrontendPos = frontend_cur_pos(lexer)
    start: usize = lexer.pos

    if ch == FRONTEND_CH_LT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_MINUS):
            return frontend_make_token(FrontendTokenKind.LArrow, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        if frontend_match_char(lexer, FRONTEND_CH_LT):
            if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
                return frontend_make_token(FrontendTokenKind.LShiftEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
            return frontend_make_token(FrontendTokenKind.LShift, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.LtEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Lt, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_GT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_GT):
            if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
                return frontend_make_token(FrontendTokenKind.RShiftEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
            return frontend_make_token(FrontendTokenKind.RShift, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.GtEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Gt, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_ASSIGN:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.EqEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Assign, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_BANG:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.BangEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Bang, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_PLUS:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.PlusEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Plus, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_MINUS:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_GT):
            return frontend_make_token(FrontendTokenKind.Arrow, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.MinusEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Minus, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_STAR:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.StarEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Star, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_SLASH:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.SlashEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Slash, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_PERCENT:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.PercentEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Percent, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_CARET:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.CaretEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Caret, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == 124:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.PipeEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Pipe, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_AMP:
        _ = frontend_advance_char(lexer)
        if frontend_match_char(lexer, FRONTEND_CH_ASSIGN):
            return frontend_make_token(FrontendTokenKind.AmpEq, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Ampersand, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_DOT:
        _ = frontend_advance_char(lexer)
        if frontend_cur_char(lexer) == FRONTEND_CH_DOT:
            if frontend_peek_char_at(lexer, 1u) == FRONTEND_CH_DOT:
                _ = frontend_advance_char(lexer)
                _ = frontend_advance_char(lexer)
                return frontend_make_token(FrontendTokenKind.Ellipsis, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
            _ = frontend_advance_char(lexer)
            if frontend_match_char(lexer, FRONTEND_CH_LT):
                return frontend_make_token(FrontendTokenKind.RangeLt, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
            if frontend_match_char(lexer, FRONTEND_CH_GT):
                return frontend_make_token(FrontendTokenKind.RangeGt, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
            return frontend_make_token(FrontendTokenKind.Range, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())
        return frontend_make_token(FrontendTokenKind.Dot, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_COLON:
        _ = frontend_advance_char(lexer)
        return frontend_make_token(FrontendTokenKind.Colon, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_COMMA:
        _ = frontend_advance_char(lexer)
        return frontend_make_token(FrontendTokenKind.Comma, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_LPAREN:
        _ = frontend_advance_char(lexer)
        lexer.paren_depth <- lexer.paren_depth + 1
        return frontend_make_token(FrontendTokenKind.LParen, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_RPAREN:
        _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            lexer.paren_depth <- lexer.paren_depth - 1
        return frontend_make_token(FrontendTokenKind.RParen, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_LBRACKET:
        _ = frontend_advance_char(lexer)
        lexer.paren_depth <- lexer.paren_depth + 1
        return frontend_make_token(FrontendTokenKind.LBracket, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_RBRACKET:
        _ = frontend_advance_char(lexer)
        if lexer.paren_depth > 0:
            lexer.paren_depth <- lexer.paren_depth - 1
        return frontend_make_token(FrontendTokenKind.RBracket, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_QUESTION:
        _ = frontend_advance_char(lexer)
        return frontend_make_token(FrontendTokenKind.Question, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_TILDE:
        _ = frontend_advance_char(lexer)
        return frontend_make_token(FrontendTokenKind.Tilde, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    if ch == FRONTEND_CH_AT:
        _ = frontend_advance_char(lexer)
        return frontend_make_token(FrontendTokenKind.At, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    _ = frontend_advance_char(lexer)
    return frontend_make_token(FrontendTokenKind.Ident, pos, frontend_make_lexer_view(lexer, start, lexer.pos), frontend_empty_view())

    return frontend_make_token(FrontendTokenKind.Eof, frontend_cur_pos(lexer), frontend_empty_view(), frontend_empty_view())


def frontend_tokenize(a: mutable any Arena&, filename: any u8&, source: any u8&) -> darray[FrontendToken] can[Memory.Allocate, Abort.Panic]:
    return frontend_tokenize_with_len(a, filename, source, runtime_strlen(source))


def frontend_tokenize_with_len(a: mutable any Arena&, filename: any u8&, source: any u8&, source_len: usize) -> darray[FrontendToken] can[Memory.Allocate, Abort.Panic]:
    lexer: mutable FrontendLexer = frontend_new_lexer_with_len(a, filename, source, source_len)
    tokens: mutable darray[FrontendToken] = zeroed

    while true:
        token: FrontendToken = frontend_next_token((&lexer).cast[mutable any FrontendLexer&])
        _ = arena_da_append(a, (&tokens).cast[mutable any darray[FrontendToken]&], token)
        match token.kind:
            FrontendTokenKind.Eof:
                return tokens

    return tokens
