def ctx_stage1rt_string_slices_eq(lhs: DStr[shape_left], lhs_start: i64, lhs_end: i64, rhs: DStr[shape_right], rhs_start: i64, rhs_end: i64) -> int:
    return ctx_stage0_string_slices_eq(lhs, lhs_start, lhs_end, rhs, rhs_start, rhs_end)

def ctx_stage1rt_string_index(value: DStr[shape_in], index: i64) -> i64:
