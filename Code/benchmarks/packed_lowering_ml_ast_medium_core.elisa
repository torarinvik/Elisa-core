include "../../compiler/runtime/elisacore_std/elisacore_runtime.elisa"

const ML_AST_PARALLEL_MAX_WORKERS = 128
const ML_AST_FOREST_ROUNDS = 6

@packed_profile(retained_reads)
packed enum TypeExpr:
    common:
        span: i64
        weight: i64
    Var(symbol: i64)
    Tuple(left: TypeExpr, right: TypeExpr)
    Arrow(param: TypeExpr, result: TypeExpr)
    Effect(label: i64, carrier: TypeExpr)
    Record(label: i64, field_ty: TypeExpr, rest: TypeExpr)
    App(callee: TypeExpr, arg: TypeExpr)

@packed_profile(retained_reads)
packed enum Pattern:
    common:
        span: i64
        weight: i64
    Wildcard
    Bind(symbol: i64, ann: TypeExpr)
    Alias(alias_symbol: i64, inner: Pattern)
    Tuple(left: Pattern, right: Pattern)
    Ctor(label: i64, arg: Pattern, ann: TypeExpr)
    LiteralInt(value: i64)
    LiteralBool(value: bool)
    ListNil
    ListCons(head: Pattern, rest: Pattern)
    Or(left: Pattern, right: Pattern)
    Guarded(inner: Pattern, guard: Expr)

@packed_profile(retained_reads)
packed enum Expr:
    common:
        span: i64
        cost: i64
    LiteralInt(value: i64)
    LiteralBool(value: bool)
    Name(symbol: i64, ty: TypeExpr)
    Lambda(param: Pattern, body: Expr, ty: TypeExpr)
    Apply(callee: Expr, arg: Expr, ty: TypeExpr)
    Let(pattern: Pattern, value: Expr, body: Expr, ty: TypeExpr)
    Match(scrutinee: Expr, clauses: Clause, ty: TypeExpr)
    Ctor(label: i64, arg: Expr, ty: TypeExpr)
    Record(label: i64, field_value: Expr, rest: Expr, ty: TypeExpr)
    Project(base: Expr, label: i64, ty: TypeExpr)
    If(cond: Expr, then_branch: Expr, else_branch: Expr, ty: TypeExpr)

@packed_profile(retained_reads)
packed enum Clause:
    common:
        span: i64
        weight: i64
    Terminal(pattern: Pattern, body: Expr)
    Chain(pattern: Pattern, body: Expr, next: Clause)
    Guarded(pattern: Pattern, guard: Expr, body: Expr, next: Clause)

@packed_profile(retained_reads)
packed enum Stmt:
    common:
        span: i64
        effect: i64
    Let(pattern: Pattern, ann: TypeExpr, value: Expr, next: Stmt)
    Match(scrutinee: Expr, clauses: Clause, next: Stmt)
    Block(first: Stmt, second: Stmt, result_expr: Expr)
    Return(value: Expr)

@packed_profile(retained_reads)
packed enum Decl:
    common:
        span: i64
        phase: i64
    Function(name: i64, param: Pattern, signature: TypeExpr, body: Stmt)
    TypeAlias(name: i64, target: TypeExpr)
    Value(name: i64, pattern: Pattern, value: Expr)
    Data(name: i64, payload: TypeExpr, ctor_pattern: Pattern)
    Script(name: i64, body: Stmt, result: Expr)
    Group(left: Decl, right: Decl)

@packed_profile(retained_reads)
packed enum Module:
    common:
        span: i64
        weight: i64
    Unit(name: i64, primary: Decl, bootstrap: Stmt, summary: Expr)
    Nested(name: i64, primary: Decl, fallback: Decl, script: Stmt, summary: Expr)
    Bundle(left: Module, right: Module)

@packed_profile(retained_reads)
packed enum Root:
    common:
        span: i64
        phase: i64
    ModuleRoot(module: Module, witness: Pattern)
    Script(script: Stmt, result: Expr, witness: Pattern)
    Eval(module: Module, expr: Expr, witness: Pattern)

struct FrozenMlAstForest:
    types: TypeExpr.Store[Frozen]
    patterns: Pattern.Store[Frozen]
    exprs: Expr.Store[Frozen]
    clauses: Clause.Store[Frozen]
    stmts: Stmt.Store[Frozen]
    decls: Decl.Store[Frozen]
    modules: Module.Store[Frozen]
    roots: Root.Store[Frozen]

struct MlAstParallelJob:
    forest_bits: uintptr
    start: usize
    end: usize
    repeats: usize
    result_bits: uintptr

def bool_score(value: bool, when_true: i64, when_false: i64) -> i64:
    if value:
        return when_true
    return when_false

def score_type(node: TypeExpr, forest: FrozenMlAstForest&) -> i64:
    match node in forest.types:
        TypeExpr.Var(symbol: symbol):
            return node.span + node.weight + symbol + node.span + 3
        TypeExpr.Tuple(left: left, right: right):
            return node.span + node.weight + score_type(left, forest) + score_type(right, forest) + 5
        TypeExpr.Arrow(param: param, result: result):
            return node.span + node.weight + score_type(param, forest) + score_type(result, forest) + 7
        TypeExpr.Effect(label: label, carrier: carrier):
            return node.span + node.weight + label + score_type(carrier, forest) + 11
        TypeExpr.Record(label: label, field_ty: field_ty, rest: rest):
            field_ty_node: TypeExpr = field_ty
            field_extra: mutable i64 = 0
            match field_ty in forest.types:
                TypeExpr.Tuple(left: left, right: right):
                    field_extra <- score_type(left, forest) + score_type(right, forest) + 17
                _:
                    field_extra <- score_type(field_ty_node, forest) + 13
            return node.span + node.weight + label + score_type(rest, forest) + field_extra
        TypeExpr.App(callee: callee, arg: arg):
            callee_node: TypeExpr = callee
            callee_extra: mutable i64 = 0
            match callee in forest.types:
                TypeExpr.Arrow(param: param, result: result):
                    callee_extra <- score_type(param, forest) + score_type(result, forest) + 23
                _:
                    callee_extra <- score_type(callee_node, forest) + 19
            return node.span + node.weight + score_type(arg, forest) + callee_extra

def score_pattern(node: Pattern, forest: FrozenMlAstForest&) -> i64:
    match node in forest.patterns:
        Pattern.Wildcard:
            return node.span + node.weight + 43
        Pattern.Bind(symbol: symbol, ann: ann):
            return node.span + node.weight + symbol + score_type(ann, forest) + 47
        Pattern.Alias(alias_symbol: alias_symbol, inner: inner):
            return node.span + node.weight + alias_symbol + score_pattern(inner, forest) + 53
        Pattern.Tuple(left: left, right: right):
            return node.span + node.weight + score_pattern(left, forest) + score_pattern(right, forest) + 59
        Pattern.Ctor(label: label, arg: arg, ann: ann):
            return node.span + node.weight + label + score_pattern(arg, forest) + score_type(ann, forest) + 61
        Pattern.LiteralInt(value: value):
            return node.span + node.weight + value + 67
        Pattern.LiteralBool(value: value):
            return node.span + node.weight + bool_score(value, 71, 73)
        Pattern.ListNil:
            return node.span + node.weight + 79
        Pattern.ListCons(head: head, rest: rest):
            return node.span + node.weight + score_pattern(head, forest) + score_pattern(rest, forest) + 83
        Pattern.Or(left: left, right: right):
            return node.span + node.weight + score_pattern(left, forest) + score_pattern(right, forest) + 89
        Pattern.Guarded(inner: inner, guard: guard):
            return node.span + node.weight + score_pattern(inner, forest) + score_expr(guard, forest) + 97

def score_expr(node: Expr, forest: FrozenMlAstForest&) -> i64:
    match node in forest.exprs:
        Expr.LiteralInt(value: value):
            return node.span + node.cost + value + 131
        Expr.LiteralBool(value: value):
            return node.span + node.cost + bool_score(value, 137, 139)
        Expr.Name(symbol: symbol, ty: ty):
            return node.span + node.cost + symbol + score_type(ty, forest) + 149
        Expr.Lambda(param: param, body: body, ty: ty):
            return node.span + node.cost + score_pattern(param, forest) + score_expr(body, forest) + score_type(ty, forest) + 151
        Expr.Apply(callee: callee, arg: arg, ty: ty):
            return node.span + node.cost + score_expr(callee, forest) + score_expr(arg, forest) + score_type(ty, forest) + 157
        Expr.Let(pattern: pattern, value: value, body: body, ty: ty):
            return node.span + node.cost + score_pattern(pattern, forest) + score_expr(value, forest) + score_expr(body, forest) + score_type(ty, forest) + 163
        Expr.Match(scrutinee: scrutinee, clauses: clauses, ty: ty):
            return node.span + node.cost + score_expr(scrutinee, forest) + score_clause(clauses, forest) + score_type(ty, forest) + 167
        Expr.Ctor(label: label, arg: arg, ty: ty):
            return node.span + node.cost + label + score_expr(arg, forest) + score_type(ty, forest) + 173
        Expr.Record(label: label, field_value: field_value, rest: rest, ty: ty):
            return node.span + node.cost + label + score_expr(field_value, forest) + score_expr(rest, forest) + score_type(ty, forest) + 179
        Expr.Project(base: base, label: label, ty: ty):
            return node.span + node.cost + score_expr(base, forest) + label + score_type(ty, forest) + 181
        Expr.If(cond: cond, then_branch: then_branch, else_branch: else_branch, ty: ty):
            return node.span + node.cost + score_expr(cond, forest) + score_expr(then_branch, forest) + score_expr(else_branch, forest) + score_type(ty, forest) + 191

def score_clause(node: Clause, forest: FrozenMlAstForest&) -> i64:
    match node in forest.clauses:
        Clause.Terminal(pattern: pattern, body: body):
            return node.span + node.weight + score_pattern(pattern, forest) + score_expr(body, forest) + 211
        Clause.Chain(pattern: pattern, body: body, next: next):
            return node.span + node.weight + score_pattern(pattern, forest) + score_expr(body, forest) + score_clause(next, forest) + 223
        Clause.Guarded(pattern: pattern, guard: guard, body: body, next: next):
            return node.span + node.weight + score_pattern(pattern, forest) + score_expr(guard, forest) + score_expr(body, forest) + score_clause(next, forest) + 227

def score_stmt(node: Stmt, forest: FrozenMlAstForest&) -> i64:
    match node in forest.stmts:
        Stmt.Let(pattern: pattern, ann: ann, value: value, next: next):
            return node.span + node.effect + score_pattern(pattern, forest) + score_type(ann, forest) + score_expr(value, forest) + score_stmt(next, forest) + 239
        Stmt.Match(scrutinee: scrutinee, clauses: clauses, next: next):
            return node.span + node.effect + score_expr(scrutinee, forest) + score_clause(clauses, forest) + score_stmt(next, forest) + 241
        Stmt.Block(first: first, second: second, result_expr: result_expr):
            return node.span + node.effect + score_stmt(first, forest) + score_stmt(second, forest) + score_expr(result_expr, forest) + 251
        Stmt.Return(value: value):
            return node.span + node.effect + score_expr(value, forest) + 257

def score_decl(node: Decl, forest: FrozenMlAstForest&) -> i64:
    match node in forest.decls:
        Decl.Function(name: name, param: param, signature: signature, body: body):
            return node.span + node.phase + name + score_pattern(param, forest) + score_type(signature, forest) + score_stmt(body, forest) + 277
        Decl.TypeAlias(name: name, target: target):
            return node.span + node.phase + name + score_type(target, forest) + 281
        Decl.Value(name: name, pattern: pattern, value: value):
            return node.span + node.phase + name + score_pattern(pattern, forest) + score_expr(value, forest) + 283
        Decl.Data(name: name, payload: payload, ctor_pattern: ctor_pattern):
            return node.span + node.phase + name + score_type(payload, forest) + score_pattern(ctor_pattern, forest) + 293
        Decl.Script(name: name, body: body, result: result):
            return node.span + node.phase + name + score_stmt(body, forest) + score_expr(result, forest) + 307
        Decl.Group(left: left, right: right):
            return node.span + node.phase + score_decl(left, forest) + score_decl(right, forest) + 311

def score_module(node: Module, forest: FrozenMlAstForest&) -> i64:
    match node in forest.modules:
        Module.Unit(name: name, primary: primary, bootstrap: bootstrap, summary: summary):
            return node.span + node.weight + name + score_decl(primary, forest) + score_stmt(bootstrap, forest) + score_expr(summary, forest) + 331
        Module.Nested(name: name, primary: primary, fallback: fallback, script: script, summary: summary):
            return node.span + node.weight + name + score_decl(primary, forest) + score_decl(fallback, forest) + score_stmt(script, forest) + score_expr(summary, forest) + 337
        Module.Bundle(left: left, right: right):
            return node.span + node.weight + score_module(left, forest) + score_module(right, forest) + 347

def score_root(node: Root, forest: FrozenMlAstForest&) -> i64:
    match node in forest.roots:
        Root.ModuleRoot(module: module, witness: witness):
            return node.span + node.phase + score_module(module, forest) + score_pattern(witness, forest) + 359
        Root.Script(script: script, result: result, witness: witness):
            return node.span + node.phase + score_stmt(script, forest) + score_expr(result, forest) + score_pattern(witness, forest) + 367
        Root.Eval(module: module, expr: expr, witness: witness):
            return node.span + node.phase + score_module(module, forest) + score_expr(expr, forest) + score_pattern(witness, forest) + 373

def checksum_root_range(start: usize, end: usize, forest: FrozenMlAstForest&) -> i64:
    total: mutable i64 = 0
    for i in start..<end:
        total <- total + score_root(forest.roots[i], forest)
    return total

def build_ml_ast_forest(
    type_store: TypeExpr.Store[Local],
    pattern_store: Pattern.Store[Local],
    expr_store: Expr.Store[Local],
    clause_store: Clause.Store[Local],
    stmt_store: Stmt.Store[Local],
    decl_store: Decl.Store[Local],
    module_store: Module.Store[Local],
    root_store: Root.Store[Local]
) -> FrozenMlAstForest:
    node_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 1, weight: 1, symbol: 11)
    int_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 2, weight: 1, symbol: 12)
    bool_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 3, weight: 1, symbol: 13)
    pair_ty: TypeExpr = new[type_store] TypeExpr.Tuple(span: 4, weight: 2, left: int_ty, right: bool_ty)
    effect_ty: TypeExpr = new[type_store] TypeExpr.Effect(span: 5, weight: 3, label: 21, carrier: pair_ty)
    parser_ty: TypeExpr = new[type_store] TypeExpr.Arrow(span: 6, weight: 5, param: effect_ty, result: node_ty)
    list_ty: TypeExpr = new[type_store] TypeExpr.App(span: 7, weight: 7, callee: node_ty, arg: pair_ty)
    record_ty: TypeExpr = new[type_store] TypeExpr.Record(span: 8, weight: 11, label: 22, field_ty: parser_ty, rest: list_ty)

    wildcard_pat: Pattern = new[pattern_store] Pattern.Wildcard(span: 9, weight: 1)
    bind_pat: Pattern = new[pattern_store] Pattern.Bind(span: 10, weight: 2, symbol: 31, ann: int_ty)
    int_pat: Pattern = new[pattern_store] Pattern.LiteralInt(span: 11, weight: 3, value: 5)
    nil_pat: Pattern = new[pattern_store] Pattern.ListNil(span: 12, weight: 4)
    cons_pat: Pattern = new[pattern_store] Pattern.ListCons(span: 13, weight: 5, head: bind_pat, rest: nil_pat)
    alias_pat: Pattern = new[pattern_store] Pattern.Alias(span: 14, weight: 7, alias_symbol: 41, inner: bind_pat)
    ctor_pat: Pattern = new[pattern_store] Pattern.Ctor(span: 15, weight: 9, label: 42, arg: cons_pat, ann: record_ty)
    or_pat: Pattern = new[pattern_store] Pattern.Or(span: 16, weight: 11, left: alias_pat, right: int_pat)

    lit_expr: Expr = new[expr_store] Expr.LiteralInt(span: 17, cost: 1, value: 99)
    false_expr: Expr = new[expr_store] Expr.LiteralBool(span: 18, cost: 1, value: false)
    name_expr: Expr = new[expr_store] Expr.Name(span: 19, cost: 2, symbol: 51, ty: node_ty)
    ctor_expr: Expr = new[expr_store] Expr.Ctor(span: 20, cost: 3, label: 61, arg: lit_expr, ty: list_ty)
    record_expr: Expr = new[expr_store] Expr.Record(span: 21, cost: 5, label: 62, field_value: ctor_expr, rest: name_expr, ty: record_ty)
    project_expr: Expr = new[expr_store] Expr.Project(span: 22, cost: 7, base: record_expr, label: 63, ty: parser_ty)
    lambda_expr: Expr = new[expr_store] Expr.Lambda(span: 23, cost: 11, param: alias_pat, body: project_expr, ty: parser_ty)
    apply_expr: Expr = new[expr_store] Expr.Apply(span: 24, cost: 13, callee: lambda_expr, arg: false_expr, ty: parser_ty)
    if_expr: Expr = new[expr_store] Expr.If(span: 25, cost: 17, cond: false_expr, then_branch: apply_expr, else_branch: ctor_expr, ty: node_ty)
    let_expr: Expr = new[expr_store] Expr.Let(span: 26, cost: 19, pattern: ctor_pat, value: if_expr, body: project_expr, ty: record_ty)

    guarded_pat: Pattern = new[pattern_store] Pattern.Guarded(span: 27, weight: 13, inner: or_pat, guard: let_expr)
    terminal_clause: Clause = new[clause_store] Clause.Terminal(span: 28, weight: 3, pattern: wildcard_pat, body: project_expr)
    guarded_clause: Clause = new[clause_store] Clause.Guarded(span: 29, weight: 5, pattern: guarded_pat, guard: apply_expr, body: let_expr, next: terminal_clause)
    chain_clause: Clause = new[clause_store] Clause.Chain(span: 30, weight: 7, pattern: ctor_pat, body: if_expr, next: guarded_clause)
    match_expr: Expr = new[expr_store] Expr.Match(span: 31, cost: 23, scrutinee: ctor_expr, clauses: chain_clause, ty: record_ty)

    ret_stmt: Stmt = new[stmt_store] Stmt.Return(span: 32, effect: 2, value: match_expr)
    let_stmt: Stmt = new[stmt_store] Stmt.Let(span: 33, effect: 3, pattern: guarded_pat, ann: parser_ty, value: let_expr, next: ret_stmt)
    match_stmt: Stmt = new[stmt_store] Stmt.Match(span: 34, effect: 5, scrutinee: match_expr, clauses: chain_clause, next: ret_stmt)
    block_stmt: Stmt = new[stmt_store] Stmt.Block(span: 35, effect: 7, first: let_stmt, second: match_stmt, result_expr: if_expr)

    alias_decl: Decl = new[decl_store] Decl.TypeAlias(span: 36, phase: 2, name: 71, target: record_ty)
    value_decl: Decl = new[decl_store] Decl.Value(span: 37, phase: 3, name: 72, pattern: guarded_pat, value: match_expr)
    data_decl: Decl = new[decl_store] Decl.Data(span: 38, phase: 5, name: 73, payload: list_ty, ctor_pattern: ctor_pat)
    function_decl: Decl = new[decl_store] Decl.Function(span: 39, phase: 7, name: 74, param: alias_pat, signature: parser_ty, body: block_stmt)
    group_decl: Decl = new[decl_store] Decl.Group(span: 40, phase: 11, left: function_decl, right: data_decl)

    unit_module: Module = new[module_store] Module.Unit(span: 41, weight: 3, name: 81, primary: group_decl, bootstrap: block_stmt, summary: match_expr)
    nested_module: Module = new[module_store] Module.Nested(span: 42, weight: 5, name: 82, primary: alias_decl, fallback: value_decl, script: match_stmt, summary: let_expr)
    bundle_module: Module = new[module_store] Module.Bundle(span: 43, weight: 7, left: unit_module, right: nested_module)

    _ = new[root_store] Root.ModuleRoot(span: 44, phase: 3, module: bundle_module, witness: guarded_pat)
    _ = new[root_store] Root.Script(span: 45, phase: 5, script: block_stmt, result: if_expr, witness: or_pat)
    _ = new[root_store] Root.Eval(span: 46, phase: 7, module: nested_module, expr: match_expr, witness: ctor_pat)

    frozen_types: TypeExpr.Store[Frozen] = freeze(move type_store)
    frozen_patterns: Pattern.Store[Frozen] = freeze(move pattern_store)
    frozen_exprs: Expr.Store[Frozen] = freeze(move expr_store)
    frozen_clauses: Clause.Store[Frozen] = freeze(move clause_store)
    frozen_stmts: Stmt.Store[Frozen] = freeze(move stmt_store)
    frozen_decls: Decl.Store[Frozen] = freeze(move decl_store)
    frozen_modules: Module.Store[Frozen] = freeze(move module_store)
    frozen_roots: Root.Store[Frozen] = freeze(move root_store)
    return FrozenMlAstForest(frozen_types, frozen_patterns, frozen_exprs, frozen_clauses, frozen_stmts, frozen_decls, frozen_modules, frozen_roots)

def packed_ml_ast_checksum_impl() -> i64:
    return packed_ml_ast_repeated_checksum_impl(1)

def packed_ml_ast_repeated_checksum_impl(iterations: usize) -> i64:
    if iterations == 0:
        return -1
    region scratch(131072)
    type_store: TypeExpr.Store[Local] = TypeExpr.Store(scratch)
    pattern_store: Pattern.Store[Local] = Pattern.Store(scratch)
    expr_store: Expr.Store[Local] = Expr.Store(scratch)
    clause_store: Clause.Store[Local] = Clause.Store(scratch)
    stmt_store: Stmt.Store[Local] = Stmt.Store(scratch)
    decl_store: Decl.Store[Local] = Decl.Store(scratch)
    module_store: Module.Store[Local] = Module.Store(scratch)
    root_store: Root.Store[Local] = Root.Store(scratch)
    forest: FrozenMlAstForest = build_ml_ast_forest(type_store, pattern_store, expr_store, clause_store, stmt_store, decl_store, module_store, root_store)
    total: mutable i64 = 0
    for iteration in 0..<iterations:
        total <- total + checksum_root_range(0, forest.roots.count, forest.ref[FrozenMlAstForest&])
    out: i64 = total
    destroy scratch
    return out

def ml_ast_parallel_worker(job: MlAstParallelJob) -> i64:
    forest: FrozenMlAstForest& = job.forest_bits.cast[FrozenMlAstForest&]
    result_slot: mutable i64& = job.result_bits.cast[mutable i64&]
    total: mutable i64 = 0
    for iteration in 0..<job.repeats:
        total <- total + checksum_root_range(job.start, job.end, forest)
    result_slot[0] <- total
    return total

def packed_ml_ast_parallel_max_workers_impl() -> i64:
    return ML_AST_PARALLEL_MAX_WORKERS.i64()

def packed_ml_ast_parallel_checksum_impl(worker_count: usize, iterations: usize) -> i64:
    can Thread.Spawn, Thread.Join, Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
        if worker_count == 0 or iterations == 0 or worker_count > ML_AST_PARALLEL_MAX_WORKERS:
            return -1

        region scratch(131072)
        type_store: TypeExpr.Store[Local] = TypeExpr.Store(scratch)
        pattern_store: Pattern.Store[Local] = Pattern.Store(scratch)
        expr_store: Expr.Store[Local] = Expr.Store(scratch)
        clause_store: Clause.Store[Local] = Clause.Store(scratch)
        stmt_store: Stmt.Store[Local] = Stmt.Store(scratch)
        decl_store: Decl.Store[Local] = Decl.Store(scratch)
        module_store: Module.Store[Local] = Module.Store(scratch)
        root_store: Root.Store[Local] = Root.Store(scratch)
        forest: FrozenMlAstForest = build_ml_ast_forest(type_store, pattern_store, expr_store, clause_store, stmt_store, decl_store, module_store, root_store)

        worker_total: mutable usize = worker_count
        if worker_total > forest.roots.count:
            worker_total <- forest.roots.count
        if worker_total == 0:
            destroy scratch
            return -1

        partials: i64[128] = zeroed
        base_roots: usize = forest.roots.count / worker_total
        extra_roots: usize = forest.roots.count % worker_total

        pool workers(worker_total):
            group: mutable TaskGroup = task_group_new()
            start: mutable usize = 0
            for slot in 0..<worker_total:
                span: mutable usize = base_roots
                if slot < extra_roots:
                    span <- span + 1

                end: usize = start + span
                forest_bits: uintptr = forest.ref[FrozenMlAstForest&].uintptr()
                result_bits: uintptr = partials[slot].ref[i64&].uintptr()
                job: MlAstParallelJob = MlAstParallelJob(forest_bits, start, end, iterations, result_bits)
                task: Task[i64, Pending] = submit ml_ast_parallel_worker(job)
                task_group_add(group.ref[TaskGroup&], move task)
                start <- end

            wait all group

        total: mutable i64 = 0
        for slot in 0..<worker_total:
            total <- total + partials[slot]
        out: i64 = total
        destroy scratch
        return out

export func packed_ml_ast_checksum() -> i64 = packed_ml_ast_checksum_impl
