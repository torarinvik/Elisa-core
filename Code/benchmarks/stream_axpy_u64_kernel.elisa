def stream_axpy_u64_impl(dst: u64&, src: u64&, len: usize, rounds: usize, scale: u64) -> u64:
    acc: mutable u64 = scale ^ 0x9e3779b97f4a7c15

    for round in 0..<rounds for i in 0..<len:
        value: u64 = dst[i] + src[i] * scale + acc
        dst[i] <- value
        acc ^= value + i.u64() + round.u64()

    return acc

export func elisa_core_stream_axpy_u64(dst: u64&, src: u64&, len: usize, rounds: usize, scale: u64) -> u64 = stream_axpy_u64_impl
