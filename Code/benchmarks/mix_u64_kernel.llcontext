def mix_u64_impl(data: any u64&, len: usize, rounds: usize, seed: u64) -> u64:
    acc: mutable u64 = seed

    for round in 0u..<rounds:
        for i in 0u..<len:
            value: mutable u64 = data[i]
            value ^= (value >> 33)
            value *= 6364136223846793005u64
            value ^= (value >> 29)
            value += acc + i.u64() + round.u64() + 1442695040888963407u64
            data[i] <- value

            acc ^= value
            acc *= 1442695040888963407u64
            acc += 1u64

    return acc

export func llctx_mix_u64(data: any u64&, len: usize, rounds: usize, seed: u64) -> u64 = mix_u64_impl
