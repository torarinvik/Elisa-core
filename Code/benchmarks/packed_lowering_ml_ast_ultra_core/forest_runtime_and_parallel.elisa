def build_seed_type(seed: usize, current: TypeExpr, previous: TypeExpr, store: TypeExpr.Store[Local]) -> TypeExpr:
    seed_i64: i64 = seed.i64()
    if seed % 6 == 0:
        pair: TypeExpr = new[store] TypeExpr.Tuple(span: 100 + seed_i64, weight: 7 + seed_i64, left: current, right: previous)
        return new[store] TypeExpr.Record(span: 101 + seed_i64, weight: 11 + seed_i64, label: 400 + seed_i64, field_ty: pair, rest: current)
    if seed % 6 == 1:
        arrow: TypeExpr = new[store] TypeExpr.Arrow(span: 102 + seed_i64, weight: 13 + seed_i64, param: previous, result: current)
        return new[store] TypeExpr.App(span: 103 + seed_i64, weight: 17 + seed_i64, callee: arrow, arg: current)
    if seed % 6 == 2:
        row: TypeExpr = new[store] TypeExpr.Record(span: 104 + seed_i64, weight: 19 + seed_i64, label: 500 + seed_i64, field_ty: previous, rest: current)
        return new[store] TypeExpr.Effect(span: 105 + seed_i64, weight: 23 + seed_i64, label: 600 + seed_i64, carrier: row)
    if seed % 6 == 3:
        return new[store] TypeExpr.Tuple(span: 106 + seed_i64, weight: 29 + seed_i64, left: current, right: previous)
    if seed % 6 == 4:
        return new[store] TypeExpr.Merge(span: 107 + seed_i64, weight: 31 + seed_i64, left: current, middle: previous, right: current)
    merged: TypeExpr = new[store] TypeExpr.Merge(span: 108 + seed_i64, weight: 37 + seed_i64, left: previous, middle: current, right: previous)
    return new[store] TypeExpr.App(span: 109 + seed_i64, weight: 41 + seed_i64, callee: merged, arg: current)

def build_seed_pattern(seed: usize, current: Pattern, previous: Pattern, guard: Expr, ann: TypeExpr, store: Pattern.Store[Local]) -> Pattern:
    seed_i64: i64 = seed.i64()
    if seed % 6 == 0:
        binding: Pattern = new[store] Pattern.Bind(span: 200 + seed_i64, weight: 3 + seed_i64, symbol: 1000 + seed_i64, ann: ann)
        return new[store] Pattern.Alias(span: 201 + seed_i64, weight: 5 + seed_i64, alias_symbol: 1100 + seed_i64, inner: binding)
    if seed % 6 == 1:
        wildcard: Pattern = new[store] Pattern.Wildcard(span: 202 + seed_i64, weight: 7 + seed_i64)
        return new[store] Pattern.Tuple(span: 203 + seed_i64, weight: 11 + seed_i64, left: wildcard, right: current)
    if seed % 6 == 2:
        nil_pat: Pattern = new[store] Pattern.ListNil(span: 204 + seed_i64, weight: 13 + seed_i64)
        cons: Pattern = new[store] Pattern.ListCons(span: 205 + seed_i64, weight: 17 + seed_i64, head: current, rest: nil_pat)
        return new[store] Pattern.Ctor(span: 206 + seed_i64, weight: 19 + seed_i64, label: 1200 + seed_i64, arg: cons, ann: ann)
    if seed % 6 == 3:
        lit_bool: Pattern = new[store] Pattern.LiteralBool(span: 207 + seed_i64, weight: 23 + seed_i64, value: seed % 2 == 0)
        return new[store] Pattern.Or(span: 208 + seed_i64, weight: 29 + seed_i64, left: current, right: lit_bool)
    if seed % 6 == 4:
        return new[store] Pattern.Annotated(span: 209 + seed_i64, weight: 31 + seed_i64, inner: current, ann: ann, fallback: previous)
    alias_inner: Pattern = new[store] Pattern.Alias(span: 209 + seed_i64, weight: 31 + seed_i64, alias_symbol: 1300 + seed_i64, inner: previous)
    return new[store] Pattern.Guarded(span: 210 + seed_i64, weight: 37 + seed_i64, inner: alias_inner, guard: guard)

def build_seed_clause(seed: usize, pattern: Pattern, body: Expr, alternative: Expr, current: Clause, store: Clause.Store[Local]) -> Clause:
    seed_i64: i64 = seed.i64()
    if seed % 4 == 0:
        return new[store] Clause.Terminal(span: 300 + seed_i64, weight: 5 + seed_i64, pattern: pattern, body: body)
    if seed % 4 == 1:
        return new[store] Clause.Guarded(span: 301 + seed_i64, weight: 7 + seed_i64, pattern: pattern, guard: body, body: alternative, next: current)
    if seed % 4 == 2:
        return new[store] Clause.Chain(span: 302 + seed_i64, weight: 11 + seed_i64, pattern: pattern, body: body, next: current)
    return new[store] Clause.Fanout(span: 303 + seed_i64, weight: 13 + seed_i64, pattern: pattern, primary: body, alternate: alternative, next: current)

def build_seed_expr(seed: usize, pattern: Pattern, current: Expr, alternative: Expr, clause: Clause, ty: TypeExpr, store: Expr.Store[Local]) -> Expr:
    seed_i64: i64 = seed.i64()
    if seed % 9 == 0:
        return new[store] Expr.Lambda(span: 400 + seed_i64, cost: 3 + seed_i64, param: pattern, body: current, ty: ty)
    if seed % 9 == 1:
        lambda_expr: Expr = new[store] Expr.Lambda(span: 401 + seed_i64, cost: 5 + seed_i64, param: pattern, body: current, ty: ty)
        return new[store] Expr.Apply(span: 402 + seed_i64, cost: 7 + seed_i64, callee: lambda_expr, arg: alternative, ty: ty)
    if seed % 9 == 2:
        return new[store] Expr.Let(span: 403 + seed_i64, cost: 11 + seed_i64, pattern: pattern, value: alternative, body: current, ty: ty)
    if seed % 9 == 3:
        return new[store] Expr.Match(span: 404 + seed_i64, cost: 13 + seed_i64, scrutinee: current, clauses: clause, ty: ty)
    if seed % 9 == 4:
        return new[store] Expr.Ctor(span: 405 + seed_i64, cost: 17 + seed_i64, label: 1400 + seed_i64, arg: current, ty: ty)
    if seed % 9 == 5:
        return new[store] Expr.Record(span: 406 + seed_i64, cost: 19 + seed_i64, label: 1500 + seed_i64, field_value: current, rest: alternative, ty: ty)
    if seed % 9 == 6:
        record_expr: Expr = new[store] Expr.Record(span: 407 + seed_i64, cost: 23 + seed_i64, label: 1600 + seed_i64, field_value: current, rest: alternative, ty: ty)
        return new[store] Expr.Project(span: 408 + seed_i64, cost: 29 + seed_i64, base: record_expr, label: 1700 + seed_i64, ty: ty)
    if seed % 9 == 7:
        third_expr: Expr = new[store] Expr.Match(span: 409 + seed_i64, cost: 31 + seed_i64, scrutinee: alternative, clauses: clause, ty: ty)
        return new[store] Expr.Sequence(span: 410 + seed_i64, cost: 37 + seed_i64, first: current, second: alternative, third: third_expr, ty: ty)
    cond_expr: Expr = new[store] Expr.LiteralBool(span: 409 + seed_i64, cost: 31 + seed_i64, value: seed % 2 == 0)
    return new[store] Expr.If(span: 410 + seed_i64, cost: 37 + seed_i64, cond: cond_expr, then_branch: current, else_branch: alternative, ty: ty)

def build_seed_stmt(seed: usize, pattern: Pattern, value: Expr, alternative: Expr, clause: Clause, current: Stmt, ann: TypeExpr, store: Stmt.Store[Local]) -> Stmt:
    seed_i64: i64 = seed.i64()
    if seed % 5 == 0:
        return new[store] Stmt.Let(span: 500 + seed_i64, effect: 3 + seed_i64, pattern: pattern, ann: ann, value: value, next: current)
    if seed % 5 == 1:
        return new[store] Stmt.Match(span: 501 + seed_i64, effect: 5 + seed_i64, scrutinee: value, clauses: clause, next: current)
    if seed % 5 == 2:
        trailing_stmt: Stmt = new[store] Stmt.Return(span: 502 + seed_i64, effect: 7 + seed_i64, value: alternative)
        return new[store] Stmt.Block(span: 503 + seed_i64, effect: 11 + seed_i64, first: current, second: trailing_stmt, result_expr: value)
    if seed % 5 == 3:
        return new[store] Stmt.Return(span: 504 + seed_i64, effect: 13 + seed_i64, value: value)
    tail_stmt: Stmt = new[store] Stmt.Return(span: 505 + seed_i64, effect: 17 + seed_i64, value: alternative)
    middle_stmt: Stmt = new[store] Stmt.Match(span: 506 + seed_i64, effect: 19 + seed_i64, scrutinee: alternative, clauses: clause, next: tail_stmt)
    return new[store] Stmt.Pipeline(span: 507 + seed_i64, effect: 23 + seed_i64, first: current, second: middle_stmt, third: tail_stmt, result_expr: value)

def build_seed_decl(seed: usize, pattern: Pattern, value: Expr, stmt: Stmt, ann: TypeExpr, current: Decl, store: Decl.Store[Local]) -> Decl:
    seed_i64: i64 = seed.i64()
    if seed % 7 == 0:
        return new[store] Decl.Function(span: 600 + seed_i64, phase: 3 + seed_i64, name: 1800 + seed_i64, param: pattern, signature: ann, body: stmt)
    if seed % 7 == 1:
        return new[store] Decl.TypeAlias(span: 601 + seed_i64, phase: 5 + seed_i64, name: 1900 + seed_i64, target: ann)
    if seed % 7 == 2:
        return new[store] Decl.Value(span: 602 + seed_i64, phase: 7 + seed_i64, name: 2000 + seed_i64, pattern: pattern, value: value)
    if seed % 7 == 3:
        return new[store] Decl.Data(span: 603 + seed_i64, phase: 11 + seed_i64, name: 2100 + seed_i64, payload: ann, ctor_pattern: pattern)
    if seed % 7 == 4:
        return new[store] Decl.Script(span: 604 + seed_i64, phase: 13 + seed_i64, name: 2200 + seed_i64, body: stmt, result: value)
    if seed % 7 == 5:
        side_decl: Decl = new[store] Decl.Value(span: 605 + seed_i64, phase: 17 + seed_i64, name: 2300 + seed_i64, pattern: pattern, value: value)
        return new[store] Decl.Group(span: 606 + seed_i64, phase: 19 + seed_i64, left: current, right: side_decl)
    return new[store] Decl.Instance(span: 607 + seed_i64, phase: 23 + seed_i64, name: 2400 + seed_i64, signature: ann, witness: pattern, body: value)

def build_seed_module(seed: usize, primary: Decl, fallback: Decl, script: Stmt, summary: Expr, current: Module, store: Module.Store[Local]) -> Module:
    seed_i64: i64 = seed.i64()
    if seed % 4 == 0:
        return new[store] Module.Unit(span: 700 + seed_i64, weight: 3 + seed_i64, name: 2400 + seed_i64, primary: primary, bootstrap: script, summary: summary)
    if seed % 4 == 1:
        return new[store] Module.Nested(span: 701 + seed_i64, weight: 5 + seed_i64, name: 2500 + seed_i64, primary: primary, fallback: fallback, script: script, summary: summary)
    if seed % 4 == 2:
        side_module: Module = new[store] Module.Unit(span: 702 + seed_i64, weight: 7 + seed_i64, name: 2600 + seed_i64, primary: primary, bootstrap: script, summary: summary)
        return new[store] Module.Bundle(span: 703 + seed_i64, weight: 11 + seed_i64, left: current, right: side_module)
    return new[store] Module.Overlay(span: 704 + seed_i64, weight: 13 + seed_i64, base: current, extension: primary, bootstrap: script, summary: summary)

def build_seed_root(seed: usize, module: Module, expr: Expr, stmt: Stmt, witness: Pattern, store: Root.Store[Local]) -> Root:
    seed_i64: i64 = seed.i64()
    if seed % 4 == 0:
        return new[store] Root.ModuleRoot(span: 800 + seed_i64, phase: 3 + seed_i64, module: module, witness: witness)
    if seed % 4 == 1:
        return new[store] Root.Script(span: 801 + seed_i64, phase: 5 + seed_i64, script: stmt, result: expr, witness: witness)
    if seed % 4 == 2:
        return new[store] Root.Eval(span: 802 + seed_i64, phase: 7 + seed_i64, module: module, expr: expr, witness: witness)
    return new[store] Root.Batch(span: 803 + seed_i64, phase: 11 + seed_i64, module: module, script: stmt, expr: expr, witness: witness)

def build_ml_ast_forest(
    type_store: TypeExpr.Store[Local],
    pattern_store: Pattern.Store[Local],
    expr_store: Expr.Store[Local],
    clause_store: Clause.Store[Local],
    stmt_store: Stmt.Store[Local],
    decl_store: Decl.Store[Local],
    module_store: Module.Store[Local],
    root_store: Root.Store[Local]
) -> FrozenMlAstForest:
    node_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 1, weight: 1, symbol: 11)
    int_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 2, weight: 1, symbol: 12)
    bool_ty: TypeExpr = new[type_store] TypeExpr.Var(span: 3, weight: 1, symbol: 13)
    pair_ty: TypeExpr = new[type_store] TypeExpr.Tuple(span: 4, weight: 2, left: int_ty, right: bool_ty)
    list_ty: TypeExpr = new[type_store] TypeExpr.App(span: 5, weight: 3, callee: node_ty, arg: pair_ty)
    effect_ty: TypeExpr = new[type_store] TypeExpr.Effect(span: 6, weight: 5, label: 91, carrier: list_ty)
    parser_ty: TypeExpr = new[type_store] TypeExpr.Arrow(span: 7, weight: 7, param: effect_ty, result: node_ty)
    record_ty: TypeExpr = new[type_store] TypeExpr.Record(span: 8, weight: 11, label: 92, field_ty: parser_ty, rest: pair_ty)
    merge_ty: TypeExpr = new[type_store] TypeExpr.Merge(span: 9, weight: 13, left: record_ty, middle: effect_ty, right: pair_ty)

    wildcard_pat: Pattern = new[pattern_store] Pattern.Wildcard(span: 10, weight: 1)
    bind_pat: Pattern = new[pattern_store] Pattern.Bind(span: 11, weight: 2, symbol: 31, ann: int_ty)
    int_pat: Pattern = new[pattern_store] Pattern.LiteralInt(span: 12, weight: 3, value: 5)
    bool_pat: Pattern = new[pattern_store] Pattern.LiteralBool(span: 13, weight: 4, value: true)
    nil_pat: Pattern = new[pattern_store] Pattern.ListNil(span: 14, weight: 5)
    cons_pat: Pattern = new[pattern_store] Pattern.ListCons(span: 15, weight: 6, head: bind_pat, rest: nil_pat)
    alias_pat: Pattern = new[pattern_store] Pattern.Alias(span: 16, weight: 7, alias_symbol: 41, inner: bind_pat)
    or_pat: Pattern = new[pattern_store] Pattern.Or(span: 17, weight: 8, left: alias_pat, right: int_pat)
    ctor_pat: Pattern = new[pattern_store] Pattern.Ctor(span: 18, weight: 9, label: 42, arg: cons_pat, ann: record_ty)

    lit_expr: Expr = new[expr_store] Expr.LiteralInt(span: 19, cost: 1, value: 99)
    false_expr: Expr = new[expr_store] Expr.LiteralBool(span: 20, cost: 1, value: false)
    name_expr: Expr = new[expr_store] Expr.Name(span: 21, cost: 2, symbol: 51, ty: node_ty)
    ctor_expr: Expr = new[expr_store] Expr.Ctor(span: 22, cost: 3, label: 61, arg: lit_expr, ty: list_ty)
    record_expr: Expr = new[expr_store] Expr.Record(span: 23, cost: 5, label: 62, field_value: ctor_expr, rest: name_expr, ty: record_ty)
    project_expr: Expr = new[expr_store] Expr.Project(span: 24, cost: 7, base: record_expr, label: 63, ty: parser_ty)
    lambda_expr: Expr = new[expr_store] Expr.Lambda(span: 25, cost: 11, param: alias_pat, body: project_expr, ty: parser_ty)
    apply_expr: Expr = new[expr_store] Expr.Apply(span: 26, cost: 13, callee: lambda_expr, arg: false_expr, ty: parser_ty)
    if_expr: Expr = new[expr_store] Expr.If(span: 27, cost: 17, cond: false_expr, then_branch: apply_expr, else_branch: ctor_expr, ty: node_ty)
    let_expr: Expr = new[expr_store] Expr.Let(span: 28, cost: 19, pattern: ctor_pat, value: if_expr, body: project_expr, ty: record_ty)

    terminal_clause: Clause = new[clause_store] Clause.Terminal(span: 29, weight: 3, pattern: wildcard_pat, body: project_expr)
    guarded_pat: Pattern = new[pattern_store] Pattern.Guarded(span: 30, weight: 10, inner: or_pat, guard: let_expr)
    annotated_pat: Pattern = new[pattern_store] Pattern.Annotated(span: 31, weight: 12, inner: ctor_pat, ann: merge_ty, fallback: guarded_pat)
    guarded_clause: Clause = new[clause_store] Clause.Guarded(span: 32, weight: 5, pattern: guarded_pat, guard: apply_expr, body: let_expr, next: terminal_clause)
    chain_clause: Clause = new[clause_store] Clause.Chain(span: 33, weight: 7, pattern: ctor_pat, body: if_expr, next: guarded_clause)
    fanout_clause: Clause = new[clause_store] Clause.Fanout(span: 34, weight: 9, pattern: annotated_pat, primary: let_expr, alternate: project_expr, next: chain_clause)
    match_expr: Expr = new[expr_store] Expr.Match(span: 35, cost: 23, scrutinee: ctor_expr, clauses: fanout_clause, ty: record_ty)
    sequence_expr: Expr = new[expr_store] Expr.Sequence(span: 36, cost: 29, first: match_expr, second: let_expr, third: project_expr, ty: merge_ty)

    ret_stmt: Stmt = new[stmt_store] Stmt.Return(span: 37, effect: 2, value: sequence_expr)
    let_stmt: Stmt = new[stmt_store] Stmt.Let(span: 38, effect: 3, pattern: annotated_pat, ann: merge_ty, value: let_expr, next: ret_stmt)
    match_stmt: Stmt = new[stmt_store] Stmt.Match(span: 39, effect: 5, scrutinee: match_expr, clauses: fanout_clause, next: ret_stmt)
    block_stmt: Stmt = new[stmt_store] Stmt.Block(span: 40, effect: 7, first: let_stmt, second: match_stmt, result_expr: if_expr)
    pipeline_stmt: Stmt = new[stmt_store] Stmt.Pipeline(span: 41, effect: 11, first: let_stmt, second: match_stmt, third: ret_stmt, result_expr: sequence_expr)

    alias_decl: Decl = new[decl_store] Decl.TypeAlias(span: 42, phase: 2, name: 71, target: record_ty)
    value_decl: Decl = new[decl_store] Decl.Value(span: 43, phase: 3, name: 72, pattern: annotated_pat, value: sequence_expr)
    data_decl: Decl = new[decl_store] Decl.Data(span: 44, phase: 5, name: 73, payload: list_ty, ctor_pattern: ctor_pat)
    function_decl: Decl = new[decl_store] Decl.Function(span: 45, phase: 7, name: 74, param: alias_pat, signature: parser_ty, body: block_stmt)
    script_decl: Decl = new[decl_store] Decl.Script(span: 46, phase: 11, name: 75, body: pipeline_stmt, result: sequence_expr)
    group_decl: Decl = new[decl_store] Decl.Group(span: 47, phase: 13, left: function_decl, right: data_decl)
    instance_decl: Decl = new[decl_store] Decl.Instance(span: 48, phase: 17, name: 76, signature: merge_ty, witness: annotated_pat, body: sequence_expr)

    unit_module: Module = new[module_store] Module.Unit(span: 49, weight: 3, name: 81, primary: group_decl, bootstrap: block_stmt, summary: match_expr)
    nested_module: Module = new[module_store] Module.Nested(span: 50, weight: 5, name: 82, primary: alias_decl, fallback: script_decl, script: match_stmt, summary: let_expr)
    bundle_module: Module = new[module_store] Module.Bundle(span: 51, weight: 7, left: unit_module, right: nested_module)
    overlay_module: Module = new[module_store] Module.Overlay(span: 52, weight: 11, base: bundle_module, extension: instance_decl, bootstrap: pipeline_stmt, summary: sequence_expr)

    _ = new[root_store] Root.ModuleRoot(span: 53, phase: 3, module: overlay_module, witness: annotated_pat)
    _ = new[root_store] Root.Script(span: 54, phase: 5, script: pipeline_stmt, result: sequence_expr, witness: or_pat)
    _ = new[root_store] Root.Eval(span: 55, phase: 7, module: nested_module, expr: match_expr, witness: ctor_pat)
    _ = new[root_store] Root.Batch(span: 56, phase: 11, module: overlay_module, script: pipeline_stmt, expr: sequence_expr, witness: annotated_pat)

    previous_type: mutable TypeExpr = bool_ty
    current_type: mutable TypeExpr = merge_ty
    previous_pattern: mutable Pattern = bool_pat
    current_pattern: mutable Pattern = annotated_pat
    previous_expr: mutable Expr = match_expr
    current_expr: mutable Expr = sequence_expr
    current_clause: mutable Clause = fanout_clause
    current_stmt: mutable Stmt = pipeline_stmt
    current_decl: mutable Decl = instance_decl
    current_module: mutable Module = overlay_module

    for seed in 0..<ML_AST_FOREST_ROUNDS:
        next_type: TypeExpr = build_seed_type(seed, current_type, previous_type, type_store)
        next_pattern: Pattern = build_seed_pattern(seed, current_pattern, previous_pattern, current_expr, next_type, pattern_store)
        next_clause: Clause = build_seed_clause(seed, next_pattern, current_expr, previous_expr, current_clause, clause_store)
        next_expr: Expr = build_seed_expr(seed, next_pattern, current_expr, previous_expr, next_clause, next_type, expr_store)
        next_stmt: Stmt = build_seed_stmt(seed, next_pattern, next_expr, previous_expr, next_clause, current_stmt, next_type, stmt_store)
        next_decl: Decl = build_seed_decl(seed, next_pattern, next_expr, next_stmt, next_type, current_decl, decl_store)
        next_module: Module = build_seed_module(seed, next_decl, current_decl, next_stmt, next_expr, current_module, module_store)
        _ = build_seed_root(seed, next_module, next_expr, next_stmt, next_pattern, root_store)

        previous_type <- current_type
        current_type <- next_type
        previous_pattern <- current_pattern
        current_pattern <- next_pattern
        previous_expr <- current_expr
        current_expr <- next_expr
        current_clause <- next_clause
        current_stmt <- next_stmt
        current_decl <- next_decl
        current_module <- next_module

    frozen_types: TypeExpr.Store[Frozen] = freeze(move type_store)
    frozen_patterns: Pattern.Store[Frozen] = freeze(move pattern_store)
    frozen_exprs: Expr.Store[Frozen] = freeze(move expr_store)
    frozen_clauses: Clause.Store[Frozen] = freeze(move clause_store)
    frozen_stmts: Stmt.Store[Frozen] = freeze(move stmt_store)
    frozen_decls: Decl.Store[Frozen] = freeze(move decl_store)
    frozen_modules: Module.Store[Frozen] = freeze(move module_store)
    frozen_roots: Root.Store[Frozen] = freeze(move root_store)

    return FrozenMlAstForest(frozen_types, frozen_patterns, frozen_exprs, frozen_clauses, frozen_stmts, frozen_decls, frozen_modules, frozen_roots)

def packed_ml_ast_checksum_impl() -> i64:
    return packed_ml_ast_repeated_checksum_impl(1)

def packed_ml_ast_repeated_checksum_impl(iterations: usize) -> i64:
    if iterations == 0:
        return -1
    region scratch(1048576)
    type_store: TypeExpr.Store[Local] = TypeExpr.Store(scratch)
    pattern_store: Pattern.Store[Local] = Pattern.Store(scratch)
    expr_store: Expr.Store[Local] = Expr.Store(scratch)
    clause_store: Clause.Store[Local] = Clause.Store(scratch)
    stmt_store: Stmt.Store[Local] = Stmt.Store(scratch)
    decl_store: Decl.Store[Local] = Decl.Store(scratch)
    module_store: Module.Store[Local] = Module.Store(scratch)
    root_store: Root.Store[Local] = Root.Store(scratch)
    forest: FrozenMlAstForest = build_ml_ast_forest(type_store, pattern_store, expr_store, clause_store, stmt_store, decl_store, module_store, root_store)
    total: mutable i64 = 0
    for iteration in 0..<iterations:
        total <- total + checksum_root_range(0, forest.roots.count, forest.ref[FrozenMlAstForest&])
    return total

def ml_ast_parallel_worker(job: MlAstParallelJob) -> i64:
    forest: FrozenMlAstForest& = job.forest_bits.cast[FrozenMlAstForest&]
    result_slot: mutable i64& = job.result_bits.cast[mutable i64&]
    total: mutable i64 = 0
    for iteration in 0..<job.repeats:
        total <- total + checksum_root_range(job.start, job.end, forest)
    result_slot[0] <- total
    return total

def packed_ml_ast_parallel_max_workers_impl() -> i64:
    return ML_AST_PARALLEL_MAX_WORKERS.i64()

def packed_ml_ast_parallel_checksum_impl(worker_count: usize, iterations: usize) -> i64:
    can Thread.Spawn, Thread.Join, Pool.Create, Pool.Shutdown, Pool.Submit, Pool.WaitAll, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
        if worker_count == 0 or iterations == 0 or worker_count > ML_AST_PARALLEL_MAX_WORKERS:
            return -1

        region scratch(1048576)
        type_store: TypeExpr.Store[Local] = TypeExpr.Store(scratch)
        pattern_store: Pattern.Store[Local] = Pattern.Store(scratch)
        expr_store: Expr.Store[Local] = Expr.Store(scratch)
        clause_store: Clause.Store[Local] = Clause.Store(scratch)
        stmt_store: Stmt.Store[Local] = Stmt.Store(scratch)
        decl_store: Decl.Store[Local] = Decl.Store(scratch)
        module_store: Module.Store[Local] = Module.Store(scratch)
        root_store: Root.Store[Local] = Root.Store(scratch)
        forest: FrozenMlAstForest = build_ml_ast_forest(type_store, pattern_store, expr_store, clause_store, stmt_store, decl_store, module_store, root_store)

        worker_total: mutable usize = worker_count
        if worker_total > forest.roots.count:
            worker_total <- forest.roots.count
        if worker_total == 0:
            return -1

        partials: i64[128] = zeroed
        base_roots: usize = forest.roots.count / worker_total
        extra_roots: usize = forest.roots.count % worker_total

        pool workers(worker_total):
            group: TaskGroup = task_group_new()
            start: mutable usize = 0
            for slot in 0..<worker_total:
                span: mutable usize = base_roots
                if slot < extra_roots:
                    span <- span + 1

                end: usize = start + span
                forest_bits: uintptr = forest.ref[FrozenMlAstForest&].uintptr()
                result_bits: uintptr = partials[slot].ref[i64&].uintptr()
                job: MlAstParallelJob = MlAstParallelJob(forest_bits, start, end, iterations, result_bits)
                task: Task[i64, Pending] = submit ml_ast_parallel_worker(job)
                task_group_add(group.ref[TaskGroup&], move task)
                start <- end

            wait all group

        total: mutable i64 = 0
        for slot in 0..<worker_total:
            total <- total + partials[slot]
        return total

export func packed_ml_ast_checksum() -> i64 = packed_ml_ast_checksum_impl
export func packed_ml_ast_repeated_checksum(iterations: usize) -> i64 = packed_ml_ast_repeated_checksum_impl
export func packed_ml_ast_parallel_max_workers() -> i64 = packed_ml_ast_parallel_max_workers_impl
export func packed_ml_ast_parallel_checksum(worker_count: usize, iterations: usize) -> i64 = packed_ml_ast_parallel_checksum_impl
