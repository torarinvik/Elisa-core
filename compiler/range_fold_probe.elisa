include "./runtime/elisacore_std/elisacore_runtime.elisa"

# An FP fold over a RANGE source — ineligible for the fixed-width pinned reduction (Phase 2 pins only
# folds over an indexable darray variable). It therefore falls back to the reassociating scalar loop:
# the accumulator update carries `reassoc` so the loop vectorizer may re-bracket it into a tree. The
# exact bits depend on the target's chosen vector width — reproducible per-target, not across targets.
# Exported so it survives -O3 DCE.
def sum_range(n: i64) -> f64:
	return (acc + i.f64() for i in 0..<n with acc: f64 = 0.0)

export fn probe_range(n: i64) -> f64 = sum_range
