include "./runtime/elisacore_std/elisacore_runtime.elisa"
include "./runtime/elisacore_std/decode.elisa"

# A consumer of the reusable elisacore_std/decode module (docs/94): it builds its own refinement
# types from the module's laws and decodes with the module's verified field/sign-extend primitives.
# Every refinement discharges statically under -strict (verified by the companion Go test).

type RegIndex = u32 is InRange[0, 31]

def decode_rd(word: u32) -> RegIndex:
    return bits5(word, 7)               # bits5 -> InRange[0,31] entails RegIndex
def decode_rs1(word: u32) -> RegIndex:
    return bits5(word, 15)
def decode_imm(word: u32) -> i32 is SBounded[-2048, 2047]:
    return sx12(word, 20)               # module sign-extender carries the signed range

def read_reg(regs: array[u64, 32]&, r: RegIndex) -> u64:
    return regs[r]                      # refined index from the module's law -> no bounds check

@test
def consumer_decodes_addi() -> void:
    word: u32 = 0x06408293             # ADDI x5, x1, 100
    regs: array[u64, 32] = zeroed
    assert(decode_rd(word) == 5)
    assert(decode_rs1(word) == 1)
    assert(decode_imm(word) == 100)
    assert(read_reg(&regs, decode_rd(word)) == 0)

@test
def consumer_sign_extends() -> void:
    word: u32 = 0xFFF00293             # imm[11:0] all ones -> -1
    assert(decode_imm(word) == -1)
