include "./runtime/elisacore_std/elisacore_runtime.elisa"

# Exported f64 maps over a runtime darray (survive -O3 DCE). The plain map's body carries only
# `contract` FP flags; the `by simd` map's body carries full `fast` flags. Used by
# TestBySimdMapAppliesFastMath.
def plain(a: mutable darray[f64]&) -> f64:
	can Memory.Allocate, Abort.Panic:
		out: darray[f64] = [x * 1.5 + 2.0 for x in a]
		return out[0.usize()]

def simd(a: mutable darray[f64]&) -> f64:
	can Memory.Allocate, Abort.Panic:
		out: darray[f64] = [x * 1.5 + 2.0 for x in a by simd]
		return out[0.usize()]

export func probe_plain(a: mutable darray[f64]&) -> f64 = plain
export func probe_simd(a: mutable darray[f64]&) -> f64 = simd
