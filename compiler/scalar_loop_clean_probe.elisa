include "./runtime/elisacore_std/elisacore_runtime.elisa"

# A user range loop in the single-buffer vector-eligible shape. An in-place f64 multiply vectorizes
# without requiring an unproven alias claim between two caller-owned buffers.
def scaled_into(a: mutable darray[f64]&) -> usize:
	can Memory.Allocate, Abort.Panic:
		for i in 0..<a.count:
			a[i] <- a[i] * 2.0
		return a.count

export fn probe_scalar_clean(a: mutable darray[f64]&) -> usize = scaled_into
