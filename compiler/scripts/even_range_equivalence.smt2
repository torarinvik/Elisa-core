(set-logic QF_BV)
(set-option :timeout 18000)
(declare-fun x () (_ BitVec 64))
(declare-fun upper () (_ BitVec 64))
(declare-fun span () (_ BitVec 64))
(define-fun one () (_ BitVec 64) (_ bv1 64))
(define-fun half () (_ BitVec 64) (bvlshr span one))
(define-fun lower () (_ BitVec 64) (bvsub upper span))
(assert (bvsge upper (_ bv0 64)))
(assert (bvugt span (_ bv0 64)))
(assert (bvsge span (_ bv0 64)))
(assert (= (bvand span one) (_ bv0 64)))
(assert (= (bvand half (bvadd half one)) (_ bv0 64)))
(assert (bvuge upper span))
(assert (= (bvand lower one) (_ bv0 64)))
(define-fun old () Bool (or (bvult (bvsub x (bvadd upper one)) (bvneg (bvadd span one))) (= ((_ extract 0 0) x) #b1)))
(define-fun new () Bool (not (= (bvand (bvsub x lower) (bvnot span)) (_ bv0 64))))
(assert (xor old new))
(check-sat)
