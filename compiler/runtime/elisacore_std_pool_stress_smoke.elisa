include "./elisacore_std/elisacore_runtime.elisa"

def stress_bump(slot: uintptr) -> i64:
	can Atomic:
		c: mutable AtomicCell[i64]& = slot.cast[mutable AtomicCell[i64]&]
		_ = atomic_fetch_add_acqrel(c, 1)
		return 0

def band_add_one(b: Slice[f64]) -> i64:
	for i in 0..<b.len():
		b.set_unchecked(i, b.get_unchecked(i) + 1.0)
	return 0

# Submit storm: many more tasks than workers, hammering the queue + completion
# handshake. The nursery joins every task before the block exits, so the atomic
# counter must read exactly N. Run twice to confirm the persistent default pool's
# workers survive and re-serve a second storm (no per-task thread spawn).
@test
def pool_submit_storm_smoke():
	can Parallel:
		counter: mutable darray[i64] = []
		_ = counter.resize(1.usize())
		counter[0.usize()] <- 0
		cb: uintptr = (&counter[0.usize()]).cast[uintptr]
		nursery workers(3):
			for k in 0..<4000:
				submit stress_bump(cb)
		assert counter[0.usize()] == 4000
		# second storm reuses the same persistent workers
		nursery workers(3):
			for k in 0..<4000:
				submit stress_bump(cb)
		assert counter[0.usize()] == 8000

# Determinism across worker counts: reduce() must return the identical sum whether
# folded by 1, 2, 4, or 8 workers. A mismatch would expose a race in the queue /
# partial-fold path. 1+2+...+4000 = 8002000.
@test
def pool_determinism_smoke():
	can Parallel:
		xs: mutable darray[f64] = []
		_ = xs.resize(4000.usize())
		for k in 0..<4000:
			xs[k.usize()] <- (k + 1).f64()
		expected: f64 = 8002000.0
		s1: f64 = reduce(slice(&xs), 0.0, lambda(a: f64, b: f64) => a + b, 1.usize())
		s2: f64 = reduce(slice(&xs), 0.0, lambda(a: f64, b: f64) => a + b, 2.usize())
		s4: f64 = reduce(slice(&xs), 0.0, lambda(a: f64, b: f64) => a + b, 4.usize())
		s8: f64 = reduce(slice(&xs), 0.0, lambda(a: f64, b: f64) => a + b, 8.usize())
		assert s1 == expected
		assert s2 == expected
		assert s4 == expected
		assert s8 == expected

# Repeated explicit pool create + shutdown. Each `pool workers(w):` scope spins up w
# persistent workers, runs a parallel-for band sweep, then shuts the pool down (signal
# + join all workers + dispose mutex/condvars). 50 iterations exercises the shutdown /
# join path hard -- a missed wake or leaked worker would deadlock or drift the result.
@test
def pool_shutdown_churn_smoke():
	can Parallel:
		data: mutable darray[f64] = []
		_ = data.resize(2048.usize())
		for k in 0..<2048:
			data[k.usize()] <- 0.0
		rounds: mutable i64 = 0
		while rounds < 50:
			pool workers(4):
				parallel for band in slice(&data):
					band_add_one(band)
			rounds <- rounds + 1
		# 50 sweeps of +1 over every element
		assert data[0.usize()] == 50.0
		assert data[2047.usize()] == 50.0

# Default-pool reuse across many fine-grained parallel-for sweeps (no explicit pool
# scope). The persistent default pool must be created once and reused; the result must
# be deterministic regardless of how the 200 sweeps interleave on the workers.
@test
def pool_default_reuse_smoke():
	can Parallel:
		data: mutable darray[f64] = []
		_ = data.resize(1024.usize())
		for k in 0..<1024:
			data[k.usize()] <- 0.0
		sweeps: mutable i64 = 0
		while sweeps < 200:
			parallel for band in slice(&data):
				band_add_one(band)
			sweeps <- sweeps + 1
		assert data[0.usize()] == 200.0
		assert data[512.usize()] == 200.0
		assert data[1023.usize()] == 200.0
