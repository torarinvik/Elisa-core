include "./elisacore_std/elisacore_runtime.elisa"

@test
def std_mutex_condvar_native_smoke():
	can Memory.Allocate, Memory.Release, Sync.Lock, Sync.Unlock, Sync.Notify, Thread.Sleep, Thread.Yield:
		mu: Mutex = mutex()
		cv: CondVar = condvar()
		assert mu.handle != null
		assert cv.handle != null
		guard: MutexGuard[Held] = mutex_lock(mu.ref[mutable Mutex&])
		notify_one(cv.ref[mutable CondVar&])
		notify_all(cv.ref[mutable CondVar&])
		mutex_unlock(move guard)
		yield_thread()
		sleep_usec(1)
		condvar_dispose(cv.ref[mutable CondVar&])
		mutex_dispose(mu.ref[mutable Mutex&])
		assert mu.handle == null
		assert cv.handle == null
