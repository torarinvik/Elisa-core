include "./elisacore_std/elisacore_runtime.elisa"

def nursery_bump(slot: uintptr) -> i64:
	can Atomic, Unsafe.PointerCast:
		c: mutable AtomicCell[i64]& = slot.cast[mutable AtomicCell[i64]&]
		_ = atomic_fetch_add_acqrel(c, 1)
		return 0

# A nursery guarantees every submitted task is joined before the scope exits, so the
# shared counter reads exactly N right after the `nursery:` block (no manual wait-all).
@test
def std_nursery_native_smoke():
	can Parallel, Unsafe.PointerCast:
		counter: mutable darray[i64] = []
		_ = counter.resize(1.usize())
		counter[0.usize()] <- 0
		cb: uintptr = (&counter[0.usize()]).cast[uintptr]
		nursery workers(4):
			for k in 0..<32:
				submit nursery_bump(cb)
		assert counter[0.usize()] == 32

# Verify that bare `nursery:` (no explicit worker count) compiles and runs correctly;
# the default worker count is perf_cores() queried at runtime.
@test
def std_nursery_default_workers_smoke():
	can Parallel, Unsafe.PointerCast:
		n: i64 = perf_cores()
		assert n > 0
		counter: mutable darray[i64] = []
		_ = counter.resize(1.usize())
		counter[0.usize()] <- 0
		cb: uintptr = (&counter[0.usize()]).cast[uintptr]
		nursery:
			for k in 0..<16:
				submit nursery_bump(cb)
		assert counter[0.usize()] == 16

# A caller-owned pool can serve multiple nursery batches. Each block joins its own
# submissions while leaving the shared pool alive for the next batch.
@test
def std_nursery_shared_pool_smoke():
	can Parallel, Unsafe.PointerCast:
		counter: mutable darray[i64] = []
		_ = counter.resize(1.usize())
		counter[0.usize()] <- 0
		cb: uintptr = (&counter[0.usize()]).cast[uintptr]
		pool workers(4):
			nursery on(workers):
				for k in 0..<24:
					submit nursery_bump(cb)
			assert counter[0.usize()] == 24
			nursery on(workers):
				for k in 0..<24:
					submit nursery_bump(cb)
			assert counter[0.usize()] == 48
		assert counter[0.usize()] == 48

# A TaskGroup can be reused after wait_all drains its current batch. This exercises
# the wait/add lifetime boundary and retained result-state cleanup in the runtime.
@test
def std_task_group_reuse_smoke():
	can Parallel, Unsafe.PointerCast:
		counter: mutable darray[i64] = []
		_ = counter.resize(1.usize())
		counter[0.usize()] <- 0
		cb: uintptr = (&counter[0.usize()]).cast[uintptr]
		pool workers(4):
			group: mutable TaskGroup = task_group_new()
			for k in 0..<32:
				task_group_add(&group, submit nursery_bump(cb))
			task_group_wait_all(&group)
			assert counter[0.usize()] == 32
			for k in 0..<32:
				task_group_add(&group, submit nursery_bump(cb))
			task_group_wait_all(&group)
		assert counter[0.usize()] == 64
