include "./elisacore_std/elisacore_runtime.elisa"

# A plain `dict = zeroed` inside a region scope grows with ZERO ceremony — the same
# frictionless surface as darray push: no `can Memory.Allocate, Abort.Panic`, no error
# union to handle, no explicit Arena threading. Allocation failure panics (parity with
# darray push) rather than returning an error union or null. This exercises the synthetic
# region-mutation path end to end (semantic dispatch -> backend arena_dict_*_or_panic).
@test
def std_dict_frictionless_smoke():
	region scratch(8192):
		d: mutable dict[cstr, i64] = zeroed
		d.reserve(16)
		d.put("alpha", 10)
		d.put("beta", 20)
		d.put("alpha", 11)
		assert d.get("alpha") != null
		assert d.contains("beta")
		assert not d.contains("zeta")
		slot: mutable i64&? = d.get_or_insert("gamma", 30)
		assert slot != null
		assert d.contains("gamma")
		# get_or_insert on an existing key keeps the original value
		again: mutable i64&? = d.get_or_insert("alpha", 999)
		assert again != null

# Full darray parity: a `dict[cstr, V] = {}` literal with NO explicit region scope. The empty
# `{}` is an allocating dict literal (the dict analogue of `[]`), so it triggers auto-region
# inference exactly like darray — the function body is wrapped in a synthesized lazy region and
# the inserts just work, no `region`/`in` ceremony at all.
@test
def std_dict_brace_auto_region_smoke():
	d: mutable dict[cstr, i64] = {}
	d.put("one", 1)
	d.put("two", 2)
	d.put("one", 11)
	assert d.contains("one")
	assert d.contains("two")
	assert not d.contains("three")
	slot: mutable i64&? = d.get_or_insert("three", 3)
	assert slot != null
	assert d.contains("three")

# Non-cstr keys: the runtime dict hashes supported key types and confirms matches with `==`, so
# keys with deterministic hashing and value equality work — integers, bool, const enums. Here i64
# keys, with value readback.
const enum Suit:
	Hearts
	Spades

@test
def std_dict_int_keys_smoke():
	d: mutable dict[i64, i64] = {}
	d.put(10, 100)
	d.put(20, 200)
	d.put(10, 111)
	assert d.contains(10)
	assert d.contains(20)
	assert not d.contains(30)
	got: i64& = get d.get(10) else return
	assert got[0] == 111

@test
def std_dict_enum_keys_smoke():
	d: mutable dict[Suit, i64] = {}
	d.put(Suit.Hearts, 1)
	d.put(Suit.Spades, 2)
	assert d.contains(Suit.Hearts)
	assert d.contains(Suit.Spades)

# Populated dict literal `{k: v, ...}` — builds an empty dict and inserts each pair. Like `{}`
# it triggers auto-region inference (no explicit region scope here). Keys/values are checked
# against the declared (or inferred) dict type; non-runtime-backed keys are rejected.
@test
def std_dict_literal_smoke():
	d: mutable dict[cstr, i64] = {"alpha": 1, "beta": 2, "gamma": 3}
	assert d.count.i64() == 3
	assert d.contains("alpha")
	assert d.contains("gamma")
	assert not d.contains("delta")
	g: i64& = get d.get("gamma") else return
	assert g[0] == 3
	# int-keyed literal, value readback
	nums: mutable dict[i64, i64] = {10: 100, 20: 200, 10: 111}
	x: i64& = get nums.get(10) else return
	assert x[0] == 111
	assert nums.count.i64() == 2

# Open-addressing hash table stress: many entries force repeated resize+rehash; removal
# leaves tombstones that probing must skip; tombstones are reused on re-insert and cleared on
# the next rehash. Validates the O(1) table end to end (collisions, growth, delete, reinsert).
@test
def std_dict_hashtable_stress():
	region scratch(1048576):
		d: mutable dict[i64, i64] = {}
		assert d.count == 0.usize()
		assert d.used == 0.usize()
		assert d.capacity == 0.usize()
		n: i64 = 1500
		for i in 0..<n:
			d.put(i, i * 3)
		assert d.count.i64() == n
		assert d.used >= d.count
		assert d.used * 4.usize() <= d.capacity * 3.usize()
		for i in 0..<n:
			probe: i64& = get d.get(i) else return
			assert probe[0] == i * 3
		# remove multiples of 3 (tombstones), verify membership split
		for i in 0..<n:
			if i % 3 == 0:
				assert d.remove(i)
		assert d.count.i64() == n - (n / 3)
		assert d.used.i64() == n
		for i in 0..<n:
			if i % 3 == 0:
				assert not d.contains(i)
			else:
				assert d.contains(i)
		# re-insert removed keys with new values (reuses tombstones / triggers rehash)
		for i in 0..<n:
			if i % 3 == 0:
				d.put(i, i * 5)
		for i in 0..<n:
			probe: i64& = get d.get(i) else return
			if i % 3 == 0:
				assert probe[0] == i * 5
			else:
				assert probe[0] == i * 3
		assert d.count.i64() == n
		assert d.used >= d.count
		assert d.used * 4.usize() <= d.capacity * 3.usize()
		d.clear()
		assert d.count == 0.usize()
		assert d.used == 0.usize()
		assert d.capacity > 0.usize()
