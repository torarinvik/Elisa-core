def ctx_sync_handle(p: void&?) -> void&:
	can Abort.Panic:
		panic("null sync handle") if p == null
		return p

# Pool-internal lock/notify helpers keep Sync effects visible through their callers.
# The pool's synchronization is verified race-free under TSan, but remains an effect
# so callers can see where locking and waiting occur.
def ctx_pool_lock(m: void&):
	can Sync.Lock:
		_ = ctx_platform_mutex_lock(m)

def ctx_pool_unlock(m: void&):
	can Sync.Unlock:
		_ = ctx_platform_mutex_unlock(m)

def ctx_pool_wait(c: void&, m: void&):
	can Sync.Wait:
		_ = ctx_platform_cond_wait(c, m)

def ctx_pool_signal(c: void&):
	can Sync.Notify:
		_ = ctx_platform_cond_signal(c)

def ctx_pool_broadcast(c: void&):
	can Sync.Notify:
		_ = ctx_platform_cond_broadcast(c)

# The worker loop. Runs on a spawned OS thread; `arg` is the ConcurrencyPoolState. It
# dequeues tasks FIFO under the pool mutex, runs each entry(arg) OUTSIDE the lock (so
# workers run concurrently), then marks the record done and broadcasts. Exits when
# `shutdown` is set and the queue is drained.
def ctx_pool_worker_main(arg: void&?) -> void&?:
	can Abort.Panic:
		return null if arg == null
		state: mutable heap ConcurrencyPoolState& = arg.cast[mutable heap ConcurrencyPoolState&] can Unsafe.PointerCast
		mu: void& = ctx_sync_handle(state.mutex)
		wc: void& = ctx_sync_handle(state.work_cond)
		dc: void& = ctx_sync_handle(state.done_cond)
		running: mutable bool = true
		trusted Unsafe.AssumeProgress:
			while running:
				can Sync.Lock:
					ctx_pool_lock(mu)
				while state.qhead == null and state.shutdown == 0:
					can Sync.Wait:
						ctx_pool_wait(wc, mu)
				head: mutable heap PoolTaskRecord&? = state.qhead
				if head != null:
					# pop the head (narrowed non-null in this branch)
					state.qhead <- head.next
					state.qtail <- null if state.qhead == null
					can Sync.Unlock:
						ctx_pool_unlock(mu)
					# run the type-erased work entry outside the lock
					entry_bits: void& = head.entry
					arg_bits: mutable void& = head.arg
					trusted Unsafe.IndirectCall:
						_ = entry_bits.call_as[fn(mutable void&) -> void&](arg_bits) can Unsafe.Alias
					# publish completion and wake any awaiter
					can Sync.Lock:
						ctx_pool_lock(mu)
					head.done <- 1
					can Sync.Notify:
						ctx_pool_broadcast(dc)
					can Sync.Unlock:
						ctx_pool_unlock(mu)
				else:
					# shutdown requested and queue drained
					can Sync.Unlock:
						ctx_pool_unlock(mu)
					running <- false
		return null

# Push a spawned worker handle onto the pool's worker list. The list head is stored as
# void& so the intrusive node is transferred by pointer rather than by an owning assignment.
def ctx_pool_push_worker(state: mutable heap ConcurrencyPoolState&, whandle: uintptr):
	can Memory.Allocate, Abort.Panic:
		nraw: heap void& = ctx_concurrency_alloc(size_of(ConcurrencyRawTaskNode))
		node: mutable heap ConcurrencyRawTaskNode& = nraw.cast[heap ConcurrencyRawTaskNode&]
		node.handle <- whandle
		node.next <- null if state.workers == null else state.workers.cast[heap ConcurrencyRawTaskNode&]
		state.workers <- node.cast[void&]

# Only this allocator-owned, exact-size conversion hides PointerCast. Callers
# cannot supply an arbitrary raw carrier; ctx_concurrency_alloc rejects null.
def ctx_pool_state_allocate() -> mutable heap ConcurrencyPoolState&:
	raw: heap void& = ctx_concurrency_alloc(size_of(ConcurrencyPoolState)) can Memory.Allocate, Abort.Panic
	trusted Unsafe.PointerCast:
		return raw.cast[mutable heap ConcurrencyPoolState&]

# Allocate + initialize a pool state and spawn its persistent workers. Shared by
# pool_new and the lazily-created default pool.
def ctx_pool_state_new(threads: usize) -> mutable heap ConcurrencyPoolState&:
	can Memory.Allocate, Memory.Release, Thread.Spawn, Abort.Panic:
		state: mutable heap ConcurrencyPoolState& = ctx_pool_state_allocate() can Memory.Allocate, Abort.Panic
		nworkers: mutable usize = threads
		nworkers <- 1.usize() if nworkers < 1.usize()
		state.worker_count <- nworkers
		state.qhead <- null
		state.qtail <- null
		state.shutdown <- 0
		state.outstanding_records <- 0.usize()
		state.owner_closed <- 0
		state.workers <- null
		# The mutex/condvar handles are heap-allocated (malloc'd in *_init) and live
		# for the pool's lifetime, but they flow through nullable `void&?` fields
		# whose `heap` storage the type system does not currently carry, so the
		# forwarded-reference check cannot prove it. The trusted runtime owns it.
		mu: mutable Mutex = zeroed
		mutex_init(&mu)
		wc: mutable CondVar = zeroed
		condvar_init(&wc)
		dc: mutable CondVar = zeroed
		condvar_init(&dc)
		trusted Unsafe.StaleRef:
			state.mutex <- mu.handle
			state.work_cond <- wc.handle
			state.done_cond <- dc.handle
		i: mutable usize = 0.usize()
		# Workers get a 64 MB stack (address space; pages are committed on use), not the
		# platform's secondary-thread default: see ctx_thread_create_stack.
		trusted Unsafe.AssumeProgress:
			while i < nworkers:
				whandle: mutable uintptr = 0
				status: int = ctx_thread_create_stack(&whandle, ctx_pool_worker_main.cast[void&], state.cast[void&?], 67108864.usize())
				panic("pool worker create failed") if status != 0
				ctx_pool_push_worker(state, whandle)
				i <- i + 1.usize()
		return state

def pool_new(threads: usize) -> ThreadPool:
	can Pool.Create, Memory.Allocate, Memory.Release, Thread.Spawn, Abort.Panic:
		state: mutable heap ConcurrencyPoolState& = ctx_pool_state_new(threads)
		out: ThreadPool = zeroed
		out.handle <- state.cast[void&]
		return move out

# Signal shutdown, wake + join all workers, then dispose the sync primitives and the
# state. After this the pool handle is null and must not be reused.
def pool_shutdown(pool: mutable ThreadPool&):
	can Pool.Shutdown, Thread.Join, Memory.Release, Abort.Panic:
		return if pool.handle == null
		state: mutable heap ConcurrencyPoolState& = pool.handle.cast[mutable heap ConcurrencyPoolState&]
		mu: void& = ctx_sync_handle(state.mutex)
		wc: void& = ctx_sync_handle(state.work_cond)
		can Sync.Lock:
			ctx_pool_lock(mu)
		state.shutdown <- 1
		can Sync.Notify:
			ctx_pool_broadcast(wc)
		can Sync.Unlock:
			ctx_pool_unlock(mu)
		# join every worker, freeing its handle node
		current: mutable heap ConcurrencyRawTaskNode&? = state.workers.cast[heap ConcurrencyRawTaskNode&?]
		state.workers <- null
		trusted Unsafe.AssumeProgress:
			while current != null:
				next: mutable heap ConcurrencyRawTaskNode&? = current.next
				ctx_concurrency_join_handle(current.handle)
				free(current.cast[heap void&])
				current <- next
		dispose_state: mutable bool = false
		can Sync.Lock:
			ctx_pool_lock(mu)
		state.owner_closed <- 1
		dispose_state <- state.outstanding_records == 0.usize()
		can Sync.Unlock:
			ctx_pool_unlock(mu)
		ctx_pool_state_destroy(state) can Unsafe.Alias if dispose_state
		pool.handle <- null

# The implicit pool for `parallel for` / each / reduce when there is no explicit
# `pool workers(w):` scope. Lazily creates ONE persistent perf_cores()-wide pool the
# first time it is needed and caches its state pointer in a global; subsequent calls
# reuse it (no per-call pool_new/shutdown, no per-task thread spawn). The workers live
# until process exit (never shut down), so fine-grained loops are cheap. Lazy init is
# driven from the orchestrating thread (the parallel-for caller), never concurrently.
global mutable __elisa_default_pool_state: void&? = null

def default_pool() -> ThreadPool:
	can Global{Read,Write}:
		can Pool.Create, Memory.Allocate, Memory.Release, Thread.Spawn, Abort.Panic:
			if __elisa_default_pool_state == null:
				workers: usize = perf_cores().usize()
				state: mutable heap ConcurrencyPoolState& = ctx_pool_state_new(workers)
				__elisa_default_pool_state <- state.cast[void&]
			out: ThreadPool = zeroed
			out.handle <- __elisa_default_pool_state
			return move out

# Enqueue (entry, arg) on the pool's FIFO queue and wake one worker. Returns a Task
# whose `handle` is the completion record (as a uintptr) the awaiter waits on.
def pool_submit_raw(pool: mutable ThreadPool&, entry: void&, arg: void&?) -> Task[void&?, Pending]:
	can Pool.Submit, Memory.Allocate, Abort.Panic:
		panic("pool_submit on uninitialized pool") if pool.handle == null
		panic("pool_submit with null arg") if arg == null
		state: mutable heap ConcurrencyPoolState& = pool.handle.cast[mutable heap ConcurrencyPoolState&]
		raw: heap void& = ctx_concurrency_alloc(size_of(PoolTaskRecord))
		rec: mutable heap PoolTaskRecord& = raw.cast[heap PoolTaskRecord&]
		rec.next <- null
		rec.group_next <- null
		rec.pool <- state.cast[void&]
		# entry/arg are caller-provided pointers stored into a heap task record the
		# pool runs asynchronously; their pointee lifetime is the caller's contract,
		# which the type system cannot verify here. The trusted runtime owns it.
		trusted Unsafe.StaleRef:
			rec.entry <- entry
			rec.arg <- arg
			rec.group_state_bits <- null
		rec.done <- 0
		mu: void& = ctx_sync_handle(state.mutex)
		wc: void& = ctx_sync_handle(state.work_cond)
		can Sync.Lock:
			ctx_pool_lock(mu)
		if state.shutdown != 0:
			can Sync.Unlock:
				ctx_pool_unlock(mu)
			panic("pool_submit on shut down pool")
		state.outstanding_records <- state.outstanding_records + 1.usize()
		tail_node: mutable heap PoolTaskRecord&? = state.qtail
		if tail_node != null:
			tail_node.next <- rec
			state.qtail <- rec
		else:
			state.qhead <- rec
			state.qtail <- rec
		can Sync.Notify:
			ctx_pool_signal(wc)
		can Sync.Unlock:
			ctx_pool_unlock(mu)
		out: Task[void&?, Pending] = zeroed
		out.handle <- rec.cast[uintptr]
		return move out

# Block until a completion record is done, leaving it alive so a TaskGroup can follow
# its separate group link after the wait.
@internal
def ctx_pool_wait_record_done(handle: uintptr):
	can Memory.Release, Abort.Panic:
		return if handle == 0
		rec: mutable heap PoolTaskRecord& = handle.cast[mutable heap PoolTaskRecord&] can Unsafe.PointerCast
		state: mutable heap ConcurrencyPoolState& = rec.pool.cast[mutable heap ConcurrencyPoolState&]
		mu: void& = ctx_sync_handle(state.mutex)
		dc: void& = ctx_sync_handle(state.done_cond)
		can Sync.Lock:
			ctx_pool_lock(mu)
		dispose_state: mutable bool = false
		trusted Unsafe.AssumeProgress:
			while rec.done == 0:
				can Sync.Wait:
					ctx_pool_wait(dc, mu)
		state.outstanding_records <- state.outstanding_records - 1.usize()
		dispose_state <- state.owner_closed != 0 and state.outstanding_records == 0.usize()
		can Sync.Unlock:
			ctx_pool_unlock(mu)
		ctx_pool_state_destroy(state) can Unsafe.Alias if dispose_state

# Standalone awaits consume their record immediately. TaskGroups use the retaining
# helper above and free records only after every task in the batch has joined.
@internal
def ctx_pool_wait_record(handle: uintptr):
	can Memory.Release, Abort.Panic:
		return if handle == 0
		ctx_pool_wait_record_done(handle)
		rec: mutable heap PoolTaskRecord& = handle.cast[mutable heap PoolTaskRecord&] can Unsafe.PointerCast
		free(rec.cast[heap void&])

# The pool owner and every outstanding completion record share this state. Workers
# are joined by pool_shutdown before owner_closed is set; the final record waiter
# may then destroy the synchronization objects after releasing the pool lock.
@internal
def ctx_pool_state_destroy(state: mutable heap ConcurrencyPoolState&):
	can Memory.Release:
		mutex_handle: mutable Mutex = zeroed
		mutex_handle.handle <- state.mutex
		mutex_destroy(&mutex_handle)
		wc_handle: mutable CondVar = zeroed
		wc_handle.handle <- state.work_cond
		condvar_destroy(&wc_handle)
		dc_handle: mutable CondVar = zeroed
		dc_handle.handle <- state.done_cond
		condvar_destroy(&dc_handle)
		free(state.cast[heap void&])

def pool_await_raw(task: Task[void&?, Pending]) -> void&?:
	can Pool.Await, Memory.Release, Abort.Panic:
		handle: uintptr = task.handle
		state_bits: void&? = task.state
		_ = move task
		can Sync{Lock,Wait,Unlock}:
			ctx_pool_wait_record(handle)
		return state_bits

@internal
def task_group_new_raw() -> TaskGroup:
	out: TaskGroup = zeroed
	return move out

@internal
def task_group_add_raw(group: mutable TaskGroup&, task: Task[void&?, Pending], state_bits: void&?):
	can Abort.Panic:
		handle: uintptr = task.handle
		_ = move task
		panic("task_group_add on invalid task") if handle == 0
		node: mutable heap PoolTaskRecord& = handle.cast[mutable heap PoolTaskRecord&] can Unsafe.PointerCast
		node.group_next <- null if group.handle == null else group.handle.cast[heap PoolTaskRecord&]
		# Keep task result state in the same intrusive record as its wait handle. The group
		# owns it until every task in this batch has joined; its lifetime remains the caller's contract.
		trusted Unsafe.StaleRef:
			node.group_state_bits <- state_bits
		group.handle <- node.cast[void&]

@internal
def task_group_wait_all_raw(group: mutable TaskGroup&):
	can Pool.WaitAll, Memory.Release, Abort.Panic:
		current: mutable heap PoolTaskRecord&? = group.handle.cast[heap PoolTaskRecord&?]
		last_waited: mutable heap PoolTaskRecord&? = null
		trusted Unsafe.AssumeProgress:
			while current != null:
				next: mutable heap PoolTaskRecord&? = current.group_next
				handle: uintptr = current.cast[uintptr]
				can Sync{Lock,Wait,Unlock}:
					ctx_pool_wait_record_done(handle)
				last_waited <- current
				current <- next
		# Retain completed records until every wait in the batch has finished, so their result
		# states are released only after all workers have stopped using their arguments.
		if group.handle != null:
			trusted Unsafe.StaleRef:
				if last_waited is last_node:
					last_node.group_next <- group.cleanup.cast[heap PoolTaskRecord&] if group.cleanup != null
				group.cleanup <- group.handle
		group.handle <- null

def ctx_concurrency_ref_release(slot: mutable AtomicSlot[i64]&) -> i64:
	trusted Unsafe.AssumeProgress:
		while true:
			current: i64 = load(slot, MemoryOrder.Acquire) can Atomics.Load
			next: i64 = current - 1
			released: bool = compare_exchange(slot, current, next, MemoryOrder.AcqRel, MemoryOrder.Acquire) can Atomics.CompareExchange
			return next if released
	return 0

def ctx_concurrency_work1_release(state_bits: mutable void&?):
	can Memory.Release, Atomics.Load, Atomics.CompareExchange:
		return if state_bits == null
		live_bits: mutable void& = state_bits
		state: mutable heap ConcurrencyWorkStart1& = live_bits.cast[mutable heap ConcurrencyWorkStart1&]
		remaining: i64 = ctx_concurrency_ref_release(&state.refs) can Unsafe.Alias
		if remaining == 0:
			free(state.arg_bits.cast[heap void&])
			free(state.result_bits.cast[heap void&])
			free(state.cast[heap void&])

def ctx_concurrency_work1_new[A, R, permission P](fn: fn(A) -> R can[P], arg: A) -> mutable heap ConcurrencyWorkStart1&:
	can Memory.Allocate, Abort.Panic:
		arg_box: heap ConcurrencyBox[A]& = ctx_concurrency_box_new(arg)
		result_storage: mutable heap void& = ctx_concurrency_alloc(size_of(ConcurrencyBox[R]))
		raw: heap void& = ctx_concurrency_alloc(size_of(ConcurrencyWorkStart1))
		state: mutable heap ConcurrencyWorkStart1& = raw.cast[heap ConcurrencyWorkStart1&]
		state.fn_bits <- fn.cast[uintptr]
		state.arg_bits <- arg_box.cast[void&]
		state.result_bits <- result_storage.cast[void&]
		state.completed.value <- 0
		state.refs.value <- 2
		return state

def ctx_concurrency_work1_entry[A, R, permission P](state_bits: mutable void&) -> void&:
	can P, Memory.Release, Atomics.Load, Atomics.Store, Atomics.CompareExchange:
		state: mutable heap ConcurrencyWorkStart1& = state_bits.cast[mutable heap ConcurrencyWorkStart1&]
		fn: fn(A) -> R can[P] = state.fn_bits.cast[fn(A) -> R can[P]]
		arg_box: heap ConcurrencyBox[A]& = state.arg_bits.cast[heap ConcurrencyBox[A]&]
		result: R = fn(arg_box.value)
		ctx_concurrency_result_write[R](state.result_bits, result) can Unsafe.Alias
		# Release-publish only after the result write. An Acquire load that sees 1
		# observes the initialized result storage; `ready` never consumes it.
		store(&state.completed, 1, MemoryOrder.Release) can Atomics.Store, Unsafe.Alias
		(ctx_concurrency_work1_release(state.cast[mutable void&]) can Unsafe{PointerCast,Alias})
		return state.cast[void&]

def ctx_concurrency_work1_take_result[R](state_bits: void&?) -> R:
	can Memory.Release, Abort.Panic, Atomics.Load, Atomics.CompareExchange:
		panic("concurrency work returned no state") if state_bits == null
		live_bits: void& = state_bits
		state: heap ConcurrencyWorkStart1& = live_bits.cast[heap ConcurrencyWorkStart1&]
		result: R = ctx_concurrency_result_read[R](state.result_bits)
		(ctx_concurrency_work1_release(state.cast[mutable void&]) can Unsafe{PointerCast,Alias})
		return result

def ctx_thread_from_raw[R, S](raw: Thread[void&?, S]) -> Thread[R, S]:
	move raw as {handle, state}
	return Thread[R, S]{handle: handle, state: state}

def ctx_thread_to_raw[R, S](thread: Thread[R, S]) -> Thread[void&?, S]:
	move thread as {handle, state}
	return Thread[void&?, S]{handle: handle, state: state}

def ctx_task_from_raw[R, S](raw: Task[void&?, S]) -> Task[R, S]:
	move raw as {handle, state}
	return Task[R, S]{handle: handle, state: state}

def ctx_task_to_raw[R, S](task: Task[R, S]) -> Task[void&?, S]:
	move task as {handle, state}
	return Task[void&?, S]{handle: handle, state: state}

