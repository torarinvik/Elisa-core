def sview_is_empty(view: sview) -> bool:
    return view.len <= 0

def sview_eq(lhs: sview, rhs: sview) -> bool:
    can Unsafe{PointerCast,RawExtern}:
        return string_views_eq(lhs, rhs) == 1

def sview_starts_with(view: sview, prefix: sview) -> bool:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return false if:
            view.len < 0 or prefix.len < 0
            prefix.len > view.len
        return string_views_eq(string_view_prefix(view, prefix.len), prefix) == 1

def sview_ends_with(view: sview, suffix: sview) -> bool:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return false if:
            view.len < 0 or suffix.len < 0
            suffix.len > view.len
        return string_views_eq(string_view_suffix(view, view.len - suffix.len), suffix) == 1

# Index of the first occurrence of `byte`, or -1 if absent.
def sview_find_byte(view: sview, byte: u8) -> i64:
    ensure (view.len < 0 or view.len.usize().i64() != view.len) implies result == -1
    ensure result >= -1
    ensure result >= 0 implies result < view.len
    ensure result >= 0 implies string_view_index(view, result) == byte.i64()
    ensure result >= 0 implies (forall prior in 0..<result: string_view_index(view, prior) != byte.i64())
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and result == -1) implies (forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64())
    trusted Unsafe.UncheckedIndex:
        return -1 if view.len < 0
        view_len: usize = view.len.usize()
        return -1 if view_len.i64() != view.len
        i: mutable i64 = 0
        while i < view.len:
            decreases view.len - i
            invariant 0 <= i and i <= view.len
            invariant forall prior in 0..<i: string_view_index(view, prior) != byte.i64()
            return i if string_view_index(view, i) == byte.i64()
            i <- i + 1
        return -1

def sview_contains_byte(view: sview, byte: u8) -> bool:
    ensure result == (sview_find_byte(view, byte) >= 0)
    can Unsafe.UncheckedIndex:
        return sview_find_byte(view, byte) >= 0

# Drop a trailing byte (e.g. a path separator) without copying.
def sview_trim_trailing(view: sview, byte: u8) -> sview:
    ensure result.len >= 0 and result.len <= (view.len if view.len > 0 and view.len.usize().i64() == view.len else 0)
    ensure result.len > 0 implies (string_view_index(view, result.len - 1) != byte.i64() and result.data == view.data)
    ensure forall suffix_index in result.len..<(view.len if view.len > 0 and view.len.usize().i64() == view.len else 0): string_view_index(view, suffix_index) == byte.i64()
    can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
        return "" if view.len < 0
        view_len: usize = view.len.usize()
        return "" if view_len.i64() != view.len
        assert view.len >= 0 and view_len.i64() == view.len
        hi: mutable i64 = view.len
        while hi > 0 and string_view_index(view, hi - 1) == byte.i64():
            decreases hi
            invariant 0 <= hi and hi <= view.len and hi.usize().i64() == hi
            invariant forall suffix_index in hi..<view.len: string_view_index(view, suffix_index) == byte.i64()
            hi <- hi - 1
        return string_view_prefix(view, hi)

# A bounds-safe view over the live bytes of a darray[u8]. This is the bridge
# that lets raw byte-buffer scanning (ELF string tables, parse buffers, ...) be
# done through the bounds-checked sview helpers instead of unchecked indexing
# with compound offsets. The single interior pointer is taken under `trusted`
# here, ONCE, so every caller scans with zero Unsafe of its own.
#
# The returned view borrows the darray's storage: it is valid only while the
# darray is alive and un-grown (a relocating push invalidates it — the compiler
# tracks this for interior darray borrows).
def bytes_view(buf: darray[u8]) -> sview:
    can Unsafe{PointerArithmetic,RawExtern}:
        n: usize = buf.count
        return sview("", 0, 0) if:
            n == 0
            buf.items == null or n > buf.capacity
        signed_len: i64 = n.i64()
        if signed_len < 0 or signed_len.usize() != n:
            return sview("", 0, 0)
        trusted Unsafe.UncheckedIndex:
            trusted Unsafe.PointerCast:
                return StringView{data: &buf[0], len: signed_len}

# A bounded borrowed view into a byte buffer. The source's count and capacity provide
# the extent; this never scans for a NUL byte and cannot be used with an arbitrary pointer.
def bytes_view_range(buf: darray[u8], start: usize, count: usize) -> sview:
    can Unsafe{PointerArithmetic,RawExtern}:
        base: sview = bytes_view(buf)
        empty: sview = sview("", 0, 0)
        return empty if base.len < 0
        base_len: usize = base.len.usize()
        return empty if base_len.i64() != base.len or start > base_len or count > base_len - start
        start_signed: i64 = start.i64()
        count_signed: i64 = count.i64()
        return empty if start_signed < 0 or start_signed.usize() != start or count_signed < 0 or count_signed.usize() != count
        return string_view_slice(base, start_signed, start_signed + count_signed)

# Reference-taking counterpart for APIs that already receive a darray borrow. It
# proves the requested extent against the live container before the only indexed
# address calculation, so the returned view carries the borrow rather than a copy.
ghost def bytes_view_range_ref_request_valid(buf: darray[u8]&, start: usize, count: usize) -> bool:
    ensure result == (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    )
    return (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    )

def bytes_view_range_ref(buf: darray[u8]&, start: usize, count: usize) -> sview:
    ensure result.len >= 0
    ensure result.len == 0 or result.len == count.i64()
    ensure (count == 0) implies result.len == 0
    ensure (start > buf.count) implies result.len == 0
    ensure (start <= buf.count and count > buf.count - start) implies result.len == 0
    ensure (buf.count == 0 or buf.items == null or buf.count > buf.capacity) implies result.len == 0
    ensure (buf.count.i64() < 0 or buf.count.i64().usize() != buf.count) implies result.len == 0
    ensure (start.i64() < 0 or start.i64().usize() != start) implies result.len == 0
    ensure (count.i64() < 0 or count.i64().usize() != count) implies result.len == 0
    ensure (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.len == count.i64()
    ensure (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.data == buf.items + start
    ensure not (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.len == 0
    can Unsafe{PointerArithmetic,RawExtern}:
        empty: sview = sview("", 0, 0)
        if (
            buf.count > 0
            and buf.items != null
            and buf.count <= buf.capacity
            and buf.count.i64() >= 0
            and buf.count.i64().usize() == buf.count
            and start <= buf.count
            and count <= buf.count - start
            and start.i64() >= 0
            and start.i64().usize() == start
            and count.i64() >= 0
            and count.i64().usize() == count
            and count > 0
            and start < buf.count
        ):
            trusted Unsafe.PointerArithmetic:
                trusted Unsafe.PointerCast:
                    return StringView{data: buf.items + start, len: count.i64()}
        assert not (
            buf.count > 0
            and buf.items != null
            and buf.count <= buf.capacity
            and buf.count.i64() >= 0
            and buf.count.i64().usize() == buf.count
            and start <= buf.count
            and count <= buf.count - start
            and start.i64() >= 0
            and start.i64().usize() == start
            and count.i64() >= 0
            and count.i64().usize() == count
            and count > 0
            and start < buf.count
        )
        return empty

# Last index of a byte in a view, or -1 when absent; used by the Fs path helpers.
def sview_find_last_byte(view: sview, byte: u8) -> i64:
    # Keep scalar range facts in independent clauses so call-site SMT projection
    # can retain them even when the quantified character facts are opaque.
    ensure (view.len < 0 or view.len.usize().i64() != view.len) implies result == -1
    ensure result >= -1
    ensure (result >= 0) implies result < view.len
    ensure (result >= 0) implies string_view_index(view, result) == byte.i64()
    ensure (result >= 0) implies (forall later in result + 1..<view.len: string_view_index(view, later) != byte.i64())
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and result == -1) implies (forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64())
    trusted Unsafe.UncheckedIndex:
        return -1 if view.len < 0
        view_len: usize = view.len.usize()
        return -1 if view_len.i64() != view.len
        assert view.len >= 0 and view_len.i64() == view.len
        i: mutable i64 = view.len
        while i > 0:
            decreases i
            invariant 0 <= i and i <= view.len
            invariant forall later in i..<view.len: string_view_index(view, later) != byte.i64()
            candidate: i64 = i - 1
            if string_view_index(view, candidate) == byte.i64():
                return candidate
            i <- candidate
        return -1

# Pure StringView path decomposition; OS-backed filesystem queries live in the host FFI.
# filename and parent select the final component and its preceding prefix.
module Fs:
    def filename(p: sview) -> sview:
        ensure (p.len >= 0 and p.len.usize().i64() == p.len) implies result.len == p.len - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) >= 0) implies result.data == p.data + (sview_find_last_byte(p, 47) + 1).usize()
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) == -1) implies result.data == p.data
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            assert slash == sview_find_last_byte(p, 47)
            assert slash >= -1 and slash < p.len
            if slash >= 0:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: p.len - (slash + 1)}
            assert slash == -1
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: p.len - (slash + 1)}

    def parent(p: sview) -> sview:
        ensure (p.len >= 0 and p.len.usize().i64() == p.len) implies ((sview_find_last_byte(p, 47) >= 0 and result.len == sview_find_last_byte(p, 47) and (result.len == 0 or result.data == p.data)) or (sview_find_last_byte(p, 47) == -1 and result.len == 0))
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            assert slash == sview_find_last_byte(p, 47)
            assert slash >= -1 and slash < p.len
            if slash >= 0:
                return string_view_empty_at(p.data) if slash == 0
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data, len: slash}
            assert slash == -1
            return string_view_empty_at(p.data)

    # The malformed-input and exhaustive valid-length cases below imply result.len >= 0.
    def extension(p: sview) -> sview:
        ensure (p.len < 0 or p.len.usize().i64() != p.len) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.len == p.len - sview_find_last_byte(p, 46)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) <= sview_find_last_byte(p, 47) + 1) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.data == p.data + sview_find_last_byte(p, 46).usize()
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            name_start: i64 = slash + 1
            dot: i64 = sview_find_last_byte(p, 46)
            assert slash >= -1 and slash < p.len
            assert name_start == sview_find_last_byte(p, 47) + 1
            assert dot == sview_find_last_byte(p, 46)
            assert name_start >= 0 and name_start <= p.len
            assert dot >= -1 and dot < p.len
            if dot > name_start:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + sview_find_last_byte(p, 46).usize(), len: p.len - dot}
            assert dot <= name_start
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: 0}

    # The malformed-input and exhaustive valid-length cases imply result.len >= 0.
    def stem(p: sview) -> sview:
        ensure (p.len < 0 or p.len.usize().i64() != p.len) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.len == sview_find_last_byte(p, 46) - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) <= sview_find_last_byte(p, 47) + 1) implies result.len == p.len - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) >= 0) implies result.data == p.data + (sview_find_last_byte(p, 47) + 1).usize()
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) == -1) implies result.data == p.data
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            name_start: i64 = slash + 1
            dot: i64 = sview_find_last_byte(p, 46)
            assert slash >= -1 and slash < p.len
            assert slash == sview_find_last_byte(p, 47)
            assert name_start == sview_find_last_byte(p, 47) + 1
            assert dot == sview_find_last_byte(p, 46)
            assert name_start >= 0 and name_start <= p.len
            assert dot >= -1 and dot < p.len
            if dot > name_start:
                if slash >= 0:
                    trusted Unsafe.PointerCast:
                        return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: dot - name_start}
                assert slash == -1
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data, len: dot - name_start}
            assert dot <= name_start
            if slash >= 0:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: p.len - name_start}
            assert slash == -1
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: p.len - name_start}

    # Build `base / leaf` into arena `a` (std::filesystem::path::operator/). Inserts a
    # single `/` separator (no doubled slash if `base` already ends with one); an absolute
    # `leaf` (leading `/`) replaces `base`, as in C++. Allocates, so it takes the arena.
    def join(a: mutable Arena&, base: sview, leaf: sview) -> dstr:
        can Abort.Panic, Memory.Allocate, Unsafe{PointerArithmetic,PointerCast,RawExtern}:
            out: mutable dstr = []
            sep: sview = sview("/", 0, -1)
            in a:
                if sview_starts_with(leaf, sep):
                    for ch in leaf:
                        _ = out.push(ch)
                    return out
                for cb in base:
                    _ = out.push(cb)
                out.push(47) if base.len > 0 and not sview_ends_with(base, sep)
                for cl in leaf:
                    _ = out.push(cl)
            return out

include "./elisacore_runtime_string_path_views.elisa"
include "./elisacore_runtime_string_hash.elisa"
