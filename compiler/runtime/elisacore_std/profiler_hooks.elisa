# ============================================================
# Profiler ABI hooks - optional host instrumentation surface
# ============================================================
#
# The core runtime owns allocation and region lifecycles, but it must not own
# profiler policy or storage. These weak entry points are therefore a narrow,
# allocation-free ABI seam: ordinary programs pay only the call cost, while a
# profiler can provide strong implementations at final link time.

const ELISA_PROFILE_ALLOCATION_ALLOC: u32 = 1
const ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE: u32 = 2
const ELISA_PROFILE_ALLOCATION_REALLOC_MOVE: u32 = 3
const ELISA_PROFILE_ALLOCATION_RECLAIM: u32 = 4
const ELISA_PROFILE_ALLOCATION_REGION_CREATE: u32 = 5
const ELISA_PROFILE_ALLOCATION_REGION_RESET: u32 = 6
const ELISA_PROFILE_ALLOCATION_REGION_TRIM: u32 = 7
const ELISA_PROFILE_ALLOCATION_REGION_FREE: u32 = 8
const ELISA_PROFILE_ALLOCATION_ARENA_ADOPT: u32 = 9
const ELISA_PROFILE_ALLOCATION_REGION_REWIND: u32 = 10
const ELISA_PROFILE_ALLOCATION_ABI_V1: u32 = 1
const ELISA_PROFILE_REGION_LAYOUT_ABI_V1: u32 = 1

extern elisa_profile_region_layout_negotiate(requested_version: u32) -> u32
extern elisa_profile_region_layout_v1(arena: uintptr, region: usize, header: uintptr, data_base: uintptr, capacity_bytes: usize) -> void

# Geometry uses the runtime's actual data pointer, never an assumed header size.
@internal
def arena_profile_region_layout(a: Arena&, r: heap Region&) -> void:
    if elisa_profile_region_layout_negotiate(ELISA_PROFILE_REGION_LAYOUT_ABI_V1) == ELISA_PROFILE_REGION_LAYOUT_ABI_V1:
        elisa_profile_region_layout_v1(a.cast[uintptr], r.global_index, r.cast[uintptr], arena_heap_u8_from_region_data(r).uintptr(), r.capacity * size_of(uintptr))

extern elisa_profile_allocation_negotiate(requested_version: u32) -> u32

# The executable link shim supplies a weak no-op implementation for ordinary
# programs. A profiler collector supplies a strong implementation at final
# link time. The pointer values are opaque capture-local identities.
# For ARENA_ADOPT, arena is the destination parent and old_address is the
# consumed child arena identity (not an allocation address). Size fields are
# zero. Older hooks emitted zero for the child: consumers must treat that as
# unavailable transfer identity, never as a known source arena.
# For REGION_REWIND, address is the retained region header and size is the
# retained bump offset in bytes within that region. Later regions are reset;
# old_address and old_size are zero. This is not a logical live-byte total.
extern elisa_profile_allocation_event_v1(
    kind: u32,
    address: uintptr,
    size: usize,
    old_address: uintptr,
    old_size: usize,
    arena: uintptr,
    region: usize
) -> void

# Negotiation is stateless: no initialization race or allocation on this path.
# A normal executable's weak host shim returns zero (unsupported).
def arena_profile_allocation_event(
    kind: u32, address: uintptr, size: usize, old_address: uintptr,
    old_size: usize, arena: uintptr, region: usize
) -> void:
    if elisa_profile_allocation_negotiate(ELISA_PROFILE_ALLOCATION_ABI_V1) == ELISA_PROFILE_ALLOCATION_ABI_V1:
        elisa_profile_allocation_event_v1(kind, address, size, old_address, old_size, arena, region)
