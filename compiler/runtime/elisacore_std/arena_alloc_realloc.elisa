def arena_alloc(a: mutable Arena&, size_bytes: usize) -> mutable heap void&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        size: usize = arena_size_bytes_to_slots(size_bytes)

        # Consume the current bump region before consulting the best-effort free hint. This
        # keeps the common allocation path to a capacity/owner check and leaves reclaimed
        # spans available for requests that cannot use the current bump range.
        current_bump_can_fit: mutable bool = false
        if a.end != null:
            current_bump_can_fit <- arena_region_can_fit(a.end, size)
            if a.strategy != ARENA_STRATEGY_RESERVE_COMMIT and a.strategy != ARENA_STRATEGY_FIXED:
                current_bump_can_fit <- current_bump_can_fit and a.end.owner_tag == 0.uintptr()
        if not current_bump_can_fit and a.begin != null:
            if (arena_take_free_block_chain(a, size, size_bytes) can Abort.Panic, Global{Read,Write}, Atomics.Load) is reclaimed:
                return reclaimed

        # RESERVE_COMMIT / FIXED: one contiguous block, never chained. The block is created
        # up front by the region declaration with the full reservation as its capacity, so
        # allocation just bumps within it (pages commit on first touch under mmap). Overflowing
        # the reservation is a hard error -- chaining a second block would break the contiguous,
        # relocation-free layout the type system relies on, so we panic instead.
        if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
            # Lazy default reservation (docs/73 §3): a reserve_commit arena whose block has not been
            # created yet reserves its default contiguous range on first touch, so empty/tiny regions
            # cost nothing. FIXED and bounded reserve_commit are reserved up front by the region
            # declaration, so they already have a block here.
            if a.end == null:
                cap: mutable usize = arena_default_reserve_slots()
                cap <- size if cap < size
                a.end as & <- (new_region_backend(cap, a.strategy) can Global{Read,Write})
                a.begin <- a.end
                a.end_index <- 0
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                    a.end.cast[uintptr],
                    arena_region_payload_bytes(a.end.capacity),
                    0.uintptr(),
                    0.usize(),
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                current_bump_can_fit <- arena_region_can_fit(a.end, size)
            assert a.end != null
            if not current_bump_can_fit:
                panic("region overflow: reservation exhausted (reserve_commit/fixed)")
            data_base: heap u8& = arena_heap_u8_from_region_data(a.end)
            (arena_profile_region_layout(a, a.end) can Global{Read,Write}) if a.end.count == 0
            offset_bytes: usize = arena_region_payload_bytes(a.end.count)
            result: mutable heap void& = arena_heap_void_from_data_base(data_base, offset_bytes)
            a.end.count <- arena_checked_add_usize(a.end.count, size)
            # Windows: page-in the bytes this allocation now spans (no-op elsewhere).
            arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_ALLOC,
                result.cast[uintptr],
                size_bytes,
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            return result

        if a.end == null:
            assert a.begin == null

            capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
            capacity <- size if capacity < size

            a.end as & <- (new_region_backend(capacity, a.strategy) can Global{Read,Write})
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                a.end.cast[uintptr],
                arena_region_payload_bytes(a.end.capacity),
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            current_bump_can_fit <- a.end.owner_tag == 0.uintptr() and arena_region_can_fit(a.end, size)

        assert a.end != null

        trusted Unsafe.AssumeProgress:
            while not current_bump_can_fit and a.end.next != null:
                a.end <- a.end.next
                a.end_index <- a.end_index + 1
                current_bump_can_fit <- a.end.owner_tag == 0.uintptr() and arena_region_can_fit(a.end, size)

        if not current_bump_can_fit:
            assert a.end.next == null

            capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
            capacity <- size if capacity < size

            a.end.next as & <- (new_region_backend(capacity, a.strategy) can Global{Read,Write})
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                a.end.cast[uintptr],
                arena_region_payload_bytes(a.end.capacity),
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        data_base: heap u8& = arena_heap_u8_from_region_data(a.end)
        (arena_profile_region_layout(a, a.end) can Global{Read,Write}) if a.end.count == 0
        offset_bytes: usize = arena_region_payload_bytes(a.end.count)
        result: mutable heap void& = arena_heap_void_from_data_base(data_base, offset_bytes)
        a.end.count <- arena_checked_add_usize(a.end.count, size)
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_ALLOC,
            result.cast[uintptr],
            size_bytes,
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
        return result

# Slot offset of an in-region allocation from the region's data base. All pointer->int
# casts are discharged here so callers (arena_realloc) surface no Unsafe effect.
@internal
def arena_tail_offset_slots(data_base: heap u8&, ptr: void&) -> usize:
    trusted Unsafe.PointerCast:
        return (ptr.cast[heap u8&].usize() - data_base.usize()) / size_of(uintptr)

# Return true only when `ptr` is the complete most-recent allocation in `r`. The
# ownership check is essential for chained arenas: an old pointer may belong to an
# earlier block, and subtracting it from the current block's base would manufacture
# an apparently valid offset. Keep the raw-address arithmetic in this one trusted
# helper so arena_realloc can use the same proof for every strategy.
@internal
def arena_region_is_tail_allocation(r: heap Region&, ptr: void&, size_bytes: usize) -> bool:
    can Abort.Panic:
        base: mutable uintptr = 0.uintptr()
        raw: mutable uintptr = 0.uintptr()
        trusted Unsafe.PointerCast:
            base <- arena_heap_u8_from_region_data(r).uintptr()
            raw <- ptr.cast[heap u8&].uintptr()
        if raw < base:
            return false
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")
        offset_bytes: usize = (raw - base).usize()
        if offset_bytes % size_of(uintptr) != 0:
            return false
        capacity_bytes: usize = arena_region_payload_bytes(r.capacity)
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if offset_bytes > capacity_bytes or size_bytes > capacity_bytes - offset_bytes:
            return false
        if offset_bytes > used_bytes:
            return false
        return size_bytes == used_bytes - offset_bytes

def arena_realloc(a: mutable Arena&, oldptr: mutable void&, oldsz: usize, newsz: usize) -> mutable heap void&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        if newsz <= oldsz:
            return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast

        old_slots: usize = arena_size_bytes_to_slots(oldsz)
        new_slots: usize = arena_size_bytes_to_slots(newsz)
        growth_slots: usize = new_slots - old_slots
        allocation_bytes: usize = arena_region_payload_bytes(old_slots)

        # A darray grows by reallocating its most recent backing allocation in the
        # active arena. Reclaim that tail in place whenever the current block owns it;
        # otherwise the old block may be earlier in a chained arena and cannot move.
        # This is the general path, not just the stable reserve/fixed path, and avoids
        # retaining one dead backing allocation for every geometric growth step.
        if a.end != null and arena_region_is_tail_allocation(a.end, oldptr, allocation_bytes):
            if arena_region_can_fit(a.end, growth_slots):
                a.end.count <- arena_checked_add_usize(a.end.count, growth_slots)
                arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE,
                    oldptr.cast[uintptr],
                    newsz,
                    oldptr.cast[uintptr],
                    oldsz,
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast

        # RESERVE_COMMIT / FIXED grow in place: the base must never move (interior-pointer
        # stability, docs/68 §4). When oldptr is the region's tail allocation we just advance
        # the bump pointer to cover newsz and hand back the SAME pointer -- zero copy, no
        # relocation, pages commit on first touch. Any other case (not the tail, or past the
        # reservation) cannot be honored without moving data, so we panic rather than silently
        # invalidate references the type system already proved stable.
        if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
            assert a.end != null
            if arena_region_is_tail_allocation(a.end, oldptr, allocation_bytes):
                if not arena_region_can_fit(a.end, growth_slots):
                    panic("region overflow: reservation exhausted (reserve_commit/fixed grow)")
                # The successful tail case returns above; this branch is retained as
                # an explicit invariant guard if the allocator representation changes.
                a.end.count <- arena_checked_add_usize(a.end.count, growth_slots)
                arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE,
                    oldptr.cast[uintptr],
                    newsz,
                    oldptr.cast[uintptr],
                    oldsz,
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast
            panic("reserve_commit/fixed array cannot grow in place: not the tail allocation")

        newptr: mutable heap void& = (arena_alloc(a, newsz) can Global{Read,Write}, Atomics.Load)

        # memcpy, not a byte loop. Every darray relocation lands here, and the
        # element-per-iteration copy moved one byte per loop trip — megabytes per
        # compile through the geometric-growth steps, and unvectorized in the -O0
        # builds the self-host fixpoint gate runs. The regions never overlap (newptr
        # is a fresh allocation), so plain memcpy is the exact same operation.
        trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
            _ = memcpy(arena_heap_void_from_mutable(newptr).cast[mutable void&], arena_u8_from_void(oldptr).cast[void&], oldsz)

        # The old block is NOT reclaimed. A darray header copy shares its buffer (docs/84):
        # after `b = a` and an allocation that makes `a` stop being the arena tail, `a`'s next
        # growth moves it while `b` still reads the old block, and handing that block to the
        # free list let the next allocation overwrite `b`'s elements (a silent wrong answer in
        # safe code). The block dies with the arena instead, as a Go slice's old backing array
        # does. arena_reclaim_allocation stays for a caller that can prove no copy of the
        # header exists.
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REALLOC_MOVE,
            newptr.cast[uintptr],
            newsz,
            oldptr.cast[uintptr],
            oldsz,
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        return newptr

# ------------------------------------------------------------
# Arena introspection (used by region-backing assertions/tests)
# ------------------------------------------------------------

# Total committed (used) slots across the whole region chain, counted in uintptr
# slots. Walks every region from `begin` regardless of the chained/owner topology,
# so it covers regions split off for packed/SoA store columns too. Read-only — does
# not allocate. Multiply by size_of(uintptr) for a byte figure.
