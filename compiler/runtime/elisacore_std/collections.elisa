# ============================================================
# Collections helpers - Elisa core runtime dialect
# ============================================================

include "./deque.elisa"
include "./elisacore_fnv1a_spec.elisa"

extern memset(dest: mutable void&, val: i32, n: usize) -> mutable void&

# Keep tiny AST/parser lists cheap. The arena allocator can reclaim non-tail
# backing allocations, but avoiding oversized seed buffers still reduces cache
# pressure and the amount of live memory touched by recursive AST construction.
const ARENA_DA_INIT_CAP: usize = 8
const DICT_INIT_CAP: usize = 8
const COLLECTION_BUCKET_EMPTY: u8 = 0
const COLLECTION_BUCKET_OCCUPIED: u8 = 1
const COLLECTION_BUCKET_TOMBSTONE: u8 = 2

struct DynArray[T]:
    items: mutable T&?
    count: mutable usize
    capacity: mutable usize

struct DynArrayView:
    data: mutable void&?
    len: mutable usize

def view_from_parts[T](data: void&?, len: usize) -> view[T]:
    return DynArrayView{data: data, len: len}

# Open-addressing slot: `state` is empty, occupied, or tombstone (deleted, but probing must
# continue past it). A zeroed bucket is therefore an empty slot.
struct DictBucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct DynDict[K, T]:
    items: mutable DictBucket[K, T]&?
    count: mutable usize
    used: mutable usize
    capacity: mutable usize
    arena: mutable Arena&?

struct DictProbeResult:
    index: mutable usize
    found: mutable bool

extern SymbolTableSlot

type SymbolTableId = id[SymbolTableSlot]


def __cast__(value: u32) -> SymbolTableId:
    return value.cast[SymbolTableId]


global SYMBOL_TABLE_INVALID_ID: SymbolTableId = 0.u32().SymbolTableId()


struct SymbolEntry[K, T]:
    key: mutable K
    value: mutable T


struct IndexMapEntry[K, T]:
    key: mutable K
    value: mutable T


struct IndexMap[K, T]:
    owner: mutable Arena&?
    entries: mutable darray[IndexMapEntry[K, T]]
    by_key: mutable dict[K, usize]


struct InlineVec[T, N: usize]:
    owner: mutable Arena&?
    inline_items: mutable T[N]
    overflow: mutable darray[T]
    len: mutable usize
    is_spilled: mutable bool


struct Flags[T]:
    bits: mutable u64


struct IndexMapNamespace:
    _unused: u8


struct InlineVecNamespace:
    _unused: u8


struct FlagsNamespace:
    _unused: u8


global indexmap: IndexMapNamespace = IndexMapNamespace{_unused: 0}
global inlinevec: InlineVecNamespace = InlineVecNamespace{_unused: 0}
global flags: FlagsNamespace = FlagsNamespace{_unused: 0}

@internal
def collections_items_from_alloc[T](ptr: heap void&) -> mutable T&:
    trusted Unsafe.PointerCast:
        return ptr.cast[mutable T&]

@internal
def collections_void_from_items[T](items: T&) -> void&:
    trusted Unsafe.PointerCast:
        return items.cast[void&]

# The optional form, for handing a possibly-absent table to collection_stack_acquire.
@internal
def collections_void_from_items_opt[T](items: T&?) -> void&?:
    trusted Unsafe.PointerCast:
        return items.cast[void&?]

# uintptr slots covering `bytes`, rounded the way the arena counts them; never 0.
@internal
def collections_table_slots(bytes: usize) -> usize:
    word_bytes: usize = size_of(uintptr)
    slots: mutable usize = bytes / word_bytes
    if bytes % word_bytes != 0:
        slots <- slots + 1
    slots <- 1 if slots == 0
    return slots

@internal
def collections_mutable_void_from_items[T](items: mutable T&) -> mutable void&:
    trusted Unsafe.PointerCast:
        return items.cast[mutable void&]

# `T& + n` is VALUE arithmetic for a scalar referent, by design: a scalar ref
# derefs for +/- so `for ref x in nums: x + 1` means the number, not the address
# (scalarRefValueContextOperandType). Only `u8&` is exempt as the byte-pointer
# case. So stepping a generic `T&` has to go through a byte pointer and scale by
# size_of(T) explicitly — writing `items + index` compiled to "load the element,
# add the index, treat the SUM as an address", which for a deque of i64 holding
# {1, 2} produced the pointer 0x1.
@internal
def collections_void_from_items_at[T](items: T&, index: usize) -> void&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (items.cast[u8&] + index * size_of(T)).cast[void&]

@internal
def collections_mutable_void_from_items_at[T](items: mutable T&, index: usize) -> mutable void&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (items.cast[mutable u8&] + index * size_of(T)).cast[mutable void&]

@internal
def collections_void_from_data_at(data: void&, offset: usize) -> void&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (data.cast[u8&] + offset).cast[void&]

@internal
def collections_items_from_data_at[T](data: void&, offset: usize) -> T&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (data.cast[u8&] + offset).cast[T&]

@internal
def collections_items_from_data[T](data: void&) -> T&:
    trusted Unsafe.PointerCast:
        return data.cast[T&]

@internal
def collections_mutable_items_from_data[T](data: mutable void&) -> mutable T&:
    trusted Unsafe.PointerCast:
        return data.cast[mutable T&]

# Allocate a single zero-initialized T on an arena and return a heap reference
# to it. This is the heap equivalent of `out: mutable T = zeroed`, but it never
# materializes a T-sized value on the stack -- essential for very large
# aggregate types (e.g. the shader IR program) whose by-value stack frame would
# be enormous. The libc memset is used (not the byte-loop cxx_memset) so zeroing
# stays O(1) syscalls rather than O(size) interpreted iterations.
def arena_box_zeroed[T](a: mutable Arena&) -> mutable heap T&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        raw: mutable heap void& = (arena_alloc(a, size_of(T)) can Global{Read,Write}, Atomics.Load)
        trusted Unsafe.RawExtern:
            memset(raw, 0, size_of(T))
        return collections_items_from_alloc[T](raw)

# ------------------------------------------------------------
# Dynamic array helpers (replacement for C macros)
# ------------------------------------------------------------

def arena_da_reserve[T](a: mutable Arena&, da: mutable darray[T, shape_in]&, needed: usize) -> mutable darray[T, shape_out]&:
    return da if needed <= da.capacity

    new_capacity: mutable usize = da.capacity
    new_capacity <- ARENA_DA_INIT_CAP if new_capacity == 0

    trusted Unsafe.AssumeProgress:
        while needed > new_capacity:
            doubled_capacity: usize = new_capacity * 2
            if doubled_capacity < new_capacity:
                # `needed` was checked before growth; use it if geometric growth wraps.
                new_capacity <- needed
                break
            new_capacity <- doubled_capacity

    old_size: usize = arena_checked_mul_usize(da.capacity, size_of(T)) can Abort.Panic
    new_size: usize = arena_checked_mul_usize(new_capacity, size_of(T)) can Abort.Panic

    if da.items == null:
        da.items as & <- collections_items_from_alloc[T]((arena_alloc(a, new_size) can Global{Read,Write}, Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}))
    else:
        resized: heap void& = (arena_realloc(
            a,
            collections_mutable_void_from_items[T](da.items),
            old_size,
            new_size
        ) can Global{Read,Write}, Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern})
        da.items as & <- collections_items_from_alloc[T](resized)

    da.capacity <- new_capacity
    return da

def arena_da_view[T](da: darray[T, shape_in]&, start: usize, end: usize) -> view[T]:
    return DynArrayView{data: null, len: 0} if da.items == null or da.count == 0

    lo: mutable usize = start if start < da.count else da.count
    hi: mutable usize = end if end < da.count else da.count
    hi <- lo if hi < lo

    return DynArrayView{data: null, len: 0} if hi == lo

    return DynArrayView{data: collections_void_from_items_at[T](da.items, lo), len: hi - lo}

def arena_da_view_len[T](view: view[T]) -> usize:
    return view.len

def arena_da_view_slice[T](view: view[T], start: usize, end: usize) -> view[T]:
    elem_size: usize = size_of(T)
    return DynArrayView{data: null, len: 0} if view.data == null or view.len == 0

    lo: mutable usize = start if start < view.len else view.len
    hi: mutable usize = end if end < view.len else view.len
    hi <- lo if hi < lo

    return DynArrayView{data: null, len: 0} if hi == lo

    offset: usize = lo * elem_size
    return DynArrayView{data: collections_void_from_data_at(view.data, offset), len: hi - lo}

def arena_da_view_prefix[T](view: view[T], end: usize) -> view[T]:
    return arena_da_view_slice(view, 0, end)

def arena_da_view_suffix[T](view: view[T], start: usize) -> view[T]:
    return arena_da_view_slice(view, start, view.len)

def arena_da_view_get[T](view: view[T], index: usize) -> T:
    assert index < view.len
    assert view.data != null

    offset: usize = index * size_of(T)
    base: T& = collections_items_from_data_at[T](view.data, offset)
    return base[0]

def arena_da_fill[T](dst: view[T], value: T):
	return if dst.len == 0

	assert dst.data != null

    out: mutable T& = collections_mutable_items_from_data[T](dst.data)
    for i in 0..<dst.len:
		out[i] <- value

def arena_da_copy_exact[T](dst: view[T], src: view[T]):
    assert dst.len == src.len
    return if dst.len == 0

    assert dst.data != null
    assert src.data != null

    out: mutable T& = collections_mutable_items_from_data[T](dst.data)
    src_items: T& = collections_items_from_data[T](src.data)
    for i in 0..<dst.len:
        out[i] <- src_items[i]

def arena_da_eq_exact[T](left: view[T], right: view[T]) -> bool:
    assert left.len == right.len
    return true if left.len == 0

    assert left.data != null
    assert right.data != null

    byte_count: usize = left.len * size_of(T)
    return arena_memeq(left.data, right.data, byte_count)

def arena_da_from_view[T](a: mutable Arena&, view: view[T]) -> darray[T, shape_out]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        return zeroed if view.len == 0

        items: mutable T& = collections_items_from_alloc[T]((arena_alloc(a, view.len * size_of(T)) can Global{Read,Write}, Atomics.Load))
        assert view.data != null
        arena_memcpy(collections_mutable_void_from_items[T](items), view.data, view.len * size_of(T))

        out: mutable darray[T, shape_out] = zeroed
        out.items as & <- items
        out.count <- view.len
        out.capacity <- view.len
        return out


def darray_view[T](da: darray[T]) -> view[T]:
    return DynArrayView{data: null, len: 0} if da.items == null or da.count == 0
    return DynArrayView{data: collections_void_from_items[T](da.items), len: da.count}


def view[T](da: darray[T]) -> view[T]:
    return darray_view[T](da)


# Build a read-only view over a fixed-size array (T[N]) with no copy and no
# arena. Pass the array by reference, e.g. `array_view(TABLE.ref[u32[N]&])`.
# Works for top-level `const` tables too (they are addressable as read-only
# globals), so a static table can be handed out as a zero-copy slice. Mirrors
# inline_vec_view's inline-buffer path.
def array_view[T, N: usize](arr: T[N]&) -> view[T]:
    return DynArrayView{data: null, len: 0} if N == 0
    trusted Unsafe.UncheckedIndex:
        return DynArrayView{data: collections_void_from_items[T](&arr[0]), len: N}


# ------------------------------------------------------------
# Inline vectors
# ------------------------------------------------------------

def inline_vec[T, N: usize](owner: mutable Arena&) -> InlineVec[T, N]:
    trusted Unsafe.PointerCast:
        # Uninitialized inline slots are inactive until vec.len includes them.
        return InlineVec[T, N]{owner: owner, inline_items: zeroed, overflow: [], len: 0, is_spilled: false}


def new[T, N: usize](api: InlineVecNamespace, owner: mutable Arena&) -> InlineVec[T, N]:
    _ = api
    return inline_vec[T, N](owner)


def inline_vec_count[T, N: usize](vec: InlineVec[T, N]&) -> usize:
    return vec.len


def count[T, N: usize](vec: InlineVec[T, N]&) -> usize:
    return inline_vec_count[T, N](vec)


def inline_vec_is_empty[T, N: usize](vec: InlineVec[T, N]&) -> bool:
    return vec.len == 0


def is_empty[T, N: usize](vec: InlineVec[T, N]&) -> bool:
    return inline_vec_is_empty[T, N](vec)


def inline_vec_spilled[T, N: usize](vec: InlineVec[T, N]&) -> bool:
    return vec.is_spilled


def spilled[T, N: usize](vec: InlineVec[T, N]&) -> bool:
    return inline_vec_spilled[T, N](vec)


def inline_vec_get[T, N: usize](vec: InlineVec[T, N]&, index: usize) -> T:
    assert index < vec.len
    trusted Unsafe.UncheckedIndex:
        return vec.overflow[index] if vec.is_spilled
    trusted Unsafe.UncheckedIndex:
        return vec.inline_items[index]


def get[T, N: usize](vec: InlineVec[T, N]&, index: usize) -> T:
    return inline_vec_get[T, N](vec, index)


def inline_vec_set[T, N: usize](vec: mutable InlineVec[T, N]&, index: usize, item: T):
    assert index < vec.len
    trusted Unsafe.UncheckedIndex:
        vec.overflow[index] <- item if vec.is_spilled
    trusted Unsafe.UncheckedIndex:
        vec.inline_items[index] <- item if not vec.is_spilled


def set[T, N: usize](vec: mutable InlineVec[T, N]&, index: usize, item: T):
    inline_vec_set[T, N](vec, index, item)


def inline_vec_spill[T, N: usize](vec: mutable InlineVec[T, N]&):
    can Memory.Allocate, Abort.Panic:
        return if vec.is_spilled

        assert vec.owner != null
        owner: mutable Arena& = vec.owner
        in owner:
            _ = vec.overflow.reserve(N * 2)
            for index in 0..<vec.len:
                trusted Unsafe.UncheckedIndex:
                    vec.overflow.push(vec.inline_items[index])

        vec.is_spilled <- true


def inline_vec_push[T, N: usize](vec: mutable InlineVec[T, N]&, item: T):
    can Memory.Allocate, Abort.Panic:
        if vec.is_spilled:
            assert vec.owner != null
            owner: mutable Arena& = vec.owner
            in owner:
                vec.overflow.push(item)
            vec.len <- vec.len + 1
            return

        if vec.len < N:
            trusted Unsafe.UncheckedIndex:
                vec.inline_items[vec.len] <- item
            vec.len <- vec.len + 1
            return

        inline_vec_spill[T, N](vec)
        assert vec.owner != null
        owner: mutable Arena& = vec.owner
        in owner:
            vec.overflow.push(item)
        vec.len <- vec.len + 1


def push[T, N: usize](vec: mutable InlineVec[T, N]&, item: T):
    can Memory.Allocate, Abort.Panic:
        inline_vec_push[T, N](vec, item)


def inline_vec_pop[T, N: usize](vec: mutable InlineVec[T, N]&) -> T:
    assert vec.len > 0
    vec.len <- vec.len - 1
    if vec.is_spilled:
        vec.overflow.count <- vec.len
        trusted Unsafe.UncheckedIndex:
            return vec.overflow[vec.len]
    trusted Unsafe.UncheckedIndex:
        return vec.inline_items[vec.len]


def pop[T, N: usize](vec: mutable InlineVec[T, N]&) -> T:
    return inline_vec_pop[T, N](vec)


def inline_vec_last[T, N: usize](vec: InlineVec[T, N]&) -> T:
    assert vec.len > 0
    return inline_vec_get[T, N](vec, vec.len - 1)


def last[T, N: usize](vec: InlineVec[T, N]&) -> T:
    return inline_vec_last[T, N](vec)


def inline_vec_view[T, N: usize](vec: InlineVec[T, N]&) -> view[T]:
    return DynArrayView{data: null, len: 0} if vec.len == 0
    if vec.is_spilled:
        assert vec.overflow.items != null
        return DynArrayView{data: collections_void_from_items[T](vec.overflow.items), len: vec.len}
    trusted Unsafe.UncheckedIndex:
        return DynArrayView{data: collections_void_from_items[T](&vec.inline_items[0]), len: vec.len}


def view[T, N: usize](vec: InlineVec[T, N]&) -> view[T]:
    return inline_vec_view[T, N](vec)


def inline_vec_clear[T, N: usize](vec: mutable InlineVec[T, N]&):
    vec.overflow.count <- 0 if vec.is_spilled
    vec.len <- 0
    vec.is_spilled <- false


def clear[T, N: usize](vec: mutable InlineVec[T, N]&):
    inline_vec_clear[T, N](vec)


# ------------------------------------------------------------
# Typed enum flags
# ------------------------------------------------------------

def flags_new[T](api: FlagsNamespace) -> Flags[T]:
    _ = api
    result: Flags[T] = zeroed
    return result


def new[T](api: FlagsNamespace) -> Flags[T]:
    return flags_new[T](api)


def flags_empty[T]() -> Flags[T]:
    result: Flags[T] = zeroed
    return result


def flags_from_bits[T](bits: u64) -> Flags[T]:
    result: mutable Flags[T] = zeroed
    result.bits <- bits
    return result


def flags_bits[T](items: Flags[T]&) -> u64:
    return items.bits


def bits[T](items: Flags[T]&) -> u64:
    return flags_bits[T](items)


def flags_mask[T](value: T) -> u64:
    index: u64 = value.u64()
    assert index < 64
    return 1.u64() << index.u32()


def flags_has[T](items: Flags[T]&, value: T) -> bool:
    return (items.bits & flags_mask[T](value)) != 0


def has[T](items: Flags[T]&, value: T) -> bool:
    return flags_has[T](items, value)


def flags_add[T](items: mutable Flags[T]&, value: T):
    items.bits <- items.bits | flags_mask[T](value)


def add[T](items: mutable Flags[T]&, value: T):
    flags_add[T](items, value)


def flags_remove[T](items: mutable Flags[T]&, value: T):
    items.bits <- items.bits & ~flags_mask[T](value)


def remove[T](items: mutable Flags[T]&, value: T):
    flags_remove[T](items, value)


def flags_set[T](items: mutable Flags[T]&, value: T, enabled: bool):
    can Unsafe.Alias:
        items.add(value) if enabled
        items.remove(value) if not enabled


def flags_clear[T](items: mutable Flags[T]&):
    items.bits <- 0


def flags_any[T](items: Flags[T]&) -> bool:
    return items.bits != 0


def flags_union[T](left: Flags[T]&, right: Flags[T]&) -> Flags[T]:
    return flags_from_bits[T](left.bits | right.bits)


def flags_intersection[T](left: Flags[T]&, right: Flags[T]&) -> Flags[T]:
    return flags_from_bits[T](left.bits & right.bits)


def flags_difference[T](left: Flags[T]&, right: Flags[T]&) -> Flags[T]:
    return flags_from_bits[T](left.bits & ~right.bits)


def arena_da_append[T](a: mutable Arena&, da: mutable darray[T, shape_in]&, item: T) -> mutable darray[T, shape_out]&:
    can Memory.Allocate, Abort.Panic:
        needed: usize = arena_checked_add_usize(da.count, 1) can Abort.Panic
        in a:
            _ = da.reserve(needed)

        assert da.items != null

        da.items[da.count] <- item
        da.count <- needed
        return da

def darray_pop[T](da: mutable darray[T]&) -> T:
    can Abort.Panic, Unsafe.UncheckedIndex:
        assert da.count > 0
        da.count <- da.count - 1
        return da[da.count]

def pop[T](da: mutable darray[T]&) -> T:
    can Abort.Panic:
        trusted Unsafe.UncheckedIndex:
            return darray_pop[T](da)

def darray_remove_at[T](da: mutable darray[T]&, index: usize) -> T:
    can Abort.Panic:
        assert index < da.count
        removed: T = da[index]
        next: mutable usize = index + 1
        trusted Unsafe.AssumeProgress:
            while next < da.count:
                da[next - 1] <- da[next]
                next <- next + 1
        da.count <- da.count - 1
        return removed

def remove_at[T](da: mutable darray[T]&, index: usize) -> T:
    can Abort.Panic:
        trusted Unsafe.UncheckedIndex:
            return darray_remove_at[T](da, index)

# Read-only range algorithms (no allocation). The predicate is a pure
# `fn(T) -> bool`, so a named function or a `lambda` works. These replace
# hand-rolled scan loops and transliterate std::any_of / all_of / count_if /
# find_if directly (`v.any_of(pred)` reads as `std::any_of(v..., pred)`).
def any_of[T](da: darray[T], pred: fn(T) -> bool) -> bool:
    for x in da:
        return true if pred(x)
    return false

def all_of[T](da: darray[T], pred: fn(T) -> bool) -> bool:
    for x in da:
        return false if not pred(x)
    return true

def count_if[T](da: darray[T], pred: fn(T) -> bool) -> usize:
    n: mutable usize = 0
    for x in da:
        n <- n + 1 if pred(x)
    return n

# Returns the first element satisfying `pred`, or `null` if none does
# (std::find_if, returning the element rather than an iterator).
def find_if[T](da: darray[T], pred: fn(T) -> bool) -> T?:
    for x in da:
        return x if pred(x)
    return null

# Comparator-based ordering algorithms (the C++ idiom: a strict-weak-ordering
# `less(a, b)`, not a `T`-level `<`, so they stay generic without operator
# overloading). All in-place / allocation-free.

# Internal heapsort sift-down used by `sort`.
def darray_sift_down[T](da: mutable darray[T]&, less: fn(T, T) -> bool, start: usize, end: usize):
    can Abort.Panic, Unsafe.UncheckedIndex:
        root: mutable usize = start
        trusted Unsafe.AssumeProgress:
            while true:
                child: usize = root * 2 + 1
                return if child >= end
                largest: mutable usize = root
                largest <- child if less(da[largest], da[child])
                largest <- child + 1 if child + 1 < end and less(da[largest], da[child + 1])
                return if largest == root
                tmp: T = da[root]
                da[root] <- da[largest]
                da[largest] <- tmp
                root <- largest

# Internal: heapsort of da[lo..hi), the introsort fallback when partitioning degenerates.
def darray_sift_down_at[T](da: mutable darray[T]&, less: fn(T, T) -> bool, base: usize, start: usize, end: usize):
    can Abort.Panic, Unsafe.UncheckedIndex:
        root: mutable usize = start
        trusted Unsafe.AssumeProgress:
            while true:
                child: usize = root * 2 + 1
                return if child >= end
                largest: mutable usize = root
                largest <- child if less(da[base + largest], da[base + child])
                largest <- child + 1 if child + 1 < end and less(da[base + largest], da[base + child + 1])
                return if largest == root
                tmp: T = da[base + root]
                da[base + root] <- da[base + largest]
                da[base + largest] <- tmp
                root <- largest

def darray_heapsort_range[T](da: mutable darray[T]&, less: fn(T, T) -> bool, lo: usize, hi: usize):
    can Abort.Panic, Unsafe.UncheckedIndex:
        n: usize = hi - lo
        return if n < 2
        i: mutable usize = n / 2
        trusted Unsafe.AssumeProgress:
            while i > 0:
                i <- i - 1
                darray_sift_down_at[T](da, less, lo, i, n)
        e: mutable usize = n
        trusted Unsafe.AssumeProgress:
            while e > 1:
                e <- e - 1
                tmp: T = da[lo]
                da[lo] <- da[lo + e]
                da[lo + e] <- tmp
                darray_sift_down_at[T](da, less, lo, 0, e)

# Internal: introsort of da[lo..hi) down to runs of at most 16 elements, which the final
# insertion pass in `sort` finishes. Median-of-three pivot; branchless Lomuto partition;
# recursion on the smaller side only, so the stack is O(log n); heapsort once `depth` runs
# out, so the worst case stays O(n log n).
def darray_introsort[T](da: mutable darray[T]&, less: fn(T, T) -> bool, lo0: usize, hi0: usize, depth0: u32):
    can Abort.Panic, Unsafe.UncheckedIndex:
        lo: mutable usize = lo0
        hi: mutable usize = hi0
        depth: mutable u32 = depth0
        trusted Unsafe.AssumeProgress:
            while hi - lo > 16:
                if depth == 0:
                    darray_heapsort_range[T](da, less, lo, hi)
                    return
                depth <- depth - 1
                mid: usize = lo + (hi - lo) / 2
                last: usize = hi - 1
                if less(da[mid], da[lo]):
                    t0: T = da[mid]
                    da[mid] <- da[lo]
                    da[lo] <- t0
                if less(da[last], da[mid]):
                    t1: T = da[mid]
                    da[mid] <- da[last]
                    da[last] <- t1
                    if less(da[mid], da[lo]):
                        t2: T = da[mid]
                        da[mid] <- da[lo]
                        da[lo] <- t2
                # Branchless Lomuto partition (pdqsort/ipnsort style): the pivot sits at lo,
                # every element is swapped with the store slot and the store index advances by
                # the comparison result, so there is no data-dependent branch to mispredict.
                pivot: T = da[mid]
                da[mid] <- da[lo]
                da[lo] <- pivot
                store: mutable usize = lo + 1
                k: mutable usize = lo + 1
                while k < hi:
                    v: T = da[k]
                    da[k] <- da[store]
                    da[store] <- v
                    store <- store + (1 if less(v, pivot) else 0)
                    k <- k + 1
                split: usize = store - 1
                da[lo] <- da[split]
                da[split] <- pivot
                # [lo, split) < pivot, da[split] == pivot, [split + 1, hi) >= pivot.
                right: mutable usize = split + 1
                if split == lo:
                    # Nothing was less than the pivot: gather the pivot's duplicates right after
                    # it and skip them, so runs of equal keys cannot degrade the partition.
                    k <- split + 1
                    while k < hi:
                        w: T = da[k]
                        da[k] <- da[right]
                        da[right] <- w
                        right <- right + (0 if less(pivot, w) else 1)
                        k <- k + 1
                if split - lo < hi - right:
                    darray_introsort[T](da, less, lo, split, depth)
                    lo <- right
                else:
                    darray_introsort[T](da, less, right, hi, depth)
                    hi <- split

# In-place sort ascending by `less` (std::sort): introsort -- quicksort with median-of-three
# pivots, heapsort past 2*log2(n) partition levels, insertion sort for the final short runs.
# O(n log n) worst case, no allocation, not stable. Measured on LangArena Sort::Self (400k i32):
# the previous plain heapsort was 6x Rust's slice::sort, cache misses in the sift-down.
def sort[T](da: mutable darray[T]&, less: fn(T, T) -> bool):
    can Abort.Panic, Unsafe.UncheckedIndex:
        n: usize = da.count
        return if n < 2
        depth: mutable u32 = 0
        m: mutable usize = n
        trusted Unsafe.AssumeProgress:
            while m > 1:
                m <- m / 2
                depth <- depth + 2
        darray_introsort[T](da, less, 0, n, depth)
        i: mutable usize = 1
        trusted Unsafe.AssumeProgress:
            while i < n:
                x: T = da[i]
                j: mutable usize = i
                while j > 0 and less(x, da[j - 1]):
                    da[j] <- da[j - 1]
                    j <- j - 1
                da[j] <- x
                i <- i + 1

# Reverse the elements in place (std::reverse).
def reverse[T](da: mutable darray[T]&):
    can Unsafe.UncheckedIndex:
        n: usize = da.count
        return if n < 2
        i: mutable usize = 0
        j: mutable usize = n - 1
        trusted Unsafe.AssumeProgress:
            while i < j:
                tmp: T = da[i]
                da[i] <- da[j]
                da[j] <- tmp
                i <- i + 1
                j <- j - 1

# True if no element compares `less` than its predecessor (std::is_sorted).
def is_sorted[T](da: darray[T], less: fn(T, T) -> bool) -> bool:
    can Unsafe.UncheckedIndex:
        i: mutable usize = 1
        trusted Unsafe.AssumeProgress:
            while i < da.count:
                return false if less(da[i], da[i - 1])
                i <- i + 1
        return true

# Smallest / largest element by `less`, or `null` if empty (std::min_element /
# std::max_element, returning the element rather than an iterator).
def min_element[T](da: darray[T], less: fn(T, T) -> bool) -> T?:
    can Unsafe.UncheckedIndex:
        return null if da.count == 0
        best: mutable T = da[0]
        i: mutable usize = 1
        trusted Unsafe.AssumeProgress:
            while i < da.count:
                best <- da[i] if less(da[i], best)
                i <- i + 1
        return best

def max_element[T](da: darray[T], less: fn(T, T) -> bool) -> T?:
    can Unsafe.UncheckedIndex:
        return null if da.count == 0
        best: mutable T = da[0]
        i: mutable usize = 1
        trusted Unsafe.AssumeProgress:
            while i < da.count:
                best <- da[i] if less(best, da[i])
                i <- i + 1
        return best

# Binary-search lookups over a range already sorted by the same `less`
# (std::lower_bound / std::binary_search). O(log n).
def lower_bound[T](da: darray[T], target: T, less: fn(T, T) -> bool) -> usize:
    can Unsafe.UncheckedIndex:
        lo: mutable usize = 0
        hi: mutable usize = da.count
        trusted Unsafe.AssumeProgress:
            while lo < hi:
                mid: usize = lo + (hi - lo) / 2
                mid_is_less: bool = less(da[mid], target)
                lo <- mid + 1 if mid_is_less
                hi <- mid if not mid_is_less
        return lo

def binary_search[T](da: darray[T], target: T, less: fn(T, T) -> bool) -> bool:
    idx: mutable usize = 0
    trusted Unsafe.UncheckedIndex:
        idx <- da.lower_bound(target, less)
    return false if idx >= da.count
    return not less(target, da[idx])

def arena_da_append_many[T](a: mutable Arena&, da: mutable darray[T, shape_in]&, new_items: T&, new_items_count: usize) -> mutable darray[T, shape_out]&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        needed: usize = arena_checked_add_usize(da.count, new_items_count) can Abort.Panic
        copy_bytes: usize = arena_checked_mul_usize(new_items_count, size_of(T)) can Abort.Panic

        if needed > da.capacity:
            new_capacity: mutable usize = da.capacity
            new_capacity <- ARENA_DA_INIT_CAP if new_capacity == 0

            trusted Unsafe.AssumeProgress:
                while needed > new_capacity:
                    doubled_capacity: usize = new_capacity * 2
                    if doubled_capacity < new_capacity:
                        # `needed` was checked before growth; use it if geometric growth wraps.
                        new_capacity <- needed
                        break
                    new_capacity <- doubled_capacity

            old_size: usize = arena_checked_mul_usize(da.capacity, size_of(T)) can Abort.Panic
            new_size: usize = arena_checked_mul_usize(new_capacity, size_of(T)) can Abort.Panic

            if da.items == null:
                da.items as & <- collections_items_from_alloc[T]((arena_alloc(a, new_size) can Global{Read,Write}, Atomics.Load))
            else:
                resized: heap void& = (arena_realloc(
                    a,
                    collections_mutable_void_from_items[T](da.items),
                    old_size,
                    new_size
                ) can Global{Read,Write}, Atomics.Load)
                da.items as & <- collections_items_from_alloc[T](resized)

            da.capacity <- new_capacity

        assert da.items != null

        arena_memcpy(
            collections_mutable_void_from_items_at[T](da.items, da.count),
            collections_void_from_items[T](new_items),
            copy_bytes
        )

        da.count <- needed
        return da

def arena_sb_append_buf(a: mutable Arena&, sb: mutable darray[u8, shape_in]&, buf: u8&, n: usize) -> mutable darray[u8, shape_out]&:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern}:
        return (arena_da_append_many(a, sb, buf, n) can Global{Read,Write}, Atomics.Load) can Memory.Allocate, Abort.Panic

def arena_sb_append_cstr(a: mutable Arena&, sb: mutable darray[u8, shape_in]&, cstr: u8&) -> mutable darray[u8, shape_out]&:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern}:
        n: usize = arena_strlen(cstr)
        return (arena_da_append_many(a, sb, cstr, n) can Global{Read,Write}, Atomics.Load) can Memory.Allocate, Abort.Panic

def arena_sb_append_null(a: mutable Arena&, sb: mutable darray[u8, shape_in]&) -> mutable darray[u8, shape_out]&:
    can Memory.Allocate, Abort.Panic:
        in a:
            return sb.extend([0.u8()])

# ------------------------------------------------------------
# Dictionary helpers
# ------------------------------------------------------------

def arena_dict_next_capacity(min_capacity: usize) -> usize:
    can Abort.Panic:
        return 0 if min_capacity == 0

        cap: mutable usize = DICT_INIT_CAP
        trusted Unsafe.AssumeProgress:
            while cap < min_capacity:
                cap <- arena_checked_mul_usize(cap, 2) can Abort.Panic
        return cap

# Key hashing for the open-addressing dict. The `ctx_hash_value` builtin (compiler-emitted)
# dispatches on the concrete key type after monomorphization: a cstr hashes its CONTENT via
# ctx_hash_cstr (FNV-1a), every fixed-size scalar key (integer/bool/char/const enum) is
# zero-extended to u64 and finalized by ctx_hash_u64 (splitmix64). Both are deterministic and
# defined here as plain functions the builtin lowers to.
def ctx_hash_cstr(s: cstr) -> u64:
    # FNV-1a over the string content (self-contained so collections.elisa needs no string
    # module). Matches hash_sview; deterministic and content-based (not pointer-based).
    h: mutable u64 = 0xcbf29ce484222325
    for ch in s[0:s.len]:
        h <- h ^ ch.u64()
        h <- h * 0x100000001b3
    return h

def ctx_hash_sview(view: sview) -> u64:
    ensure result == sview_fnv1a_model(view)
    can Unsafe.UncheckedIndex:
        h: mutable u64 = SVIEW_FNV1A_OFFSET_BASIS
        return h if view.len <= 0
        view_len: usize = view.len.usize()
        return h if view_len.i64() != view.len
        i: mutable usize = 0
        while i < view_len:
            decreases view_len - i
            invariant i <= view_len
            invariant i.i64().usize() == i
            invariant view_len == view.len.usize()
            invariant view_len.i64() == view.len
            invariant view.len > 0 and view.len.usize().i64() == view.len
            invariant i <= view.len.usize()
            invariant 0.usize() <= view.len.usize()
            invariant sview_fnv1a_fold_from(view, i, view_len - i, h) == sview_fnv1a_fold_from(view, 0.usize(), view_len, SVIEW_FNV1A_OFFSET_BASIS)
            h <- (h ^ view[i].u8().u64()) * SVIEW_FNV1A_PRIME
            i <- i + 1.usize()
        return h

def ctx_cstr_eq_sview(text: cstr, expected_length: i64, view: sview) -> bool:
    ensure (view.len < 0 or view.len.usize().i64() != view.len) implies result == false
    ensure expected_length != view.len implies result == false
    ensure result implies (view.len >= 0 and view.len.usize().i64() == view.len and expected_length == view.len)
    can Unsafe.UncheckedIndex:
        return false if view.len < 0
        len: usize = view.len.usize()
        return false if:
            len.i64() != view.len
            expected_length != view.len
        for i in 0..<len:
            view_byte: u8 = view[i].u8()
            text_byte: mutable u8 = 0
            # A CStr promises readable bytes through its first NUL. Stop there before any later
            # index, so this loop never reads beyond a shorter C string.
            trusted Unsafe.UncheckedIndex:
                text_byte <- text[i].u8()
            return false if text_byte == 0
            return false if text_byte != view_byte
        terminator: mutable u8 = 1
        # Every payload byte before `len` was checked nonzero above. Therefore index `len` is
        # either the CStr terminator or another readable payload byte, and a nonzero byte rejects
        # a string longer than the view.
        trusted Unsafe.UncheckedIndex:
            terminator <- text[len].u8()
        return false if terminator != 0
        return true

# Inverse for the SplitMix64 finalizer below. Every xor-shift is undone by its
# finite geometric series; the odd multipliers are units modulo 2^64.
const CTX_HASH_U64_INV_MUL_1: u64 = 0x96de1b173f119089
const CTX_HASH_U64_INV_MUL_2: u64 = 0x319642b2d24d8ec3

def ctx_unhash_xor_31(value: u64) -> u64:
    ensure result == (value ^ (value >> 31) ^ (value >> 62))
    ensure result ^ (result >> 31) == value
    first_shift: u64 = value >> 31
    second_shift: u64 = value >> 62
    candidate: u64 = value ^ first_shift ^ second_shift
    shifted_candidate: u64 = first_shift ^ second_shift
    assert first_shift >> 31 == second_shift
    assert second_shift >> 31 == 0
    assert candidate >> 31 == shifted_candidate
    assert candidate ^ shifted_candidate == value
    assert candidate ^ (candidate >> 31) == value
    assert candidate == (value ^ (value >> 31) ^ (value >> 62))
    return candidate

def ctx_unhash_xor_27(value: u64) -> u64:
    ensure result == (value ^ (value >> 27) ^ (value >> 54))
    ensure result ^ (result >> 27) == value
    first_shift: u64 = value >> 27
    second_shift: u64 = value >> 54
    candidate: u64 = value ^ first_shift ^ second_shift
    shifted_candidate: u64 = first_shift ^ second_shift
    assert first_shift >> 27 == second_shift
    assert second_shift >> 27 == 0
    assert candidate >> 27 == shifted_candidate
    assert candidate ^ shifted_candidate == value
    assert candidate ^ (candidate >> 27) == value
    assert candidate == (value ^ (value >> 27) ^ (value >> 54))
    return candidate

def ctx_unhash_xor_30(value: u64) -> u64:
    ensure result == (value ^ (value >> 30) ^ (value >> 60))
    ensure result ^ (result >> 30) == value
    first_shift: u64 = value >> 30
    second_shift: u64 = value >> 60
    candidate: u64 = value ^ first_shift ^ second_shift
    shifted_candidate: u64 = first_shift ^ second_shift
    assert first_shift >> 30 == second_shift
    assert second_shift >> 30 == 0
    assert candidate >> 30 == shifted_candidate
    assert candidate ^ shifted_candidate == value
    assert candidate ^ (candidate >> 30) == value
    assert candidate == (value ^ (value >> 30) ^ (value >> 60))
    return candidate

def ctx_unhash_mul_1(value: u64) -> u64:
    ensure result == value * CTX_HASH_U64_INV_MUL_1
    ensure result * 0xbf58476d1ce4e5b9 == value
    return value * CTX_HASH_U64_INV_MUL_1

def ctx_unhash_mul_2(value: u64) -> u64:
    ensure result == value * CTX_HASH_U64_INV_MUL_2
    ensure result * 0x94d049bb133111eb == value
    return value * CTX_HASH_U64_INV_MUL_2

def ctx_unhash_u64(hash: u64) -> u64:
    ensure result == ctx_unhash_xor_30(ctx_unhash_mul_1(ctx_unhash_xor_27(ctx_unhash_mul_2(ctx_unhash_xor_31(hash)))))
    return ctx_unhash_xor_30(ctx_unhash_mul_1(ctx_unhash_xor_27(ctx_unhash_mul_2(ctx_unhash_xor_31(hash)))))

def ctx_hash_u64(value: u64) -> u64:
    ensure ctx_unhash_u64(result) == value
    h: mutable u64 = value
    h <- (h ^ (h >> 30)) * 0xbf58476d1ce4e5b9
    ghost after_mul_1: u64 = h
    h <- (h ^ (h >> 27)) * 0x94d049bb133111eb
    ghost after_mul_2: u64 = h
    h <- h ^ (h >> 31)
    # Keep proof witnesses erased rather than running inverse helpers per hash.
    ghost hash_value: u64 = h
    ghost undo_xor_31: u64 = (hash_value ^ (hash_value >> 31) ^ (hash_value >> 62))
    assert undo_xor_31 == after_mul_2
    ghost undo_mul_2: u64 = undo_xor_31 * CTX_HASH_U64_INV_MUL_2
    assert undo_mul_2 == (after_mul_1 ^ (after_mul_1 >> 27))
    ghost undo_xor_27: u64 = (undo_mul_2 ^ (undo_mul_2 >> 27) ^ (undo_mul_2 >> 54))
    assert undo_xor_27 == after_mul_1
    ghost undo_mul_1: u64 = undo_xor_27 * CTX_HASH_U64_INV_MUL_1
    assert undo_mul_1 == (value ^ (value >> 30))
    ghost undo_xor_30: u64 = (undo_mul_1 ^ (undo_mul_1 >> 30) ^ (undo_mul_1 >> 60))
    assert undo_xor_30 == value
    assert ctx_unhash_u64(hash_value) == value
    return h

# Open-addressing probe (linear probing over a power-of-2 table). Returns found=true with the
# slot of the matching occupied entry, or found=false with the slot to insert at: the first
# tombstone seen (slot reuse), else the terminating empty slot. O(1) expected with load < 1/2.
def arena_dict_find_index[K, T](m: dict[K, T]&, key: K) -> DictProbeResult:
    ensure (m.capacity == 0 or m.items == null) implies (result.index == 0 and not result.found)
    ensure m.capacity > 0 implies result.index < m.capacity
    ensure result.found implies (m.capacity > 0 and m.items != null)
    return DictProbeResult{index: 0, found: false} if m.capacity == 0 or m.items == null

    assert m.items != null
    items: DictBucket[K, T]& = m.items
    mask: usize = m.capacity - 1
    slot: mutable usize = ctx_hash_value(key).usize() & mask
    insert_slot: mutable usize = m.capacity   # sentinel: no reusable slot seen yet
    for _ in 0..<m.capacity:
        invariant slot < m.capacity
        invariant insert_slot == m.capacity or insert_slot < m.capacity
        st: u8 = items[slot].state
        if st == 0:
            final_slot: usize = slot if insert_slot == m.capacity else insert_slot
            return DictProbeResult{index: final_slot, found: false}
        return DictProbeResult{index: slot, found: true} if st == 1 and items[slot].key == key
        insert_slot <- slot if st == 2 and insert_slot == m.capacity
        slot <- (slot + 1.usize()) & mask
    if insert_slot != m.capacity:
        assert insert_slot < m.capacity
        return DictProbeResult{index: insert_slot, found: false}
    return DictProbeResult{index: 0, found: false}

def arena_dict_find_cstr_view_index[T](m: dict[cstr, T]&, key: sview) -> DictProbeResult:
    ensure (m.capacity == 0 or m.items == null) implies (result.index == 0 and not result.found)
    ensure m.capacity > 0 implies result.index < m.capacity
    ensure result.found implies (m.capacity > 0 and m.items != null)
    can Unsafe.UncheckedIndex:
        return DictProbeResult{index: 0, found: false} if m.capacity == 0 or m.items == null

        assert m.items != null
        assert m.capacity > 0
        items: DictBucket[cstr, T]& = m.items
        capacity: usize = m.capacity
        start_slot: usize = ctx_hash_sview(key).usize() % capacity
        assert start_slot < capacity
        wrap_at: usize = capacity - start_slot
        for probe in 0..<capacity:
            slot: usize = start_slot + probe if probe < wrap_at else probe - wrap_at
            assert slot < capacity
            break if items[slot].state == COLLECTION_BUCKET_EMPTY
            if items[slot].state == COLLECTION_BUCKET_OCCUPIED:
                candidate_text: cstr = items[slot].key
                if ctx_cstr_eq_sview(candidate_text, key.len, key):
                    assert slot < m.capacity
                    return DictProbeResult{index: slot, found: true}
        # No matching key occurs before the first empty bucket, or across a full table.
        # On a second bounded pass, the first tombstone/empty bucket is a safe insertion slot.
        for probe in 0..<capacity:
            slot: usize = start_slot + probe if probe < wrap_at else probe - wrap_at
            assert slot < capacity
            if items[slot].state == COLLECTION_BUCKET_TOMBSTONE or items[slot].state == COLLECTION_BUCKET_EMPTY:
                return DictProbeResult{index: slot, found: false}
        return DictProbeResult{index: 0, found: false}

# Place (key, value) into a table that is known to have room and to not already contain `key`
# (used by rehash). The probe terminates at an empty slot since the fresh table has no tombstones.
def arena_dict_place_fresh[K, T](m: mutable dict[K, T]&, key: K, value: T) -> void:
    assert m.items != null
    items: mutable DictBucket[K, T]& = m.items
    probe: DictProbeResult = arena_dict_find_index(m, key)
    items[probe.index].key <- key
    items[probe.index].value <- value
    items[probe.index].state <- COLLECTION_BUCKET_OCCUPIED
    m.count <- m.count + 1.usize()
    m.used <- m.used + 1.usize()

def arena_dict_zero_buckets[K, T](items: mutable DictBucket[K, T]&, capacity: usize):
    return if capacity == 0
    can Abort.Panic:
        byte_count: usize = arena_checked_mul_usize(capacity, size_of(DictBucket[K, T]))
        trusted Unsafe.RawExtern:
            # Clear inactive storage without constructing an invalid live payload.
            # Readers inspect state first; insertion initializes before publishing occupied.
            memset(collections_mutable_void_from_items[DictBucket[K, T]](items), 0, byte_count)


def arena_dict_new[K, T](a: mutable Arena&, initial_capacity: usize) -> dict[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        out: mutable dict[K, T] = zeroed
        out.arena as & <- a

        capacity: usize = arena_dict_next_capacity(initial_capacity)
        return out if capacity == 0

        # The table lives on a stack of its own (collection_stack_acquire in arena.elisa),
        # not in the arena's bump chain, so growing it never strands the old table.
        table_bytes: usize = arena_checked_mul_usize(capacity, size_of(DictBucket[K, T])) can Abort.Panic
        table_stack: mutable heap Region& = (collection_stack_acquire(a, null, collections_table_slots(table_bytes)) can Global{Read,Write}, Atomics.Load)
        items: mutable DictBucket[K, T]& = collections_items_from_alloc[DictBucket[K, T]](collection_stack_table(table_stack))
        arena_dict_zero_buckets(items, capacity)

        out.items as & <- items
        out.capacity <- capacity
        return out

def arena_dict_reserve[K, T](a: mutable Arena&, m: mutable dict[K, T]&, min_capacity: usize) -> void error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        target_capacity: usize = arena_dict_next_capacity(min_capacity)
        return if:
            target_capacity == 0

            target_capacity <= m.capacity

        # A table this module placed sits at its stack's data base and is handed back so
        # the stack becomes the new table's spare. A const dict's static buckets have no
        # arena; they are foreign, only ever READ from during the rehash below.
        had_stack: bool = m.arena != null and m.items != null and m.capacity > 0

        owner: mutable Arena& = m.arena if m.arena != null else a
        m.arena as & <- owner if m.arena == null

        old_items_opt: mutable DictBucket[K, T]&? = m.items
        old_capacity: usize = m.capacity

        live_table: void&? = collections_void_from_items_opt[DictBucket[K, T]](old_items_opt) if had_stack else null
        # Ping-pong: the spare stack (or a pooled/fresh one) takes the new table; the old
        # table's stack becomes the spare. Reused storage still holds the dead table, so
        # the buckets are zeroed here as before.
        table_bytes: usize = arena_checked_mul_usize(target_capacity, size_of(DictBucket[K, T])) can Abort.Panic
        table_stack: mutable heap Region& = (collection_stack_acquire(owner, live_table, collections_table_slots(table_bytes)) can Global{Read,Write}, Atomics.Load)
        new_items: mutable DictBucket[K, T]& = collections_items_from_alloc[DictBucket[K, T]](collection_stack_table(table_stack))
        arena_dict_zero_buckets(new_items, target_capacity)

        # Rehash through a distinct dictionary value so reads from the old
        # backing and writes to the new backing are visibly disjoint.
        rehash: mutable dict[K, T] = zeroed
        rehash.arena as & <- owner
        rehash.items as & <- new_items
        rehash.capacity <- target_capacity

        if old_items_opt != null and old_capacity > 0:
            old_items: mutable DictBucket[K, T]& = old_items_opt
            for i in 0..<old_capacity:
                arena_dict_place_fresh(rehash, old_items[i].key, old_items[i].value) if old_items[i].state == COLLECTION_BUCKET_OCCUPIED

        m.items as & <- rehash.items
        (collection_stack_profile_release(owner, live_table) can Global{Read,Write})
        m.capacity <- rehash.capacity
        m.count <- rehash.count
        m.used <- rehash.used
        return

def arena_dict_get[K, T](m: dict[K, T]&, key: K) -> T&?:
	return null if m.count == 0 or m.items == null

	probe: DictProbeResult = arena_dict_find_index(m, key)
	return null if not probe.found

	assert m.items != null
	items: DictBucket[K, T]& = m.items
	return &items[probe.index].value

def arena_dict_get_cstr_view[T](m: dict[cstr, T]&, key: sview) -> T&?:
 can Unsafe.UncheckedIndex:
    	return null if m.count == 0 or m.items == null

    	probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    	return null if not probe.found

    	assert m.items != null
    	items: DictBucket[cstr, T]& = m.items
    	return &items[probe.index].value

@internal
def arena_dict_get_mut[K, T](m: mutable dict[K, T]&, key: K) -> mutable T&?:
	return null if m.count == 0 or m.items == null

	probe: DictProbeResult = arena_dict_find_index(m, key)
	return null if not probe.found

	assert m.items != null
	items: mutable DictBucket[K, T]& = m.items
	return &items[probe.index].value

@internal
def arena_dict_get_cstr_view_mut[T](m: mutable dict[cstr, T]&, key: sview) -> mutable T&?:
 can Unsafe.UncheckedIndex:
    	return null if m.count == 0 or m.items == null

    	probe: DictProbeResult = arena_dict_find_cstr_view_index(m, key)
    	return null if not probe.found

    	assert m.items != null
    	items: mutable DictBucket[cstr, T]& = m.items
    	return &items[probe.index].value

def arena_dict_get[K, T](m: mutable dict[K, T]&, key: K) -> mutable T&?:
	return arena_dict_get_mut(m, key)

def arena_dict_put[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> mutable T&? error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        owner: mutable Arena& = m.arena if m.arena != null else a
        m.arena as & <- owner if m.arena == null

        # When the next used slot (including tombstones) would cross 1/2 load (speed over memory: short linear-probe chains), probe first:
        # update an existing key in place, or grow and clear tombstones before inserting a
        # missing key. Non-growth inserts pay only for the ordinary probe below.
        if m.capacity == 0:
            target_capacity: usize = DICT_INIT_CAP
            try (arena_dict_reserve(owner, m, target_capacity) can Global{Read,Write}, Atomics.Load)
        elif m.used >= m.capacity / 2.usize():
            growth_probe: DictProbeResult = arena_dict_find_index(m, key)
            if growth_probe.found:
                assert m.items != null
                growth_items: mutable DictBucket[K, T]& = m.items
                growth_items[growth_probe.index].value <- value
                return &growth_items[growth_probe.index].value
            # Reusing a tombstone does not increase `used`, so the table remains at
            # its current non-empty load. Avoid a rehash when this key's probe path
            # already found a reusable deleted slot.
            if m.items != null and growth_probe.index < m.capacity:
                tombstone_items: mutable DictBucket[K, T]& = m.items
                if tombstone_items[growth_probe.index].state == COLLECTION_BUCKET_TOMBSTONE:
                    tombstone_items[growth_probe.index].key <- key
                    tombstone_items[growth_probe.index].value <- value
                    tombstone_items[growth_probe.index].state <- COLLECTION_BUCKET_OCCUPIED
                    m.count <- m.count + 1.usize()
                    return &tombstone_items[growth_probe.index].value
            target_capacity: usize = arena_checked_mul_usize(m.capacity, 2) can Abort.Panic
            try (arena_dict_reserve(owner, m, target_capacity) can Global{Read,Write}, Atomics.Load)

        assert m.items != null
        assert m.capacity > 0

        items: mutable DictBucket[K, T]& = m.items
        probe: DictProbeResult = arena_dict_find_index(m, key)
        if probe.found:
            items[probe.index].value <- value
            return &items[probe.index].value

        reused_tombstone: bool = items[probe.index].state == COLLECTION_BUCKET_TOMBSTONE
        items[probe.index].key <- key
        items[probe.index].value <- value
        items[probe.index].state <- COLLECTION_BUCKET_OCCUPIED
        m.count <- m.count + 1.usize()
        m.used <- m.used + 1.usize() if not reused_tombstone
        return &items[probe.index].value

def arena_dict_get_or_insert[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> mutable T&? error[RuntimeError]:
    existing: mutable T&? = arena_dict_get_mut(m, key) can Abort.Panic, Unsafe.UncheckedIndex
    return existing if existing != null
    return try (arena_dict_put(a, m, key, value) can Global{Read,Write}, Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex})

# Non-error wrappers used by the dict-entry codegen ABI (`d.entry(k).insert(v)`
# / `.get_or_insert(v)`). The entry ops run under `can Abort.Panic`, so a growth
# OOM surfaces as null rather than an error-union the hand-rolled call site would
# have to thread. These keep the codegen call shape simple: a plain nullable
# value ref (`mutable T&?` -> nullable ptr), no sret/error-tag ABI.
def arena_dict_put_checked[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> T&?:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return try (arena_dict_put(a, m, key, value) can Global{Read,Write}, Atomics.Load) else null

def arena_dict_get_or_insert_checked[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> T&?:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return try (arena_dict_get_or_insert(a, m, key, value) can Global{Read,Write}, Atomics.Load) else null

def arena_dict_reserve_checked[K, T](a: mutable Arena&, m: mutable dict[K, T]&, min_capacity: usize) -> void:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_dict_reserve(a, m, min_capacity) can Global{Read,Write}, Atomics.Load):
            ok:
                return
            error e:
                return

# Panic-on-failure wrappers: the frictionless default surface for `d.put`/`.get_or_insert`/
# `.reserve` (dict parity with darray push). darray push panics on allocation failure and
# surfaces no error union; these give dict the same shape. A growth OOM is unrecoverable in
# the common in-region case, so it aborts rather than forcing every call site to thread an
# error union. These are invoked only from the backend's synthetic `dict.put`/`.get_or_insert`/
# `.reserve` lowering (dictMutationHelperName), which carries no effect of its own — exactly
# like darray push — so `d.put(k, v)` needs no `can` grant. Callers who want to RECOVER from
# OOM use the error-returning arena_dict_put directly.
def arena_dict_put_or_panic[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> T&?:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_dict_put(a, m, key, value) can Global{Read,Write}, Atomics.Load):
            slot:
                return slot
            error e:
                panic("dict put: allocation failed")

def arena_dict_get_or_insert_or_panic[K, T](a: mutable Arena&, m: mutable dict[K, T]&, key: K, value: T) -> T&?:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_dict_get_or_insert(a, m, key, value) can Global{Read,Write}, Atomics.Load):
            slot:
                return slot
            error e:
                panic("dict get_or_insert: allocation failed")

def arena_dict_reserve_or_panic[K, T](a: mutable Arena&, m: mutable dict[K, T]&, min_capacity: usize) -> void:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_dict_reserve(a, m, min_capacity) can Global{Read,Write}, Atomics.Load):
            ok:
                return
            error e:
                panic("dict reserve: allocation failed")

def arena_dict_contains[K, T](m: dict[K, T]&, key: K) -> bool:
    return arena_dict_get(m, key) != null

def arena_dict_remove[K, T](m: mutable dict[K, T]&, key: K) -> bool:
    can Unsafe.Alias:
        return false if m.count == 0 or m.items == null

        probe: DictProbeResult = arena_dict_find_index(m, key)
        return false if not probe.found

        assert m.items != null
        items: mutable DictBucket[K, T]& = m.items
        # Tombstone the slot (state 2): it stays non-empty so probes for entries that collided past
        # it still reach them. `used` is unchanged; the slot is reclaimed on the next rehash.
        trusted Unsafe.RawExtern:
            # The tombstone state prevents readers from observing this inactive payload.
            memset(collections_mutable_void_from_items[DictBucket[K, T]](&items[probe.index]), 0, size_of(DictBucket[K, T]))
        items[probe.index].state <- COLLECTION_BUCKET_TOMBSTONE
        m.count <- m.count - 1.usize()
        return true

def arena_dict_clear[K, T](m: mutable dict[K, T]&):
    if m.items == null or m.capacity == 0:
        m.count <- 0
        m.used <- 0
        return

    assert m.items != null
    items: mutable DictBucket[K, T]& = m.items
    arena_dict_zero_buckets(items, m.capacity) can Abort.Panic
    m.count <- 0
    m.used <- 0

def arena_dict_new__i64(a: mutable Arena&, initial_capacity: usize) -> dict[cstr[key_shape], i64]:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (arena_dict_new[cstr[key_shape], i64](a, initial_capacity) can Global{Read,Write}, Atomics.Load) can Memory.Allocate, Abort.Panic

def arena_dict_reserve__i64(a: mutable Arena&, m: mutable dict[cstr[key_shape], i64]&, min_capacity: usize) -> void error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        try (arena_dict_reserve[cstr[key_shape], i64](a, m, min_capacity) can Global{Read,Write}, Atomics.Load)

def arena_dict_get__i64(m: dict[cstr[key_shape], i64]&, key: cstr[key_shape]) -> i64&?:
	return arena_dict_get[cstr[key_shape], i64](m, key)

def arena_dict_get_mut__i64(m: mutable dict[cstr[key_shape], i64]&, key: cstr[key_shape]) -> mutable i64&?:
	return arena_dict_get_mut[cstr[key_shape], i64](m, key)

def arena_dict_put__i64(a: mutable Arena&, m: mutable dict[cstr[key_shape], i64]&, key: cstr[key_shape], value: i64) -> mutable i64&? error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return try (arena_dict_put[cstr[key_shape], i64](a, m, key, value) can Global{Read,Write}, Atomics.Load)

def arena_dict_get_or_insert__i64(a: mutable Arena&, m: mutable dict[cstr[key_shape], i64]&, key: cstr[key_shape], value: i64) -> mutable i64&? error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return try (arena_dict_get_or_insert[cstr[key_shape], i64](a, m, key, value) can Global{Read,Write}, Atomics.Load)

def arena_dict_contains__i64(m: dict[cstr[key_shape], i64]&, key: cstr[key_shape]) -> bool:
    return arena_dict_contains[cstr[key_shape], i64](m, key)

def arena_dict_remove__i64(m: mutable dict[cstr[key_shape], i64]&, key: cstr[key_shape]) -> bool:
    can Unsafe.Alias:
        return arena_dict_remove[cstr[key_shape], i64](m, key)

def arena_dict_clear__i64(m: mutable dict[cstr[key_shape], i64]&):
    arena_dict_clear[cstr[key_shape], i64](m)


# ------------------------------------------------------------
# Set helpers
# ------------------------------------------------------------

def arena_set_find_index[T](s: set[T]&, key: T) -> DictProbeResult:
    ensure (s.capacity == 0 or s.items == null) implies (result.index == 0 and not result.found)
    ensure s.capacity > 0 implies result.index < s.capacity
    ensure result.found implies (s.capacity > 0 and s.items != null)
    return DictProbeResult{index: 0, found: false} if s.capacity == 0 or s.items == null

    assert s.items != null
    items: SetBucket[T]& = s.items
    mask: usize = s.capacity - 1
    slot: mutable usize = ctx_hash_value(key).usize() & mask
    insert_slot: mutable usize = s.capacity
    for _ in 0..<s.capacity:
        invariant slot < s.capacity
        invariant insert_slot == s.capacity or insert_slot < s.capacity
        st: u8 = items[slot].state
        if st == 0:
            final_slot: usize = slot if insert_slot == s.capacity else insert_slot
            return DictProbeResult{index: final_slot, found: false}
        return DictProbeResult{index: slot, found: true} if st == 1 and items[slot].key == key
        insert_slot <- slot if st == 2 and insert_slot == s.capacity
        slot <- (slot + 1.usize()) & mask
    if insert_slot != s.capacity:
        assert insert_slot < s.capacity
        return DictProbeResult{index: insert_slot, found: false}
    return DictProbeResult{index: 0, found: false}

def arena_set_place_fresh[T](s: mutable set[T]&, key: T) -> void:
    assert s.items != null
    items: mutable SetBucket[T]& = s.items
    probe: DictProbeResult = arena_set_find_index(s, key)
    items[probe.index].key <- key
    items[probe.index].state <- COLLECTION_BUCKET_OCCUPIED
    s.count <- s.count + 1.usize()
    s.used <- s.used + 1.usize()

def arena_set_zero_buckets[T](items: mutable SetBucket[T]&, capacity: usize):
    return if capacity == 0
    can Abort.Panic:
        byte_count: usize = arena_checked_mul_usize(capacity, size_of(SetBucket[T]))
        trusted Unsafe.RawExtern:
            # Clear inactive storage without constructing an invalid live payload.
            # Readers inspect state first; insertion initializes before publishing occupied.
            memset(collections_mutable_void_from_items[SetBucket[T]](items), 0, byte_count)


def arena_set_new[T](a: mutable Arena&, initial_capacity: usize) -> set[T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        out: mutable set[T] = zeroed
        out.arena as & <- a

        capacity: usize = arena_dict_next_capacity(initial_capacity)
        return out if capacity == 0

        # Same as arena_dict_new: the table is on a collection stack of its own.
        table_bytes: usize = arena_checked_mul_usize(capacity, size_of(SetBucket[T])) can Abort.Panic
        table_stack: mutable heap Region& = (collection_stack_acquire(a, null, collections_table_slots(table_bytes)) can Global{Read,Write}, Atomics.Load)
        items: mutable SetBucket[T]& = collections_items_from_alloc[SetBucket[T]](collection_stack_table(table_stack))
        arena_set_zero_buckets(items, capacity)

        out.items as & <- items
        out.capacity <- capacity
        return out

def arena_set_reserve[T](a: mutable Arena&, s: mutable set[T]&, min_capacity: usize) -> void error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        target_capacity: usize = arena_dict_next_capacity(min_capacity)
        return if:
            target_capacity == 0

            target_capacity <= s.capacity

        # Same shape as arena_dict_reserve: see the comments there.
        had_stack: bool = s.arena != null and s.items != null and s.capacity > 0

        owner: mutable Arena& = s.arena if s.arena != null else a
        s.arena as & <- owner if s.arena == null

        old_items_opt: mutable SetBucket[T]&? = s.items
        old_capacity: usize = s.capacity

        live_table: void&? = collections_void_from_items_opt[SetBucket[T]](old_items_opt) if had_stack else null
        table_bytes: usize = arena_checked_mul_usize(target_capacity, size_of(SetBucket[T])) can Abort.Panic
        table_stack: mutable heap Region& = (collection_stack_acquire(owner, live_table, collections_table_slots(table_bytes)) can Global{Read,Write}, Atomics.Load)
        new_items: mutable SetBucket[T]& = collections_items_from_alloc[SetBucket[T]](collection_stack_table(table_stack))
        arena_set_zero_buckets(new_items, target_capacity)

        # Rehash through a separate set value. This keeps the old backing read
        # through `s` and the fresh backing mutated through `rehash`, so no
        # mutable-alias capability escapes from this safe collection helper.
        rehash: mutable set[T] = zeroed
        rehash.arena as & <- owner
        rehash.items as & <- new_items
        rehash.capacity <- target_capacity

        if old_items_opt != null and old_capacity > 0:
            old_items: mutable SetBucket[T]& = old_items_opt
            for i in 0..<old_capacity:
                arena_set_place_fresh(rehash, old_items[i].key) if old_items[i].state == COLLECTION_BUCKET_OCCUPIED

        s.items as & <- rehash.items
        (collection_stack_profile_release(owner, live_table) can Global{Read,Write})
        s.capacity <- rehash.capacity
        s.count <- rehash.count
        s.used <- rehash.used
        return

def arena_set_add[T](a: mutable Arena&, s: mutable set[T]&, key: T) -> bool error[RuntimeError]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        owner: mutable Arena& = s.arena if s.arena != null else a
        s.arena as & <- owner if s.arena == null

        # When the next used slot (including tombstones) would cross 1/2 load (speed over memory: short linear-probe chains), probe first:
        # return false for an existing key, or grow and clear tombstones before inserting a
        # missing key. Non-growth adds pay only for the ordinary probe below.
        if s.capacity == 0:
            target_capacity: usize = DICT_INIT_CAP
            try (arena_set_reserve(owner, s, target_capacity) can Global{Read,Write}, Atomics.Load)
        elif s.used >= s.capacity / 2.usize():
            growth_probe: DictProbeResult = arena_set_find_index(s, key)
            return false if growth_probe.found
            # A tombstone is already included in `used`; replacing it leaves that
            # load unchanged and does not need a larger table or a rehash.
            if s.items != null and growth_probe.index < s.capacity:
                tombstone_items: mutable SetBucket[T]& = s.items
                if tombstone_items[growth_probe.index].state == COLLECTION_BUCKET_TOMBSTONE:
                    tombstone_items[growth_probe.index].key <- key
                    tombstone_items[growth_probe.index].state <- COLLECTION_BUCKET_OCCUPIED
                    s.count <- s.count + 1.usize()
                    return true
            target_capacity: usize = arena_checked_mul_usize(s.capacity, 2) can Abort.Panic
            try (arena_set_reserve(owner, s, target_capacity) can Global{Read,Write}, Atomics.Load)

        assert s.items != null
        assert s.capacity > 0

        items: mutable SetBucket[T]& = s.items
        probe: DictProbeResult = arena_set_find_index(s, key)
        return false if probe.found

        reused_tombstone: bool = items[probe.index].state == COLLECTION_BUCKET_TOMBSTONE
        items[probe.index].key <- key
        items[probe.index].state <- COLLECTION_BUCKET_OCCUPIED
        s.count <- s.count + 1.usize()
        s.used <- s.used + 1.usize() if not reused_tombstone
        return true

def arena_set_add_or_panic[T](a: mutable Arena&, s: mutable set[T]&, key: T) -> bool:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_set_add(a, s, key) can Global{Read,Write}, Atomics.Load):
            inserted:
                return inserted
            error e:
                panic("set add: allocation failed")

def arena_set_reserve_or_panic[T](a: mutable Arena&, s: mutable set[T]&, min_capacity: usize) -> void:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        catch (arena_set_reserve(a, s, min_capacity) can Global{Read,Write}, Atomics.Load):
            ok:
                return
            error e:
                panic("set reserve: allocation failed")

def arena_set_contains[T](s: set[T]&, key: T) -> bool:
    return false if s.count == 0 or s.items == null
    probe: DictProbeResult = arena_set_find_index(s, key)
    return probe.found

def contains[T](s: set[T]&, key: T) -> bool:
    return arena_set_contains[T](s, key)

def has[T](s: set[T]&, key: T) -> bool:
    return arena_set_contains[T](s, key)

def arena_set_remove[T](s: mutable set[T]&, key: T) -> bool:
    can Unsafe.Alias:
        return false if s.count == 0 or s.items == null

        probe: DictProbeResult = arena_set_find_index(s, key)
        return false if not probe.found

        assert s.items != null
        items: mutable SetBucket[T]& = s.items
        trusted Unsafe.RawExtern:
            # The tombstone state prevents readers from observing this inactive payload.
            memset(collections_mutable_void_from_items[SetBucket[T]](&items[probe.index]), 0, size_of(SetBucket[T]))
        items[probe.index].state <- COLLECTION_BUCKET_TOMBSTONE
        s.count <- s.count - 1.usize()
        return true

def remove[T](s: mutable set[T]&, key: T) -> bool:
    can Unsafe.Alias:
        return arena_set_remove[T](s, key)

def arena_set_clear[T](s: mutable set[T]&):
    if s.items == null or s.capacity == 0:
        s.count <- 0
        s.used <- 0
        return

    assert s.items != null
    items: mutable SetBucket[T]& = s.items
    arena_set_zero_buckets(items, s.capacity) can Abort.Panic
    s.count <- 0
    s.used <- 0

def clear[T](s: mutable set[T]&):
    arena_set_clear[T](s)


# ------------------------------------------------------------
# Ordered index maps
# ------------------------------------------------------------

def index_map[K, T](owner: mutable Arena&, initial_capacity: usize) -> IndexMap[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        map: mutable IndexMap[K, T] = zeroed
        map.owner as & <- owner
        map.by_key <- (arena_dict_new[K, usize](owner, initial_capacity) can Global{Read,Write}, Atomics.Load)
        in owner:
            _ = map.entries.reserve(initial_capacity)
        return map


def index_map_new[K, T](owner: mutable Arena&) -> IndexMap[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (index_map[K, T](owner, 32) can Global{Read,Write}, Atomics.Load)


def new[K, T](api: IndexMapNamespace, owner: mutable Arena&) -> IndexMap[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        _ = api
        return (index_map_new[K, T](owner) can Global{Read,Write}, Atomics.Load)


def index_map_with_capacity[K, T](owner: mutable Arena&, initial_capacity: usize) -> IndexMap[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (index_map[K, T](owner, initial_capacity) can Global{Read,Write}, Atomics.Load)


def with_capacity[K, T](api: IndexMapNamespace, owner: mutable Arena&, initial_capacity: usize) -> IndexMap[K, T]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        _ = api
        return (index_map_with_capacity[K, T](owner, initial_capacity) can Global{Read,Write}, Atomics.Load)


def index_map_count[K, T](map: IndexMap[K, T]&) -> usize:
    return map.entries.count


def count[K, T](map: IndexMap[K, T]&) -> usize:
    return index_map_count[K, T](map)


def index_map_valid_index[K, T](map: IndexMap[K, T]&, index: usize) -> bool:
    return index < map.entries.count


def index_map_find_index[K, T](map: IndexMap[K, T]&, key: K) -> usize?:
	found: usize&? = arena_dict_get[K, usize](map.by_key, key)
    return null if found == null
    trusted Unsafe.UncheckedIndex:
        return found[0]


def index_map_contains[K, T](map: IndexMap[K, T]&, key: K) -> bool:
    return index_map_find_index[K, T](map, key) != null


def index_map_entry[K, T](map: IndexMap[K, T]&, index: usize) -> IndexMapEntry[K, T]:
    assert index < map.entries.count
    return map.entries[index]


def index_map_value[K, T](map: IndexMap[K, T]&, index: usize) -> T:
    return index_map_entry[K, T](map, index).value


def index_map_entries[K, T](map: IndexMap[K, T]&) -> view[IndexMapEntry[K, T]]:
    return map.entries.view()


def entry[K, T](map: IndexMap[K, T]&, index: usize) -> IndexMapEntry[K, T]:
    return index_map_entry[K, T](map, index)


def value[K, T](map: IndexMap[K, T]&, index: usize) -> T:
    return index_map_value[K, T](map, index)


def entry_view[K, T](map: IndexMap[K, T]&) -> view[IndexMapEntry[K, T]]:
    return index_map_entries[K, T](map)


def index_map_put[K, T](map: mutable IndexMap[K, T]&, key: K, value: T) -> usize:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        match index_map_find_index[K, T](map, key):
            null:
                pass
            existing_index:
                assert existing_index < map.entries.count
                map.entries[existing_index].value <- value
                return existing_index

        assert map.owner != null
        owner: mutable Arena& = map.owner
        index: usize = map.entries.count
        in owner:
            map.entries.push(IndexMapEntry[K, T]{key: key, value: value})
        catch (arena_dict_put[K, usize](owner, map.by_key, key, index) can Global{Read,Write}, Atomics.Load):
            inserted:
                return index
            error e:
                map.entries.count <- index
                panic("index map put: allocation failed")
        return index


def put[K, T](map: mutable IndexMap[K, T]&, key: K, value: T) -> usize:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (index_map_put[K, T](map, key, value) can Global{Read,Write}, Atomics.Load)


def index_map_set[K, T](map: mutable IndexMap[K, T]&, key: K, value: T) -> usize:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (index_map_put[K, T](map, key, value) can Global{Read,Write}, Atomics.Load)


def set[K, T](map: mutable IndexMap[K, T]&, key: K, value: T) -> usize:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return (index_map_set[K, T](map, key, value) can Global{Read,Write}, Atomics.Load)


def index_map_get[K, T](map: IndexMap[K, T]&, key: K) -> T?:
    index: usize = get index_map_find_index[K, T](map, key)
    value: T = index_map_value[K, T](map, index)
    return value


def get[K, T](map: IndexMap[K, T]&, key: K) -> T?:
    return index_map_get[K, T](map, key)


def index_map_has[K, T](map: IndexMap[K, T]&, key: K) -> bool:
    return index_map_contains[K, T](map, key)


def has[K, T](map: IndexMap[K, T]&, key: K) -> bool:
    return index_map_has[K, T](map, key)


def update_at[K, T](map: mutable IndexMap[K, T]&, index: usize, value: T) -> bool:
    return false if not index_map_valid_index[K, T](map, index)
    assert index < map.entries.count
    map.entries[index].value <- value
    return true


def clear[K, T](map: mutable IndexMap[K, T]&):
    map.entries.count <- 0
    arena_dict_clear[K, usize](map.by_key)


# ------------------------------------------------------------
# Symbol tables
# ------------------------------------------------------------

def symbol_table_index(symbol_id: SymbolTableId) -> usize:
    assert symbol_id != SYMBOL_TABLE_INVALID_ID
    return (!symbol_id).usize() - 1


def symbol_table_id_from_index(index: usize) -> SymbolTableId:
    return (index + 1).u32().SymbolTableId()


# --- Store / Handle unification (docs/69) -----------------------------------
# `Store` is the shared surface over every handle-into-store container: a handle
# resolves to an element, and the store has a size. darray is the first backing
# (Handle = usize index); dict/pool/packed stores implement the same interface
# with their own Handle representations. Layout/provenance/usage stay orthogonal:
# the core surface is read + size only and says nothing about growth or ownership.
protocol Store:
    type Elem
    type Handle
    # A total handle lookup can reject an out-of-range handle by panicking.
    def store_get(s: Self&, h: Handle) -> Elem& can[Abort.Panic]
    def store_count(s: Self&) -> usize

impl[T] Store for darray[T]:
    type Elem = T
    type Handle = usize
    def store_get(s: darray[T]&, h: usize) -> T&:
        if h >= s.count:
            can Abort.Panic:
                panic("store_get: handle out of bounds")
        trusted Unsafe.UncheckedIndex:
            return s[h]
    def store_count(s: darray[T]&) -> usize:
        return s.count

# Deque is a second Store backing: a ring buffer rather than a contiguous darray, yet the
# same surface — a usize handle resolves to an element and there's a count. arena_deque_at
# maps the logical handle through the ring's head/wrap. (Deque comes from the include above.)
impl[T] Store for Deque[T]:
    type Elem = T
    type Handle = usize
    def store_get(s: Deque[T]&, h: usize) -> T&:
        can Abort.Panic:
            return arena_deque_at(s, h)
    def store_count(s: Deque[T]&) -> usize:
        return arena_deque_len(s)


# --- KeyedStore: the partial-lookup sub-protocol (docs/69) ----------------------
# Some stores are addressed by a KEY that may or may not be present, so their lookup is
# partial: `store_find` returns an optional element rather than the total `store_get`. This
# is the orthogonality the core Store preserves — dict is keyed/partial, not a total
# handle→element store, so it implements KeyedStore instead of distorting the core.
protocol KeyedStore:
    type Key
    type Elem
    def store_find(s: Self&, k: Key) -> Elem&?
    def store_count(s: Self&) -> usize

impl[K, T] KeyedStore for dict[K, T]:
    type Key = K
    type Elem = T
    def store_find(s: dict[K, T]&, k: K) -> T&?:
        return arena_dict_get(s, k)
    def store_count(s: dict[K, T]&) -> usize:
        return s.count
