# Correctly rounded decimal -> f64 parsing (what Go strconv.ParseFloat(s, 64) and Rust
# str::parse::<f64> return), without libc strtod or its locale lock.
#
#   f64_parse(text: sview) -> F64Parse          whole-string parse
#   f64_parse_prefix(text, start) -> F64Parse   longest valid prefix from `start`
#
# Accepted: [+-] digits [. digits] [(e|E) [+-] digits], or [+-] inf / infinity / nan (any
# case). Out-of-range values give +-inf or +-0 (ok stays true), like Go's value.
#
# Three tiers: Clinger's exact path (<= 2^53 mantissa, |exp10| <= 22, one IEEE operation);
# Eisel-Lemire (D. Lemire, "Number Parsing at a Gigabyte per Second", 2021) over the first 19
# significant digits with a 128-bit table of 10^e; and, when Eisel-Lemire cannot decide (or
# more than 19 digits do not settle it), an exact big-integer quotient with round-half-even.
include "elisacore_bigint.elisa"

@intrinsic("elisa.mul_hi.u64")
extern f64_parse_mul_hi(a: u64, b: u64) -> u64

@intrinsic("elisa.f64_from_bits")
extern f64_parse_from_bits(bits: u64) -> f64

struct F64Parse:
    ok: bool        # false: no number at `start` (value is 0)
    value: f64
    end: usize      # index just past the parsed text

# Scan result: value = mantissa * 10^exp10 when not truncated.
struct F64Scan:
    ok: bool
    negative: bool
    mantissa: u64        # first 19 significant digits
    exp10: i64
    truncated: bool      # nonzero significant digits past the 19th
    digits_start: usize  # first digit character (for the exact fallback)
    digits_end: usize    # end of the digits (and '.') run
    point: i64           # decimal exponent of the whole digit string: value = 0.D * 10^point
    end: usize
    special: u8          # 0 number, 1 inf, 2 nan

# 10^0 .. 10^22, all exact in binary64 (Clinger's fast path).
const ELISA_F64_PARSE_EXACT_POW10: f64[23] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]

const F64_PARSE_MIN_EXP10: i64 = -348
const F64_PARSE_MAX_EXP10: i64 = 347

# Three words per power (u64 constants must be below 2^63 here): hi without its top bit
# (always set), lo >> 1, lo & 1.
