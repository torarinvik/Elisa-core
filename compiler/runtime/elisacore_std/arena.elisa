# ============================================================
# Arena allocator - Elisa core runtime dialect
# ============================================================

include "./profiler_hooks.elisa"
include "./elisacore_runtime_atomics.elisa"

const ARENA_BACKEND_LIBC_MALLOC = 0
const ARENA_BACKEND_LINUX_MMAP = 1
const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2
const ARENA_BACKEND_WASM_HEAPBASE = 3

# Bootstrap compatibility: older stage0 binaries do not predefine the WASM target row.
# Stage1 registers the same name with the actual target value before folding static branches;
# stage0 sees this conservative false value and keeps compiling the host stdlib.
const ELISA_TARGET_OS_WASM: bool = false

# Allocation-hook negotiation is fixed for ABI v1, so cache its supported /
# unsupported result once per process. Keep this state in the arena layer: the
# profiler declarations are also included by the runtime prelude, which does not
# include the atomics module. WASI sets POSIX for its runtime ABI, but this
# WebAssembly target is single-threaded and must use the ordinary access path.
global mutable __elisa_profile_allocation_status_cell: AtomicCell[i32] = zeroed
global mutable __elisa_profile_allocation_lock_cell: AtomicCell[i32] = zeroed

@internal
def arena_profile_allocation_status_load() -> i32:
    result: mutable i32 = 0
    static if ELISA_TARGET_OS_WASM:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                result <- __elisa_profile_allocation_status_cell.slot.value
    static elif ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_acquire(&__elisa_profile_allocation_status_cell)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_acquire(&__elisa_profile_allocation_status_cell)
    static else:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                result <- __elisa_profile_allocation_status_cell.slot.value
    return result

@internal
def arena_profile_allocation_status_store(status: i32):
    static if ELISA_TARGET_OS_WASM:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                __elisa_profile_allocation_status_cell.slot.value <- status
    static elif ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_release(&__elisa_profile_allocation_status_cell, status)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_release(&__elisa_profile_allocation_status_cell, status)
    static else:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                __elisa_profile_allocation_status_cell.slot.value <- status

@internal
def arena_profile_allocation_lock_acquire():
    static if ELISA_TARGET_OS_WASM:
        pass
    static elif ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Exchange:
                    while atomic_exchange_acqrel(&__elisa_profile_allocation_lock_cell, 1) != 0:
                        pass
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Exchange:
                    while atomic_exchange_acqrel(&__elisa_profile_allocation_lock_cell, 1) != 0:
                        pass
    static else:
        pass

@internal
def arena_profile_allocation_lock_release():
    static if ELISA_TARGET_OS_WASM:
        pass
    static elif ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_release(&__elisa_profile_allocation_lock_cell, 0)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_release(&__elisa_profile_allocation_lock_cell, 0)
    static else:
        pass

@internal
def arena_profile_allocation_supported() -> bool:
    # Status cell layout: bits 0-1 allocation-hook status, bits 2-3 region-layout status;
    # per field 0 = not negotiated, 1 = unsupported, 2 = supported.
    cached: mutable i32 = (arena_profile_allocation_status_load() can Global.Read, Atomics.Load) & 3
    if cached != 0:
        return cached == 2

    # The bundled profiler initializes shared state during negotiation, so only
    # one thread may enter it. Keep the initialized event path to one atomic load.
    (arena_profile_allocation_lock_acquire() can Global{Read,Write}, Atomics.Exchange)
    word: mutable i32 = (arena_profile_allocation_status_load() can Global.Read, Atomics.Load)
    cached <- word & 3
    if cached == 0:
        negotiated: mutable u32 = 0.u32()
        can Unsafe.RawExtern:
            negotiated <- elisa_profile_allocation_negotiate(ELISA_PROFILE_ALLOCATION_ABI_V1)
        cached <- 1 if negotiated != ELISA_PROFILE_ALLOCATION_ABI_V1 else 2
        (arena_profile_allocation_status_store((word & 12) | cached) can Global{Read,Write}, Atomics.Store)
    (arena_profile_allocation_lock_release() can Global{Read,Write}, Atomics.Store)
    return cached == 2

# Region-layout hook negotiation, cached in bits 2-3 of the shared status cell so the
# per-region layout report costs one atomic load once negotiated, not a weak call.
@internal
def arena_profile_region_layout_supported() -> bool:
    cached: mutable i32 = ((arena_profile_allocation_status_load() can Global.Read, Atomics.Load) >> 2) & 3
    if cached != 0:
        return cached == 2
    (arena_profile_allocation_lock_acquire() can Global{Read,Write}, Atomics.Exchange)
    word: mutable i32 = (arena_profile_allocation_status_load() can Global.Read, Atomics.Load)
    cached <- (word >> 2) & 3
    if cached == 0:
        negotiated: mutable u32 = 0.u32()
        can Unsafe.RawExtern:
            negotiated <- elisa_profile_region_layout_negotiate(ELISA_PROFILE_REGION_LAYOUT_ABI_V1)
        cached <- 1 if negotiated != ELISA_PROFILE_REGION_LAYOUT_ABI_V1 else 2
        (arena_profile_allocation_status_store((word & 3) | (cached << 2)) can Global{Read,Write}, Atomics.Store)
    (arena_profile_allocation_lock_release() can Global{Read,Write}, Atomics.Store)
    return cached == 2

# Public runtime seam used by allocation sites and by the backend's explicit
# region-create emission. The shared profiler include declares only the host
# ABI; this wrapper lives here so its cache can use the arena atomics layer.
def arena_profile_allocation_event(
    kind: u32, address: uintptr, size: usize, old_address: uintptr,
    old_size: usize, arena: uintptr, region: usize
) -> void:
    can Unsafe.RawExtern:
        return if not (arena_profile_allocation_supported() can Global{Read,Write}, Atomics{Exchange,Load,Store})
        can Global{Read,Write}, Unsafe.RawExtern:
            elisa_profile_allocation_event_v1(kind, address, size, old_address, old_size, arena, region)

# Backend chosen by target OS so the arena never depends on host libc malloc on the
# platforms the emulator targets: POSIX (macOS/Linux/FreeBSD) -> mmap, Windows ->
# VirtualAlloc. This matters because on the x86_64-under-Rosetta substrate, libc malloc
# is unusable from inside guarded guest execution; an mmap-backed arena avoids it.
static if ELISA_TARGET_OS_WASM:
    const ARENA_BACKEND: int = ARENA_BACKEND_WASM_HEAPBASE
static elif ELISA_TARGET_OS_WINDOWS:
    const ARENA_BACKEND: int = ARENA_BACKEND_WIN32_VIRTUALALLOC
static elif ELISA_TARGET_OS_POSIX:
    const ARENA_BACKEND: int = ARENA_BACKEND_LINUX_MMAP
static else:
    const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

# 128Ki slots = 1 MiB of payload on 64-bit (was 8Ki slots / 64 KiB). A driver-sized
# compile chained THOUSANDS of 64 KiB regions, and both the per-allocation free-block
# chain walk and the mmap count scale with region count. Anonymous mmap pages are
# committed on first touch, so idle capacity in the tail region costs address space,
# not RSS. Matches REGION_CACHE_MAX_SLOTS so default regions stay cacheable.
const ARENA_REGION_DEFAULT_CAPACITY: usize = 128 * 1024
# Regions one free-block search may visit after missing in the hinted region (next-fit).
const ARENA_FREE_CHAIN_REGION_VISITS: usize = 8
const ARENA_WASM_PAGE_SIZE: usize = 64 * 1024

# Per-region strategy stored in Arena.strategy (the surface `region r(N) using <strategy>`).
# This single selector encodes both the block source and the growth/stability behavior,
# mirroring the one-selector surface (docs/68 §3). CHAINED (0) is the default, so a
# zero-initialized Arena keeps the existing linked-block behavior unchanged. These are a
# per-region selector, intentionally distinct from the compile-time ARENA_BACKEND_* above.
#
#   CHAINED        linked mmap blocks; grow by chaining a new block; a single contiguous
#                  allocation cannot span blocks (interior refs invalidated on growth).
#   MALLOC         like CHAINED but blocks come from libc malloc/free (retained block source).
#   RESERVE_COMMIT one contiguous reservation; grow in place by committing pages, so the base
#                  never moves and interior refs stay valid; panic on reservation overflow.
#   FIXED          one block of the given capacity; no growth; panic on overflow.
#   SCRATCH        thread-local scratch pool (interim: behaves as CHAINED until pooled).
const ARENA_STRATEGY_CHAINED: int = 0
const ARENA_STRATEGY_MALLOC: int = 1
const ARENA_STRATEGY_RESERVE_COMMIT: int = 2
const ARENA_STRATEGY_FIXED: int = 3
const ARENA_STRATEGY_SCRATCH: int = 4

# Default reservation (in uintptr slots) for a reserve_commit arena with no inferred bound
# (docs/73). On a 64-bit demand-paged target this is 256 MiB of contiguous virtual ADDRESS SPACE:
# pages commit on first touch, so it costs no physical memory and overflowing it panics.
#
# 33554432 slots on 64-bit; 2097152 (8 MiB) on 32-bit. See arena_default_reserve_slots below.
const ARENA_DEFAULT_RESERVE_COMMIT_SLOTS: usize = 33554432
# Demand-paged 64-bit backends (mmap / VirtualAlloc reserve) reserve 8 GiB instead: address space
# only, and 256 MiB was a hard ceiling real programs hit -- reading a 254 MB stdin into one
# darray (Benchmarks Game reverse-complement at a quarter of its official size) panicked with
# "region overflow: reservation exhausted". 8 GiB still leaves room for ~16k live regions in
# a 47-bit user address space. The mmap is MAP_NORESERVE on Linux so heuristic overcommit
# does not refuse a reservation larger than RAM + swap.
const ARENA_DEMAND_PAGED_RESERVE_COMMIT_SLOTS: usize = 1073741824
const ARENA_NARROW_RESERVE_COMMIT_SLOTS: usize = 2097152

# Owner tag of a COLLECTION STACK (see "Collection stacks" below). Non-zero is what keeps
# arena_alloc from ever bumping into one; 1 is arena_adopt's marker, so this is 2.
const ARENA_OWNER_TAG_COLLECTION: usize = 2

# Owner tag of a caller-frame block (see arena_init_stack_block). The block lives in the
# function's stack frame, so arena_free and arena_trim must never hand it to the backend.
const ARENA_OWNER_TAG_STACK: usize = 3

# Address space reserved per collection stack on the demand-paged backends, in uintptr
# slots: 1Mi slots = 8 MiB, committed page by page as the table is touched, so a doubled
# table lands in the spare with no new mapping. On the eager backends (libc malloc, wasm)
# reserving IS paying, so a stack is sized to twice its first table and the spare fits
# every other growth. A table past the reservation gets a bespoke stack of twice its size.
static if ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 1048576
static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 1048576
static else:
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 0

error RuntimeError:
    OutOfMemory

# ------------------------------------------------------------
# Basic low-level types
# ------------------------------------------------------------

# A reclaimed non-tail allocation. Bump allocation remains the fast path, but
# darray growth can copy an older backing block after another allocation has
# been made. Keeping the reclaimed span as an intrusive free block makes that
# copy reclaimable without a side table or a second allocator.
@intrusive
struct ArenaFreeBlock:
    next: mutable heap ArenaFreeBlock&?
    slots: mutable usize

struct Region:
    next: mutable heap Region&?
    count: mutable usize
    capacity: mutable usize
    owner_tag: mutable uintptr
    owner_next: mutable heap Region&?
    global_index: mutable usize
    # Bytes physically committed from the block base (Windows reserve_commit/fixed lazy
    # MEM_RESERVE+MEM_COMMIT path); 0 on POSIX/WASM/malloc where the block is fully backed at
    # creation, so arena_region_ensure_committed no-ops there.
    committed: mutable usize
    free_list: mutable heap ArenaFreeBlock&?
    data: tail uintptr

struct Arena:
    begin:mutable heap Region&?
    end:mutable heap Region&?
    end_index: mutable usize
    # Per-region strategy (ARENA_STRATEGY_*); 0 (CHAINED) for a zero-initialized arena, so
    # existing arenas keep the linked-block path. Set by the region declaration's codegen.
    strategy: mutable int

struct ArenaMark:
    region: heap Region&?
    count: usize

# ------------------------------------------------------------
# Backend FFI declarations
# ------------------------------------------------------------

# malloc/free are declared for every backend: the libc-malloc backend uses them for
# region allocation, and other runtime modules (e.g. concurrency) call malloc directly
# and resolve it via this declaration. Under the mmap/VirtualAlloc backends the arena
# itself does not use them for regions.
extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]
extern free(ptr: heap void&) can[Memory.Release]
# Used by the region cache to restore fresh-mmap zeroing when parking a region.
extern memset(dest: mutable void&, val: i32, n: usize) -> mutable void&
# Used by arena_realloc's relocation copy.
extern memcpy(dest: mutable void&, src: void&, n: usize) -> mutable void&

static if ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    const ELISA_ARENA_PROT_READ = 0x1
    const ELISA_ARENA_PROT_WRITE = 0x2
    const ELISA_ARENA_MAP_PRIVATE = 0x02
    # MAP_ANON differs by OS: 0x20 on Linux, 0x1000 on macOS/BSD.
    static if ELISA_TARGET_OS_LINUX:
        const ELISA_ARENA_MAP_ANONYMOUS = 0x20
        const ELISA_ARENA_MAP_NORESERVE = 0x4000
    static else:
        const ELISA_ARENA_MAP_ANONYMOUS = 0x1000
        # Darwin/BSD reserve lazily anyway (their MAP_NORESERVE is a no-op or absent).
        const ELISA_ARENA_MAP_NORESERVE = 0x0

    # uintptr-typed to exactly match the declaration the emulator (guest_exec/tls) uses,
    # so the two declarations dedup to one instead of conflicting as "duplicate mmap".
    extern mmap(addr: uintptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> uintptr

    extern munmap(addr: heap void&, length: usize) -> i32

    # MAP_FAILED is the macro ((void*)-1), NOT a libc function. Compute it instead of
    # declaring a (nonexistent) extern function, which would crash when called.
    def MAP_FAILED() -> uintptr:
        return 0.uintptr() - 1.uintptr()

static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04

    extern GetCurrentProcess() -> void&
    extern VirtualAllocEx(
        process: void&,
        address: mutable heap void&?,
        size: usize,
        alloc_type: u32,
        protect: u32
    ) -> mutable heap void&?

    extern VirtualFreeEx(
        process: void&,
        address: heap void&,
        size: usize,
        free_type: u32
    ) -> i32

    # Commit granularity for the lazy reserve_commit/fixed path: pages are committed 64 KiB at a
    # time (a multiple of the 4 KiB page size and equal to the reservation allocation granularity),
    # amortizing the per-allocation MEM_COMMIT syscall.
    const WIN_COMMIT_CHUNK: usize = 65536

    def win_commit_round_up(n: usize) -> usize:
        can Abort.Panic:
            remainder: usize = n % WIN_COMMIT_CHUNK
            padding: usize = 0 if remainder == 0 else WIN_COMMIT_CHUNK - remainder
            rounded: usize = arena_checked_add_usize(n, padding)
            return (rounded / WIN_COMMIT_CHUNK) * WIN_COMMIT_CHUNK

static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
    # The generated host facade owns the allocator and seeds it from wasm-ld's
    # `__heap_base` export after instantiation. Routing regions through malloc/free keeps
    # Elisa's arena and JS-created strings/byte buffers on one collision-free heap.
    const ARENA_WASM_USES_HOST_ALLOCATOR: bool = true

# The default reserve_commit reservation, sized to the TARGET'S POINTER WIDTH.
#
# 256 MiB of address space is free on a 64-bit demand-paged target. It is not free anywhere
# else. On WebAssembly there is no demand paging at all -- `memory.grow` commits real pages
# immediately and linear memory is capped at 4 GiB -- so a 256 MiB "reservation" is a 256 MiB
# ALLOCATION, per region. A display-list frame nests two regions and the browser shell grew
# ~128 MiB per frame until memory.grow failed. On any 32-bit target it is also 1/16th of the
# entire address space, which is unreasonable even with demand paging.
#
# Keyed on `size_of(uintptr)` rather than on a target predicate on purpose: pointer width is
# the property that actually matters, it folds at compile time on every backend, and it adds
# NO dependency on a compiler new enough to define a particular ELISA_TARGET_* name. An
# earlier version of this used `static if ELISA_TARGET_ARCH_WASM` and broke every tool still
# pinned to an older stage0, which is a bad trade for a constant.
def arena_default_reserve_slots() -> usize:
    return ARENA_NARROW_RESERVE_COMMIT_SLOTS if size_of(uintptr) < 8
    return ARENA_DEMAND_PAGED_RESERVE_COMMIT_SLOTS if ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP or ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC
    return ARENA_DEFAULT_RESERVE_COMMIT_SLOTS

def max(a: usize, b: usize) -> usize:
    ensure result >= a
    ensure result >= b
    return a if a > b else b

def min(a: usize, b: usize) -> usize:
    ensure result <= a
    ensure result <= b
    return a if a < b else b

def clamp(x: usize, lo: usize, hi: usize) -> usize:
    requires lo <= hi
    ensure result >= lo
    ensure result <= hi
    return lo if x < lo
    return hi if x > hi
    return x

def inv_handle(ptr: heap void&?) -> bool:
    return ptr == null

@internal
def arena_region_from_raw(raw: heap void&) -> mutable heap Region&:
    trusted Unsafe.PointerCast:
        return raw.cast[mutable heap Region&]

@internal
def arena_region_from_uintptr(raw: uintptr) -> mutable heap Region&:
    # An integer alone proves neither allocation provenance nor Region layout.
    can Unsafe.PointerCast:
        return raw.cast[mutable heap Region&]

@internal
def arena_heap_void_from_region(r: heap Region&) -> heap void&:
    trusted Unsafe.PointerCast:
        return r.cast[heap void&]

@internal
def arena_mutable_heap_void_from_region(r: heap Region&) -> mutable heap void&?:
    trusted Unsafe.PointerCast:
        return r.cast[mutable heap void&?]

@internal
def arena_heap_u8_from_region_data(r: heap Region&) -> mutable heap u8&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (r.cast[heap u8&] + size_of(Region)).cast[mutable heap u8&]

@internal
def arena_heap_void_from_data_base(data_base: heap u8&, offset_bytes: usize) -> mutable heap void&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (data_base + offset_bytes).cast[mutable heap void&]

@internal
def arena_heap_void_from_mutable(ptr: mutable void&) -> mutable heap void&:
    # Promoting an arbitrary borrow to heap requires authority at the caller.
    can Unsafe.PointerCast:
        return ptr.cast[mutable heap void&]

@internal
def arena_heap_u8_from_void(ptr: heap void&) -> mutable heap u8&:
    trusted Unsafe.PointerCast:
        return ptr.cast[mutable heap u8&]

@internal
def arena_heap_void_from_u8(ptr: heap u8&) -> heap void&:
    trusted Unsafe.PointerCast:
        return ptr.cast[heap void&]

@internal
def arena_u8_from_void(ptr: void&) -> u8&:
    trusted Unsafe.PointerCast:
        return ptr.cast[u8&]

@internal
def arena_mutable_u8_from_void(ptr: mutable void&) -> mutable u8&:
    trusted Unsafe.PointerCast:
        return ptr.cast[mutable u8&]

@internal
def arena_heap_u8_from_alloc(ptr: heap void&) -> mutable heap u8&:
    trusted Unsafe.PointerCast:
        return ptr.cast[mutable heap u8&]

@internal
def arena_void_from_mutable_u8(ptr: mutable heap u8&) -> mutable void&:
    trusted Unsafe.PointerCast:
        return ptr.cast[mutable void&]

@internal
def arena_void_from_u8(ptr: u8&) -> void&:
    trusted Unsafe.PointerCast:
        return ptr.cast[void&]

@internal
def arena_nullable_u8_from_heap(ptr: heap u8&) -> u8&?:
    trusted Unsafe.PointerCast:
        return ptr.cast[u8&?]

# ------------------------------------------------------------
# Pointer-state helpers
# ------------------------------------------------------------

def sfree[T](ptr: heap T&) -> heap T!:
    can Memory.Release:
        # Only valid against the libc-malloc backend; mmap/VirtualAlloc regions are released
        # by free_region (which knows the size). Calling libc free on an mmap pointer is UB.
        static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
            trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                free(ptr.cast[heap void&])
    return null

# ------------------------------------------------------------
# Region allocation / freeing
# ------------------------------------------------------------

# A bounded cache of the most recently freed mmap-backed regions. Sampling the -O2
# compiler showed 15.5% of ALL cpu inside mmap/munmap: ordinary backend helpers each
# spin up a scratch region and tear it down again, so the same-sized block is unmapped
# and re-mapped thousands of times per compile. The cache keeps up to
# REGION_CACHE_MAX_ENTRIES parked regions; new_region_with_owner probes that list and
# reuses a region when its capacity suffices. free_region parks instead of unmapping
# while the cache has room and the region is not oversized (so a giant block is never
# pinned). Cache metadata and the cross-arena free-region hint are protected by the
# runtime atomic lock below; the per-arena region chains remain under their arena
# owner's synchronization contract.
struct ArenaRegionCache:
    slot: mutable heap Region&?
    # Number of regions currently parked on `slot` (bounded by REGION_CACHE_MAX_ENTRIES).
    # Keep the historical field name because it is part of the runtime interface layout.
    reclaimed_spans: mutable usize

global mutable __elisa_region_cache: ArenaRegionCache = ArenaRegionCache{slot: null, reclaimed_spans: 0}

# A single best-effort reclaimed-span hint. The key prevents a hint belonging to a freed or
# unrelated arena from suppressing a valid allocation. Keeping this separate from Arena avoids
# changing the public carrier layout consumed by the stage0 runtime interface.
struct ArenaFreeHint:
    owner: mutable uintptr
    region: mutable heap Region&?

global mutable __elisa_free_hint: ArenaFreeHint = ArenaFreeHint{owner: 0.uintptr(), region: null}

# Atomic advisory owner tag for the free hint. The common no-hint/mismatched-owner path reads
# this scalar without contending on the shared cache lock; a matching tag is always rechecked
# under that lock before the region pointer is read. Relaxed ordering is enough for this filter:
# stale mismatches only miss the fast path, while the lock synchronizes access to the hint itself.
# It stays outside Arena to preserve its ABI.
global mutable __elisa_free_hint_owner_cell: AtomicCell[uintptr] = zeroed

@internal
def arena_free_hint_fast_owner() -> uintptr:
    result: mutable uintptr = 0.uintptr()
    static if ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_relaxed(&__elisa_free_hint_owner_cell)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_relaxed(&__elisa_free_hint_owner_cell)
    static else:
        # The arena cache lock is also a no-op on single-threaded targets such as WASM.
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                result <- __elisa_free_hint_owner_cell.slot.value
    return result

@internal
def arena_free_hint_fast_owner_publish(owner: uintptr):
    static if ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_relaxed(&__elisa_free_hint_owner_cell, owner)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_relaxed(&__elisa_free_hint_owner_cell, owner)
    static else:
        # Keep the no-thread target on ordinary loads/stores, matching its cache-lock policy.
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                __elisa_free_hint_owner_cell.slot.value <- owner

@internal
def arena_region_cache_take(capacity: usize, owner_tag: uintptr) -> mutable heap Region&?:
    can Unsafe.Alias:
        result: mutable heap Region&? = null
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                reuse_cache: mutable ArenaRegionCache& = &__elisa_region_cache
                reuse_previous: mutable heap Region&? = null
                reuse_cursor: mutable heap Region&? = reuse_cache.slot
                reuse_probes: mutable usize = REGION_CACHE_MAX_ENTRIES
                while reuse_cursor != null and reuse_probes > 0:
                    reuse_probes <- reuse_probes - 1
                    cache_candidate: mutable heap Region&? = reuse_cursor
                    if cache_candidate is cached and cached.capacity >= capacity:
                        if reuse_previous is previous:
                            previous.next <- cached.next
                        else:
                            reuse_cache.slot <- cached.next
                        reuse_cache.reclaimed_spans <- reuse_cache.reclaimed_spans - 1 if reuse_cache.reclaimed_spans > 0
                        cached.next <- null
                        cached.count <- 0
                        cached.owner_tag <- owner_tag
                        cached.owner_next <- null
                        cached.global_index <- 0
                        cached.committed <- 0
                        cached.free_list <- null
                        result <- cached
                        break
                    reuse_previous <- reuse_cursor
                    reuse_cursor <- reuse_cursor.next
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

@internal
def arena_free_hint_get(owner: uintptr) -> mutable heap Region&?:
    # A miss is advisory only: a concurrent writer may publish this owner immediately after
    # the load, in which case this allocation simply falls back to bump allocation. On a hit,
    # the lock below still protects both owner validation and the region pointer's lifetime.
    can Global.Read, Atomics.Load:
        return null if arena_free_hint_fast_owner() != owner
    result: mutable heap Region&? = null
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        hint: ArenaFreeHint& = &__elisa_free_hint can Global.Read
        can Global.Read:
            result <- hint.region if hint.owner == owner
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
    return result

@internal
def arena_free_hint_set(owner: uintptr, region: mutable heap Region&?):
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            hint.owner <- owner
            hint.region <- region
    published_owner: uintptr = owner if region != null else 0.uintptr()
    can Global{Read,Write}:
        arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_update(owner: uintptr, region: mutable heap Region&?):
    matched: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == owner:
                hint.region <- region
                matched <- true
    if matched:
        published_owner: uintptr = owner if region != null else 0.uintptr()
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_clear(owner: uintptr):
    # Every writer publishes the fast owner under the lock whenever the hint names a live
    # region, and only this arena's own thread frees it, so a mismatch here means the hint
    # holds no region of ours. A stale owner with a null region left behind is inert.
    can Global.Read, Atomics.Load:
        return if arena_free_hint_fast_owner() != owner
    matched: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == owner:
                hint.owner <- 0.uintptr()
                hint.region <- null
                matched <- true
    if matched:
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(0.uintptr())
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_transfer(child: uintptr, parent: uintptr, child_region: mutable heap Region&?):
    transferred: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == child and child_region != null:
                hint.owner <- parent
                hint.region <- child_region
                transferred <- true
    if transferred:
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(parent)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_cache_record_reclaim(owner: uintptr, region: mutable heap Region&?):
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            # A reclaimed span stays inside its own arena's region and is released with
            # that arena, so it must not consume the parked-region budget: charging it
            # here (with only a cache hit ever refunding) permanently closed the cache
            # after 128 reclaims and sent every later free_region to munmap.
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            hint.owner <- owner
            hint.region <- region
    published_owner: uintptr = owner if region != null else 0.uintptr()
    can Global{Read,Write}:
        arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_region_cache_try_park(r: heap Region&) -> bool:
    can Abort.Panic:
        return false if r.capacity > REGION_CACHE_MAX_SLOTS
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")

        # Zero before publishing the block in the shared list. The region is still
        # exclusively owned by this release operation and this work need not extend the
        # critical section. The room check happens once, under the lock below: a full
        # cache only wastes this memset, while a pre-check cost a lock round-trip on
        # every call-scoped region free.
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if used_bytes > 0:
            trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                _ = memset(arena_heap_u8_from_region_data(r).cast[mutable void&], 0, used_bytes)

        parked_ok: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                cache: mutable ArenaRegionCache& = &__elisa_region_cache
                if cache.reclaimed_spans < REGION_CACHE_MAX_ENTRIES:
                    trusted Unsafe.PointerCast:
                        parked: mutable heap Region& = r.cast[mutable heap Region&]
                        parked.next <- cache.slot
                        cache.slot <- parked
                    cache.reclaimed_spans <- cache.reclaimed_spans + 1
                    parked_ok <- true
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return parked_ok

# Largest region the cache will park, in SLOTS (uintptr-sized): 128Ki slots = 1 MiB of
# payload on 64-bit. Scratch regions are far smaller; anything bigger is unmapped as
# before so RSS never pins a large one-off block.
const REGION_CACHE_MAX_SLOTS: usize = 131072
const REGION_CACHE_MAX_ENTRIES: usize = 128

# RESERVATION-sized regions get a parked list of their own. stage0 gives every function's
# auto region the reserve_commit strategy, so in a stage0-built program (the seed product)
# the first allocation of EVERY call maps a 256 MiB reservation and its arena_free unmaps
# it again: 23.8k mmap/munmap pairs compiling just the runtime, ~760k for the self-compile,
# each re-faulting the pages it touches (8.5M minor faults, ~60 s of system time). The
# reservation itself is address space, not memory, so parking it is free; what a parked
# block pins is only the pages its last owner touched, and those are zeroed on park. A
# region whose owner touched more than RESERVE_CACHE_MAX_USED_SLOTS is unmapped exactly as
# before, so the parked list can never hold more than
# RESERVE_CACHE_MAX_ENTRIES * RESERVE_CACHE_MAX_USED_SLOTS words resident (8 MiB on 64-bit).
# Kept apart from the small list so a 1 MiB request never takes (and chains into) a
# reservation, and a reservation request never walks 128 small blocks.
const RESERVE_CACHE_MAX_ENTRIES: usize = 32
const RESERVE_CACHE_MAX_USED_SLOTS: usize = 32768

global mutable __elisa_reserve_region_cache: ArenaRegionCache = ArenaRegionCache{slot: null, reclaimed_spans: 0}

@internal
def arena_reserve_cache_take(capacity: usize, owner_tag: uintptr) -> mutable heap Region&?:
    can Unsafe.Alias:
        result: mutable heap Region&? = null
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                reuse_cache: mutable ArenaRegionCache& = &__elisa_reserve_region_cache
                reuse_previous: mutable heap Region&? = null
                reuse_cursor: mutable heap Region&? = reuse_cache.slot
                reuse_probes: mutable usize = RESERVE_CACHE_MAX_ENTRIES
                while reuse_cursor != null and reuse_probes > 0:
                    reuse_probes <- reuse_probes - 1
                    cache_candidate: mutable heap Region&? = reuse_cursor
                    if cache_candidate is cached and cached.capacity >= capacity:
                        if reuse_previous is previous:
                            previous.next <- cached.next
                        else:
                            reuse_cache.slot <- cached.next
                        reuse_cache.reclaimed_spans <- reuse_cache.reclaimed_spans - 1 if reuse_cache.reclaimed_spans > 0
                        cached.next <- null
                        cached.count <- 0
                        cached.owner_tag <- owner_tag
                        cached.owner_next <- null
                        cached.global_index <- 0
                        cached.committed <- 0
                        cached.free_list <- null
                        result <- cached
                        break
                    reuse_previous <- reuse_cursor
                    reuse_cursor <- reuse_cursor.next
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

@internal
def arena_reserve_cache_try_park(r: heap Region&) -> bool:
    can Abort.Panic:
        return false if r.capacity <= REGION_CACHE_MAX_SLOTS
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")
        return false if r.count > RESERVE_CACHE_MAX_USED_SLOTS

        room: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            cache: ArenaRegionCache& = &__elisa_reserve_region_cache can Global.Read
            can Global.Read:
                room <- cache.reclaimed_spans < RESERVE_CACHE_MAX_ENTRIES
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return false if not room

        # Same zeroing contract as the small list: a fresh anonymous mmap is kernel-zeroed.
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if used_bytes > 0:
            trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                _ = memset(arena_heap_u8_from_region_data(r).cast[mutable void&], 0, used_bytes)

        parked_ok: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                cache: mutable ArenaRegionCache& = &__elisa_reserve_region_cache
                if cache.reclaimed_spans < RESERVE_CACHE_MAX_ENTRIES:
                    trusted Unsafe.PointerCast:
                        parked: mutable heap Region& = r.cast[mutable heap Region&]
                        parked.next <- cache.slot
                        cache.slot <- parked
                    cache.reclaimed_spans <- cache.reclaimed_spans + 1
                    parked_ok <- true
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return parked_ok

@internal
def arena_checked_add_usize(left: usize, right: usize) -> usize:
    can Abort.Panic:
        result: usize = left + right
        if result < left:
            panic("arena size addition overflow")
        return result

@internal
def arena_checked_mul_usize(left: usize, right: usize) -> usize:
    can Abort.Panic:
        result: usize = left * right
        if left != 0 and result / left != right:
            panic("arena size multiplication overflow")
        return result

@internal
def arena_region_payload_bytes(capacity_slots: usize) -> usize:
    return arena_checked_mul_usize(capacity_slots, size_of(uintptr)) can Abort.Panic

@internal
def arena_region_total_bytes(capacity_slots: usize) -> usize:
    return arena_checked_add_usize(size_of(Region), arena_region_payload_bytes(capacity_slots)) can Abort.Panic

@internal
def arena_size_bytes_to_slots(size_bytes: usize) -> usize:
    can Abort.Panic:
        word_bytes: usize = size_of(uintptr)
        if word_bytes == 0:
            panic("arena has zero-sized allocation words")

        slots: mutable usize = size_bytes / word_bytes
        if size_bytes % word_bytes != 0:
            slots <- arena_checked_add_usize(slots, 1)
        slots <- 1 if slots == 0

        rounded_bytes: usize = slots * word_bytes
        if slots != 0 and rounded_bytes / slots != word_bytes:
            panic("arena allocation size overflow")
        if rounded_bytes < size_bytes:
            panic("arena allocation size overflow")
        return slots

@internal
def arena_region_can_fit(r: Region&, requested_slots: usize) -> bool:
    can Abort.Panic:
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")
        return requested_slots <= r.capacity - r.count


# Own a fresh, aligned mapping sized for Region plus its requested payload.
# Failed/null carriers are rejected before the one suppressed conversion;
# arbitrary integer promotion in arena_region_from_uintptr remains tracked.
static if ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
    @internal
    def arena_mmap_owned_region(capacity: usize) -> mutable heap Region&:
        size_bytes: usize = arena_region_total_bytes(capacity) can Abort.Panic
        raw_addr: mutable uintptr = 0.uintptr()
        trusted Unsafe.RawExtern:
            raw_addr <- (mmap(
                0.uintptr(),
                size_bytes,
                ELISA_ARENA_PROT_READ | ELISA_ARENA_PROT_WRITE,
                ELISA_ARENA_MAP_ANONYMOUS | ELISA_ARENA_MAP_PRIVATE | ELISA_ARENA_MAP_NORESERVE,
                -1,
                0
            ) can Memory.Allocate)
        if raw_addr == MAP_FAILED() or raw_addr == 0.uintptr():
            can Abort.Panic:
                panic("arena allocation failed")
        trusted Unsafe.PointerCast:
            return arena_region_from_uintptr(raw_addr)

def new_region_with_owner(capacity: usize, owner_tag: uintptr) -> mutable heap Region&:
    can Abort.Panic, Atomics{Exchange,Store}, Memory.Allocate, Unsafe.Alias:
        size_bytes: usize = arena_region_total_bytes(capacity)

        # Reuse the parked region when it is big enough — its own (possibly larger)
        # capacity is kept, exactly as if the caller had asked for that size.
        static if ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
            if capacity > REGION_CACHE_MAX_SLOTS:
                reserved_region: mutable heap Region&? = (arena_reserve_cache_take(capacity, owner_tag) can Global{Read,Write})
                if reserved_region is reserved:
                    return reserved
            else:
                cached_region: mutable heap Region&? = (arena_region_cache_take(capacity, owner_tag) can Global{Read,Write})
                if cached_region is cached:
                    return cached
        static else:
            pass

        static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
            raw: mutable heap void&? = null
            trusted Unsafe.RawExtern:
                raw <- malloc(size_bytes)
            if raw == null:
                panic("arena allocation failed")
            r: mutable heap Region& = arena_region_from_raw(raw)

        static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
            r: mutable heap Region& = arena_mmap_owned_region(capacity) can Memory.Allocate, Abort.Panic

        static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
            raw: mutable heap void&? = null
            trusted Unsafe.RawExtern:
                raw <- VirtualAllocEx(
                    GetCurrentProcess(),
                    null,
                    size_bytes,
                    MEM_COMMIT | MEM_RESERVE,
                    PAGE_READWRITE
                )
            if inv_handle(raw) or raw == null:
                panic("arena allocation failed")
            r: mutable heap Region& = arena_region_from_raw(raw)

        static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
            raw: mutable heap void&? = null
            trusted Unsafe.RawExtern:
                raw <- malloc(size_bytes)
            if raw == null:
                panic("arena allocation failed")
            r: mutable heap Region& = arena_region_from_raw(raw)

        static else:
            static error("Unknown arena backend")

        r.next <- null
        r.count <- 0
        r.capacity <- capacity
        r.owner_tag <- owner_tag
        r.owner_next <- null
        r.global_index <- 0
        r.committed <- 0
        r.free_list <- null
        return r

def new_region(capacity: usize) -> mutable heap Region&:
    can Atomics{Exchange,Store}, Unsafe.Alias:
        return (new_region_with_owner(capacity, 0.uintptr()) can Global{Read,Write}) can Memory.Allocate, Abort.Panic

# A libc-malloc-backed region block, available on every target (malloc/free are declared for
# all backends above). Used by malloc-selected regions regardless of the compile-time default.
@internal
def new_region_malloc(capacity: usize) -> mutable heap Region&:
    can Memory.Allocate, Abort.Panic:
        size_bytes: usize = arena_region_total_bytes(capacity)
        raw: mutable heap void&? = null
        trusted Unsafe.RawExtern:
            raw <- malloc(size_bytes)
        if raw == null:
            panic("arena allocation failed")
        r: mutable heap Region& = arena_region_from_raw(raw)
        r.next <- null
        r.count <- 0
        r.capacity <- capacity
        r.owner_tag <- 0.uintptr()
        r.owner_next <- null
        r.global_index <- 0
        r.committed <- 0
        r.free_list <- null
        return r

# A reserve-only region block for the reserve_commit/fixed strategies. On Windows the block's
# address range is MEM_RESERVE'd up front (no physical backing) and pages are MEM_COMMIT'd on
# demand by arena_region_ensure_committed as the bump pointer advances — so a large default
# reservation (256 MiB) costs only address space, matching POSIX mmap's demand-paging. On every
# other backend it is identical to new_region (mmap demand-pages, or malloc/eager-commit), and
# the commit-on-demand helper no-ops.
@internal
def new_region_reserve(capacity: usize) -> mutable heap Region&:
    can Abort.Panic, Atomics{Exchange,Store}, Memory.Allocate, Unsafe.Alias:
        static if ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
            size_bytes: usize = arena_region_total_bytes(capacity)
            raw: mutable heap void&? = null
            trusted Unsafe.RawExtern:
                raw <- VirtualAllocEx(
                    GetCurrentProcess(),
                    null,
                    size_bytes,
                    MEM_RESERVE,
                    PAGE_READWRITE
                )
            if inv_handle(raw) or raw == null:
                panic("arena reservation failed")
            # Commit an initial chunk covering the Region header before writing any field.
            initial: usize = win_commit_round_up(arena_region_total_bytes(1))
            commit_raw: mutable heap void&? = null
            trusted Unsafe.RawExtern:
                commit_raw <- VirtualAllocEx(
                    GetCurrentProcess(),
                    raw,
                    initial,
                    MEM_COMMIT,
                    PAGE_READWRITE
                )
            if inv_handle(commit_raw) or commit_raw == null:
                panic("arena initial page commit failed")
            r: mutable heap Region& = arena_region_from_raw(raw)
            r.next <- null
            r.count <- 0
            r.capacity <- capacity
            r.owner_tag <- 0.uintptr()
            r.owner_next <- null
            r.global_index <- 0
            r.committed <- initial
            r.free_list <- null
            return r
        static else:
            return (new_region(capacity) can Global{Read,Write})

# WINDOWS reserve_commit/fixed only: commit (page-in) enough pages so that `needed_bytes` from the
# block base are physically backed, growing the committed watermark in chunks to amortize syscalls.
# Idempotent — re-committing already-committed pages is a no-op per VirtualAlloc. A no-op on every
# other backend (their blocks are fully backed at creation: mmap demand-pages, malloc/eager-commit).
@internal
def arena_region_ensure_committed(r: mutable heap Region&, needed_bytes: usize):
    can Abort.Panic:
        static if ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
            if needed_bytes > r.committed:
                target: mutable usize = win_commit_round_up(needed_bytes)
                full: usize = arena_region_total_bytes(r.capacity)
                target <- full if target > full
                base: mutable heap void&? = arena_mutable_heap_void_from_region(r)
                commit_raw: mutable heap void&? = null
                trusted Unsafe.RawExtern:
                    commit_raw <- VirtualAllocEx(
                        GetCurrentProcess(),
                        base,
                        target,
                        MEM_COMMIT,
                        PAGE_READWRITE
                    )
                if inv_handle(commit_raw) or commit_raw == null:
                    panic("arena page commit failed")
                r.committed <- target
        static else:
            pass

# Strategy-dispatching region allocator: chooses the block source. MALLOC draws blocks from
# libc malloc; every other strategy (CHAINED/RESERVE_COMMIT/FIXED/SCRATCH) uses the compile-time
# ARENA_BACKEND (mmap/VirtualAlloc), so it is identical to new_region for those.
def new_region_backend(capacity: usize, strategy: int) -> mutable heap Region&:
    can Abort.Panic, Atomics{Exchange,Store}, Memory.Allocate, Unsafe.Alias:
        return new_region_malloc(capacity) if strategy == ARENA_STRATEGY_MALLOC
        # reserve_commit/fixed take a contiguous block that grows in place. On Windows that block
        # is reserved-then-committed-on-demand (new_region_reserve); on POSIX it is a demand-paged
        # mmap (new_region_reserve falls through to new_region there). CHAINED/SCRATCH keep the
        # plain block source.
        return (new_region_reserve(capacity) can Global{Read,Write}) if strategy == ARENA_STRATEGY_RESERVE_COMMIT or strategy == ARENA_STRATEGY_FIXED
        return (new_region(capacity) can Global{Read,Write})

@internal
def arena_free_block_after_slots(block: mutable heap ArenaFreeBlock&, slots: usize) -> mutable heap ArenaFreeBlock&:
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic]:
        return (block.cast[mutable heap u8&] + slots * size_of(uintptr)).cast[mutable heap ArenaFreeBlock&]

@internal
def arena_take_free_block(r: mutable heap Region&, need_slots: usize, exhaustive: bool) -> mutable heap void&?:
    can Unsafe.Alias:
        header_slots: usize = (size_of(ArenaFreeBlock) + size_of(uintptr) - 1) / size_of(uintptr)
        # FIRST-FIT WITH A BOUNDED PROBE. The exhaustive walk made every allocation
        # O(live free blocks): a compiler-sized run reclaims thousands of darray backings
        # into this list, and sampling stage1 compiling its own driver put ~35% of ALL
        # cpu inside this walk (arena_take_free_block + _chain + reclaim, plus the
        # mmap/munmap churn it drives). Ordinary allocations use a bounded probe and then
        # bump-allocate. Constrained arenas request an exhaustive probe only on the overflow
        # path, where missing a reusable block would otherwise cause a spurious panic.
        # Insertion is LIFO, so the bounded probe still sees the most recently freed — cache-
        # warm and, in the grow-in-place realloc pattern that dominates, right-sized — blocks
        # first.
        probes_left: mutable usize = 32
        previous: mutable heap ArenaFreeBlock&? = null
        current: mutable heap ArenaFreeBlock&? = r.free_list
        while current != null and (exhaustive == true or probes_left > 0):
            probes_left <- probes_left - 1 if not exhaustive
            if current.slots >= need_slots:
                block: mutable heap ArenaFreeBlock& = current
                remainder: usize = current.slots - need_slots
                if remainder >= header_slots:
                    # The checked request size and remainder bound establish a live free-block
                    # header here; construct its reference directly instead of zeroing a non-null
                    # reference slot and rebinding it inside an unsafe block.
                    split: mutable heap ArenaFreeBlock& = arena_free_block_after_slots(block, need_slots)
                    split.slots <- remainder
                    split.next <- current.next
                    if previous != null:
                        previous.next <- split
                    else:
                        r.free_list as & <- split
                else:
                    if previous != null:
                        previous.next <- current.next
                    else:
                        r.free_list <- current.next
                trusted Unsafe.PointerCast:
                    return block.cast[mutable heap void&]
            previous <- current
            current <- current.next
        return null

# The reclaimed-span HINT is keyed by arena address. A stale hint can cost reuse on growable
# arenas; fixed/reserve-commit arenas exhaustively scan only after bump overflow so a displaced
# hint cannot hide reclaimed capacity and cause a spurious reservation-exhausted panic. The
# allocator calls this lookup only when a non-empty arena cannot use its current bump region; a
# first allocation and normal bump allocation avoid even the advisory atomic owner load.

@internal
def arena_find_free_region(start: mutable heap Region&?) -> mutable heap Region&?:
    cursor: mutable heap Region&? = start
    while cursor != null:
        return cursor if cursor.free_list != null
        cursor <- cursor.next
    return null


@internal
def arena_fixed_overflow_reuse(a: mutable Arena&, need_slots: usize, size_bytes: usize) -> mutable heap void&?:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern}:
        cursor: mutable heap Region&? = a.begin
        while cursor != null:
            if arena_take_free_block(cursor, need_slots, true) is reclaimed:
                next_hint: mutable heap Region&? = arena_find_free_region(a.begin)
                if next_hint != null:
                    (arena_free_hint_set(a.cast[uintptr], next_hint) can Global{Read,Write})
                else:
                    # Clear only our own exhausted hint; do not evict another arena's useful
                    # entry when this constrained arena has no reusable blocks left.
                    (arena_free_hint_update(a.cast[uintptr], null) can Global{Read,Write})
                (arena_profile_region_layout(a, cursor) can Global{Read,Write})
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_ALLOC,
                    reclaimed.cast[uintptr],
                    size_bytes,
                    0.uintptr(),
                    0.usize(),
                    a.cast[uintptr],
                    cursor.global_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                return reclaimed
            cursor <- cursor.next
        return null


@internal
def arena_take_free_block_chain(a: mutable Arena&, need_slots: usize, size_bytes: usize) -> mutable heap void&?:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern}:
        hinted: mutable heap Region&? = (arena_free_hint_get(a.cast[uintptr]) can Global{Read,Write}, Atomics.Load)
        if hinted == null:
            if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
                if a.end != null and not arena_region_can_fit(a.end, need_slots):
                    if (arena_fixed_overflow_reuse(a, need_slots, size_bytes) can Global{Read,Write}) is reclaimed:
                        return reclaimed
            return null

        # Probe the remembered region first. This is the usual reclaim/realloc path and
        # avoids scanning all earlier regions in a compiler-sized arena.
        if arena_take_free_block(hinted, need_slots, false) is reclaimed:
            next_hint: mutable heap Region&? = hinted
            next_hint <- arena_find_free_region(hinted) if hinted.free_list == null
            (arena_free_hint_update(a.cast[uintptr], next_hint) can Global{Read,Write})
            (arena_profile_region_layout(a, hinted) can Global{Read,Write})
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_ALLOC,
                reclaimed.cast[uintptr],
                size_bytes,
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                hinted.global_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            return reclaimed

        # NEXT-FIT WITH A BOUNDED SCAN. The hint is valid (reset, rewind, trim, free and adopt
        # all clear or re-point it), so every region reached from it is still in this chain.
        # The old fallback walked the WHOLE chain from `a.begin` on every hint miss, probing up
        # to 32 blocks per region. A compiler-sized arena holds ~1000 regions, and the miss is
        # the common case (a darray growth move asks for twice the block it just freed), so
        # sampling stage1 compiling itself put ~45% of all cpu in arena_take_free_block. Visit
        # a bounded number of regions after the hint, wrapping at `a.begin`, and leave the
        # hint where the scan stopped: the next miss resumes there, so every region is still
        # revisited in turn. A scan that wraps back to the hint has seen everything and clears
        # it, exactly as the exhaustive walk did.
        cursor: mutable heap Region&? = hinted.next
        cursor <- a.begin if cursor == null
        regions_left: mutable usize = ARENA_FREE_CHAIN_REGION_VISITS
        trusted Unsafe.AssumeProgress:
            while cursor != null and cursor != hinted and regions_left > 0:
                regions_left <- regions_left - 1
                if cursor.free_list != null:
                    if arena_take_free_block(cursor, need_slots, false) is reclaimed:
                        next_hint: mutable heap Region&? = cursor
                        next_hint <- arena_find_free_region(cursor) if cursor.free_list == null
                        (arena_free_hint_update(a.cast[uintptr], next_hint) can Global{Read,Write})
                        (arena_profile_region_layout(a, cursor) can Global{Read,Write})
                        arena_profile_allocation_event(
                            ELISA_PROFILE_ALLOCATION_ALLOC,
                            reclaimed.cast[uintptr],
                            size_bytes,
                            0.uintptr(),
                            0.usize(),
                            a.cast[uintptr],
                            cursor.global_index
                        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                        return reclaimed
                cursor <- cursor.next
                cursor <- a.begin if cursor == null
        if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
            if a.end != null and not arena_region_can_fit(a.end, need_slots):
                if (arena_fixed_overflow_reuse(a, need_slots, size_bytes) can Global{Read,Write}) is reclaimed:
                    return reclaimed
        resume: mutable heap Region&? = cursor
        resume <- null if cursor == hinted
        (arena_free_hint_update(a.cast[uintptr], resume) can Global{Read,Write})
        return null

# Unchecked containment test for the reclaim walk. A region's payload size was
# overflow-checked when the region was created, so recomputing it cannot overflow and
# needs no checked multiply; the full validated test runs only on the region that
# actually contains `raw`. The walk used to pay three checked multiplies per region on
# every darray growth move (~12% of a self-host compile in arena_checked_mul_usize).
@internal
def arena_region_contains_address(r: heap Region&, raw: uintptr) -> bool:
    base: mutable uintptr = 0.uintptr()
    trusted Unsafe.PointerCast:
        base <- arena_heap_u8_from_region_data(r).uintptr()
    return false if raw < base
    return (raw - base).usize() < r.capacity * size_of(uintptr)

# Compiler-emitted reclaim of a darray buffer the analyzer proved unreferenced (a reassigned local
# whose old value has no other header copy or view; analyzer_reassign_reclaim.go). size_bytes is
# the buffer's capacity in bytes. A pointer outside `a` is ignored by arena_reclaim_allocation.
def arena_reclaim_bytes(a: mutable Arena&, ptr: mutable void&, size_bytes: usize):
    can Abort.Panic, Atomics{Exchange,Load,Store}, Unsafe.RawExtern:
        return if size_bytes == 0
        (arena_reclaim_allocation(a, ptr, arena_size_bytes_to_slots(size_bytes), size_bytes) can Global{Read,Write})

@internal
def arena_reclaim_allocation(a: mutable Arena&, oldptr: mutable void&, old_slots: usize, old_size: usize):
    can Abort.Panic, Atomics{Exchange,Load,Store}, Unsafe.RawExtern:
        header_slots: usize = (size_of(ArenaFreeBlock) + size_of(uintptr) - 1) / size_of(uintptr)
        return if old_slots < header_slots

        raw: mutable uintptr = 0.uintptr()
        trusted Unsafe.PointerCast:
            raw <- oldptr.cast[heap u8&].uintptr()
        cursor: mutable heap Region&? = a.begin
        while cursor != null:
            if arena_region_contains_address(cursor, raw):
                trusted Unsafe.PointerCast:
                    base: uintptr = arena_heap_u8_from_region_data(cursor).uintptr()
                    if cursor.count > cursor.capacity:
                        panic("arena cursor exceeds region capacity")
                    payload_bytes: usize = arena_region_payload_bytes(cursor.capacity)
                    used_bytes: usize = arena_region_payload_bytes(cursor.count)
                    allocation_bytes: usize = arena_region_payload_bytes(old_slots)
                    if raw >= base:
                        offset_bytes: usize = (raw - base).usize()
                        if offset_bytes % size_of(uintptr) == 0 and offset_bytes <= used_bytes and allocation_bytes <= used_bytes - offset_bytes and offset_bytes <= payload_bytes and allocation_bytes <= payload_bytes - offset_bytes:
                            block: mutable heap ArenaFreeBlock& = oldptr.cast[mutable heap ArenaFreeBlock&]
                            block.slots <- old_slots
                            block.next <- cursor.free_list
                            cursor.free_list as & <- block
                            (arena_cache_record_reclaim(a.cast[uintptr], cursor) can Global{Read,Write})
                            arena_profile_allocation_event(
                                ELISA_PROFILE_ALLOCATION_RECLAIM,
                                0.uintptr(),
                                0.usize(),
                                oldptr.cast[uintptr],
                                old_size,
                                a.cast[uintptr],
                                cursor.global_index
                            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                            return
            cursor <- cursor.next

def free_region(r: heap Region&):
    can Abort.Panic, Atomics{Exchange,Store}, Memory.Release:
        static if ARENA_BACKEND == ARENA_BACKEND_LIBC_MALLOC:
            trusted Unsafe.RawExtern:
                free(arena_heap_void_from_region(r))

        static elif ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP:
            # A fresh anonymous mmap is kernel-zeroed. Restore that invariant before
            # publishing a parked region so a concurrent cache consumer never observes
            # stale bytes from its former owner.
            if (arena_region_cache_try_park(r) can Global{Read,Write}):
                return
            if (arena_reserve_cache_try_park(r) can Global{Read,Write}):
                return
            size_bytes: usize = arena_region_total_bytes(r.capacity)
            ret: mutable int = 0
            trusted Unsafe.RawExtern:
                ret <- munmap(arena_heap_void_from_region(r), size_bytes)
            if ret != 0:
                panic("arena region release failed")

        static elif ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC:
            ok: i32 = VirtualFreeEx(
                GetCurrentProcess(),
                arena_heap_void_from_region(r),
                0,
                MEM_RELEASE
            )
            if ok == 0:
                panic("arena region release failed")

        static elif ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE:
            trusted Unsafe.RawExtern:
                free(arena_heap_void_from_region(r))

# Free a libc-malloc-backed region block (counterpart to new_region_malloc).
@internal
def free_region_malloc(r: heap Region&):
    can Memory.Release, Abort.Panic:
        trusted Unsafe.RawExtern:
            free(arena_heap_void_from_region(r))

# Strategy-dispatching region free. MALLOC frees via libc free (matching new_region_backend's
# MALLOC block source); every other strategy frees via free_region (munmap/VirtualFree).
def free_region_backend(r: heap Region&, strategy: int):
    can Abort.Panic, Atomics{Exchange,Store}, Memory.Release:
        if strategy == ARENA_STRATEGY_MALLOC:
            free_region_malloc(r)
            return
        trusted Unsafe.RawExtern:
            (free_region(r) can Global{Read,Write})

# Intended allocator contract: every returned extent is distinct from every other live extent.
# A block may be reused only after its previous allocation lifetime has ended through
# explicit reclaim/reset/rewind/trim/free; `arena_adopt` transfers extents without ending them.
# The LLVM backend does not publish this as a return `noalias` attribute: arena extents are
# subranges of Region storage, and mutable Arena/Region bookkeeping or source-provided
# replacements can violate malloc-like disjointness from objects accessible to the caller.
# `arena_trim`, reset, rewind, and free require the caller to ensure no later use of pointers
# into the storage they release.
def arena_alloc(a: mutable Arena&, size_bytes: usize) -> mutable heap void&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        size: usize = arena_size_bytes_to_slots(size_bytes)

        # Consume the current bump region before consulting the best-effort free hint. This
        # keeps the common allocation path to a capacity/owner check and leaves reclaimed
        # spans available for requests that cannot use the current bump range.
        current_bump_can_fit: mutable bool = false
        if a.end != null:
            current_bump_can_fit <- arena_region_can_fit(a.end, size)
            if a.strategy != ARENA_STRATEGY_RESERVE_COMMIT and a.strategy != ARENA_STRATEGY_FIXED:
                current_bump_can_fit <- current_bump_can_fit and a.end.owner_tag == 0.uintptr()
        if not current_bump_can_fit and a.begin != null:
            if (arena_take_free_block_chain(a, size, size_bytes) can Abort.Panic, Global{Read,Write}, Atomics.Load) is reclaimed:
                return reclaimed

        # RESERVE_COMMIT / FIXED: one contiguous block, never chained. The block is created
        # up front by the region declaration with the full reservation as its capacity, so
        # allocation just bumps within it (pages commit on first touch under mmap). Overflowing
        # the reservation is a hard error -- chaining a second block would break the contiguous,
        # relocation-free layout the type system relies on, so we panic instead.
        if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
            # Lazy default reservation (docs/73 §3): a reserve_commit arena whose block has not been
            # created yet reserves its default contiguous range on first touch, so empty/tiny regions
            # cost nothing. FIXED and bounded reserve_commit are reserved up front by the region
            # declaration, so they already have a block here.
            if a.end == null:
                cap: mutable usize = arena_default_reserve_slots()
                cap <- size if cap < size
                a.end as & <- (new_region_backend(cap, a.strategy) can Global{Read,Write})
                a.begin <- a.end
                a.end_index <- 0
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                    a.end.cast[uintptr],
                    arena_region_payload_bytes(a.end.capacity),
                    0.uintptr(),
                    0.usize(),
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                current_bump_can_fit <- arena_region_can_fit(a.end, size)
            assert a.end != null
            if not current_bump_can_fit:
                panic("region overflow: reservation exhausted (reserve_commit/fixed)")
            data_base: heap u8& = arena_heap_u8_from_region_data(a.end)
            (arena_profile_region_layout(a, a.end) can Global{Read,Write}) if a.end.count == 0
            offset_bytes: usize = arena_region_payload_bytes(a.end.count)
            result: mutable heap void& = arena_heap_void_from_data_base(data_base, offset_bytes)
            a.end.count <- arena_checked_add_usize(a.end.count, size)
            # Windows: page-in the bytes this allocation now spans (no-op elsewhere).
            arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_ALLOC,
                result.cast[uintptr],
                size_bytes,
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            return result

        if a.end == null:
            assert a.begin == null

            capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
            capacity <- size if capacity < size

            a.end as & <- (new_region_backend(capacity, a.strategy) can Global{Read,Write})
            a.begin <- a.end
            a.end_index <- 0
            a.end.global_index <- 0
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                a.end.cast[uintptr],
                arena_region_payload_bytes(a.end.capacity),
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            current_bump_can_fit <- a.end.owner_tag == 0.uintptr() and arena_region_can_fit(a.end, size)

        assert a.end != null

        trusted Unsafe.AssumeProgress:
            while not current_bump_can_fit and a.end.next != null:
                a.end <- a.end.next
                a.end_index <- a.end_index + 1
                current_bump_can_fit <- a.end.owner_tag == 0.uintptr() and arena_region_can_fit(a.end, size)

        if not current_bump_can_fit:
            assert a.end.next == null

            capacity:mutable usize = ARENA_REGION_DEFAULT_CAPACITY
            capacity <- size if capacity < size

            a.end.next as & <- (new_region_backend(capacity, a.strategy) can Global{Read,Write})
            a.end <- a.end.next
            a.end_index <- a.end_index + 1
            a.end.global_index <- a.end_index
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                a.end.cast[uintptr],
                arena_region_payload_bytes(a.end.capacity),
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                a.end_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        data_base: heap u8& = arena_heap_u8_from_region_data(a.end)
        (arena_profile_region_layout(a, a.end) can Global{Read,Write}) if a.end.count == 0
        offset_bytes: usize = arena_region_payload_bytes(a.end.count)
        result: mutable heap void& = arena_heap_void_from_data_base(data_base, offset_bytes)
        a.end.count <- arena_checked_add_usize(a.end.count, size)
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_ALLOC,
            result.cast[uintptr],
            size_bytes,
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
        return result

# Slot offset of an in-region allocation from the region's data base. All pointer->int
# casts are discharged here so callers (arena_realloc) surface no Unsafe effect.
@internal
def arena_tail_offset_slots(data_base: heap u8&, ptr: void&) -> usize:
    trusted Unsafe.PointerCast:
        return (ptr.cast[heap u8&].usize() - data_base.usize()) / size_of(uintptr)

# Return true only when `ptr` is the complete most-recent allocation in `r`. The
# ownership check is essential for chained arenas: an old pointer may belong to an
# earlier block, and subtracting it from the current block's base would manufacture
# an apparently valid offset. Keep the raw-address arithmetic in this one trusted
# helper so arena_realloc can use the same proof for every strategy.
@internal
def arena_region_is_tail_allocation(r: heap Region&, ptr: void&, size_bytes: usize) -> bool:
    can Abort.Panic:
        base: mutable uintptr = 0.uintptr()
        raw: mutable uintptr = 0.uintptr()
        trusted Unsafe.PointerCast:
            base <- arena_heap_u8_from_region_data(r).uintptr()
            raw <- ptr.cast[heap u8&].uintptr()
        if raw < base:
            return false
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")
        offset_bytes: usize = (raw - base).usize()
        if offset_bytes % size_of(uintptr) != 0:
            return false
        capacity_bytes: usize = arena_region_payload_bytes(r.capacity)
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if offset_bytes > capacity_bytes or size_bytes > capacity_bytes - offset_bytes:
            return false
        if offset_bytes > used_bytes:
            return false
        return size_bytes == used_bytes - offset_bytes

def arena_realloc(a: mutable Arena&, oldptr: mutable void&, oldsz: usize, newsz: usize) -> mutable heap void&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        if newsz <= oldsz:
            return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast

        old_slots: usize = arena_size_bytes_to_slots(oldsz)
        new_slots: usize = arena_size_bytes_to_slots(newsz)
        growth_slots: usize = new_slots - old_slots
        allocation_bytes: usize = arena_region_payload_bytes(old_slots)

        # A darray grows by reallocating its most recent backing allocation in the
        # active arena. Reclaim that tail in place whenever the current block owns it;
        # otherwise the old block may be earlier in a chained arena and cannot move.
        # This is the general path, not just the stable reserve/fixed path, and avoids
        # retaining one dead backing allocation for every geometric growth step.
        if a.end != null and arena_region_is_tail_allocation(a.end, oldptr, allocation_bytes):
            if arena_region_can_fit(a.end, growth_slots):
                a.end.count <- arena_checked_add_usize(a.end.count, growth_slots)
                arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE,
                    oldptr.cast[uintptr],
                    newsz,
                    oldptr.cast[uintptr],
                    oldsz,
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast

        # RESERVE_COMMIT / FIXED grow in place: the base must never move (interior-pointer
        # stability, docs/68 §4). When oldptr is the region's tail allocation we just advance
        # the bump pointer to cover newsz and hand back the SAME pointer -- zero copy, no
        # relocation, pages commit on first touch. Any other case (not the tail, or past the
        # reservation) cannot be honored without moving data, so we panic rather than silently
        # invalidate references the type system already proved stable.
        if a.strategy == ARENA_STRATEGY_RESERVE_COMMIT or a.strategy == ARENA_STRATEGY_FIXED:
            assert a.end != null
            if arena_region_is_tail_allocation(a.end, oldptr, allocation_bytes):
                if not arena_region_can_fit(a.end, growth_slots):
                    panic("region overflow: reservation exhausted (reserve_commit/fixed grow)")
                # The successful tail case returns above; this branch is retained as
                # an explicit invariant guard if the allocator representation changes.
                a.end.count <- arena_checked_add_usize(a.end.count, growth_slots)
                arena_region_ensure_committed(a.end, arena_region_total_bytes(a.end.count))
                arena_profile_allocation_event(
                    ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE,
                    oldptr.cast[uintptr],
                    newsz,
                    oldptr.cast[uintptr],
                    oldsz,
                    a.cast[uintptr],
                    a.end_index
                ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
                return arena_heap_void_from_mutable(oldptr) can Unsafe.PointerCast
            panic("reserve_commit/fixed array cannot grow in place: not the tail allocation")

        newptr: mutable heap void& = (arena_alloc(a, newsz) can Global{Read,Write}, Atomics.Load)

        # memcpy, not a byte loop. Every darray relocation lands here, and the
        # element-per-iteration copy moved one byte per loop trip — megabytes per
        # compile through the geometric-growth steps, and unvectorized in the -O0
        # builds the self-host fixpoint gate runs. The regions never overlap (newptr
        # is a fresh allocation), so plain memcpy is the exact same operation.
        trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
            _ = memcpy(arena_heap_void_from_mutable(newptr).cast[mutable void&], arena_u8_from_void(oldptr).cast[void&], oldsz)

        # The old block is NOT reclaimed. A darray header copy shares its buffer (docs/84):
        # after `b = a` and an allocation that makes `a` stop being the arena tail, `a`'s next
        # growth moves it while `b` still reads the old block, and handing that block to the
        # free list let the next allocation overwrite `b`'s elements (a silent wrong answer in
        # safe code). The block dies with the arena instead, as a Go slice's old backing array
        # does. arena_reclaim_allocation stays for a caller that can prove no copy of the
        # header exists.
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REALLOC_MOVE,
            newptr.cast[uintptr],
            newsz,
            oldptr.cast[uintptr],
            oldsz,
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        return newptr

# ------------------------------------------------------------
# Arena introspection (used by region-backing assertions/tests)
# ------------------------------------------------------------

# Total committed (used) slots across the whole region chain, counted in uintptr
# slots. Walks every region from `begin` regardless of the chained/owner topology,
# so it covers regions split off for packed/SoA store columns too. Read-only — does
# not allocate. Multiply by size_of(uintptr) for a byte figure.
def arena_used_slots(a: mutable Arena&) -> usize:
    total: mutable usize = 0
    cursor: mutable heap Region&? = a.begin
    trusted Unsafe.AssumeProgress:
        while cursor != null:
            total <- total + cursor.count
            cursor <- cursor.next
    return total

# Total committed (used) bytes across the whole region chain.
def arena_used_bytes(a: mutable Arena&) -> usize:
    return arena_used_slots(a) * size_of(uintptr)

# Number of regions (blocks) currently chained into the arena.
def arena_region_count(a: mutable Arena&) -> usize:
    n: mutable usize = 0
    cursor: mutable heap Region&? = a.begin
    trusted Unsafe.AssumeProgress:
        while cursor != null:
            n <- n + 1
            cursor <- cursor.next
    return n

# ------------------------------------------------------------
# Memory/string helpers
# ------------------------------------------------------------

def arena_strlen(s: u8&) -> usize:
    n:mutable usize = 0
    trusted Unsafe.UncheckedIndex:
        trusted Unsafe.AssumeProgress:
            while s[n] != 0:
                n <- n + 1
    return n

def arena_memcpy(dest: mutable void&, src: void&, n: usize) -> mutable void&:
    d: mutable u8& = arena_mutable_u8_from_void(dest)
    s: u8& = arena_u8_from_void(src)

    trusted Unsafe.UncheckedIndex:
        for i in 0..<n:
            d[i] <- s[i]

    return dest

def arena_memeq(lhs: void&, rhs: void&, n: usize) -> bool:
    left: u8& = arena_u8_from_void(lhs)
    right: u8& = arena_u8_from_void(rhs)

    trusted Unsafe.UncheckedIndex:
        for i in 0..<n:
            return false if left[i] != right[i]

    return true

def arena_strdup(a: mutable Arena&, cstr: u8&) -> mutable heap u8&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        n: usize = arena_strlen(cstr)
        allocation_bytes: usize = arena_checked_add_usize(n, 1)
        dup: mutable heap u8& = arena_heap_u8_from_alloc((arena_alloc(a, allocation_bytes) can Global{Read,Write}, Atomics.Load))
        arena_memcpy(arena_void_from_mutable_u8(dup), arena_void_from_u8(cstr), n)
        trusted Unsafe.UncheckedIndex:
            dup[n] <- 0
        return dup

def arena_memdup(a: mutable Arena&, data: void&, size: usize) -> mutable heap void&:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern}:
        dup: mutable heap void& = (arena_alloc(a, size) can Global{Read,Write}, Atomics.Load) can Memory.Allocate, Abort.Panic
        _ = arena_memcpy(dup, data, size)
        return dup

# ------------------------------------------------------------
# Snapshot / rewind / reset / free / trim
# ------------------------------------------------------------

def arena_snapshot(a: Arena&) -> ArenaMark:
    if a.end == null:
        assert a.begin == null
        return ArenaMark{region: null, count: 0}

    return ArenaMark{region: a.end, count: a.end.count}

def arena_reset(a: mutable Arena&):
    can Atomics{Exchange,Load,Store}, Unsafe{PointerCast,RawExtern,UncheckedIndex}:
        r: mutable heap Region&? = a.begin
        trusted Unsafe.AssumeProgress:
            while r != null:
                r.count <- 0
                r.free_list <- null
                r <- r.next

        a.end <- a.begin
        a.end_index <- 0
        (arena_free_hint_clear(a.cast[uintptr]) can Global{Read,Write})
        (collection_arena_memo_pooled(a) can Global{Read,Write})
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REGION_RESET,
            0.uintptr(),
            0.usize(),
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

def arena_rewind(a: mutable Arena&, m: ArenaMark):
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        if m.region == null:
            (arena_reset(a) can Global{Read,Write})
            return

        region: mutable heap Region& = m.region
        region.count <- m.count
        region.free_list <- null

        r: mutable heap Region&? = region.next
        trusted Unsafe.AssumeProgress:
            while r != null:
                r.count <- 0
                r.free_list <- null
                r <- r.next

        a.end as & <- region
        (arena_free_hint_clear(a.cast[uintptr]) can Global{Read,Write})
        (collection_arena_memo_pooled(a) can Global{Read,Write})

        region_index: mutable usize = 0
        current: mutable heap Region&? = a.begin
        trusted Unsafe.AssumeProgress:
            while current != null and current != region:
                current <- current.next
                region_index <- region_index + 1

        assert current != null
        a.end_index <- region_index
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REGION_REWIND,
            region.cast[uintptr],
            m.count * size_of(uintptr),
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            region_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

# Install a caller-frame block as the arena's single region. The backend emits this for a
# reserve_commit stack whose proven element bound fits the block at run time, so the stack
# never needs a second block: allocation bumps within it (overflow still panics on the
# reserve_commit path) and the base never moves. `block` must be uintptr-aligned, hold
# `capacity` payload slots after the Region header, and outlive the arena (it lives in the
# frame of the function that owns the region, which frees the arena before returning).
def arena_init_stack_block(a: mutable Arena&, block: mutable heap void&, capacity: usize):
    can Unsafe.Alias:
        r: mutable heap Region& = arena_region_from_raw(block)
        r.next <- null
        r.count <- 0
        r.capacity <- capacity
        r.owner_tag <- ARENA_OWNER_TAG_STACK.uintptr()
        r.owner_next <- null
        r.global_index <- 0
        r.committed <- 0
        r.free_list <- null
        a.begin as & <- r
        a.end as & <- r
        a.end_index <- 0

def arena_free(a: mutable Arena&):
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Release, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        r: mutable heap Region&? = a.begin

        # Detach the chain BEFORE releasing any block.  Backend epilogues may emit more than
        # one cleanup edge for the same owned carrier (for example, an ordinary fallthrough
        # plus a generated contract/defer edge).  Clearing the header first makes arena_free
        # genuinely idempotent: a second call observes begin == null and cannot traverse or
        # release already-freed memory.
        a.begin as ! <- null
        a.end as ! <- null
        a.end_index <- 0
        (arena_free_hint_clear(a.cast[uintptr]) can Global{Read,Write})

        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REGION_FREE,
            0.uintptr(),
            0.usize(),
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            0.usize()
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        trusted Unsafe.AssumeProgress:
            while r != null:
                r0: mutable heap Region& = r
                r <- r.next
                (collection_stack_memo_forget(r0) can Global{Read,Write}) if r0.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr()
                if r0.owner_tag != ARENA_OWNER_TAG_STACK.uintptr():
                    trusted Unsafe.RawExtern:
                        (free_region_backend(r0, a.strategy) can Global{Read,Write})


def arena_trim(a: mutable Arena&):
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Release, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return if a.end == null

        r: mutable heap Region&? = a.end.next
        trusted Unsafe.AssumeProgress:
            while r != null:
                r0: mutable heap Region& = r
                r <- r.next
                (collection_stack_memo_forget(r0) can Global{Read,Write}) if r0.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr()
                if r0.owner_tag != ARENA_OWNER_TAG_STACK.uintptr():
                    trusted Unsafe.RawExtern:
                        (free_region_backend(r0, a.strategy) can Global{Read,Write})

        a.end.next as ! <- null
        (arena_free_hint_update(a.cast[uintptr], arena_find_free_region(a.begin)) can Global{Read,Write})
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_REGION_TRIM,
            0.uintptr(),
            0.usize(),
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            a.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

# Splice an entire child region's block chain onto the parent (docs/67 adopt).
# Zero-copy: the child's blocks (and the data they already hold) are appended to
# the parent's chain and will be freed when the parent is freed. Each adopted
# block is marked owned so the parent's bump allocator skips it and never
# overwrites its data. The child is then emptied, so its own cleanup is a no-op.
# The semantic layer has already proven the child is consumed and that the two
# backings are compatible (so the parent's free can reclaim the adopted blocks).
def arena_adopt(parent: mutable Arena&, child: mutable Arena&):
    can Atomics{Exchange,Load,Store}, Unsafe{PointerCast,RawExtern,UncheckedIndex}, Unsafe{Alias,PointerCast,UncheckedIndex}:
        return if child.begin == null

        child_free_hint: mutable heap Region&? = (arena_free_hint_get(child.cast[uintptr]) can Global{Read,Write}, Atomics.Load)

        c: mutable heap Region&? = child.begin
        trusted Unsafe.AssumeProgress:
            while c != null:
                (collection_stack_memo_forget(c) can Global{Read,Write}) if c.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr()
                c.owner_tag <- 1.uintptr()
                c <- c.next

        if parent.begin == null:
            parent.begin <- child.begin
            parent.end <- child.begin
            parent.end_index <- 0
        else:
            last: mutable heap Region&? = parent.begin
            trusted Unsafe.AssumeProgress:
                while last != null and last.next != null:
                    last <- last.next
            last.next as & <- child.begin if last != null

        # Free-list reuse and reclaim report each block's parent-chain index. Adopted
        # blocks previously kept child-local indices, aliasing parent blocks in profiler
        # evidence (and subsequent collection-stack indexing). Refresh those indices
        # before publishing the lifecycle event so profile records never alias a
        # child-local index with an existing parent block.
        adopted_index: mutable usize = 0
        adopted_cursor: mutable heap Region&? = parent.begin
        trusted Unsafe.AssumeProgress:
            while adopted_cursor != null:
                adopted_cursor.global_index <- adopted_index
                (arena_profile_region_layout(parent, adopted_cursor) can Global{Read,Write})
                adopted_index <- adopted_index + 1
                adopted_cursor <- adopted_cursor.next

        child.begin as ! <- null
        child.end as ! <- null
        child.end_index <- 0
        (arena_free_hint_transfer(child.cast[uintptr], parent.cast[uintptr], child_free_hint) can Global{Read,Write})
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_ARENA_ADOPT,
            0.uintptr(),
            0.usize(),
            child.cast[uintptr],
            0.usize(),
            parent.cast[uintptr],
            parent.end_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

# ------------------------------------------------------------
# Collection stacks
# ------------------------------------------------------------
# A hash table cannot grow in place: a rehash needs a differently sized table, and the
# old one is dead the moment its last entry moves. Bump-allocated in a region, that dead
# table sat below the live one until the region died -- a dict grown 16 -> 1024 slots
# kept every intermediate table resident. So a growing collection gets two stacks of its
# own and ping-pongs between them: rehash into the spare, which becomes the live table,
# while the old live stack becomes the spare -- reset, never freed, reused on the next
# growth with no allocation at all. Steady state is one live table and one spare holding
# its high-water mark; that retention is the model's accepted cost and what makes the
# next growth free.
#
# A stack IS a region of the arena: created by the arena's own strategy-dispatched block
# source, linked into the `begin` chain, and marked with ARENA_OWNER_TAG_COLLECTION. That
# rides machinery that already exists for packed stores -- arena_alloc skips any owned
# region so nothing is ever bumped into a table (it has no neighbour above it, which is
# the whole point), arena_free frees the chain, arena_reset zeroes every count (which
# POOLS every stack), arena_adopt splices the chain. Nothing is added to Arena: an
# earlier attempt kept a separate list in a new Arena field, and that field was not
# zero-initialised on every path stage0 creates an arena, so arena_free walked garbage.
# A stack is linked at the chain's TAIL and never becomes the bump cursor: the
# reserve/fixed strategies bump straight into a.end without looking at owner_tag.
#
# Claimed: count == the table it holds. Pooled: count == 0. A live table's stack links
# its spare through owner_next; DynDict/DynSet are untouched (pinned in both compilers),
# so the live stack is found by matching the table pointer against the chain.

# Growth used to find a collection's stack by walking the arena's WHOLE region chain
# (every bump block plus every other collection's stack), and a new stack walked the
# chain again for a pooled one and once more for the tail: O(chain) per growth, ~37% of
# a self-compile. Two direct-mapped memo tables make those lookups O(1) on a hit; a miss
# falls back to the original walk, so a memo can only ever make a lookup faster.
#
# COLLECTION_STACK_MEMO: data-base address -> the stack Region, with the arena (address
# and `begin` block) whose chain it was found in or linked into. It is the only memo
# that holds a Region pointer, and it is purged by REGION IDENTITY at the two places a
# stack leaves its chain alive or dead: arena_free/arena_trim (before the block is
# released or parked) and arena_adopt (before the stack is retagged as an adopted
# block). So an entry never names a freed or re-owned region. A hit additionally
# requires the caller's arena address AND its `begin` block to match the entry, so a
# different arena header that reuses an old address cannot pick up another chain's
# stack.
#
# COLLECTION_ARENA_MEMO: arena address (+ `begin`) -> the data base of the last stack
# linked into that arena (resolved through the stack memo, never dereferenced on its
# own) and whether a full walk found NO pooled stack. Both are hints: a stale "no pooled
# stack" only skips reuse and maps a fresh stack, which is always safe; it is cleared on
# reset/rewind (which pool every stack) and when acquire pools a spare.
const COLLECTION_STACK_MEMO_SLOTS: usize = 4096
const COLLECTION_ARENA_MEMO_SLOTS: usize = 256

struct CollectionStackMemoEntry:
    table: mutable uintptr
    region: mutable heap Region&?
    arena: mutable uintptr
    begin: mutable uintptr

struct CollectionArenaMemoEntry:
    arena: mutable uintptr
    begin: mutable uintptr
    last_table: mutable uintptr
    no_pooled: mutable bool
    # When known, no pooled stack of the arena holds more than pooled_bound slots, so an
    # acquire needing more skips the walk over the region chain.
    pooled_bound_known: mutable bool
    pooled_bound: mutable usize

global mutable __elisa_collection_stack_memo: CollectionStackMemoEntry[COLLECTION_STACK_MEMO_SLOTS] = zeroed
global mutable __elisa_collection_arena_memo: CollectionArenaMemoEntry[COLLECTION_ARENA_MEMO_SLOTS] = zeroed

@internal
def collection_memo_hash(key: uintptr, slots: usize) -> usize:
    mixed: uintptr = (key >> 4.uintptr()) ^ (key >> 13.uintptr()) ^ (key >> 22.uintptr())
    return (mixed & (slots - 1).uintptr()).usize()

@internal
def collection_region_addr(r: heap Region&) -> uintptr:
    can Unsafe.PointerCast:
        return r.cast[uintptr]

@internal
def collection_region_table_addr(r: heap Region&) -> uintptr:
    trusted Unsafe.PointerCast:
        return arena_heap_u8_from_region_data(r).cast[uintptr]

@internal
def collection_table_addr(table: void&) -> uintptr:
    trusted Unsafe.PointerCast:
        return table.cast[uintptr]

@internal
def collection_arena_addr(a: Arena&) -> uintptr:
    can Unsafe.PointerCast:
        return a.cast[uintptr]

@internal
def collection_arena_begin_addr(a: Arena&) -> uintptr:
    can Unsafe.PointerCast:
        first: heap Region&? = a.begin
        return 0.uintptr() if first == null
        first_region: heap Region& = first
        return collection_region_addr(first_region)

# Record `r` (a collection stack linked into `a`'s chain) in the stack memo.
@internal
def collection_stack_memo_put(a: Arena&, r: mutable heap Region&):
    can Unsafe{PointerCast,UncheckedIndex}:
        key: uintptr = collection_region_table_addr(r)
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(key, COLLECTION_STACK_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                entry: mutable CollectionStackMemoEntry& = &__elisa_collection_stack_memo[slot]
                entry.table <- key
                entry.region <- r
                entry.arena <- arena_key
                entry.begin <- begin_key
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

# The memoised stack whose data base is `key` in arena `a`, or null.
@internal
def collection_stack_memo_get(a: Arena&, key: uintptr) -> mutable heap Region&?:
    can Unsafe{PointerCast,UncheckedIndex}:
        result: mutable heap Region&? = null
        return result if key == 0.uintptr()
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        return result if begin_key == 0.uintptr()
        slot: usize = collection_memo_hash(key, COLLECTION_STACK_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            entry: CollectionStackMemoEntry& = &__elisa_collection_stack_memo[slot] can Global.Read
            can Global.Read:
                if entry.table == key and entry.arena == arena_key and entry.begin == begin_key:
                    result <- entry.region
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

# Drop `r` from the stack memo. Called for every collection-tagged region before it is
# released, parked or retagged; a no-op when its slot holds another stack.
@internal
def collection_stack_memo_forget(r: heap Region&):
    can Unsafe{PointerCast,UncheckedIndex}:
        key: uintptr = collection_region_table_addr(r)
        region_key: uintptr = collection_region_addr(r)
        slot: usize = collection_memo_hash(key, COLLECTION_STACK_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}, Unsafe.Alias:
                entry: mutable CollectionStackMemoEntry& = &__elisa_collection_stack_memo[slot]
                held: heap Region&? = entry.region
                if held is held_region and collection_region_addr(held_region) == region_key:
                    entry.table <- 0.uintptr()
                    entry.region <- null
                    entry.arena <- 0.uintptr()
                    entry.begin <- 0.uintptr()
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def collection_arena_memo_last_table(a: Arena&) -> uintptr:
    can Unsafe{PointerCast,UncheckedIndex}:
        result: mutable uintptr = 0.uintptr()
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            entry: CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot] can Global.Read
            can Global.Read:
                if entry.arena == arena_key and entry.begin == begin_key:
                    result <- entry.last_table
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

@internal
def collection_arena_memo_no_pooled(a: Arena&) -> bool:
    can Unsafe{PointerCast,UncheckedIndex}:
        result: mutable bool = false
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            entry: CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot] can Global.Read
            can Global.Read:
                if entry.arena == arena_key and entry.begin == begin_key:
                    result <- entry.no_pooled
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

# Update `a`'s arena memo: `last_table` when non-zero, and the no-pooled hint.
@internal
def collection_arena_memo_set(a: Arena&, last_table: uintptr, no_pooled: bool):
    can Unsafe{PointerCast,UncheckedIndex}:
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        return if begin_key == 0.uintptr()
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                entry: mutable CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot]
                if entry.arena != arena_key or entry.begin != begin_key:
                    entry.arena <- arena_key
                    entry.begin <- begin_key
                    entry.last_table <- 0.uintptr()
                    entry.pooled_bound_known <- false
                entry.last_table <- last_table if last_table != 0.uintptr()
                entry.no_pooled <- no_pooled
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

# Reset/rewind pool every stack of `a`: the no-pooled hint no longer holds.
@internal
def collection_arena_memo_pooled(a: Arena&):
    can Unsafe{PointerCast,UncheckedIndex}:
        arena_key: uintptr = collection_arena_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                entry: mutable CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot]
                if entry.arena == arena_key:
                    entry.no_pooled <- false
                    entry.pooled_bound_known <- false
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

# One stack of `capacity` slots was pooled: the no-pooled hint no longer holds, and a
# known bound widens to cover it.
@internal
def collection_arena_memo_pool_one(a: Arena&, capacity: usize):
    can Unsafe{PointerCast,UncheckedIndex}:
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                entry: mutable CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot]
                if entry.arena == arena_key and entry.begin == begin_key:
                    entry.no_pooled <- false
                    entry.pooled_bound <- capacity if entry.pooled_bound_known and capacity > entry.pooled_bound
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

# A full walk saw every pooled stack of `a`; none holds more than `bound` slots.
@internal
def collection_arena_memo_bound_set(a: Arena&, bound: usize):
    can Unsafe{PointerCast,UncheckedIndex}:
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                entry: mutable CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot]
                if entry.arena == arena_key and entry.begin == begin_key:
                    entry.pooled_bound_known <- true
                    entry.pooled_bound <- bound
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

# Whether a pooled stack of `a` could hold `needed_slots`, as far as the memo knows.
@internal
def collection_arena_memo_may_fit(a: Arena&, needed_slots: usize) -> bool:
    can Unsafe{PointerCast,UncheckedIndex}:
        result: mutable bool = true
        arena_key: uintptr = collection_arena_addr(a)
        begin_key: uintptr = collection_arena_begin_addr(a)
        slot: usize = collection_memo_hash(arena_key, COLLECTION_ARENA_MEMO_SLOTS)
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            entry: CollectionArenaMemoEntry& = &__elisa_collection_arena_memo[slot] can Global.Read
            can Global.Read:
                if entry.arena == arena_key and entry.begin == begin_key:
                    result <- false if entry.no_pooled or (entry.pooled_bound_known and needed_slots > entry.pooled_bound)
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

# The table a stack holds: its data base.
def collection_stack_table(r: heap Region&) -> mutable heap void&:
    return arena_heap_void_from_data_base(arena_heap_u8_from_region_data(r), 0)

# The collection stack whose data base IS `table`, or null. A dict/set built from a
# literal or comprehension gets its first table straight from the bump chain (the
# backend allocates it), so a table pointer alone cannot be assumed to sit at a stack's
# base -- matched, never computed. Walked only on growth.
@internal
def collection_stack_of_table(a: mutable Arena&, table: void&) -> mutable heap Region&?:
    can Atomics{Exchange,Store}, Unsafe{Alias,PointerCast,UncheckedIndex}:
        target: uintptr = collection_table_addr(table)
        memo: mutable heap Region&? = (collection_stack_memo_get(a, target) can Global{Read,Write})
        if memo is memo_stack and memo_stack.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr():
            return memo_stack
        trusted Unsafe.AssumeProgress:
            cursor: mutable heap Region&? = a.begin
            while cursor != null:
                found: mutable heap Region& = cursor
                if found.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr() and collection_region_table_addr(found) == target:
                    (collection_stack_memo_put(a, found) can Global{Read,Write})
                    return found
                cursor <- found.next
        return null

# Link a fresh stack at the chain's tail. Never at a.end: an empty arena first
# materialises its own block through its strategy's path (one slot, once), so the bump
# cursor is always an ordinary block.
@internal
def collection_stack_link(a: mutable Arena&, fresh: mutable heap Region&):
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        if a.end == null:
            _ = (arena_alloc(a, size_of(uintptr)) can Global{Read,Write}, Atomics.Load)
        assert a.end != null
        last_block: mutable heap Region&? = a.end
        # The last stack linked into this arena is at or past the tail found last time;
        # start there instead of re-walking every stack behind a.end.
        last_linked: mutable heap Region&? = (collection_stack_memo_get(a, collection_arena_memo_last_table(a)) can Global{Read,Write})
        last_block <- last_linked if last_linked != null
        trusted Unsafe.AssumeProgress:
            while last_block != null and last_block.next != null:
                last_block <- last_block.next
        assert last_block != null
        tail_region: mutable heap Region& = last_block
        tail_region.next as & <- fresh
        fresh.global_index <- tail_region.global_index + 1
        (collection_stack_memo_put(a, fresh) can Global{Read,Write})
        (collection_arena_memo_set(a, collection_region_table_addr(fresh), collection_arena_memo_no_pooled(a)) can Global{Read,Write})

# Claim a stack for a table of `needed_slots` (uintptr slots) in arena `a`, for the
# collection whose current table is `live_table` (null when it has none). Preference:
# the collection's own spare when the table fits; a pooled stack that fits; a fresh
# mapping. The result is claimed and committed where that is a separate step; the CALLER
# zeroes the buckets, because a reused stack still holds the dead table. When the
# collection had a live stack, it becomes the returned stack's spare.
def collection_stack_acquire(a: mutable Arena&, live_table: void&?, needed_slots: usize) -> mutable heap Region&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        live: mutable heap Region&? = null
        chosen: mutable heap Region&? = null
        if live_table != null:
            live_ref: void& = live_table
            live <- (collection_stack_of_table(a, live_ref) can Global{Read,Write})
            if live != null:
                live_stack: mutable heap Region& = live
                spare: mutable heap Region&? = live_stack.owner_next
                chosen <- spare if spare != null and spare.capacity >= needed_slots

        if chosen == null and (collection_arena_memo_may_fit(a, needed_slots) can Global{Read,Write}):
            probe: mutable heap Region&? = a.begin
            saw_pooled: mutable bool = false
            largest_pooled: mutable usize = 0
            trusted Unsafe.AssumeProgress:
                while probe != null:
                    if probe.owner_tag == ARENA_OWNER_TAG_COLLECTION.uintptr() and probe.count == 0:
                        saw_pooled <- true
                        if probe.capacity >= needed_slots:
                            chosen <- probe
                            probe <- null
                        else:
                            largest_pooled <- probe.capacity if probe.capacity > largest_pooled
                            probe <- probe.next
                    else:
                        probe <- probe.next
            # A full walk that met no pooled stack at all: later acquires skip the walk
            # until something pools a stack again.
            (collection_arena_memo_set(a, 0.uintptr(), true) can Global{Read,Write}) if not saw_pooled
            # A full walk that found no fit: later acquires larger than every pooled stack
            # skip the walk until a reset pools stacks of unknown size.
            (collection_arena_memo_bound_set(a, largest_pooled) can Global{Read,Write}) if chosen == null

        # Fresh, from the arena's own block source so arena_free's strategy-dispatched
        # free matches it. Running out is a panic inside new_region_*; there is no error
        # to return.
        if chosen == null:
            capacity: mutable usize = COLLECTION_STACK_RESERVE_SLOTS
            if needed_slots > capacity / 2:
                capacity <- arena_checked_mul_usize(needed_slots, 2)
            fresh: mutable heap Region& = (new_region_backend(capacity, a.strategy) can Global{Read,Write})
            fresh.owner_tag <- ARENA_OWNER_TAG_COLLECTION.uintptr()
            (collection_stack_link(a, fresh) can Global{Read,Write}, Atomics.Load)
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_REGION_CREATE,
                fresh.cast[uintptr],
                arena_region_payload_bytes(fresh.capacity),
                0.uintptr(),
                0.usize(),
                a.cast[uintptr],
                fresh.global_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}
            chosen <- fresh

        assert chosen != null
        claimed: mutable heap Region& = chosen
        (collection_stack_memo_put(a, claimed) can Global{Read,Write})
        claimed.count <- needed_slots
        claimed.free_list <- null
        arena_region_ensure_committed(claimed, arena_region_total_bytes(needed_slots))
        (arena_profile_region_layout(a, claimed) can Global{Read,Write})
        arena_profile_allocation_event(
            ELISA_PROFILE_ALLOCATION_ALLOC,
            collection_stack_table(claimed).cast[uintptr],
            arena_region_payload_bytes(needed_slots),
            0.uintptr(),
            0.usize(),
            a.cast[uintptr],
            claimed.global_index
        ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

        # Ping-pong: the old live stack is the new spare. A spare too small for this table
        # is unpaired and pooled for a smaller one.
        if live != null:
            old_live: mutable heap Region& = live
            dropped: mutable heap Region&? = old_live.owner_next
            if dropped != null and dropped != chosen:
                dropped_stack: mutable heap Region& = dropped
                dropped_stack.count <- 0
                dropped_stack.owner_next <- null
                (collection_arena_memo_pool_one(a, dropped_stack.capacity) can Global{Read,Write})
            old_live.owner_next <- null
            claimed.owner_next <- old_live
        else:
            claimed.owner_next <- null
        return claimed

# Rehash callers invoke this only after the last read of the old table. The stack
# remains pooled for reuse, but the profiler must see the logical retirement so
# allocation pressure and retained table capacity are not understated.
def collection_stack_profile_release(a: mutable Arena&, table: void&?) -> void:
    can Atomics{Exchange,Load,Store}, Unsafe{Alias,PointerCast,RawExtern,UncheckedIndex}:
        return if:
            table == null
            not (arena_profile_allocation_supported() can Global{Read,Write}, Atomics{Exchange,Load,Store})
        old_table: void& = table
        old_backing: mutable heap Region&? = (collection_stack_of_table(a, old_table) can Global{Read,Write})
        if old_backing != null:
            arena_profile_allocation_event(
                ELISA_PROFILE_ALLOCATION_RECLAIM,
                0.uintptr(),
                0.usize(),
                old_table.cast[uintptr],
                old_backing.count * size_of(uintptr),
                a.cast[uintptr],
                old_backing.global_index
            ) can Global{Read,Write}, Atomics{Exchange,Load,Store}

# ------------------------------------------------------------
# Optional stdio formatting stubs
# ------------------------------------------------------------

extern va_list
extern va_copy(args: va_list) -> va_list
extern va_end(args: va_list)

extern vsnprintf(
    buffer: u8&?,
    buffer_size: usize,
    format: u8&,
    args: va_list
) -> i32

def arena_vsprintf(a: mutable Arena&, format: u8&, args: va_list) -> mutable heap u8&:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Console.Format, Memory.Allocate, Unsafe{Alias,PointerCast,RawExtern}:
        args_copy: mutable va_list = args
        n: mutable int = -1
        trusted Unsafe.RawExtern:
            args_copy <- va_copy(args)
            n <- vsnprintf(null, 0, format, args_copy)
            va_end(args_copy)

        assert n >= 0

        allocation_bytes: usize = arena_checked_add_usize(n.usize(), 1)
        result: mutable heap u8& = arena_heap_u8_from_alloc((arena_alloc(a, allocation_bytes) can Global{Read,Write}, Atomics.Load))
        trusted Unsafe.RawExtern:
            _ = vsnprintf(arena_nullable_u8_from_heap(result), allocation_bytes, format, args)
        return result
