# Freestanding runtime support for WASM component canonical ABI lowering.
#
# This file is deliberately independent of the host/native Elisa runtime. A WIT
# string or list lowerer may call `cabi_realloc`; the component must satisfy that
# call inside linear memory without importing libc, `env`, or JavaScript glue.

@intrinsic("llvm.wasm.memory.grow.i32")
extern wasm_memory_grow(memory_index: u32, pages: u32) -> i32

@intrinsic("llvm.wasm.memory.size.i32")
extern wasm_memory_size(memory_index: u32) -> u32

@intrinsic("llvm.trap")
extern wasm_trap() -> void

global mutable wasm_component_heap_cursor: u32 = 1048576
global mutable wasm_component_free_chunk: u32 = 0

# The compiler's Arena is four wasm32 words:
#   begin, end, end_index, strategy
#
# Component mode intentionally does not link the native Region implementation, but it
# still receives pointers to this ABI-shaped value from generated code. Keep the private
# component representation bit-compatible with that layout. `begin` and `end` point at
# component chunk headers; `end_index` is the used payload byte count of the active chunk.
# `strategy` remains owned by the compiler and is not interpreted here.
struct WasmComponentArenaState:
    begin: mutable u32
    end: mutable u32
    end_index: mutable u32
    strategy: mutable i32

const WASM_COMPONENT_CHUNK_HEADER_BYTES: u32 = 8
const WASM_COMPONENT_CHUNK_DEFAULT_BYTES: u32 = 65536

def wasm_component_arena_state(a: mutable void&) -> mutable WasmComponentArenaState&:
    trusted Unsafe.PointerCast:
        return a.cast[mutable WasmComponentArenaState&]

def wasm_component_load_word(address: u32) -> u32:
    trusted [Unsafe.PointerCast, Unsafe.UncheckedIndex]:
        words: u32& = address.cast[u8&].cast[u32&]
        return words[0]

def wasm_component_store_word(address: u32, value: u32):
    trusted [Unsafe.PointerCast, Unsafe.UncheckedIndex]:
        words: mutable u32& = address.cast[mutable u8&].cast[mutable u32&]
        words[0] <- value

# The normal Elisa container lowering uses the same arena ABI as native code:
# `arena_alloc(arena, bytes)` and `arena_realloc(arena, old, old_bytes,
# new_bytes)`. Component guests do not have the native Region implementation,
# but they still need ordinary darrays for local list construction and canonical
# WIT lowering.
#
# Each owned arena gets a linked list of linear-memory chunks. A chunk is never
# returned to the global bump cursor: CABI strings/lists may have been allocated
# after it. Instead, arena_free moves whole chunks to a private reusable free list.
# This gives arena lifetimes real reclamation without invalidating unrelated live
# allocations. Reallocation remains copy-and-grow within the same arena; all of
# its old backing becomes reclaimable when the arena is freed.
def wasm_component_align_up(value: u32, alignment: u32) -> u32:
    return value if alignment <= 1
    remainder: u32 = value % alignment
    return value if remainder == 0
    delta: u32 = alignment - remainder
    result: u32 = value + delta
    if result < value:
        wasm_trap()
        return 0
    return result

def wasm_component_ensure_capacity(end: u32):
    current: u32 = wasm_memory_size(0) * 65536
    if end > current:
        needed: u32 = end - current
        pages: mutable u32 = needed / 65536
        pages <- pages + 1 if needed % 65536 != 0
        result: i32 = wasm_memory_grow(0, pages)
        if result < 0:
            wasm_trap()

def wasm_component_chunk_take(required_bytes: u32) -> u32:
    requested: mutable u32 = required_bytes if required_bytes > WASM_COMPONENT_CHUNK_DEFAULT_BYTES else WASM_COMPONENT_CHUNK_DEFAULT_BYTES
    requested <- wasm_component_align_up(requested, 8)

    previous: mutable u32 = 0
    candidate: mutable u32 = wasm_component_free_chunk
    while candidate != 0:
        capacity: u32 = wasm_component_load_word(candidate + 4)
        next: u32 = wasm_component_load_word(candidate)
        if capacity >= requested:
            if previous == 0:
                wasm_component_free_chunk <- next
            else:
                wasm_component_store_word(previous, next)
            wasm_component_store_word(candidate, 0)
            return candidate
        previous <- candidate
        candidate <- next

    start: u32 = wasm_component_align_up(wasm_component_heap_cursor, 8)
    payload: u32 = start + WASM_COMPONENT_CHUNK_HEADER_BYTES
    end: u32 = payload + requested
    if payload < start or end < payload:
        wasm_trap()
        return 0
    wasm_component_ensure_capacity(end)
    wasm_component_heap_cursor <- end
    wasm_component_store_word(start, 0)
    wasm_component_store_word(start + 4, requested)
    return start

def wasm_component_arena_alloc(a: mutable void&, size_bytes: usize) -> u32:
    state: mutable WasmComponentArenaState& = wasm_component_arena_state(a)
    requested: mutable u32 = size_bytes.u32()
    requested <- 1 if requested == 0
    requested <- wasm_component_align_up(requested, 8)

    current: u32 = state.end
    if current != 0:
        capacity: u32 = wasm_component_load_word(current + 4)
        used: u32 = state.end_index
        if used <= capacity and requested <= capacity - used:
            result: u32 = current + WASM_COMPONENT_CHUNK_HEADER_BYTES + used
            state.end_index <- used + requested
            return result

    fresh: u32 = wasm_component_chunk_take(requested)
    if state.end != 0:
        wasm_component_store_word(state.end, fresh)
    else:
        state.begin <- fresh
    state.end <- fresh
    state.end_index <- requested
    return fresh + WASM_COMPONENT_CHUNK_HEADER_BYTES

def arena_alloc(a: mutable void&, size_bytes: usize) -> mutable void&:
    return wasm_component_arena_alloc(a, size_bytes).cast[mutable void&]

def arena_realloc(
    a: mutable void&,
    oldptr: mutable void&,
    oldsz: usize,
    newsz: usize
) -> mutable void&:
    return oldptr if newsz <= oldsz
    newptr: mutable void& = arena_alloc(a, newsz)
    trusted [Unsafe.PointerCast]:
        destination: u32 = newptr.cast[uintptr].u32()
        source: u32 = oldptr.cast[uintptr].u32()
        wasm_component_copy_bytes(destination, source, oldsz.u32())
    return newptr

def arena_free(a: mutable void&) -> void:
    state: mutable WasmComponentArenaState& = wasm_component_arena_state(a)
    current: mutable u32 = state.begin
    while current != 0:
        next: u32 = wasm_component_load_word(current)
        wasm_component_store_word(current, wasm_component_free_chunk)
        wasm_component_free_chunk <- current
        current <- next
    state.begin <- 0
    state.end <- 0
    state.end_index <- 0

def wasm_component_copy_bytes(destination: u32, source: u32, count: u32):
    trusted [Unsafe.PointerCast, Unsafe.PointerArithmetic, Unsafe.UncheckedIndex]:
        dst: mutable u8& = destination.cast[mutable u8&]
        src: u8& = source.cast[u8&]
        for index in 0..<count.usize():
            dst[index] <- src[index]

# Canonical ABI allocator signature:
#   cabi_realloc(old_ptr, old_size, align, new_size) -> new_ptr
# The linker calls this for WIT strings/lists/results. Most allocations remain
# monotonic, but the top allocation is resized or released in place. Canonical
# lowering commonly follows a LIFO lifetime, so this small rule prevents a
# long-running guest from leaking every temporary string/list buffer while
# keeping the runtime independent of host allocation functions.
def wasm_component_cabi_realloc(
    old_ptr: u32,
    old_size: u32,
    alignment: u32,
    new_size: u32
) -> u32:
    effective_alignment: u32 = alignment if alignment > 0 else 1

    old_end: u32 = old_ptr + old_size
    old_is_top: bool = old_ptr != 0 and old_end >= old_ptr and old_end == wasm_component_heap_cursor

    if new_size == 0:
        wasm_component_heap_cursor <- old_ptr if old_is_top
        return 0

    if old_is_top and old_ptr % effective_alignment == 0:
        resized_end: u32 = old_ptr + new_size
        if resized_end < old_ptr:
            wasm_trap()
            return 0
        wasm_component_ensure_capacity(resized_end)
        wasm_component_heap_cursor <- resized_end
        return old_ptr

    start: u32 = wasm_component_align_up(wasm_component_heap_cursor, effective_alignment)
    end: u32 = start + new_size
    if end < start:
        wasm_trap()
        return 0
    wasm_component_ensure_capacity(end)
    wasm_component_copy_bytes(start, old_ptr, old_size if old_size < new_size else new_size) if old_ptr != 0
    wasm_component_heap_cursor <- end
    return start

export fn cabi_realloc(old_ptr: u32, old_size: u32, alignment: u32, new_size: u32) -> u32 = wasm_component_cabi_realloc
