struct ArenaRegionCache:
    slot: mutable heap Region&?
    # Number of regions currently parked on `slot` (bounded by REGION_CACHE_MAX_ENTRIES).
    # Keep the historical field name because it is part of the runtime interface layout.
    reclaimed_spans: mutable usize

global mutable __elisa_region_cache: ArenaRegionCache = ArenaRegionCache{slot: null, reclaimed_spans: 0}

# A single best-effort reclaimed-span hint. The key prevents a hint belonging to a freed or
# unrelated arena from suppressing a valid allocation. Keeping this separate from Arena avoids
# changing the public carrier layout consumed by the stage0 runtime interface.
struct ArenaFreeHint:
    owner: mutable uintptr
    region: mutable heap Region&?

global mutable __elisa_free_hint: ArenaFreeHint = ArenaFreeHint{owner: 0.uintptr(), region: null}

# Atomic advisory owner tag for the free hint. The common no-hint/mismatched-owner path reads
# this scalar without contending on the shared cache lock; a matching tag is always rechecked
# under that lock before the region pointer is read. Relaxed ordering is enough for this filter:
# stale mismatches only miss the fast path, while the lock synchronizes access to the hint itself.
# It stays outside Arena to preserve its ABI.
global mutable __elisa_free_hint_owner_cell: AtomicCell[uintptr] = zeroed

@internal
def arena_free_hint_fast_owner() -> uintptr:
    result: mutable uintptr = 0.uintptr()
    static if ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_relaxed(&__elisa_free_hint_owner_cell)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                can Atomics.Load:
                    result <- atomic_load_relaxed(&__elisa_free_hint_owner_cell)
    static else:
        # The arena cache lock is also a no-op on single-threaded targets such as WASM.
        trusted Unsafe.MutableGlobal:
            can Global.Read:
                result <- __elisa_free_hint_owner_cell.slot.value
    return result

@internal
def arena_free_hint_fast_owner_publish(owner: uintptr):
    static if ELISA_TARGET_OS_POSIX:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_relaxed(&__elisa_free_hint_owner_cell, owner)
    static elif ELISA_TARGET_OS_WINDOWS:
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                can Atomics.Store:
                    atomic_store_relaxed(&__elisa_free_hint_owner_cell, owner)
    static else:
        # Keep the no-thread target on ordinary loads/stores, matching its cache-lock policy.
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                __elisa_free_hint_owner_cell.slot.value <- owner

@internal
def arena_region_cache_take(capacity: usize, owner_tag: uintptr) -> mutable heap Region&?:
    can Unsafe.Alias:
        result: mutable heap Region&? = null
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                reuse_cache: mutable ArenaRegionCache& = &__elisa_region_cache
                reuse_previous: mutable heap Region&? = null
                reuse_cursor: mutable heap Region&? = reuse_cache.slot
                reuse_probes: mutable usize = REGION_CACHE_MAX_ENTRIES
                while reuse_cursor != null and reuse_probes > 0:
                    reuse_probes <- reuse_probes - 1
                    cache_candidate: mutable heap Region&? = reuse_cursor
                    if cache_candidate is cached and cached.capacity >= capacity:
                        if reuse_previous is previous:
                            previous.next <- cached.next
                        else:
                            reuse_cache.slot <- cached.next
                        reuse_cache.reclaimed_spans <- reuse_cache.reclaimed_spans - 1 if reuse_cache.reclaimed_spans > 0
                        cached.next <- null
                        cached.count <- 0
                        cached.owner_tag <- owner_tag
                        cached.owner_next <- null
                        cached.global_index <- 0
                        cached.committed <- 0
                        cached.free_list <- null
                        result <- cached
                        break
                    reuse_previous <- reuse_cursor
                    reuse_cursor <- reuse_cursor.next
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

@internal
def arena_free_hint_get(owner: uintptr) -> mutable heap Region&?:
    # A miss is advisory only: a concurrent writer may publish this owner immediately after
    # the load, in which case this allocation simply falls back to bump allocation. On a hit,
    # the lock below still protects both owner validation and the region pointer's lifetime.
    can Global.Read, Atomics.Load:
        return null if arena_free_hint_fast_owner() != owner
    result: mutable heap Region&? = null
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        hint: ArenaFreeHint& = &__elisa_free_hint can Global.Read
        can Global.Read:
            result <- hint.region if hint.owner == owner
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
    return result

@internal
def arena_free_hint_set(owner: uintptr, region: mutable heap Region&?):
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            hint.owner <- owner
            hint.region <- region
    published_owner: uintptr = owner if region != null else 0.uintptr()
    can Global{Read,Write}:
        arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_update(owner: uintptr, region: mutable heap Region&?):
    matched: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == owner:
                hint.region <- region
                matched <- true
    if matched:
        published_owner: uintptr = owner if region != null else 0.uintptr()
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_clear(owner: uintptr):
    # Every writer publishes the fast owner under the lock whenever the hint names a live
    # region, and only this arena's own thread frees it, so a mismatch here means the hint
    # holds no region of ours. A stale owner with a null region left behind is inert.
    can Global.Read, Atomics.Load:
        return if arena_free_hint_fast_owner() != owner
    matched: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == owner:
                hint.owner <- 0.uintptr()
                hint.region <- null
                matched <- true
    if matched:
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(0.uintptr())
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_free_hint_transfer(child: uintptr, parent: uintptr, child_region: mutable heap Region&?):
    transferred: mutable bool = false
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            if hint.owner == child and child_region != null:
                hint.owner <- parent
                hint.region <- child_region
                transferred <- true
    if transferred:
        can Global{Read,Write}:
            arena_free_hint_fast_owner_publish(parent)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_cache_record_reclaim(owner: uintptr, region: mutable heap Region&?):
    __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
    trusted Unsafe.MutableGlobal:
        can Global{Read,Write}:
            # A reclaimed span stays inside its own arena's region and is released with
            # that arena, so it must not consume the parked-region budget: charging it
            # here (with only a cache hit ever refunding) permanently closed the cache
            # after 128 reclaims and sent every later free_region to munmap.
            hint: mutable ArenaFreeHint& = &__elisa_free_hint
            hint.owner <- owner
            hint.region <- region
    published_owner: uintptr = owner if region != null else 0.uintptr()
    can Global{Read,Write}:
        arena_free_hint_fast_owner_publish(published_owner)
    __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store

@internal
def arena_region_cache_try_park(r: heap Region&) -> bool:
    can Abort.Panic:
        return false if r.capacity > REGION_CACHE_MAX_SLOTS
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")

        # Zero before publishing the block in the shared list. The region is still
        # exclusively owned by this release operation and this work need not extend the
        # critical section. The room check happens once, under the lock below: a full
        # cache only wastes this memset, while a pre-check cost a lock round-trip on
        # every call-scoped region free.
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if used_bytes > 0:
            trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                _ = memset(arena_heap_u8_from_region_data(r).cast[mutable void&], 0, used_bytes)

        parked_ok: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                cache: mutable ArenaRegionCache& = &__elisa_region_cache
                if cache.reclaimed_spans < REGION_CACHE_MAX_ENTRIES:
                    trusted Unsafe.PointerCast:
                        parked: mutable heap Region& = r.cast[mutable heap Region&]
                        parked.next <- cache.slot
                        cache.slot <- parked
                    cache.reclaimed_spans <- cache.reclaimed_spans + 1
                    parked_ok <- true
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return parked_ok

# Largest region the cache will park, in SLOTS (uintptr-sized): 128Ki slots = 1 MiB of
# payload on 64-bit. Scratch regions are far smaller; anything bigger is unmapped as
# before so RSS never pins a large one-off block.
const REGION_CACHE_MAX_SLOTS: usize = 131072
const REGION_CACHE_MAX_ENTRIES: usize = 128

# RESERVATION-sized regions get a parked list of their own. stage0 gives every function's
# auto region the reserve_commit strategy, so in a stage0-built program (the seed product)
# the first allocation of EVERY call maps a 256 MiB reservation and its arena_free unmaps
# it again: 23.8k mmap/munmap pairs compiling just the runtime, ~760k for the self-compile,
# each re-faulting the pages it touches (8.5M minor faults, ~60 s of system time). The
# reservation itself is address space, not memory, so parking it is free; what a parked
# block pins is only the pages its last owner touched, and those are zeroed on park. A
# region whose owner touched more than RESERVE_CACHE_MAX_USED_SLOTS is unmapped exactly as
# before, so the parked list can never hold more than
# RESERVE_CACHE_MAX_ENTRIES * RESERVE_CACHE_MAX_USED_SLOTS words resident (8 MiB on 64-bit).
# Kept apart from the small list so a 1 MiB request never takes (and chains into) a
# reservation, and a reservation request never walks 128 small blocks.
const RESERVE_CACHE_MAX_ENTRIES: usize = 32
const RESERVE_CACHE_MAX_USED_SLOTS: usize = 32768

global mutable __elisa_reserve_region_cache: ArenaRegionCache = ArenaRegionCache{slot: null, reclaimed_spans: 0}

@internal
def arena_reserve_cache_take(capacity: usize, owner_tag: uintptr) -> mutable heap Region&?:
    can Unsafe.Alias:
        result: mutable heap Region&? = null
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                reuse_cache: mutable ArenaRegionCache& = &__elisa_reserve_region_cache
                reuse_previous: mutable heap Region&? = null
                reuse_cursor: mutable heap Region&? = reuse_cache.slot
                reuse_probes: mutable usize = RESERVE_CACHE_MAX_ENTRIES
                while reuse_cursor != null and reuse_probes > 0:
                    reuse_probes <- reuse_probes - 1
                    cache_candidate: mutable heap Region&? = reuse_cursor
                    if cache_candidate is cached and cached.capacity >= capacity:
                        if reuse_previous is previous:
                            previous.next <- cached.next
                        else:
                            reuse_cache.slot <- cached.next
                        reuse_cache.reclaimed_spans <- reuse_cache.reclaimed_spans - 1 if reuse_cache.reclaimed_spans > 0
                        cached.next <- null
                        cached.count <- 0
                        cached.owner_tag <- owner_tag
                        cached.owner_next <- null
                        cached.global_index <- 0
                        cached.committed <- 0
                        cached.free_list <- null
                        result <- cached
                        break
                    reuse_previous <- reuse_cursor
                    reuse_cursor <- reuse_cursor.next
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return result

@internal
def arena_reserve_cache_try_park(r: heap Region&) -> bool:
    can Abort.Panic:
        return false if r.capacity <= REGION_CACHE_MAX_SLOTS
        if r.count > r.capacity:
            panic("arena cursor exceeds region capacity")
        return false if r.count > RESERVE_CACHE_MAX_USED_SLOTS

        room: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            cache: ArenaRegionCache& = &__elisa_reserve_region_cache can Global.Read
            can Global.Read:
                room <- cache.reclaimed_spans < RESERVE_CACHE_MAX_ENTRIES
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return false if not room

        # Same zeroing contract as the small list: a fresh anonymous mmap is kernel-zeroed.
        used_bytes: usize = arena_region_payload_bytes(r.count)
        if used_bytes > 0:
            trusted [Unsafe.PointerCast, Unsafe.RawExtern]:
                _ = memset(arena_heap_u8_from_region_data(r).cast[mutable void&], 0, used_bytes)

        parked_ok: mutable bool = false
        __elisa_arena_cache_lock_acquire() can Global{Read,Write}, Atomics.Exchange
        trusted Unsafe.MutableGlobal:
            can Global{Read,Write}:
                cache: mutable ArenaRegionCache& = &__elisa_reserve_region_cache
                if cache.reclaimed_spans < RESERVE_CACHE_MAX_ENTRIES:
                    trusted Unsafe.PointerCast:
                        parked: mutable heap Region& = r.cast[mutable heap Region&]
                        parked.next <- cache.slot
                        cache.slot <- parked
                    cache.reclaimed_spans <- cache.reclaimed_spans + 1
                    parked_ok <- true
        __elisa_arena_cache_lock_release() can Global{Read,Write}, Atomics.Store
        return parked_ok

@internal
