# ============================================================
# Elisa core Runtime - arbitrary-precision signed integers
# ============================================================
#
# BigInt is sign + magnitude. The magnitude is little-endian base-2^64 limbs held in
# a darray[u64]. Limb products use the compiler builtins `elisa.mul_hi.u64` (high
# half of the 128-bit product; the low half is the wrapping `a * b`) and
# `elisa.div_wide.u64` (128-by-64 quotient), both lowered to LLVM i128 arithmetic
# and inlined. Invariant ("normalized"): the top limb is non-zero, and zero is the
# empty magnitude with `negative == false`.
#
# Operations mutate a destination in place (GMP style) so hot loops reuse limb storage:
#   bigint_assign / bigint_set_u64 / bigint_set_i64 / bigint_set_decimal
#   bigint_add_assign / bigint_sub_assign         dst += src / dst -= src
#   bigint_addmul_small / bigint_submul_small     dst += src*k / dst -= src*k   (k: u64)
#   bigint_mul_small_assign                       dst *= k
#   bigint_mul                                    dst = a*b (schoolbook)
#   bigint_divmod / bigint_divmod_with            truncated q, r (Knuth algorithm D)
#   bigint_div_with                               truncated q only, reusable scratch
#   bigint_divmod_small_assign                    dst /= k, returns |remainder|
#   bigint_compare / bigint_compare_abs / bigint_sign / bigint_is_zero
#   bigint_low_u64 / bigint_append_decimal
#
# Division truncates toward zero (C/Rust/GMP tdiv): q = trunc(a/b), r = a - q*b, so r
# takes the sign of a. Dividing by zero panics.

const BIGINT_DECIMAL_CHUNK: u64 = 1000000000000000000   # 10^18
const BIGINT_DECIMAL_CHUNK_DIGITS: usize = 18

@intrinsic("elisa.mul_hi.u64")
extern bigint_mul_hi(a: u64, b: u64) -> u64

@intrinsic("elisa.div_wide.u64")
extern bigint_div_wide(high: u64, low: u64, divisor: u64) -> u64

struct BigInt:
    negative: mutable bool
    limbs: mutable darray[u64]

# Reusable working storage for long division (the normalized divisor and numerator).
# Passing one to bigint_divmod_with keeps repeated divisions allocation-free.
struct BigIntDivScratch:
    divisor: mutable darray[u64]
    numerator: mutable darray[u64]

def bigint_div_scratch() -> BigIntDivScratch:
    return BigIntDivScratch{divisor: [], numerator: []}

def bigint_zero() -> BigInt:
    return BigInt{negative: false, limbs: []}

def bigint_from_u64(value: u64) -> BigInt can[Abort.Panic, Memory.Allocate]:
    limbs: mutable darray[u64] = []
    limbs.push(value) if value != 0
    return BigInt{negative: false, limbs: limbs}

def bigint_from_i64(value: i64) -> BigInt can[Abort.Panic, Memory.Allocate]:
    return bigint_from_u64(value.u64()) if value >= 0
    # -(value + 1) cannot overflow, even for the i64 minimum.
    limbs: mutable darray[u64] = []
    limbs.push((0 - (value + 1)).u64() + 1)
    return BigInt{negative: true, limbs: limbs}

def bigint_is_zero(value: BigInt&) -> bool:
    return value.limbs.count == 0

def bigint_sign(value: BigInt&) -> i32:
    return 0 if value.limbs.count == 0
    return -1 if value.negative
    return 1

def bigint_set_u64(value: mutable BigInt&, x: u64) -> void can[Abort.Panic, Memory.Allocate]:
    value.limbs.clear()
    value.negative <- false
    value.limbs.push(x) if x != 0

def bigint_set_i64(value: mutable BigInt&, x: i64) -> void can[Abort.Panic, Memory.Allocate]:
    if x >= 0:
        bigint_set_u64(value, x.u64())
        return
    bigint_set_u64(value, (0 - (x + 1)).u64() + 1)
    value.negative <- true

def bigint_assign(destination: mutable BigInt&, source: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    count: usize = source.limbs.count
    destination.limbs.resize(count)
    for index in 0..<count |destination, source|:
        destination.limbs[index] <- source.limbs[index]
    destination.negative <- source.negative

# Low 64 bits of the magnitude (the exact value when it fits in a u64).
def bigint_low_u64(value: BigInt&) -> u64:
    return 0 if value.limbs.count == 0
    return value.limbs[0]

def bigint_normalize(value: mutable BigInt&) -> void can[Abort.Panic]:
    count: mutable usize = value.limbs.count
    while count > 0 |count, value|:
        break if value.limbs[count - 1] != 0
        count <- count - 1
    value.limbs.resize(count) if count < value.limbs.count
    value.negative <- false if count == 0

def bigint_bit(condition: bool) -> u64:
    return 1 if condition
    return 0

# ------------------------------------------------------------
# Magnitude helpers (limbs only, sign ignored)
# ------------------------------------------------------------

def bigint_mag_compare(left: darray[u64]&, right: darray[u64]&) -> i32:
    return 1 if left.count > right.count
    return -1 if left.count < right.count
    index: mutable usize = left.count
    while index > 0 |index, left, right|:
        index <- index - 1
        return 1 if left[index] > right[index]
        return -1 if left[index] < right[index]
    return 0

def bigint_compare_abs(left: BigInt&, right: BigInt&) -> i32:
    return bigint_mag_compare(left.limbs, right.limbs)

def bigint_compare(left: BigInt&, right: BigInt&) -> i32:
    left_sign: i32 = bigint_sign(left)
    right_sign: i32 = bigint_sign(right)
    return -1 if left_sign < right_sign
    return 1 if left_sign > right_sign
    magnitude: i32 = bigint_mag_compare(left.limbs, right.limbs)
    return 0 - magnitude if left_sign < 0
    return magnitude

# Extends with zero limbs: one resize, then the new limbs are cleared explicitly
# (resize does not promise zeroed storage when it reuses a previous allocation).
def bigint_grow_to(value: mutable BigInt&, count: usize) -> void can[Abort.Panic, Memory.Allocate]:
    old_count: usize = value.limbs.count
    return if old_count >= count
    value.limbs.resize(count)
    for index in old_count..<count |value|:
        value.limbs[index] <- 0

# |dst| += |src| * k
def bigint_mag_addmul(destination: mutable BigInt&, source: BigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    source_count: usize = source.limbs.count
    bigint_grow_to(destination, source_count)
    carry: mutable u64 = 0
    index: mutable usize = 0
    while index < source_count |index, carry, destination, source, factor|:
        term: u64 = source.limbs[index]
        low: u64 = term * factor
        high: u64 = bigint_mul_hi(term, factor)
        sum: u64 = destination.limbs[index] + low
        total: u64 = sum + carry
        destination.limbs[index] <- total
        carry <- high + bigint_bit(sum < low) + bigint_bit(total < sum)
        index <- index + 1
    while carry != 0 and index < destination.limbs.count |index, carry, destination|:
        total: u64 = destination.limbs[index] + carry
        destination.limbs[index] <- total
        carry <- bigint_bit(total < carry)
        index <- index + 1
    destination.limbs.push(carry) if carry != 0

# |dst| -= |src| * k. When the product exceeds |dst| the limbs are negated in place
# (two's complement over the extended width) and the function returns true: the
# magnitude is then |src|*k - |dst| and the caller flips the sign.
def bigint_mag_submul(destination: mutable BigInt&, source: BigInt&, factor: u64) -> bool can[Abort.Panic, Memory.Allocate]:
    source_count: usize = source.limbs.count
    bigint_grow_to(destination, source_count + 1)
    carry: mutable u64 = 0
    index: mutable usize = 0
    count: usize = destination.limbs.count
    while index < count |index, carry, destination, source, factor, source_count, count|:
        term: u64 = source.limbs[index] if index < source_count else 0
        low: u64 = term * factor
        high: u64 = bigint_mul_hi(term, factor)
        subtrahend: u64 = low + carry
        current: u64 = destination.limbs[index]
        destination.limbs[index] <- current - subtrahend
        carry <- high + bigint_bit(subtrahend < low) + bigint_bit(current < subtrahend)
        index <- index + 1
        break if index >= source_count + 1 and carry == 0
    flipped: bool = carry != 0
    if flipped:
        negate_carry: mutable u64 = 1
        position: mutable usize = 0
        while position < count |position, negate_carry, destination|:
            inverted: u64 = (destination.limbs[position] ^ 0xFFFFFFFFFFFFFFFF) + negate_carry
            negate_carry <- bigint_bit(negate_carry != 0 and inverted == 0)
            destination.limbs[position] <- inverted
            position <- position + 1
    return flipped

# dst += sign * src * k, where sign is -1 when `subtract` is set.
def bigint_signed_addmul(destination: mutable BigInt&, source: BigInt&, factor: u64, subtract: bool) -> void can[Abort.Panic, Memory.Allocate]:
    return if factor == 0 or source.limbs.count == 0
    term_negative: bool = source.negative != subtract
    if destination.limbs.count == 0:
        bigint_mag_addmul(destination, source, factor)
        destination.negative <- term_negative
        bigint_normalize(destination)
        return
    if destination.negative == term_negative:
        bigint_mag_addmul(destination, source, factor)
        return
    flipped: bool = bigint_mag_submul(destination, source, factor)
    destination.negative <- not destination.negative if flipped
    bigint_normalize(destination)

# ------------------------------------------------------------
# Signed arithmetic
# ------------------------------------------------------------

def bigint_add_assign(destination: mutable BigInt&, source: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_signed_addmul(destination, source, 1, false)

def bigint_sub_assign(destination: mutable BigInt&, source: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_signed_addmul(destination, source, 1, true)

def bigint_addmul_small(destination: mutable BigInt&, source: BigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_signed_addmul(destination, source, factor, false)

def bigint_submul_small(destination: mutable BigInt&, source: BigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_signed_addmul(destination, source, factor, true)

def bigint_mul_small_assign(value: mutable BigInt&, factor: u64) -> void can[Abort.Panic, Memory.Allocate]:
    if factor == 0:
        value.limbs.clear()
        value.negative <- false
        return
    carry: mutable u64 = 0
    count: usize = value.limbs.count
    for index in 0..<count |value, carry, factor|:
        limb: u64 = value.limbs[index]
        low: u64 = limb * factor
        total: u64 = low + carry
        carry <- bigint_mul_hi(limb, factor) + bigint_bit(total < low)
        value.limbs[index] <- total
    value.limbs.push(carry) if carry != 0

# destination = left * right (schoolbook). The destination must not be an operand.
def bigint_mul(destination: mutable BigInt&, left: BigInt&, right: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    destination.limbs.clear()
    destination.negative <- false
    return if left.limbs.count == 0 or right.limbs.count == 0
    left_count: usize = left.limbs.count
    right_count: usize = right.limbs.count
    bigint_grow_to(destination, left_count + right_count)
    for i in 0..<left_count |destination, left, right, right_count|:
        multiplier: u64 = left.limbs[i]
        carry: mutable u64 = 0
        for j in 0..<right_count |destination, right, multiplier, carry, i|:
            term: u64 = right.limbs[j]
            low: u64 = multiplier * term
            high: u64 = bigint_mul_hi(multiplier, term)
            sum: u64 = low + destination.limbs[i + j]
            total: u64 = sum + carry
            destination.limbs[i + j] <- total
            carry <- high + bigint_bit(sum < low) + bigint_bit(total < sum)
        destination.limbs[i + right_count] <- carry
    destination.negative <- left.negative != right.negative
    bigint_normalize(destination)

# |value| /= divisor; returns |value| mod divisor. The sign is kept (truncation).
def bigint_divmod_small_assign(value: mutable BigInt&, divisor: u64) -> u64 can[Abort.Panic]:
    if divisor == 0:
        panic("bigint: division by zero")
    remainder: mutable u64 = 0
    index: mutable usize = value.limbs.count
    while index > 0 |index, remainder, value, divisor|:
        index <- index - 1
        limb: u64 = value.limbs[index]
        # remainder < divisor, so the 128-by-64 quotient fits in 64 bits.
        quotient: u64 = bigint_div_wide(remainder, limb, divisor)
        value.limbs[index] <- quotient
        remainder <- limb - quotient * divisor
    bigint_normalize(value)
    return remainder

def bigint_leading_zero_bits(limb: u64) -> u64:
    return 64 if limb == 0
    bits: mutable u64 = 0
    probe: mutable u64 = limb
    while (probe & 0x8000000000000000) == 0 |probe, bits|:
        probe <- probe << 1
        bits <- bits + 1
    return bits

# (limb << shift) | (lower >> (64 - shift)), with shift in [0, 63].
def bigint_shift_pair(limb: u64, lower: u64, shift: u64) -> u64:
    return limb if shift == 0
    return (limb << shift) | (lower >> (64 - shift))

# Knuth TAOCP vol. 2, 4.3.1 algorithm D on base-2^64 limbs;
# |numerator| >= |divisor| and the divisor has at least 2 limbs.
def bigint_mag_divmod_long(quotient: mutable BigInt&, remainder: mutable BigInt&, numerator: BigInt&, divisor: BigInt&, scratch: mutable BigIntDivScratch&, want_remainder: bool) -> void can[Abort.Panic, Memory.Allocate]:
    n: usize = divisor.limbs.count
    m: usize = numerator.limbs.count
    shift: u64 = bigint_leading_zero_bits(divisor.limbs[n - 1])
    scratch.divisor.resize(n)
    scratch.numerator.resize(m + 1)
    scratch.divisor[0] <- bigint_shift_pair(divisor.limbs[0], 0, shift)
    for i in 1..<n |scratch, divisor, shift|:
        scratch.divisor[i] <- bigint_shift_pair(divisor.limbs[i], divisor.limbs[i - 1], shift)
    scratch.numerator[0] <- bigint_shift_pair(numerator.limbs[0], 0, shift)
    for i in 1..<m |scratch, numerator, shift|:
        scratch.numerator[i] <- bigint_shift_pair(numerator.limbs[i], numerator.limbs[i - 1], shift)
    scratch.numerator[m] <- bigint_shift_pair(0, numerator.limbs[m - 1], shift)

    quotient.limbs.clear()
    bigint_grow_to(quotient, m - n + 1)
    top: u64 = scratch.divisor[n - 1]
    second: u64 = scratch.divisor[n - 2]
    j: mutable usize = m - n + 1
    while j > 0 |j, scratch, quotient, n, top, second|:
        j <- j - 1
        high: u64 = scratch.numerator[j + n]
        low: u64 = scratch.numerator[j + n - 1]
        qhat: mutable u64 = 0
        rhat: mutable u64 = 0
        rhat_overflow: mutable bool = false
        if high >= top:
            # high == top: the estimate saturates at B - 1 and rhat = low + top.
            qhat <- 0xFFFFFFFFFFFFFFFF
            rhat <- low + top
            rhat_overflow <- rhat < low
        else:
            qhat <- bigint_div_wide(high, low, top)
            rhat <- low - qhat * top
        next: u64 = scratch.numerator[j + n - 2]
        while not rhat_overflow |qhat, rhat, rhat_overflow, top, second, next|:
            product_high: u64 = bigint_mul_hi(qhat, second)
            product_low: u64 = qhat * second
            break if product_high < rhat or (product_high == rhat and product_low <= next)
            qhat <- qhat - 1
            rhat <- rhat + top
            rhat_overflow <- rhat < top
        # Multiply and subtract qhat * scratch.divisor from scratch.numerator[j .. j+n].
        carry: mutable u64 = 0
        for i in 0..<n |scratch, qhat, carry, j|:
            term: u64 = scratch.divisor[i]
            product_low: u64 = qhat * term
            subtrahend: u64 = product_low + carry
            current: u64 = scratch.numerator[i + j]
            scratch.numerator[i + j] <- current - subtrahend
            carry <- bigint_mul_hi(qhat, term) + bigint_bit(subtrahend < product_low) + bigint_bit(current < subtrahend)
        top_limb: u64 = scratch.numerator[j + n]
        scratch.numerator[j + n] <- top_limb - carry
        if top_limb < carry:
            # Estimate was one too large: add the divisor back.
            qhat <- qhat - 1
            add_carry: mutable u64 = 0
            for i in 0..<n |scratch, add_carry, j|:
                sum: u64 = scratch.numerator[i + j] + scratch.divisor[i]
                total: u64 = sum + add_carry
                add_carry <- bigint_bit(sum < scratch.divisor[i]) + bigint_bit(total < sum)
                scratch.numerator[i + j] <- total
            scratch.numerator[j + n] <- scratch.numerator[j + n] + add_carry
        quotient.limbs[j] <- qhat

    bigint_normalize(quotient)
    return if not want_remainder
    remainder.limbs.resize(n)
    for i in 0..<n |remainder, scratch, shift|:
        upper: u64 = scratch.numerator[i + 1] << (64 - shift) if shift != 0 else 0
        remainder.limbs[i] <- (scratch.numerator[i] >> shift) | upper
    bigint_normalize(remainder)

# Truncated division: quotient = trunc(numerator / divisor), remainder takes the
# numerator's sign. quotient and remainder must be distinct from the operands.
def bigint_divmod(quotient: mutable BigInt&, remainder: mutable BigInt&, numerator: BigInt&, divisor: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    scratch: mutable BigIntDivScratch = bigint_div_scratch()
    bigint_divmod_with(quotient, remainder, numerator, divisor, &scratch)

# bigint_divmod with caller-provided working storage (no allocation once warm).
def bigint_divmod_with(quotient: mutable BigInt&, remainder: mutable BigInt&, numerator: BigInt&, divisor: BigInt&, scratch: mutable BigIntDivScratch&) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_div_core(quotient, remainder, numerator, divisor, scratch, true)

# Quotient only (truncated); skips building the remainder. `unused` receives nothing
# meaningful and exists so the core can share one signature.
def bigint_div_with(quotient: mutable BigInt&, numerator: BigInt&, divisor: BigInt&, scratch: mutable BigIntDivScratch&, unused: mutable BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    bigint_div_core(quotient, unused, numerator, divisor, scratch, false)

def bigint_div_core(quotient: mutable BigInt&, remainder: mutable BigInt&, numerator: BigInt&, divisor: BigInt&, scratch: mutable BigIntDivScratch&, want_remainder: bool) -> void can[Abort.Panic, Memory.Allocate]:
    if divisor.limbs.count == 0:
        panic("bigint: division by zero")
    if bigint_mag_compare(numerator.limbs, divisor.limbs) < 0:
        quotient.limbs.clear()
        quotient.negative <- false
        bigint_assign(remainder, numerator) if want_remainder
        return
    if divisor.limbs.count == 1:
        bigint_assign(quotient, numerator)
        quotient.negative <- false
        rest: u64 = bigint_divmod_small_assign(quotient, divisor.limbs[0])
        bigint_set_u64(remainder, rest) if want_remainder
    else:
        bigint_mag_divmod_long(quotient, remainder, numerator, divisor, scratch, want_remainder)
    quotient.negative <- numerator.negative != divisor.negative
    bigint_normalize(quotient)
    if want_remainder:
        remainder.negative <- numerator.negative
        bigint_normalize(remainder)

# ------------------------------------------------------------
# Decimal conversion
# ------------------------------------------------------------

def bigint_append_decimal(output: mutable darray[u8]&, value: BigInt&) -> void can[Abort.Panic, Memory.Allocate]:
    if value.limbs.count == 0:
        output.push('0'.u8())
        return
    output.push('-'.u8()) if value.negative
    work: mutable BigInt = bigint_zero()
    bigint_assign(&work, value)
    chunks: mutable darray[u64] = []
    while work.limbs.count > 0 |work, chunks|:
        chunks.push(bigint_divmod_small_assign(&work, BIGINT_DECIMAL_CHUNK))
    index: mutable usize = chunks.count
    first: mutable bool = true
    while index > 0 |index, chunks, first, output|:
        index <- index - 1
        digits: mutable u8[20] = zeroed
        length: mutable usize = 0
        rest: mutable u64 = chunks[index]
        while rest > 0 |rest, digits, length|:
            digits[length] <- '0'.u8() + (rest % 10).u8()
            rest <- rest / 10
            length <- length + 1
        if not first:
            while length < BIGINT_DECIMAL_CHUNK_DIGITS |digits, length|:
                digits[length] <- '0'.u8()
                length <- length + 1
        while length > 0 |length, digits, output|:
            length <- length - 1
            output.push(digits[length])
        first <- false

# Parses an optional sign followed by one or more ASCII digits. Returns false (and
# leaves zero) on any other input.
def bigint_set_decimal(value: mutable BigInt&, text: sview) -> bool can[Abort.Panic, Memory.Allocate]:
    value.limbs.clear()
    value.negative <- false
    length: usize = text.len.usize()
    start: mutable usize = 0
    negative: mutable bool = false
    if length > 0 and (text[0].u8() == '-'.u8() or text[0].u8() == '+'.u8()):
        negative <- text[0].u8() == '-'.u8()
        start <- 1
    return false if start >= length
    for index in start..<length |value, text|:
        byte: u8 = text[index].u8()
        if byte < '0'.u8() or byte > '9'.u8():
            value.limbs.clear()
            return false
        bigint_mul_small_assign(value, 10)
        digit: mutable BigInt = bigint_from_u64((byte - '0'.u8()).u64())
        bigint_mag_addmul(value, digit, 1)
    value.negative <- negative
    bigint_normalize(value)
    return true
