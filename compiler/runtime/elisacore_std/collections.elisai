const ELISA_PROFILE_ALLOCATION_ALLOC: u32 = 1

const ELISA_PROFILE_ALLOCATION_REALLOC_IN_PLACE: u32 = 2

const ELISA_PROFILE_ALLOCATION_REALLOC_MOVE: u32 = 3

const ELISA_PROFILE_ALLOCATION_RECLAIM: u32 = 4

const ELISA_PROFILE_ALLOCATION_REGION_CREATE: u32 = 5

const ELISA_PROFILE_ALLOCATION_REGION_RESET: u32 = 6

const ELISA_PROFILE_ALLOCATION_REGION_TRIM: u32 = 7

const ELISA_PROFILE_ALLOCATION_REGION_FREE: u32 = 8

const ELISA_PROFILE_ALLOCATION_ARENA_ADOPT: u32 = 9

const ELISA_PROFILE_ALLOCATION_REGION_REWIND: u32 = 10

const ELISA_PROFILE_ALLOCATION_ABI_V1: u32 = 1

const ELISA_PROFILE_REGION_LAYOUT_ABI_V1: u32 = 1

extern elisa_profile_region_layout_negotiate(requested_version: u32) -> u32

extern elisa_profile_region_layout_v1(arena: uintptr, region: usize, header: uintptr, data_base: uintptr, capacity_bytes: usize) -> void

extern elisa_profile_allocation_negotiate(requested_version: u32) -> u32

extern elisa_profile_allocation_event_v1(kind: u32, address: uintptr, size: usize, old_address: uintptr, old_size: usize, arena: uintptr, region: usize) -> void

extern arena_profile_allocation_event(kind: u32, address: uintptr, size: usize, old_address: uintptr, old_size: usize, arena: uintptr, region: usize) -> void

struct AtomicSlot[T]:
    value: mutable T

struct AtomicCell[T]:
    slot: mutable AtomicSlot[T]

enum MemoryOrder:
    Relaxed
    Acquire
    Release
    AcqRel
    SeqCst

extern __elisa_arena_cache_lock_cell: AtomicCell[i32]

extern load[T](slot: AtomicSlot[T]&, order: MemoryOrder) -> T

extern store[T](slot: mutable AtomicSlot[T]&, value: T, order: MemoryOrder)

extern exchange[T](slot: mutable AtomicSlot[T]&, value: T, order: MemoryOrder) -> T

extern compare_exchange[T](slot: mutable AtomicSlot[T]&, expected: T, desired: T, success: MemoryOrder, failure: MemoryOrder) -> bool

extern fetch_add(slot: mutable AtomicSlot[i64]&, value: i64, order: MemoryOrder) -> i64

extern fetch_sub(slot: mutable AtomicSlot[i64]&, value: i64, order: MemoryOrder) -> i64

extern fetch_or(slot: mutable AtomicSlot[i64]&, value: i64, order: MemoryOrder) -> i64

extern fetch_and(slot: mutable AtomicSlot[i64]&, value: i64, order: MemoryOrder) -> i64

extern fetch_xor(slot: mutable AtomicSlot[i64]&, value: i64, order: MemoryOrder) -> i64

extern fence(order: MemoryOrder)

extern atomic_cell[T](value: T) -> AtomicCell[T]

extern atomic_load_relaxed[T](cell: AtomicCell[T]&) -> T

extern atomic_load_acquire[T](cell: AtomicCell[T]&) -> T

extern atomic_store_relaxed[T](cell: mutable AtomicCell[T]&, value: T)

extern atomic_store_release[T](cell: mutable AtomicCell[T]&, value: T)

extern atomic_exchange_acqrel[T](cell: mutable AtomicCell[T]&, value: T) -> T

extern atomic_compare_exchange_acqrel[T](cell: mutable AtomicCell[T]&, expected: T, desired: T) -> bool

extern atomic_fetch_add_acqrel(cell: mutable AtomicCell[i64]&, value: i64) -> i64

extern atomic_fetch_sub_acqrel(cell: mutable AtomicCell[i64]&, value: i64) -> i64

const ARENA_BACKEND_LIBC_MALLOC = 0

const ARENA_BACKEND_LINUX_MMAP = 1

const ARENA_BACKEND_WIN32_VIRTUALALLOC = 2

const ARENA_BACKEND_WASM_HEAPBASE = 3

const ELISA_TARGET_OS_WASM: bool = false

static if ELISA_TARGET_OS_WASM:
    const ARENA_BACKEND: int = ARENA_BACKEND_WASM_HEAPBASE
static elif ELISA_TARGET_OS_WINDOWS:
    const ARENA_BACKEND: int = ARENA_BACKEND_WIN32_VIRTUALALLOC
static elif ELISA_TARGET_OS_POSIX:
    const ARENA_BACKEND: int = ARENA_BACKEND_LINUX_MMAP
static else:
    const ARENA_BACKEND: int = ARENA_BACKEND_LIBC_MALLOC

const ARENA_REGION_DEFAULT_CAPACITY: usize = (128 * 1024)

const ARENA_FREE_CHAIN_REGION_VISITS: usize = 8

const ARENA_WASM_PAGE_SIZE: usize = (64 * 1024)

const ARENA_STRATEGY_CHAINED: int = 0

const ARENA_STRATEGY_MALLOC: int = 1

const ARENA_STRATEGY_RESERVE_COMMIT: int = 2

const ARENA_STRATEGY_FIXED: int = 3

const ARENA_STRATEGY_SCRATCH: int = 4

const ARENA_DEFAULT_RESERVE_COMMIT_SLOTS: usize = 33554432

const ARENA_NARROW_RESERVE_COMMIT_SLOTS: usize = 2097152

const ARENA_OWNER_TAG_COLLECTION: usize = 2

static if (ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP):
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 1048576
static elif (ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC):
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 1048576
static else:
    const COLLECTION_STACK_RESERVE_SLOTS: usize = 0

error RuntimeError:
    OutOfMemory

@intrusive
struct ArenaFreeBlock:
    next: mutable heap ArenaFreeBlock&?
    slots: mutable usize

struct Region:
    next: mutable heap Region&?
    count: mutable usize
    capacity: mutable usize
    owner_tag: mutable uintptr
    owner_next: mutable heap Region&?
    global_index: mutable usize
    committed: mutable usize
    free_list: mutable heap ArenaFreeBlock&?
    data: tail uintptr

struct Arena:
    begin: mutable heap Region&?
    end: mutable heap Region&?
    end_index: mutable usize
    strategy: mutable int

struct ArenaMark:
    region: heap Region&?
    count: usize

extern malloc(size: usize) -> mutable heap void&? can[Memory.Allocate]

extern free(ptr: heap void&) can[Memory.Release]

extern memset(dest: mutable void&, val: i32, n: usize) -> mutable void&

extern memcpy(dest: mutable void&, src: void&, n: usize) -> mutable void&

static if (ARENA_BACKEND == ARENA_BACKEND_LINUX_MMAP):
    const ELISA_ARENA_PROT_READ = 0x1
    const ELISA_ARENA_PROT_WRITE = 0x2
    const ELISA_ARENA_MAP_PRIVATE = 0x02
    static if ELISA_TARGET_OS_LINUX:
        const ELISA_ARENA_MAP_ANONYMOUS = 0x20
    static else:
        const ELISA_ARENA_MAP_ANONYMOUS = 0x1000
    extern mmap(addr: uintptr, length: usize, prot: i32, flags: i32, fd: i32, offset: i64) -> uintptr
    extern munmap(addr: heap void&, length: usize) -> i32
    extern MAP_FAILED() -> uintptr
static elif (ARENA_BACKEND == ARENA_BACKEND_WIN32_VIRTUALALLOC):
    const MEM_COMMIT = 0x1000
    const MEM_RESERVE = 0x2000
    const MEM_RELEASE = 0x8000
    const PAGE_READWRITE = 0x04
    extern GetCurrentProcess() -> void&
    extern VirtualAllocEx(process: void&, address: mutable heap void&?, size: usize, alloc_type: u32, protect: u32) -> mutable heap void&?
    extern VirtualFreeEx(process: void&, address: heap void&, size: usize, free_type: u32) -> i32
    const WIN_COMMIT_CHUNK: usize = 65536
    extern win_commit_round_up(n: usize) -> usize
static elif (ARENA_BACKEND == ARENA_BACKEND_WASM_HEAPBASE):
    const ARENA_WASM_USES_HOST_ALLOCATOR: bool = true

extern arena_default_reserve_slots() -> usize

extern max(a: usize, b: usize) -> usize

extern min(a: usize, b: usize) -> usize

extern clamp(x: usize, lo: usize, hi: usize) -> usize

extern inv_handle(ptr: heap void&?) -> bool

extern sfree[T](ptr: heap T&) -> heap T!

struct ArenaRegionCache:
    slot: mutable heap Region&?
    reclaimed_spans: mutable usize

extern __elisa_region_cache: ArenaRegionCache

struct ArenaFreeHint:
    owner: mutable uintptr
    region: mutable heap Region&?

extern __elisa_free_hint: ArenaFreeHint

const REGION_CACHE_MAX_SLOTS: usize = 131072

const REGION_CACHE_MAX_ENTRIES: usize = 128

const RESERVE_CACHE_MAX_ENTRIES: usize = 32

const RESERVE_CACHE_MAX_USED_SLOTS: usize = 32768

extern __elisa_reserve_region_cache: ArenaRegionCache

extern new_region_with_owner(capacity: usize, owner_tag: uintptr) -> mutable heap Region&

extern new_region(capacity: usize) -> mutable heap Region&

extern new_region_backend(capacity: usize, strategy: int) -> mutable heap Region&

extern free_region(r: heap Region&)

extern free_region_backend(r: heap Region&, strategy: int)

extern arena_alloc(a: mutable Arena&, size_bytes: usize) -> mutable heap void& can[Atomics.Load]

extern arena_realloc(a: mutable Arena&, oldptr: mutable void&, oldsz: usize, newsz: usize) -> mutable heap void& can[Atomics.Load]

extern arena_used_slots(a: mutable Arena&) -> usize

extern arena_used_bytes(a: mutable Arena&) -> usize

extern arena_region_count(a: mutable Arena&) -> usize

extern arena_strlen(s: u8&) -> usize

extern arena_memcpy(dest: mutable void&, src: void&, n: usize) -> mutable void&

extern arena_memeq(lhs: void&, rhs: void&, n: usize) -> bool

extern arena_strdup(a: mutable Arena&, cstr: u8&) -> mutable heap u8& can[Atomics.Load]

extern arena_memdup(a: mutable Arena&, data: void&, size: usize) -> mutable heap void& can[Atomics.Load]

extern arena_snapshot(a: Arena&) -> ArenaMark

extern arena_reset(a: mutable Arena&)

extern arena_rewind(a: mutable Arena&, m: ArenaMark)

extern arena_free(a: mutable Arena&)

extern arena_trim(a: mutable Arena&)

extern arena_adopt(parent: mutable Arena&, child: mutable Arena&) can[Atomics.Load]

