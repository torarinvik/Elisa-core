# ============================================================
# Elisa core Runtime - byte regular expressions (Thompson NFA + lazy DFA)
# ============================================================
#
# Syntax (bytes, no flags):
#   literals, `.` (any byte but '\n'), `[...]` / `[^...]` classes with ranges,
#   `\d \D \w \W \s \S \n \r \t` and `\` + any other byte (that byte literally),
#   grouping `( )`, alternation `|`, postfix `*`, `+`, `?`, counted `{m}` `{m,}` `{m,n}`,
#   and `(?i)` (ASCII case-insensitive to the end of the enclosing group).
# Unsupported syntax (anchors, backreferences, other group flags, unbalanced brackets) makes
# regex_compile return false.
#
# Semantics: leftmost-longest (POSIX). A search returns the match that starts
# earliest and, among those, ends latest. For patterns whose alternatives do not
# overlap (e.g. `agggtaaa|tttaccct`) this equals Perl/RE2 leftmost-first.
#
# Engine: the pattern is parsed to a small AST and compiled twice into Thompson
# NFAs: forward, and reversed behind an unanchored any-byte loop. Each NFA runs as
# a lazily built DFA whose states are canonical (sorted) sets of NFA states; every
# transition is computed once and cached in a 256-wide table, so a scan costs one
# table load per byte. Whole-text operations (count, replace_all) first run the
# reverse DFA once from the end of the text to the start, which marks every
# position where some match begins; each match is then the longest forward
# anchored run from the next marked position at or after the scan point. Work is
# linear in the text plus the matched spans. regex_find_at (a single search) tries
# start positions in order behind a first-byte prefilter instead. Each DFA cache is
# bounded (REGEX_DFA_STATE_LIMIT); when it fills it is flushed and the scan
# restarts once, with growth allowed on the retry so every scan terminates.

const REGEX_DFA_STATE_LIMIT: usize = 4096
const REGEX_UNKNOWN: i32 = -2
const REGEX_DEAD: i32 = -1
const REGEX_NO_STATE: u32 = 0xFFFFFFFF

# AST node kinds.
const REGEX_AST_BYTES: u8 = 0
const REGEX_AST_CONCAT: u8 = 1
const REGEX_AST_EITHER: u8 = 2
const REGEX_AST_STAR: u8 = 3
const REGEX_AST_PLUS: u8 = 4
const REGEX_AST_OPTIONAL: u8 = 5
const REGEX_AST_EMPTY: u8 = 6

# NFA state kinds.
const REGEX_NFA_BYTES: u8 = 0
const REGEX_NFA_SPLIT: u8 = 1
const REGEX_NFA_ACCEPT: u8 = 2

struct RegexMatch:
    found: bool
    first: usize
    last: usize   # exclusive end

struct RegexAutomaton:
    sets: mutable darray[u64]           # copy of the pattern's 256-bit byte sets
    nfa_kind: mutable darray[u8]
    nfa_out1: mutable darray[u32]
    nfa_out2: mutable darray[u32]
    nfa_set: mutable darray[u32]
    nfa_start: mutable u32
    dfa_offset: mutable darray[u32]    # members of state i: dfa_members[offset[i] ..< offset[i+1]]
    dfa_members: mutable darray[u32]
    dfa_accept: mutable darray[bool]
    dfa_next: mutable darray[i32]      # state * 256 + byte -> target * 2 + accepting(target), REGEX_UNKNOWN or REGEX_DEAD
    dfa_hash: mutable darray[u64]
    dfa_chain: mutable darray[u32]     # next state with the same hash
    dfa_index: mutable dict[u64, u32]  # hash -> newest state with that hash
    dfa_start: mutable i32
    dfa_flushes: mutable usize
    mark: mutable darray[u32]
    mark_generation: mutable u32
    pending: mutable darray[u32]
    work: mutable darray[u32]
    scanned: mutable usize             # bytes stepped by regex_longest_at (work budget)

struct Regex:
    valid: mutable bool
    # 256-bit byte sets, four u64 words each (built by the parser).
    sets: mutable darray[u64]
    # AST (built by the parser, consumed by the NFA compiler).
    ast_kind: mutable darray[u8]
    ast_left: mutable darray[u32]
    ast_right: mutable darray[u32]
    forward: mutable RegexAutomaton
    backward: mutable RegexAutomaton   # reversed pattern behind an unanchored loop
    first_bytes: mutable darray[u64]   # 4 words; bytes that can begin a match
    use_prefilter: mutable bool
    starts: mutable darray[u64]        # bitmap: positions where a match begins
    first_count: mutable u32           # number of bytes in first_bytes
    first_byte: mutable u8             # the byte, when first_count == 1
    forward_scan: mutable bool         # current whole-text scan uses forward search, not starts
    no_newline: mutable bool           # no byte set admits '\n': matches never cross lines
    literals: mutable darray[u8]       # mandatory literal runs, back to back
    literal_ends: mutable darray[u32]  # end offset of each run in `literals`

struct RegexParser:
    position: mutable usize
    ok: mutable bool
    ignore_case: mutable bool   # set by `(?i)`, scoped to the enclosing group

def regex_automaton_new() -> RegexAutomaton:
    return RegexAutomaton{sets: [], nfa_kind: [], nfa_out1: [], nfa_out2: [], nfa_set: [], nfa_start: 0, dfa_offset: [], dfa_members: [], dfa_accept: [], dfa_next: [], dfa_hash: [], dfa_chain: [], dfa_index: {}, dfa_start: REGEX_DEAD, dfa_flushes: 0, mark: [], mark_generation: 0, pending: [], work: [], scanned: 0}

def regex_new() -> Regex:
    return Regex{valid: false, sets: [], ast_kind: [], ast_left: [], ast_right: [], forward: regex_automaton_new(), backward: regex_automaton_new(), first_bytes: [], use_prefilter: false, starts: [], first_count: 0, first_byte: 0, forward_scan: false, no_newline: false, literals: [], literal_ends: []}

# ------------------------------------------------------------
# Byte sets
# ------------------------------------------------------------

def regex_new_set(re: mutable Regex&) -> u32 can[Abort.Panic, Memory.Allocate]:
    index: u32 = (re.sets.count / 4).u32()
    for word in 0..<4 |re|:
        re.sets.push(0)
    return index

def regex_set_add(re: mutable Regex&, set: u32, byte: u8) -> void can[Abort.Panic]:
    word: usize = set.usize() * 4 + (byte >> 6).usize()
    re.sets[word] <- re.sets[word] | (1.u64() << (byte & 63).u64())

def regex_set_add_range(re: mutable Regex&, set: u32, low: u8, high: u8) -> void can[Abort.Panic]:
    value: mutable u64 = low.u64()
    while value <= high.u64() |value, re, set, high|:
        regex_set_add(re, set, value.u8())
        value <- value + 1

def regex_set_has(sets: darray[u64]&, set: u32, byte: u8) -> bool can[Abort.Panic]:
    word: u64 = sets[set.usize() * 4 + (byte >> 6).usize()]
    return ((word >> (byte & 63).u64()) & 1) != 0

def regex_set_invert(re: mutable Regex&, set: u32) -> void can[Abort.Panic]:
    for word in 0..<4 |re, set|:
        index: usize = set.usize() * 4 + word
        re.sets[index] <- re.sets[index] ^ 0xFFFFFFFFFFFFFFFF

# Adds the class named by an escape letter (d, w, s and negations); returns false
# when the letter is not a class.
def regex_set_add_escape_class(re: mutable Regex&, set: u32, letter: u8) -> bool can[Abort.Panic, Memory.Allocate]:
    lower: u8 = letter | 0x20
    return false if lower != 'd'.u8() and lower != 'w'.u8() and lower != 's'.u8()
    class_set: u32 = regex_new_set(re)
    if lower == 'd'.u8():
        regex_set_add_range(re, class_set, '0'.u8(), '9'.u8())
    elif lower == 'w'.u8():
        regex_set_add_range(re, class_set, '0'.u8(), '9'.u8())
        regex_set_add_range(re, class_set, 'a'.u8(), 'z'.u8())
        regex_set_add_range(re, class_set, 'A'.u8(), 'Z'.u8())
        regex_set_add(re, class_set, '_'.u8())
    else:
        regex_set_add(re, class_set, ' '.u8())
        regex_set_add_range(re, class_set, 9, 13)
    regex_set_invert(re, class_set) if letter != lower
    for word in 0..<4 |re, set, class_set|:
        target: usize = set.usize() * 4 + word
        re.sets[target] <- re.sets[target] | re.sets[class_set.usize() * 4 + word]
    return true

# Adds the other ASCII case of every letter in the set.
def regex_set_fold_case(re: mutable Regex&, set: u32) -> void can[Abort.Panic]:
    for offset in 0..<26 |re, set|:
        lower: u8 = 'a'.u8() + offset.u8()
        upper: u8 = 'A'.u8() + offset.u8()
        if regex_set_has(re.sets, set, lower) or regex_set_has(re.sets, set, upper):
            regex_set_add(re, set, lower)
            regex_set_add(re, set, upper)

def regex_escape_byte(letter: u8) -> u8:
    return 10 if letter == 'n'.u8()
    return 13 if letter == 'r'.u8()
    return 9 if letter == 't'.u8()
    return letter

# ------------------------------------------------------------
# Parser (recursive descent to the AST)
# ------------------------------------------------------------

def regex_ast_node(re: mutable Regex&, kind: u8, left: u32, right: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
    re.ast_kind.push(kind)
    re.ast_left.push(left)
    re.ast_right.push(right)
    return (re.ast_kind.count - 1).u32()

def regex_parse_class(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    set: u32 = regex_new_set(re)
    negate: mutable bool = false
    if parser.position < length and pattern[parser.position].u8() == '^'.u8():
        negate <- true
        parser.position <- parser.position + 1
    first_item: mutable bool = true
    closed: mutable bool = false
    while parser.position < length |re, parser, pattern, length, set, first_item, closed|:
        byte: u8 = pattern[parser.position].u8()
        if byte == ']'.u8() and not first_item:
            parser.position <- parser.position + 1
            closed <- true
            break
        first_item <- false
        parser.position <- parser.position + 1
        low: mutable u8 = byte
        if byte == '\\'.u8():
            if parser.position >= length:
                parser.ok <- false
                return set
            letter: u8 = pattern[parser.position].u8()
            parser.position <- parser.position + 1
            continue if regex_set_add_escape_class(re, set, letter)
            low <- regex_escape_byte(letter)
        # Range `low-high` unless the '-' is last before ']'.
        if parser.position + 1 < length and pattern[parser.position].u8() == '-'.u8() and pattern[parser.position + 1].u8() != ']'.u8():
            high: mutable u8 = pattern[parser.position + 1].u8()
            parser.position <- parser.position + 2
            if high == '\\'.u8():
                if parser.position >= length:
                    parser.ok <- false
                    return set
                high <- regex_escape_byte(pattern[parser.position].u8())
                parser.position <- parser.position + 1
            if high < low:
                parser.ok <- false
                return set
            regex_set_add_range(re, set, low, high)
        else:
            regex_set_add(re, set, low)
    parser.ok <- false if not closed
    regex_set_fold_case(re, set) if parser.ignore_case
    regex_set_invert(re, set) if negate
    return regex_ast_node(re, REGEX_AST_BYTES, set, 0)

def regex_parse_atom(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    byte: u8 = pattern[parser.position].u8()
    parser.position <- parser.position + 1
    if byte == '('.u8():
        # `(?i)`: case-insensitive from here to the end of the enclosing group.
        if parser.position + 2 < length and pattern[parser.position].u8() == '?'.u8() and pattern[parser.position + 1].u8() == 'i'.u8() and pattern[parser.position + 2].u8() == ')'.u8():
            parser.position <- parser.position + 3
            parser.ignore_case <- true
            return regex_ast_node(re, REGEX_AST_EMPTY, 0, 0)
        if parser.position < length and pattern[parser.position].u8() == '?'.u8():
            parser.ok <- false   # other group flags / non-capturing syntax: unsupported
            return regex_ast_node(re, REGEX_AST_EMPTY, 0, 0)
        saved_ignore_case: bool = parser.ignore_case
        inner: u32 = regex_parse_either(re, parser, pattern)
        parser.ignore_case <- saved_ignore_case
        if parser.position >= length or pattern[parser.position].u8() != ')'.u8():
            parser.ok <- false
            return inner
        parser.position <- parser.position + 1
        return inner
    return regex_parse_class(re, parser, pattern) if byte == '['.u8()
    set: u32 = regex_new_set(re)
    if byte == '.'.u8():
        regex_set_add(re, set, 10)
        regex_set_invert(re, set)
    elif byte == '\\'.u8():
        if parser.position >= length:
            parser.ok <- false
            return regex_ast_node(re, REGEX_AST_BYTES, set, 0)
        letter: u8 = pattern[parser.position].u8()
        parser.position <- parser.position + 1
        if not regex_set_add_escape_class(re, set, letter):
            regex_set_add(re, set, regex_escape_byte(letter))
    elif byte == ')'.u8() or byte == '*'.u8() or byte == '+'.u8() or byte == '?'.u8() or byte == '{'.u8() or byte == '^'.u8() or byte == '$'.u8():
        parser.ok <- false
    else:
        regex_set_add(re, set, byte)
    regex_set_fold_case(re, set) if parser.ignore_case
    return regex_ast_node(re, REGEX_AST_BYTES, set, 0)

const REGEX_MAX_COUNT: usize = 1000

def regex_parse_count(parser: mutable RegexParser&, pattern: sview) -> usize can[Abort.Panic]:
    length: usize = pattern.len.usize()
    value: mutable usize = 0
    digits: mutable usize = 0
    while parser.position < length |parser, pattern, value, digits|:
        byte: u8 = pattern[parser.position].u8()
        break if byte < '0'.u8() or byte > '9'.u8()
        value <- value * 10 + (byte - '0'.u8()).usize() if value <= REGEX_MAX_COUNT
        digits <- digits + 1
        parser.position <- parser.position + 1
    parser.ok <- false if digits == 0 or value > REGEX_MAX_COUNT
    return value

# `{m}`, `{m,}` and `{m,n}` (counts up to REGEX_MAX_COUNT), expanded on the AST: m
# required copies, then either a star (unbounded) or n - m optional copies.
def regex_parse_counted(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview, node: u32) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    parser.position <- parser.position + 1   # '{'
    minimum: usize = regex_parse_count(parser, pattern)
    maximum: mutable usize = minimum
    unbounded: mutable bool = false
    if parser.position < length and pattern[parser.position].u8() == ','.u8():
        parser.position <- parser.position + 1
        if parser.position < length and pattern[parser.position].u8() == '}'.u8():
            unbounded <- true
        else:
            maximum <- regex_parse_count(parser, pattern)
    if parser.position >= length or pattern[parser.position].u8() != '}'.u8() or maximum < minimum:
        parser.ok <- false
        return node
    parser.position <- parser.position + 1
    return node if not parser.ok
    result: mutable u32 = regex_ast_node(re, REGEX_AST_EMPTY, 0, 0)
    for _ in 0..<minimum |result, re, node|:
        result <- regex_ast_node(re, REGEX_AST_CONCAT, result, node)
    if unbounded:
        return regex_ast_node(re, REGEX_AST_CONCAT, result, regex_ast_node(re, REGEX_AST_STAR, node, 0))
    for _ in minimum..<maximum |result, re, node|:
        result <- regex_ast_node(re, REGEX_AST_CONCAT, result, regex_ast_node(re, REGEX_AST_OPTIONAL, node, 0))
    return result

def regex_parse_repeat(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    node: mutable u32 = regex_parse_atom(re, parser, pattern)
    while parser.position < length |re, parser, pattern, length, node|:
        byte: u8 = pattern[parser.position].u8()
        if byte == '{'.u8():
            node <- regex_parse_counted(re, parser, pattern, node)
            continue
        kind: u8 = REGEX_AST_STAR if byte == '*'.u8() else (REGEX_AST_PLUS if byte == '+'.u8() else (REGEX_AST_OPTIONAL if byte == '?'.u8() else REGEX_AST_EMPTY))
        break if kind == REGEX_AST_EMPTY
        parser.position <- parser.position + 1
        node <- regex_ast_node(re, kind, node, 0)
    return node

def regex_parse_concat(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    node: mutable u32 = regex_ast_node(re, REGEX_AST_EMPTY, 0, 0)
    while parser.position < length and parser.ok |re, parser, pattern, length, node|:
        byte: u8 = pattern[parser.position].u8()
        break if byte == '|'.u8() or byte == ')'.u8()
        piece: u32 = regex_parse_repeat(re, parser, pattern)
        node <- regex_ast_node(re, REGEX_AST_CONCAT, node, piece)
    return node

def regex_parse_either(re: mutable Regex&, parser: mutable RegexParser&, pattern: sview) -> u32 can[Abort.Panic, Memory.Allocate]:
    length: usize = pattern.len.usize()
    node: mutable u32 = regex_parse_concat(re, parser, pattern)
    while parser.position < length and parser.ok |re, parser, pattern, length, node|:
        break if pattern[parser.position].u8() != '|'.u8()
        parser.position <- parser.position + 1
        other: u32 = regex_parse_concat(re, parser, pattern)
        node <- regex_ast_node(re, REGEX_AST_EITHER, node, other)
    return node

# ------------------------------------------------------------
# NFA construction (continuation style: compile(node, follow) -> entry state)
# ------------------------------------------------------------


include "./elisacore_regex_automaton.elisa"
include "./elisacore_regex_search.elisa"
