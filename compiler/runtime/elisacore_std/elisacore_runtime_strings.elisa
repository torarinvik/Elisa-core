# ============================================================
# Elisa core Runtime - string primitives and views
# ============================================================

# ------------------------------------------------------------
# String concatenation
# ------------------------------------------------------------

def concat2(lhs: cstr?, rhs: cstr?) -> cstr can[Global.Read, Global.Write, Atomics.Load]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        left: cstr = lhs if lhs != null else ""
        right: cstr = rhs if rhs != null else ""

        left_len: usize = runtime_strlen(left)
        right_len: usize = runtime_strlen(right)

        return right if left_len == 0

        return left if right_len == 0

        result_len: usize = runtime_checked_add_usize(left_len, right_len)

        if result_len <= 8:
            text: u8[9]
            memcpy((&text[0]).cast[mutable void&], left.cast[void&], left_len)
            memcpy((&text[0] + left_len).cast[mutable void&], right.cast[void&], right_len)
            text[result_len] <- 0
            trusted Unsafe.PointerCast:
                return intern_small_string(&text[0], result_len).cast[cstr] can Global{Read,Write}, Atomics.Load

        allocation_bytes: usize = runtime_checked_add_usize(result_len, 1)
        out: mutable u8& = alloc_perm(runtime_checked_usize_to_i64(allocation_bytes)).cast[u8&] can Global{Read,Write}, Atomics.Load
        memcpy(out.cast[mutable void&], left.cast[void&], left_len)
        memcpy((out + left_len).cast[mutable void&], right.cast[void&], right_len)
        out[result_len] <- 0
        register_perm_string_len(out, result_len) can Global{Read,Write}, Atomics.Load
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

def concat2_scratch(lhs: cstr?, rhs: cstr?) -> cstr can[Global.Read, Global.Write, Atomics.Load]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        left: cstr = lhs if lhs != null else ""
        right: cstr = rhs if rhs != null else ""

        left_len: usize = runtime_strlen(left)
        right_len: usize = runtime_strlen(right)

        return right if left_len == 0

        return left if right_len == 0

        result_len: usize = runtime_checked_add_usize(left_len, right_len)

        if result_len <= 8:
            text: u8[9]
            memcpy((&text[0]).cast[mutable void&], left.cast[void&], left_len)
            memcpy((&text[0] + left_len).cast[mutable void&], right.cast[void&], right_len)
            text[result_len] <- 0
            trusted Unsafe.PointerCast:
                return intern_small_string(&text[0], result_len).cast[cstr] can Global{Read,Write}, Atomics.Load

        allocation_bytes: usize = runtime_checked_add_usize(result_len, 1)
        out: mutable u8& = alloc_scratch(runtime_checked_usize_to_i64(allocation_bytes)).cast[u8&] can Global{Read,Write}, Atomics.Load
        memcpy(out.cast[mutable void&], left.cast[void&], left_len)
        memcpy((out + left_len).cast[mutable void&], right.cast[void&], right_len)
        out[result_len] <- 0
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

# ------------------------------------------------------------
# f-string interpolation support
# ------------------------------------------------------------
# The backend lowers an f-string expression `f"a{x}b"` to one ctx_fstr_alloc
# (presized to the exact total length — a single allocation) followed by one
# ctx_fstr_append per part. The payload is perm-allocated, exactly like
# concat2's string results; the returned header is an ordinary dstr
# (count == capacity), so growth-by-push in the caller goes through the
# caller's own region machinery (arena_realloc copies out of perm).

def ctx_fstr_alloc(total: usize) -> dstr can[Global.Read, Atomics.Load]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,MutableGlobal,PointerCast,RawExtern}:
        out: mutable dstr = zeroed
        return out if total == 0
        buf: mutable u8& = alloc_perm(runtime_checked_usize_to_i64(total)).cast[mutable u8&] can Global{Read,Write}, Atomics.Load
        out.items as & <- buf
        out.count <- 0
        out.capacity <- total
        return out

def ctx_fstr_append(out: mutable dstr&, ptr: u8&?, len: usize):
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return if:
            ptr == null or len == 0
            out.items == null
        new_count: usize = runtime_checked_add_usize(out.count, len)
        if new_count > out.capacity:
            panic("f-string append exceeds allocation")
        arena_memcpy(collections_mutable_void_from_items_at[u8](out.items, out.count), ptr.cast[void&], len)
        out.count <- new_count

# ------------------------------------------------------------
# String operations
# ------------------------------------------------------------

def string_index(value: cstr?, index: i64) -> i64:
    can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
        return string_view_index(sview(value, 0, -1), index)



def string_slice_eq(value: cstr?, start: i64, end: i64, other: cstr?) -> int:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return string_view_eq(sview(value, start, end), other)

def string_slices_eq(lhs: cstr?, lhs_start: i64, lhs_end: i64, rhs: cstr?, rhs_start: i64, rhs_end: i64) -> int:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return string_views_eq(sview(lhs, lhs_start, lhs_end), sview(rhs, rhs_start, rhs_end))

def string_slice(value: cstr?, start: i64, end: i64) -> cstr can[Global.Read, Global.Write, Atomics.Load]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,MutableGlobal,PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}:
        src: cstr = value if value != null else ""
        len: usize = runtime_strlen(src)

        lo: mutable usize = 0
        hi: mutable usize = len

        if start > 0:
            lo <- start.usize()
            lo <- len if lo > len

        if end >= 0:
            hi <- end.usize()
            hi <- len if hi > len

        hi <- lo if hi < lo

        return src if lo == 0 and hi == len

        out_len: usize = hi - lo

        return "" if out_len == 0

        if out_len <= 8:
            trusted Unsafe.PointerCast:
                return intern_small_string(src.cast[u8&] + lo, out_len).cast[cstr] can Global{Read,Write}, Atomics.Load

        allocation_bytes: usize = runtime_checked_add_usize(out_len, 1)
        out: mutable u8& = alloc_perm(runtime_checked_usize_to_i64(allocation_bytes)).cast[u8&] can Global{Read,Write}, Atomics.Load
        memcpy(out.cast[mutable void&], (src.cast[u8&] + lo).cast[void&], out_len)
        out[out_len] <- 0
        register_perm_string_len(out, out_len) can Global{Read,Write}, Atomics.Load
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

def sview(value: cstr?, start: i64, end: i64) -> sview:
    ensure result.len >= 0
    ensure end == 0 implies result.len == 0
    trusted Unsafe{PointerArithmetic,RawExtern}:
        src: cstr = value if value != null else ""
        trusted Unsafe.PointerCast:
            src_bytes: u8& = src.cast[u8&]
            len: usize = runtime_strlen(src)

            # Clamp start to [0, len] and end (negative = to the end) to [start, len].
            lo: usize = 0 if start <= 0 else (len if start.usize() > len else start.usize())
            end_clamped: usize = len if end < 0 else (len if end.usize() > len else end.usize())
            hi: usize = lo if end_clamped < lo else end_clamped

            out_len: usize = hi - lo
            signed_out_len: i64 = out_len.i64()
            if signed_out_len < 0 or signed_out_len.usize() != out_len:
                return StringView{data: src_bytes, len: 0}
            return StringView{data: src_bytes + lo, len: signed_out_len}

def string_view_empty_at(data: u8&) -> sview:
    ensure result.len == 0
    ensure result.data == data
    trusted Unsafe.PointerCast:
        return StringView{data: data, len: 0}

# A borrowed view over foreign or otherwise raw storage with a caller-supplied extent.
# This is deliberately an unsafe boundary: the caller must prove that `count` bytes are
# readable at `data` and that the storage outlives every use of the returned view. Unlike
# `sview`, this function never scans for a NUL terminator. Prefer `bytes_view_range[_ref]`
# for darrays, which proves the requested extent from the container itself.
def unsafe_sview_bounded_bytes(data: u8&, count: usize) -> sview can[Unsafe.PointerCast]:
    can Unsafe{PointerArithmetic,RawExtern}:
        signed_count: i64 = count.i64()
        if signed_count < 0 or signed_count.usize() != count:
            return sview("", 0, 0)
        can Unsafe.PointerCast:
            return StringView{data: data, len: signed_count}

# Ergonomic cast: a nullable C string pointer -> borrowed string view, so content
# equality works directly (`bytes.sview() == "x86_64"`) instead of streq().
# This is the explicit postfix-shorthand cast `value.sview()`; it strlen's the
# NUL-terminated string to bound the view (null -> empty view). The view BORROWS the
# underlying storage, so it is valid only while that C-string is alive — the
# compiler tracks the interior borrow. Unlike `cstr`/DStr (a counted/owned
# string that would require a copy), a view is alloc-free and is exactly the
# right primitive for comparison.
def __cast__(value: cstr?) -> sview:
    can Unsafe{PointerArithmetic,RawExtern}:
        source: cstr = value if value != null else ""
        return sview(source, 0, -1)

def string_view_len(view: sview) -> i64:
    return 0 if view.len < 0
    view_len: usize = view.len.usize()
    return 0 if view_len.i64() != view.len
    return view.len

def string_view_slice(view: sview, start: i64, end: i64) -> sview:
    ensure result.len >= 0 and result.len <= (view.len if view.len > 0 and view.len.usize().i64() == view.len else 0)
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.len == (
        (view.len if end < 0 else (start if start > 0 and start <= view.len else view.len if start > view.len else 0) if end < (start if start > 0 and start <= view.len else view.len if start > view.len else 0) else end if end <= view.len else view.len)
        - (start if start > 0 and start <= view.len else view.len if start > view.len else 0)
    )
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.data == view.data + (start if start > 0 and start <= view.len else view.len if start > view.len else 0).usize()
    can Unsafe{PointerArithmetic,RawExtern}:
        return "" if view.len < 0
        view_len: usize = view.len.usize()
        return "" if view_len.i64() != view.len
        low: i64 = start if start > 0 and start <= view.len else view.len if start > view.len else 0
        high: i64 = view.len if end < 0 else low if end < low else end if end <= view.len else view.len
        assert 0 <= low and low <= view.len
        assert low <= high and high <= view.len
        assert low == (start if start > 0 and start <= view.len else view.len if start > view.len else 0)
        assert high == (view.len if end < 0 else (start if start > 0 and start <= view.len else view.len if start > view.len else 0) if end < (start if start > 0 and start <= view.len else view.len if start > view.len else 0) else end if end <= view.len else view.len)
        assert high - low == ((view.len if end < 0 else (start if start > 0 and start <= view.len else view.len if start > view.len else 0) if end < (start if start > 0 and start <= view.len else view.len if start > view.len else 0) else end if end <= view.len else view.len) - (start if start > 0 and start <= view.len else view.len if start > view.len else 0))
        trusted Unsafe.PointerCast:
            return StringView{data: view.data + (start if start > 0 and start <= view.len else view.len if start > view.len else 0).usize(), len: high - low}

def string_view_prefix(view: sview, end: i64) -> sview:
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.len == (view.len if end < 0 else end if end <= view.len else view.len)
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and end >= 0 and end <= view.len) implies result.len == end
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.data == view.data
    can Unsafe{PointerArithmetic,RawExtern}:
        return "" if view.len < 0
        view_len: usize = view.len.usize()
        return "" if view_len.i64() != view.len
        high: i64 = view.len if end < 0 else end if end <= view.len else view.len
        assert 0 <= high and high <= view.len
        assert high == (view.len if end < 0 else end if end <= view.len else view.len)
        trusted Unsafe.PointerCast:
            return StringView{data: view.data, len: high}

def string_view_suffix(view: sview, start: i64) -> sview:
    ensure result.len >= 0 and result.len <= (view.len if view.len > 0 and view.len.usize().i64() == view.len else 0)
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.len == view.len - (start if start > 0 and start <= view.len else view.len if start > view.len else 0)
    ensure (view.len >= 0 and view.len.usize().i64() == view.len) implies result.data == view.data + (start if start > 0 and start <= view.len else view.len if start > view.len else 0).usize()
    can Unsafe{PointerArithmetic,RawExtern}:
        return "" if view.len < 0
        view_len: usize = view.len.usize()
        return "" if view_len.i64() != view.len
        low: i64 = start if start > 0 and start <= view.len else view.len if start > view.len else 0
        assert 0 <= low and low <= view.len
        assert low == (start if start > 0 and start <= view.len else view.len if start > view.len else 0)
        assert view.len - low == view.len - (start if start > 0 and start <= view.len else view.len if start > view.len else 0)
        trusted Unsafe.PointerCast:
            return StringView{data: view.data + (start if start > 0 and start <= view.len else view.len if start > view.len else 0).usize(), len: view.len - low}

ghost def string_view_index_request_valid(view: sview, index: i64) -> bool:
    ensure result == (
        view.len >= 0
        and view.len.usize().i64() == view.len
        and index >= 0
        and index < view.len
        and index.usize().i64() == index
    )
    return (
        view.len >= 0
        and view.len.usize().i64() == view.len
        and index >= 0
        and index < view.len
        and index.usize().i64() == index
    )

def string_view_index(view: sview, index: i64) -> i64:
    ensure not string_view_index_request_valid(view, index) implies result == 0
    # Not stated: a valid request returns byte `index`. `view[i]` lowers to this function, so the
    # body must read `view.data`, and the prover treats that raw read as opaque in a contract.
    ensure result >= 0 and result <= 255
    trusted Unsafe.UncheckedIndex:
        return 0 if view.len < 0
        view_len: usize = view.len.usize()
        index_usize: usize = index.usize()
        # The round-trip checks keep this valid on targets where usize is narrower.
        # A negative index cannot round-trip on those targets; on a full-width
        # target its unsigned value is outside any nonnegative signed length.
        return 0 if:
            view_len.i64() != view.len
            index_usize.i64() != index
            index_usize >= view_len
        return view.data[index_usize].i64()

def string_view_eq(view: sview, other: cstr?) -> int:
    can Unsafe{PointerCast,RawExtern}:
        rhs: cstr = other if other != null else ""
        rhs_len: usize = runtime_strlen(rhs)

        return 0 if view.len < 0
        view_len: usize = view.len.usize()
        return 0 if view_len.i64() != view.len or view_len != rhs_len
        #1 return if view.len == 0
        #1 return if view.data == rhs

        return 1 if view.len == 0 or view.data.cast[uintptr] == rhs.cast[uintptr]

        return 1 if memcmp(view.data.cast[void&], rhs.cast[void&], view_len) == 0 else 0

def string_views_eq(lhs: sview, rhs: sview) -> int:
    can Unsafe{PointerCast,RawExtern}:
        return 0 if lhs.len < 0 or rhs.len < 0
        lhs_len: usize = lhs.len.usize()
        rhs_len: usize = rhs.len.usize()
        return 0 if lhs_len.i64() != lhs.len or rhs_len.i64() != rhs.len
        if likely lhs_len != rhs_len:
            return 0

        #1 return if lhs.len == 0
        #1 return if lhs.data == rhs.data
        return 1 if lhs.len == 0 or lhs.data.cast[uintptr] == rhs.data.cast[uintptr]

        return 1 if memcmp(lhs.data.cast[void&], rhs.data.cast[void&], lhs_len) == 0 else 0

def string_view_copy(view: sview) -> cstr can[Global.Read, Global.Write, Atomics.Load]:
    can Abort.Panic, Atomics{Exchange,Load,Store}, Memory.Allocate, Unsafe{Alias,MutableGlobal,PointerCast,RawExtern,UncheckedIndex}:
        if view.len <= 0:
            can Global{Read,Write}, Atomics.Load:
                trusted Unsafe.PointerCast:
                    return intern_small_string("", 0).cast[cstr]
        view_len: usize = runtime_checked_i64_to_usize(view.len)
        if view_len <= 8:
            can Global{Read,Write}, Atomics.Load:
                trusted Unsafe.PointerCast:
                    return intern_small_string(view.data, view_len).cast[cstr]

        allocation_bytes: usize = runtime_checked_add_usize(view_len, 1)
        out: mutable heap u8& = arena_alloc(&perm_arena, allocation_bytes).cast[heap u8&] can Global{Read,Write}, Atomics.Load
        memcpy(out.cast[mutable void&], view.data.cast[void&], view_len)
        out[view_len] <- 0
        register_perm_string_len(out.cast[u8&], view_len) can Global{Read,Write}, Atomics.Load
        trusted Unsafe.PointerCast:
            return out.cast[cstr]

# ------------------------------------------------------------
# Ergonomic string-view queries.
#
# Length is available directly as `.len`, and bounded byte reads use `view[index]`.
# These higher-level helpers operate on the same signed extent.
# ------------------------------------------------------------

def sview_is_empty(view: sview) -> bool:
    return view.len <= 0

def sview_eq(lhs: sview, rhs: sview) -> bool:
    can Unsafe{PointerCast,RawExtern}:
        return string_views_eq(lhs, rhs) == 1

def sview_starts_with(view: sview, prefix: sview) -> bool:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return false if:
            view.len < 0 or prefix.len < 0
            prefix.len > view.len
        return string_views_eq(string_view_prefix(view, prefix.len), prefix) == 1

def sview_ends_with(view: sview, suffix: sview) -> bool:
    can Unsafe{PointerArithmetic,PointerCast,RawExtern}:
        return false if:
            view.len < 0 or suffix.len < 0
            suffix.len > view.len
        return string_views_eq(string_view_suffix(view, view.len - suffix.len), suffix) == 1

# Index of the first occurrence of `byte`, or -1 if absent.
def sview_find_byte(view: sview, byte: u8) -> i64:
    ensure (view.len < 0 or view.len.usize().i64() != view.len) implies result == -1
    ensure result >= -1
    ensure result >= 0 implies result < view.len
    ensure result >= 0 implies string_view_index(view, result) == byte.i64()
    ensure result >= 0 implies (forall prior in 0..<result: string_view_index(view, prior) != byte.i64())
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and result == -1) implies (forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64())
    trusted Unsafe.UncheckedIndex:
        return -1 if view.len < 0
        view_len: usize = view.len.usize()
        return -1 if view_len.i64() != view.len
        i: mutable i64 = 0
        while i < view.len:
            decreases view.len - i
            invariant 0 <= i and i <= view.len
            invariant forall prior in 0..<i: string_view_index(view, prior) != byte.i64()
            return i if string_view_index(view, i) == byte.i64()
            i <- i + 1
        return -1

def sview_contains_byte(view: sview, byte: u8) -> bool:
    ensure result == (sview_find_byte(view, byte) >= 0)
    can Unsafe.UncheckedIndex:
        return sview_find_byte(view, byte) >= 0

# Drop a trailing byte (e.g. a path separator) without copying.
def sview_trim_trailing(view: sview, byte: u8) -> sview:
    ensure result.len >= 0 and result.len <= (view.len if view.len > 0 and view.len.usize().i64() == view.len else 0)
    ensure result.len > 0 implies (string_view_index(view, result.len - 1) != byte.i64() and result.data == view.data)
    ensure forall suffix_index in result.len..<(view.len if view.len > 0 and view.len.usize().i64() == view.len else 0): string_view_index(view, suffix_index) == byte.i64()
    can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
        return "" if view.len < 0
        view_len: usize = view.len.usize()
        return "" if view_len.i64() != view.len
        assert view.len >= 0 and view_len.i64() == view.len
        hi: mutable i64 = view.len
        while hi > 0 and string_view_index(view, hi - 1) == byte.i64():
            decreases hi
            invariant 0 <= hi and hi <= view.len and hi.usize().i64() == hi
            invariant forall suffix_index in hi..<view.len: string_view_index(view, suffix_index) == byte.i64()
            hi <- hi - 1
        return string_view_prefix(view, hi)

# A bounds-safe view over the live bytes of a darray[u8]. This is the bridge
# that lets raw byte-buffer scanning (ELF string tables, parse buffers, ...) be
# done through the bounds-checked sview helpers instead of unchecked indexing
# with compound offsets. The single interior pointer is taken under `trusted`
# here, ONCE, so every caller scans with zero Unsafe of its own.
#
# The returned view borrows the darray's storage: it is valid only while the
# darray is alive and un-grown (a relocating push invalidates it — the compiler
# tracks this for interior darray borrows).
def bytes_view(buf: darray[u8]) -> sview:
    can Unsafe{PointerArithmetic,RawExtern}:
        n: usize = buf.count
        return sview("", 0, 0) if:
            n == 0
            buf.items == null or n > buf.capacity
        signed_len: i64 = n.i64()
        if signed_len < 0 or signed_len.usize() != n:
            return sview("", 0, 0)
        trusted Unsafe.UncheckedIndex:
            trusted Unsafe.PointerCast:
                return StringView{data: &buf[0], len: signed_len}

# A bounded borrowed view into a byte buffer. The source's count and capacity provide
# the extent; this never scans for a NUL byte and cannot be used with an arbitrary pointer.
def bytes_view_range(buf: darray[u8], start: usize, count: usize) -> sview:
    can Unsafe{PointerArithmetic,RawExtern}:
        base: sview = bytes_view(buf)
        empty: sview = sview("", 0, 0)
        return empty if base.len < 0
        base_len: usize = base.len.usize()
        return empty if base_len.i64() != base.len or start > base_len or count > base_len - start
        start_signed: i64 = start.i64()
        count_signed: i64 = count.i64()
        return empty if start_signed < 0 or start_signed.usize() != start or count_signed < 0 or count_signed.usize() != count
        return string_view_slice(base, start_signed, start_signed + count_signed)

# Reference-taking counterpart for APIs that already receive a darray borrow. It
# proves the requested extent against the live container before the only indexed
# address calculation, so the returned view carries the borrow rather than a copy.
ghost def bytes_view_range_ref_request_valid(buf: darray[u8]&, start: usize, count: usize) -> bool:
    ensure result == (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    )
    return (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    )

def bytes_view_range_ref(buf: darray[u8]&, start: usize, count: usize) -> sview:
    ensure result.len >= 0
    ensure result.len == 0 or result.len == count.i64()
    ensure (count == 0) implies result.len == 0
    ensure (start > buf.count) implies result.len == 0
    ensure (start <= buf.count and count > buf.count - start) implies result.len == 0
    ensure (buf.count == 0 or buf.items == null or buf.count > buf.capacity) implies result.len == 0
    ensure (buf.count.i64() < 0 or buf.count.i64().usize() != buf.count) implies result.len == 0
    ensure (start.i64() < 0 or start.i64().usize() != start) implies result.len == 0
    ensure (count.i64() < 0 or count.i64().usize() != count) implies result.len == 0
    ensure (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.len == count.i64()
    ensure (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.data == buf.items + start
    ensure not (
        buf.count > 0
        and buf.items != null
        and buf.count <= buf.capacity
        and buf.count.i64() >= 0
        and buf.count.i64().usize() == buf.count
        and start <= buf.count
        and count <= buf.count - start
        and start.i64() >= 0
        and start.i64().usize() == start
        and count.i64() >= 0
        and count.i64().usize() == count
        and count > 0
        and start < buf.count
    ) implies result.len == 0
    can Unsafe{PointerArithmetic,RawExtern}:
        empty: sview = sview("", 0, 0)
        if (
            buf.count > 0
            and buf.items != null
            and buf.count <= buf.capacity
            and buf.count.i64() >= 0
            and buf.count.i64().usize() == buf.count
            and start <= buf.count
            and count <= buf.count - start
            and start.i64() >= 0
            and start.i64().usize() == start
            and count.i64() >= 0
            and count.i64().usize() == count
            and count > 0
            and start < buf.count
        ):
            trusted Unsafe.PointerArithmetic:
                trusted Unsafe.PointerCast:
                    return StringView{data: buf.items + start, len: count.i64()}
        assert not (
            buf.count > 0
            and buf.items != null
            and buf.count <= buf.capacity
            and buf.count.i64() >= 0
            and buf.count.i64().usize() == buf.count
            and start <= buf.count
            and count <= buf.count - start
            and start.i64() >= 0
            and start.i64().usize() == start
            and count.i64() >= 0
            and count.i64().usize() == count
            and count > 0
            and start < buf.count
        )
        return empty

# Last index of a byte in a view, or -1 when absent; used by the Fs path helpers.
def sview_find_last_byte(view: sview, byte: u8) -> i64:
    # Keep scalar range facts in independent clauses so call-site SMT projection
    # can retain them even when the quantified character facts are opaque.
    ensure (view.len < 0 or view.len.usize().i64() != view.len) implies result == -1
    ensure result >= -1
    ensure (result >= 0) implies result < view.len
    ensure (result >= 0) implies string_view_index(view, result) == byte.i64()
    ensure (result >= 0) implies (forall later in result + 1..<view.len: string_view_index(view, later) != byte.i64())
    ensure (view.len >= 0 and view.len.usize().i64() == view.len and result == -1) implies (forall candidate in 0..<view.len: string_view_index(view, candidate) != byte.i64())
    trusted Unsafe.UncheckedIndex:
        return -1 if view.len < 0
        view_len: usize = view.len.usize()
        return -1 if view_len.i64() != view.len
        assert view.len >= 0 and view_len.i64() == view.len
        i: mutable i64 = view.len
        while i > 0:
            decreases i
            invariant 0 <= i and i <= view.len
            invariant forall later in i..<view.len: string_view_index(view, later) != byte.i64()
            candidate: i64 = i - 1
            if string_view_index(view, candidate) == byte.i64():
                return candidate
            i <- candidate
        return -1

# Pure StringView path decomposition; OS-backed filesystem queries live in the host FFI.
# filename and parent select the final component and its preceding prefix.
module Fs:
    def filename(p: sview) -> sview:
        ensure (p.len >= 0 and p.len.usize().i64() == p.len) implies result.len == p.len - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) >= 0) implies result.data == p.data + (sview_find_last_byte(p, 47) + 1).usize()
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) == -1) implies result.data == p.data
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            assert slash == sview_find_last_byte(p, 47)
            assert slash >= -1 and slash < p.len
            if slash >= 0:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: p.len - (slash + 1)}
            assert slash == -1
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: p.len - (slash + 1)}

    def parent(p: sview) -> sview:
        ensure (p.len >= 0 and p.len.usize().i64() == p.len) implies ((sview_find_last_byte(p, 47) >= 0 and result.len == sview_find_last_byte(p, 47) and (result.len == 0 or result.data == p.data)) or (sview_find_last_byte(p, 47) == -1 and result.len == 0))
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            assert slash == sview_find_last_byte(p, 47)
            assert slash >= -1 and slash < p.len
            if slash >= 0:
                return string_view_empty_at(p.data) if slash == 0
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data, len: slash}
            assert slash == -1
            return string_view_empty_at(p.data)

    # The malformed-input and exhaustive valid-length cases below imply result.len >= 0.
    def extension(p: sview) -> sview:
        ensure (p.len < 0 or p.len.usize().i64() != p.len) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.len == p.len - sview_find_last_byte(p, 46)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) <= sview_find_last_byte(p, 47) + 1) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.data == p.data + sview_find_last_byte(p, 46).usize()
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            name_start: i64 = slash + 1
            dot: i64 = sview_find_last_byte(p, 46)
            assert slash >= -1 and slash < p.len
            assert name_start == sview_find_last_byte(p, 47) + 1
            assert dot == sview_find_last_byte(p, 46)
            assert name_start >= 0 and name_start <= p.len
            assert dot >= -1 and dot < p.len
            if dot > name_start:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + sview_find_last_byte(p, 46).usize(), len: p.len - dot}
            assert dot <= name_start
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: 0}

    # The malformed-input and exhaustive valid-length cases imply result.len >= 0.
    def stem(p: sview) -> sview:
        ensure (p.len < 0 or p.len.usize().i64() != p.len) implies result.len == 0
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) > sview_find_last_byte(p, 47) + 1) implies result.len == sview_find_last_byte(p, 46) - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 46) <= sview_find_last_byte(p, 47) + 1) implies result.len == p.len - (sview_find_last_byte(p, 47) + 1)
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) >= 0) implies result.data == p.data + (sview_find_last_byte(p, 47) + 1).usize()
        ensure (p.len >= 0 and p.len.usize().i64() == p.len and sview_find_last_byte(p, 47) == -1) implies result.data == p.data
        can Unsafe{PointerArithmetic,RawExtern,UncheckedIndex}:
            return string_view_empty_at(p.data) if p.len < 0 or p.len.usize().i64() != p.len
            slash: i64 = sview_find_last_byte(p, 47)
            name_start: i64 = slash + 1
            dot: i64 = sview_find_last_byte(p, 46)
            assert slash >= -1 and slash < p.len
            assert slash == sview_find_last_byte(p, 47)
            assert name_start == sview_find_last_byte(p, 47) + 1
            assert dot == sview_find_last_byte(p, 46)
            assert name_start >= 0 and name_start <= p.len
            assert dot >= -1 and dot < p.len
            if dot > name_start:
                if slash >= 0:
                    trusted Unsafe.PointerCast:
                        return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: dot - name_start}
                assert slash == -1
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data, len: dot - name_start}
            assert dot <= name_start
            if slash >= 0:
                trusted Unsafe.PointerCast:
                    return StringView{data: p.data + (sview_find_last_byte(p, 47) + 1).usize(), len: p.len - name_start}
            assert slash == -1
            trusted Unsafe.PointerCast:
                return StringView{data: p.data, len: p.len - name_start}

    # Build `base / leaf` into arena `a` (std::filesystem::path::operator/). Inserts a
    # single `/` separator (no doubled slash if `base` already ends with one); an absolute
    # `leaf` (leading `/`) replaces `base`, as in C++. Allocates, so it takes the arena.
    def join(a: mutable Arena&, base: sview, leaf: sview) -> dstr:
        can Abort.Panic, Memory.Allocate, Unsafe{PointerArithmetic,PointerCast,RawExtern}:
            out: mutable dstr = []
            sep: sview = sview("/", 0, -1)
            in a:
                if sview_starts_with(leaf, sep):
                    for ch in leaf:
                        _ = out.push(ch)
                    return out
                for cb in base:
                    _ = out.push(cb)
                out.push(47) if base.len > 0 and not sview_ends_with(base, sep)
                for cl in leaf:
                    _ = out.push(cl)
            return out

include "./elisacore_runtime_string_path_views.elisa"
include "./elisacore_runtime_string_hash.elisa"
