include "./runtime/elisacore_std/elisacore_runtime.elisa"

# A USER-WRITTEN range loop (not a comprehension) with the single-buffer indexed-store shape:
# integer remainder by a runtime divisor has no vector idiv, so it stays scalar and the autovec
# verifier must flag it (warning; hard error under -Wperf) because no `can Scalar` grant
# acknowledges the scalar loop.
def mods_into(a: mutable darray[i64]&, d: i64) -> usize:
	can Memory.Allocate, Abort.Panic:
		for i in 0..<a.count:
			a[i] <- a[i] % d
		return a.count

export fn probe_scalar_mods(a: mutable darray[i64]&, d: i64) -> usize = mods_into
