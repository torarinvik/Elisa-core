include "./runtime/elisacore_std/elisacore_runtime.elisa"

# A USER-WRITTEN range loop (not a comprehension) with the clean element-wise indexed-store shape:
# call-free straight-line body storing to out[i]. Fixed-size arrays prove both indexed accesses,
# making the loop genuinely vector-eligible — yet integer remainder by a runtime divisor has no
# vector idiv, so it stays scalar and the autovec verifier must flag it (warning; hard error under
# -Wperf) because no `can Scalar` grant acknowledges the scalar loop.
def mods_into(a: array[i64, 1024]&, out: mutable array[i64, 1024]&, d: i64) -> usize:
	can Memory.Allocate, Abort.Panic:
		for i in 0..<1024:
			out[i] <- a[i] % d
		return 1024

export fn probe_scalar_mods(a: array[i64, 1024]&, out: mutable array[i64, 1024]&, d: i64) -> usize = mods_into
