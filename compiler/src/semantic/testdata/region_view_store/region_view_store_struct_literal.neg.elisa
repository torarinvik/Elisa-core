struct S:
    known: bool
    v: view[i64]

def main() -> i32:
    can Memory.Allocate:
        base: mutable darray[i64] = [0]
        t: mutable S = S{known: false, v: base[0:0]}
        region scratch(4096):
            xs: mutable darray[i64] = [1, 2, 3]
            t <- S{known: true, v: xs[0:2]}
        ys: mutable darray[i64] = [9, 9, 9, 9, 9]
        return t.v[1].i32() + ys[0].i32()
