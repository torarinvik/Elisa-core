module NameStore:
    @append_only
    struct Store:
        private:
            current: mutable darray[u8]
            retired: mutable darray[darray[u8]]

    def new_store() -> Store:
        return Store{current: [], retired: []}

    def make_room[@r](store: mutable Store& @r, needed: usize) -> void:
        return if store.current.count + needed <= store.current.capacity
        store.retired.push(store.current)
        store.current <- []
        store.current.reserve(needed if needed > 64 else 64)
    def append[@r](store: mutable Store& @r, byte: u8) -> usize:
        make_room(store, 1)
        start: usize = store.current.count
        store.current.push(byte)
        return start

struct Pool:
    names: NameStore::Store
    tag: u8

struct Outer:
    pool: Pool

def take(p: Pool) -> u8:
    return p.tag

def main() -> i32:
    p: mutable Pool = Pool{names: NameStore::new_store(), tag: 1}
    t: u8 = take(p)
    NameStore::append(p.names, 1)
    return 0
