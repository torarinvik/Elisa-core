module NameStore:
    @append_only
    struct Store:
        private:
            current: mutable darray[u8]
            retired: mutable darray[darray[u8]]

    def new_store() -> Store:
        return Store{current: [], retired: []}

    def make_room[@r](store: mutable Store& @r, needed: usize) -> void:
        return if store.current.count + needed <= store.current.capacity
        store.retired.push(store.current)
        store.current <- []
        store.current.reserve(needed if needed > 64 else 64)
    def append[@r](store: mutable Store& @r, byte: u8) -> usize:
        make_room(store, 1)
        start: usize = store.current.count
        store.current.push(byte)
        return start

struct Pool:
    names: mutable NameStore::Store
    tag: mutable u8

def bump(p: lmut Pool) -> u8:
    p.tag <- p.tag + 1
    return p.tag

def unit(p: lmut Pool, out: mutable darray[u8]&, k: bool, q: Pool) -> void:
    p, out <-
        if k:
            q, out.push(1)
        else:
            q, out
    x: u8 = q.tag
    r: Pool = move q

def main() -> i32:
    p: mutable Pool = Pool{names: NameStore::new_store(), tag: 0}
    out: mutable darray[u8] = []
    p <- p.unit(&out, true, Pool{names: NameStore::new_store(), tag: 0})
    return p.tag.i32()
